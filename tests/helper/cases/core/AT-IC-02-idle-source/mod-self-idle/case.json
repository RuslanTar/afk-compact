{
 "id": "AT-IS-11 (mod-self-idle)",
 "needs": [
  "fixture:transcripts/idle-cases.json"
 ],
 "note": "Owner 2026-10-27 (\"Compact (Recommended)\", SPEC-DELTAS AT-IS-11): the plugin's own idle compaction while agents run is a mod-self idle dispatch (trigger plugin) that Claude Code writes no idle notice for. The none-mod-idle transcript (no native idle row) with such a record: the next Stop gives idle true, idle_source mod and idle_gap_s on the compaction_boundary row, and no idle_mismatch row (a mod-hook idle record there gives one: none-mod-idle). Skipped until the WP-fix fixtures are merged.",
 "sid": "5e55a001-0c0f-4f1e-9a00-00000000a001",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "transcript and a mod-self idle dispatch record",
   "setup": [
    {
     "mkdir": "$TMP/example-repo"
    },
    {
     "copy": "transcripts/idle-none/main.jsonl",
     "subst": true,
     "to": "$TMP/projects/-tmp-example-repo/$SID.jsonl"
    },
    {
     "write": "$WATCH/$SID/dispatch/1d1e0c0a.json",
     "json": {
      "v": 1,
      "nonce": "1d1e0c0a",
      "session_id": "$SID",
      "actor": "main",
      "agent_id": null,
      "trigger": "plugin",
      "channel": "mod-self",
      "resume_pref": "prompt.context",
      "midturn": false,
      "idle": true,
      "tags": [],
      "instructions_sha8": "9f2c01ab",
      "instructions_bytes": 3994,
      "cc_version": "2.1.307",
      "load_id": "l0ad0001",
      "pid": 43210,
      "pid_lstart": "Wed Oct 21 09:00:00 2026",
      "ts": "2026-10-21T14:04:36+03:00",
      "idle_gap_s": 3330
     }
    }
   ]
  },
  {
   "name": "PostCompact (idle unknown until reconcile)",
   "now": "2026-10-21T14:05:30.200+03:00",
   "argv": [
    "hook",
    "PostCompact"
   ],
   "stdin": "payloads/PostCompact/idle-main.json",
   "expect": {
    "exit": 0,
    "rows": [
     {
      "file": "$WATCH/$SID/compactions.jsonl",
      "ev": "compaction",
      "count": 1,
      "fields": {
       "nonce": "1d1e0c0a",
       "idle": "unknown"
      }
     }
    ]
   }
  },
  {
   "name": "the next Stop decides idle",
   "now": "2026-10-21T14:20:00+03:00",
   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/projects/-tmp-example-repo/$SID.jsonl",
    "cwd": "$TMP/example-repo",
    "hook_event_name": "Stop",
    "stop_hook_active": false
   },
   "expect": {
    "exit": 0,
    "rows": [
     {
      "file": "$WATCH/$SID/compactions.jsonl",
      "ev": "compaction_boundary",
      "count": 1,
      "fields": {
       "nonce": "1d1e0c0a",
       "idle": true,
       "idle_source": "mod",
       "idle_gap_s": 3330
      }
     },
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "idle_mismatch",
      "count": 0
     }
    ],
    "joined": [
     {
      "nonce": "1d1e0c0a",
      "idle": true,
      "idle_source": "mod",
      "idle_gap_s": 3330
     }
    ],
    "grep_absent": [
     {
      "dir": "$WATCH",
      "text": "Compacted while idle"
     },
     {
      "dir": "$WATCH",
      "text": "written while you were away"
     }
    ]
   }
  },
  {
   "name": "a second Stop adds no row",
   "now": "2026-10-21T14:25:00+03:00",
   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/projects/-tmp-example-repo/$SID.jsonl",
    "cwd": "$TMP/example-repo",
    "hook_event_name": "Stop",
    "stop_hook_active": false
   },
   "expect": {
    "exit": 0,
    "rows": [
     {
      "file": "$WATCH/$SID/compactions.jsonl",
      "ev": "compaction_boundary",
      "count": 1
     },
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "idle_mismatch",
      "count": 0
     }
    ]
   }
  }
 ]
}
