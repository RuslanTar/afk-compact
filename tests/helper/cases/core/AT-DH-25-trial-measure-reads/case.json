{
 "id": "AT-DH-25-trial-measure-reads",
 "note": "Trial measure reads (review fixes): a folder outside git whose name has a space gets a bucket name (slug + 8 hex), and its real handoff bucket is still read under the name as found; the skip-list is tested before any other fact (the queue tool is not called); .remember/now.md is read only as a plain file inside the folder (a symlink out of it is not read); a symlinked old shadow is skipped; this session's own earlier shadow is given in full when it is not the previous handoff; the queue list is read without writing the session's queue state or the caps cache",
 "now": "2026-10-27T10:00:00+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "setup",
   "setup": [
    {"write": "$HOME/.cache/$BRAND-trial/trial.json", "json": {"v": 1, "on": true, "trial_until": "2026-11-24", "handoff_root": "$ROOT", "log_dir": "$WATCH", "cc_versions": ["2.1.311"], "skip_repos": ["My Project"]}},
    {"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {"queue_cmd": "$TMP/bin/queue"}}}}},
    {"write": "$TMP/bin/queue", "content": "#!/bin/sh\necho called >> \"$TMP/queue-called\"\necho '{\"schema\":\"queue-stub/v1\",\"lane\":\"lane:r/x\",\"open\":[\"Q-1\"],\"commands\":[\"list\"]}'\n", "mode": "0700"},
    {"write": "$TMP/outside/creds.txt", "content": "PROBE-OUTSIDE-CONTENT\n"},
    {"write": "$TMP/outside/prev.txt", "content": "LINKED-PREV-TEXT\n"},
    {"mkdir": "$TMP/My Project/src"},
    {"symlink": "$TMP/My Project/.remember/now.md", "to": "$TMP/outside/creds.txt"},
    {"write": "$TMP/plain/.remember/now.md", "content": "NOW-INSIDE\n"},
    {"write": "$ROOT/My Project/general/2026-10-27_08-00-00_real.md", "content": "REAL-BUCKET-TEXT\n"},
    {"write": "$HOME/.cache/$BRAND-trial/old/My-Project-51e38ecc/general/2026-10-26_09-00-00_${SID8}_own.old-handoff.txt", "content": "OWN-SHADOW-TEXT\n"},
    {"write": "$HOME/.cache/$BRAND-trial/old/My-Project-51e38ecc/general/2026-10-26_12-00-00_bbbbbbbb_other.old-handoff.txt", "content": "OTHER-SHADOW-TEXT\n"},
    {"symlink": "$HOME/.cache/$BRAND-trial/old/My-Project-51e38ecc/general/2026-10-27_09-00-00_aaaaaaaa_link.old-handoff.txt", "to": "$TMP/outside/prev.txt"}
   ]
  },
  {
   "name": "the skip-list by the name as found: no other fact gathered, the queue tool not called",
   "argv": ["trial-measure", "--sid", "$SID", "--cwd", "$TMP/My Project", "--cc-version", "2.1.311"],
   "expect": {
    "exit": 0,
    "json": {"state": "on", "skip": "repo-skipped"},
    "absent": ["$TMP/queue-called"]
   }
  },
  {
   "name": "a folder name with a space: the bucket name, the real bucket by the name, no linked text, own shadow in full",
   "setup": [
    {"write": "$HOME/.cache/$BRAND-trial/trial.json", "json": {"v": 1, "on": true, "trial_until": "2026-11-24", "handoff_root": "$ROOT", "log_dir": "$WATCH", "cc_versions": ["2.1.311"]}}
   ],
   "argv": ["trial-measure", "--sid", "$SID", "--cwd", "$TMP/My Project", "--cc-version", "2.1.311"],
   "expect": {
    "exit": 0,
    "json": {"state": "on", "skip": null, "facts.repo": "My-Project-51e38ecc", "facts.ticket": "general"},
    "stdout_has": [
     "Repository: My-Project-51e38ecc \\(the folder My Project, as one path part\\)",
     "REAL-BUCKET-TEXT",
     "Step 0\\): .*_own\\.old-handoff\\.txt\\\\nOWN-SHADOW-TEXT",
     "\\.remember/now\\.md:\\\\nabsent",
     "Queued: 1 open in lane:r/x"
    ],
    "stdout_lacks": ["PROBE-OUTSIDE-CONTENT", "LINKED-PREV-TEXT", "OTHER-SHADOW-TEXT"],
    "files": [{"path": "$TMP/queue-called", "count": 1}],
    "absent": ["$WATCH/*/queue-state.json", "$WATCH/queue-caps.json"]
   }
  },
  {
   "name": "a plain now.md inside the folder is read",
   "argv": ["trial-measure", "--sid", "$SID", "--cwd", "$TMP/plain", "--cc-version", "2.1.311"],
   "expect": {
    "exit": 0,
    "json": {"state": "on", "facts.repo": "plain"},
    "stdout_has": ["\\.remember/now\\.md:\\\\nNOW-INSIDE"]
   }
  }
 ]
}
