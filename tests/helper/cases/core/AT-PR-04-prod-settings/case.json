{
 "id": "AT-PR-04, AT-PR-02 (settings part)",
 "note": "S-SETTINGS B / MOD-SPEC §1.2, §2.6 (CORE-02): settings::prod. The shipped prod-token class catches --context=prod-eu, db.prod.example.com, AWS_PROFILE=production and --profile prd, not product or produce; prod_patterns adds user-prod-<n> (no ^ needed); a pattern that is an eval group, over 200 chars or not compiling is dropped (config_invalid {key, index}); the 33rd is dropped; unattended_prod_reads is trimmed and case-folded, another value is forbid plus config_invalid. CLI: --prod-patterns / --unattended-prod-reads flags and env are ignored with the 'settings file only' note and a config_note row; the file's bad pattern gives one config_invalid row; under a foreign CLAUDE_CONFIG_DIR the consent key takes its safe value (note) while the protective prod_patterns is still read from that folder's file",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "shipped class", "lib": "settings_prod", "args": {"values": {},
   "reads": "forbid", "user": 0,
   "matches": {"kubectl get pods --context=prod-eu": "prod-token", "psql -h db.prod.example.com -c 'select 1'": "prod-token",
               "AWS_PROFILE=production aws s3 ls": "prod-token", "aws --profile prd s3 ls": "prod-token",
               "make product-build": null, "./produce report": null, "git status": null},
   "invalid": []}},
  {"name": "user patterns", "lib": "settings_prod", "args": {"values": {"unattended_prod_reads": " Allow ", "prod_patterns": "--context=acme-eu1; (?{1}) ; xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx ;(  ;db\\.acme\\.internal"},
   "reads": "allow", "user": 2,
   "matches": {"kubectl get pods --context=acme-eu1": "user-prod-1", "psql -h db.acme.internal": "user-prod-5", "kubectl get pods --context=prod-eu": "prod-token", "kubectl get pods --context=dev": null},
   "invalid": ["prod_patterns:2", "prod_patterns:3", "prod_patterns:4"]}},
  {"name": "33rd pattern dropped", "lib": "settings_prod", "args": {"values": {"prod_patterns": "=acme-1$;=acme-2$;=acme-3$;=acme-4$;=acme-5$;=acme-6$;=acme-7$;=acme-8$;=acme-9$;=acme-10$;=acme-11$;=acme-12$;=acme-13$;=acme-14$;=acme-15$;=acme-16$;=acme-17$;=acme-18$;=acme-19$;=acme-20$;=acme-21$;=acme-22$;=acme-23$;=acme-24$;=acme-25$;=acme-26$;=acme-27$;=acme-28$;=acme-29$;=acme-30$;=acme-31$;=acme-32$;=acme-33$"}, "user": 32, "invalid": ["prod_patterns:33"],
   "matches": {"x --context=acme-32": "user-prod-32", "x --context=acme-3": "user-prod-3", "x --context=acme-33": null}}},
  {"name": "other value", "lib": "settings_prod", "args": {"values": {"unattended_prod_reads": "sometimes"}, "reads": "forbid", "invalid": ["unattended_prod_reads"]}},
  {"name": "flags and env ignored, file read",
   "options": {"prod_patterns": "--context=acme-eu1;(", "unattended_prod_reads": "allow"},
   "argv": ["status", "--sid", "$SID", "--prod-patterns", "--context=x", "--unattended-prod-reads", "allow"],
   "env": {"CLAUDE_PLUGIN_OPTION_PROD_PATTERNS": "--context=y", "CLAUDE_PLUGIN_OPTION_UNATTENDED_PROD_READS": "allow"},
   "expect": {"exit": 0,
     "stdout_has": ["^note: prod_patterns: settings file only$", "^note: unattended_prod_reads: settings file only$"],
     "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "config_note", "count": 1, "fields": {"key": "prod_patterns", "note": "settings-file-only"}},
              {"file": "$WATCH/$SID.classic.jsonl", "ev": "config_note", "count": 1, "fields": {"key": "unattended_prod_reads", "note": "settings-file-only"}},
              {"file": "$WATCH/$SID.classic.jsonl", "ev": "config_invalid", "count": 1, "fields": {"key": "prod_patterns", "index": 2}}]}},
  {"name": "foreign config dir: consent key safe, protective key still read",
   "setup": [{"write": "$TMP/cfg/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {"unattended_prod_reads": "allow", "prod_patterns": "ok;[bad"}}}}}],
   "argv": ["status", "--sid", "s-foreign"],
   "env": {"CLAUDE_CONFIG_DIR": "$TMP/cfg"},
   "expect": {"exit": 0,
     "stdout_has": ["^note: unattended_prod_reads: CLAUDE_CONFIG_DIR is not ~/\\.claude, safe value used$"],
     "stdout_lacks": ["^note: prod_patterns"],
     "rows": [{"file": "$WATCH/s-foreign.classic.jsonl", "ev": "config_invalid", "count": 1, "fields": {"key": "prod_patterns", "index": 2}}]}}
 ]
}
