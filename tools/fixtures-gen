def entropy(s):
    counts = {}
    for c in s:
        counts[c] = counts.get(c, 0) + 1
    return -sum(n / len(s) * math.log2(n / len(s)) for n in counts.values())


def load_rules():
    spec = os.path.join(REPO, "src", "assets", "handoff-spec.md")
    if os.path.exists(spec):
        m = re.search(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", read(spec), re.S | re.M)
        if m:
            try:
                lit = json.loads(m.group(1))
                rules = [(r["id"], r["class"], r["re"]) for r in lit.get("secret_rules", [])]
                if rules:
                    compiled = [(i, c, re.compile(x)) for i, c, x in rules]
                    return compiled, "src/assets/handoff-spec.md"
            except (ValueError, KeyError, re.error) as e:
                print("fixtures-gen: spec secret_rules unusable ({}); built-in set used".format(e))
    return [(i, c, None if x == "@entropy@" else re.compile(x)) for i, c, x in BUILTIN_RULES], "built-in"


def scan(text, rules):
    hits = []
    for rid, cls, rx in rules:
        if rx is None:
            for m in ENTROPY_RUN.finditer(text):
                if entropy(m.group(0)) >= 4.0:
                    hits.append((rid, cls))
                    break
        elif rx.search(text):
            hits.append((rid, cls))
    return hits


def deny_name(name):
    if re.search(DENY_EXCEPT, name):
        return False
    return any(re.search(p, name) for p in BUILTIN_DENY)


def load_corpus():
    with open(os.path.join(FIX, "secrets", "corpus.json"), encoding="utf-8") as f:
        return json.load(f)


# BD-2 reference redaction (C-STORE D6, AT-ST-12): every rule runs on the original text; overlapping
# or touching hits merge into one span, replaced once by `[redacted:<rule>]`, labelled by the first
# rule of the spec list among the merged hits. A rule's leading `(^|[^…])` or trailing `($|[^…])`
# guard group is not part of the hit. Corpus entries may pin the result: `redacted` (exact text) and
# `markers` (marker count).
def spec_rules_full():
    rules = literals().get("secret_rules") or []
    out = []
    for r in rules:
        try:
            out.append((r["id"], re.compile(r["re"]), r.get("min_entropy"), r["re"]))
        except (KeyError, re.error):
            pass
    return out


def hit_spans(text, rules):
    spans = []
    for order, (rid, rx, min_ent, src) in enumerate(rules):
        lead = src.startswith("(^|[^")
        trail = src.endswith(")") and re.search(r"\(\$\|\[\^[^\]]*\]\)$", src) is not None
        for m in rx.finditer(text):
            a, z = m.span()
            if lead and m.re.groups >= 1:
                a = m.end(1)
            if trail and m.re.groups >= 1:
                z = m.start(m.re.groups)
            if z <= a:
                continue
            if min_ent is not None and entropy(text[a:z]) < min_ent:
                continue
            spans.append((a, z, order, rid))
    return spans


def redact_bd2(text, rules):
    spans = sorted(hit_spans(text, rules))
    merged = []
    for a, z, order, rid in spans:
        if merged and a <= merged[-1][1]:
            m = merged[-1]
            merged[-1] = [m[0], max(m[1], z), min(m[2], (order, rid))]
        else:
            merged.append([a, z, (order, rid)])
    out, at = [], 0
    for a, z, (order, rid) in merged:
        out.append(text[at:a] + "[redacted:{}]".format(rid))
        at = z
    out.append(text[at:])
    return "".join(out), len(merged)


def check_bd2(corpus):
    rules = spec_rules_full()
    problems, pinned = [], 0
    if not rules:
        return ["bd2: no spec secret_rules to run"], 0
    for e in corpus["entries"]:
        joined = "".join(e["fragments"])
        out, n = redact_bd2(joined, rules)
        if re.search(r"\]\s*\[redacted:", out):
            problems.append("bd2 {}: two markers touch or sit apart by whitespace only: {!r}".format(e["id"], out[:80]))
        if "redacted" in e:
            pinned += 1
            if out != e["redacted"]:
                problems.append("bd2 {}: redacts to {!r}, the pin says {!r}".format(e["id"], out, e["redacted"]))
        if "markers" in e:
            pinned += 1
            if n != e["markers"]:
                problems.append("bd2 {}: {} markers, the pin says {}".format(e["id"], n, e["markers"]))
    return problems, pinned


