{
 "id": "AT-QA-02, AT-QA-03 (core part: queue mode, strict list, queue_contract)",
 "note": "QA-1, QA-2: queue::mode() is off when queue_cmd is empty, degraded (not-executable) for a path that is not an executable file (no exec), on otherwise, and degraded (<why>) after this session's list reply broke the contract. A list reply must carry schema queue-stub/v1: an untagged reply gives degraded (untagged), no Queued: line, no lane, and one queue_contract {why: untagged} row per session; queue-stub/v2 gives degraded (schema); a tagged v1 reply gives the Queued: line and caches its commands (adopt:must-exist). The same parser serves checkpoint, measure --compact and PostCompact; /status says the mode and makes no queue call",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "unset: off, no call",
   "setup": [{"repo_fixture": "main-branch.json", "at": "$TMP/example-repo"},
             {"write": "$TMP/not-exec", "text": "#!/bin/sh\necho no\n", "mode": "0644"}],
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["^queue: off$"], "trace_absent": ["queue_cmd"]}},
  {"name": "not an executable file: degraded (not-executable), no exec",
   "options": {"queue_cmd": "$TMP/not-exec"},
   "argv": ["checkpoint", "--sid", "$SID", "--nonce", "1a2b3c01", "--budget-ms", "10000", "--measured", "--cwd", "$TMP/example-repo"],
   "expect": {"exit": 0, "json": {"lane": null, "queued_line": null}, "trace_absent": ["queue_cmd"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "queue_contract", "count": 0}]}},
  {"argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["^queue: degraded \\(not-executable\\)$"], "trace_absent": ["queue_cmd"]}},
  {"name": "executable, never listed: on",
   "options": {"queue_cmd": "$FIX/bin/queue-stub"},
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["^queue: on$"], "trace_absent": ["queue_cmd"]}},
  {"name": "untagged reply (checkpoint): degraded (untagged), no Queued line, one queue_contract row",
   "env": {"QUEUE_STUB_DIR": "$CASE/queue-untagged", "QUEUE_STUB_LOG": "$TMP/queue.log"},
   "argv": ["checkpoint", "--sid", "$SID", "--nonce", "1a2b3c02", "--budget-ms", "10000", "--measured", "--cwd", "$TMP/example-repo"],
   "expect": {"exit": 0, "json": {"lane": null, "queued_line": null, "measured_block": {"re": "\\A(?![\\s\\S]*Queued:)"}},
              "trace_has": ["queue_cmd"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "queue_contract", "count": 1, "fields": {"why": "untagged"}},
                       {"file": "$WATCH/$SID.classic.jsonl", "ev": "lane_unknown", "count": 1, "fields": {"why": "untagged"}}]}},
  {"name": "untagged again (measure --compact): still one queue_contract row",
   "env": {"QUEUE_STUB_DIR": "$CASE/queue-untagged", "QUEUE_STUB_LOG": "$TMP/queue.log"},
   "argv": ["measure", "--sid", "$SID", "--compact", "--cwd", "$TMP/example-repo"],
   "expect": {"exit": 0, "stdout_lacks": ["^Queued:"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "queue_contract", "count": 1}]}},
  {"argv": ["status", "--sid", "$SID"],
   "env": {"QUEUE_STUB_LOG": "$TMP/status-queue.log"},
   "expect": {"exit": 0, "stdout_has": ["^queue: degraded \\(untagged\\)$"], "trace_absent": ["queue_cmd"],
              "files": [{"path": "$TMP/status-queue.log", "count": 0}]}},
  {"name": "queue::mode(sid, cmd) reads that session's record, no queue call",
   "lib": "queue_mode", "args": {"watch": "$WATCH", "sid": "$SID", "cmd": "$FIX/bin/queue-stub", "mode": "degraded", "why": "untagged", "text": "degraded (untagged)"}},
  {"name": "another session with no record: on",
   "lib": "queue_mode", "args": {"watch": "$WATCH", "sid": "5e55a0ff-0c0f-4f1e-9a00-00000000a0ff", "cmd": "$FIX/bin/queue-stub", "mode": "on", "why": null, "text": "on"}},
  {"name": "a sid that is not one path component reads no record",
   "lib": "queue_mode", "args": {"watch": "$WATCH", "sid": "../$SID", "cmd": "$FIX/bin/queue-stub", "mode": "on", "text": "on"}},
  {"name": "two-argument form, empty cmd: off",
   "lib": "queue_mode", "args": {"watch": "$WATCH", "sid": "$SID", "cmd": "", "mode": "off", "text": "off"}},
  {"name": "another schema: degraded (schema)",
   "env": {"QUEUE_STUB_DIR": "$CASE/../AT-E-10/queue-v2", "QUEUE_STUB_LOG": "$TMP/queue.log"},
   "argv": ["checkpoint", "--sid", "$SID", "--nonce", "1a2b3c03", "--budget-ms", "10000", "--measured", "--cwd", "$TMP/example-repo"],
   "expect": {"exit": 0, "json": {"lane": null, "queued_line": null},
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "queue_contract", "count": 1, "fields": {"why": "schema"}},
                       {"file": "$WATCH/$SID.classic.jsonl", "ev": "queue_contract", "count": 2}]}},
  {"argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["^queue: degraded \\(schema\\)$"]}},
  {"name": "tagged v1 (PostCompact, no checkpoint): the lane, mode on again, commands cached",
   "env": {"QUEUE_STUB_DIR": "$CASE/queue-v1-caps", "QUEUE_STUB_LOG": "$TMP/queue.log"},
   "setup": [{"dispatch": {"nonce": "5e6f7a8b", "actor": "main", "channel": "mod-hook", "trigger": "auto", "age_s": 20}}],
   "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP/example-repo", "hook_event_name": "PostCompact", "trigger": "auto",
                  "compact_summary": "<summary>\n⟪{{plugin}} v1 n=5e6f7a8b s=main⟫\n# LAB-42 queue lane\n## Resume here\nStatus: active · State: one spec left\nStep 1: `bin/test` — for \"x\"\n⟪/{{plugin}} n=5e6f7a8b⟫\n</summary>"},
   "expect": {"exit": 0,
              "files": [{"path": "$ROOT/*/*/compact/*5e6f7a.md", "count": 1, "frontmatter": {"queue_lane": "lane:repo/x"}},
                        {"path": "$WATCH/queue-caps.json", "contains": ["adopt:must-exist"]}],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "queue_contract", "count": 2}]}},
  {"argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["^queue: on$"]}},
  {"name": "measure --compact with a tagged reply: the Queued line",
   "env": {"QUEUE_STUB_DIR": "$CASE/queue-v1-caps", "QUEUE_STUB_LOG": "$TMP/queue.log"},
   "argv": ["measure", "--sid", "$SID", "--compact", "--cwd", "$TMP/example-repo"],
   "expect": {"exit": 0, "stdout_has": ["^Queued: 2 open in repo x \\(q-0007, q-0009\\); "]}}
 ]
}
