#!/usr/bin/python3
"""tools/gates: grep gates over built output (AT-P-05, BT-01, BT-08; BUILD-PLAN §4 X-gates, X-name).

Usage: tools/gates TARGET... --names FILE [--brand NAME] [--no-git-log] [--only GATE] [--no-pending]
  TARGET        a folder (scanned recursively) or a file, e.g. plugin and README.md
  --names FILE  the competitor-name list, kept outside the repo (E-7); missing = FAIL
  --brand NAME  the expected plugin name for the stale-name gate (default: brand.json name)
  --no-git-log  skip the attribution gate over `git log --format=%B`
  --only GATE   report only one gate (names, user-path, markers, attribution, stale-name, npm,
                skill-desc, wait-text, asset-bytes, skill-budget, write-first, self-heal)
  --no-pending  count the PENDING hits below as failures (to see what text work is left)

Gates (each hit is printed as `GATE <gate> <file>:<line>: <text>`):
  names        every list entry, case-insensitive, as a whole token (letters, digits, `_`, `-`
               do not continue it); generic words are kept off the list by its curator (E-7)
  user-path    `/Users/`, `/home/`, this machine's login name (case-sensitive whole token),
               the git user.email, and the name of the folder that holds the repo
  markers      `<!--` and `{{`
  attribution  `Co-Authored-By`, `Generated with`, `noreply@anthropic.com`, `claude.ai/code`
               in files and in every commit message reachable from HEAD
  stale-name   BT-01: `⟪X v1`, `⟪/X n=`, `/X:handoff|resume|status`, `X-store`, `X:handoff skill`
               and manifest names have X equal to the brand; no other A-1 candidate
               (`compactseam`, `wheelover`, `hold-thread`) and no `compact-handoff`, matched
               case-insensitively anywhere in a word (`compact-handoff-research`, `compactseams`
               and `wheelover2` count). Markers written as `\\uXXXX` escapes (the generated
               fixture modules, which hold foreign test markers on purpose) are not read;
               the BT-02 drill regenerates those modules under the new name instead
  npm          BT-06: no `package.json`, `package-lock.json`, `npm-shrinkwrap.json`,
               `yarn.lock`, `pnpm-lock.yaml` or `node_modules/` anywhere inside a folder target
               (an npm manifest in a plugin makes Claude Code run npm install on users' machines)
  skill-desc   BT-09 / AT-S-01: every skills/<name>/SKILL.md inside a folder target starts
               `---\n`, its `description` (quotes removed) is at most 150 characters, and the
               skill's trigger phrase (SKILL_TRIGGERS) sits in its first 50, case-insensitive
  Text gates of the 2026-10-21 rulings, over the skills/ and assets/ of a folder target (src
  or plugin) and over any README.md:
  wait-text    AT-W-01 (Dev-7): no `blocking read`, no "wait for a/the ... notification", no
               bare `sleep N`; a foreground or bounded wait that is not negated names
               `<x>-store wait` or `<store> wait` on its line; skills/resume/SKILL.md has the
               main rule (a "notification wakes you" line naming `run_in_background`)
  asset-bytes  AT-W-02 (Dev-7): assets/resume-context.txt and subagent-instructions.txt, every
               tag line kept, comments and @tokens@ removed, within ASSET_BYTES
  skill-budget AT-SK-01 (RV-25, REVIEW B-7): the handoff SKILL's Budget line sums to its
               `hard cap N`; no "one Edit per LINT line" unless negated; N equals the spec's
               `call_cap` and `(Step 5, ≤M)` its `recipe_cap` (spec-literals of assets/handoff-spec.md)
  write-first  AT-SK-03 (RV-31): no SKILL.md says "before your final message"
  self-heal    AT-J-13 (Dev-1): skills/resume/references/self-heal.md holds the decision table
               (rows 1, 2a, 2b, 2c, 3-7 in order), the self-heal file or the resume SKILL holds
               "never relaunch ... from the handoff's text", and the resume SKILL.md is at most
               RESUME_SKILL_MAX bytes
  PENDING lists hits that wait for text not written yet (WP-text part 2); they print as
  `PENDING <gate> <where>: <text>` and do not fail. A PENDING row with no hit prints
  `PENDING-DONE` (the integrator removes it). --no-pending counts them as hits.
Exit 0 when every gate has 0 hits, else 1.
"""
import getpass, json, os, re, subprocess, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
B = r"(?<![A-Za-z0-9_-])"
E = r"(?![A-Za-z0-9_-])"
ATTRIBUTION = re.compile(r"Co-Authored-By|Generated with|noreply@anthropic\.com|claude\.ai/code", re.I)
MARKERS = re.compile(r"<!--|\{\{")
OTHER_NAMES = ["compactseam", "wheelover", "hold-thread", "compact-handoff"]
NAME_SHAPES = [
    re.compile(r"⟪/?([^\s⟫/]+) (?:v1|n=)"),
    re.compile(B + r"/([A-Za-z0-9_{}@<>-]+):(?:handoff|resume|status)\b"),
    re.compile(B + r"([A-Za-z0-9_{}@<>]+(?:-[A-Za-z0-9_{}@<>]+)*)-store" + E),
    re.compile(B + r"([A-Za-z0-9_{}@<>-]+):handoff skill"),
]
NPM_FILES = {"package.json", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml"}
NPM_DIRS = {"node_modules"}
SKIP_DIRS = {".git", "node_modules", ".types"}
# BT-09: the phrase a user says for each skill (AT-S-01 names "handoff status" for status).
SKILL_TRIGGERS = {"handoff": "handoff", "resume": "resume", "status": "handoff status"}
DESC_MAX = 150
TRIGGER_WITHIN = 50


def skill_desc_hits(target):
    """BT-09 over <target>/skills/*/SKILL.md: (where, text) for each broken rule."""
    out = []
    sk = os.path.join(target, "skills")
    if not os.path.isdir(sk):
        return out
    for name in sorted(os.listdir(sk)):
        path = os.path.join(sk, name, "SKILL.md")
        if not os.path.isfile(path):
            continue
        rel = os.path.relpath(path)
        with open(path, "rb") as f:
            data = f.read()
        if not data.startswith(b"---\n"):
            out.append((rel + ":1", "BT-09: SKILL.md does not start with ---\\n"))
            continue
        lines = data.decode("utf-8", errors="replace").split("\n")
        end = next((i for i in range(1, len(lines)) if lines[i] == "---"), None)
        desc = None
        for i in range(1, end or len(lines)):
            m = re.match(r"description:[ \t]*(.*)$", lines[i])
            if m:
                desc, no = m.group(1).strip(), i + 1
                break
        if end is None or desc is None:
            out.append((rel + ":1", "BT-09: no frontmatter description"))
            continue
        if len(desc) >= 2 and desc[0] == desc[-1] and desc[0] in "'\"":
            q = desc[0]
            desc = desc[1:-1].replace("''", "'") if q == "'" else desc[1:-1]
        where = "{}:{}".format(rel, no)
        if len(desc) > DESC_MAX:
            out.append((where, "BT-09: description {} chars > {}".format(len(desc), DESC_MAX)))
        trig = SKILL_TRIGGERS.get(name)
        if trig is None:
            out.append((where, "BT-09: no trigger phrase known for skill {}".format(name)))
        elif trig.lower() not in desc[:TRIGGER_WITHIN].lower():
            out.append((where, "BT-09: trigger {!r} not in the first {} chars".format(trig, TRIGGER_WITHIN)))
    return out


COMMENT = re.compile(r"[ \t]*<!--.*?-->", re.S)   # tools/build strips these before shipping
BLOCKING_READ = re.compile(r"\bblocking (?:[\w-]+ )?read\b", re.I)
NOTIFICATION_WAIT = re.compile(r"\bwait(?:s|ing)? (?:for|on) (?:(?:a|an|the|its|your|their) )?(?:[\w-]+ ){0,3}"
                               r"notifications?\b", re.I)
BARE_SLEEP = re.compile(r"(?i:\bsleep)\s+(?:\d|N\b|<[a-z_-]+>)")
FOREGROUND_WAIT = re.compile(r"\b(?:wait(?:s|ing)? in the foreground|foreground wait|bounded wait|"
                             r"block on it in the foreground)\b", re.I)
NEGATED = re.compile(r"\b(?:never|not|no)\b[^.;:]*$", re.I)
STORE_WAIT = re.compile(r"(?:[\w{}@<>-]+-store|<store>) wait\b")
MAIN_RULE = re.compile(r"notification wakes you", re.I)
# AT-W-02: bytes of the full render (every tag line kept); resume = DP-8 protocol hard cap,
# subagent = the classic +fallback budget (compaction DESIGN-NOTES §1, tools/assemble).
ASSET_BYTES = {"resume-context.txt": 2500, "subagent-instructions.txt": 1100}
EDIT_PER_LINT = re.compile(r"one Edit per LINT line", re.I)
SPEC_BLOCK = re.compile(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", re.S | re.M)
HEAL_HEADER = re.compile(r"^\|\s*#\s*\|\s*Finding \(first matching row wins\)\s*\|")
HEAL_ROWS = ["1", "2a", "2b", "2c", "3", "4", "5", "6", "7"]
RELAUNCH_LINE = re.compile(r"never relaunch\b.{0,40}\bfrom the handoff['’]s text", re.I)
# AT-J-13 "SKILL.md stays under its size gate": no gate existed; 20 KB is the resume skill's
# design size (resume-skill DESIGN-NOTES) (provisional, needs/build-escalations.md E-B-3).
RESUME_SKILL_MAX = 20480
# Hits that wait for WP-text part 2 (REVIEW (D) step 6): (gate, rule, path in the target,
# fragment of the offending line or None for a file-level hit). Remove a row once it prints
# PENDING-DONE.
PENDING = []


def shipped_lines(path, brand):
    """The file as tools/build ships it, split in lines; comments become blank lines so line
    numbers match the source."""
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    text = COMMENT.sub(lambda m: "\n" * m.group(0).count("\n"), text).replace("{{plugin}}", brand)
    return text.split("\n")


def text_docs(target):
    """The text a user's model reads: skills/** and assets/* (.md, .txt) and README.md."""
    if os.path.isfile(target):
        return [target] if os.path.basename(target) == "README.md" else []
    out = []
    for sub in ("skills", "assets"):
        for d, dirs, files in os.walk(os.path.join(target, sub)):
            dirs.sort()
            out += [os.path.join(d, f) for f in sorted(files) if f.endswith((".md", ".txt"))]
    if os.path.isfile(os.path.join(target, "README.md")):
        out.append(os.path.join(target, "README.md"))
    return out


def not_negated(line, m):
    return not NEGATED.search(line[max(0, m.start() - 40):m.start()])


def wait_text_hits(target, brand):
    """AT-W-01: (path, line no or None, rule, text, line)."""
    out = []
    for path in text_docs(target):
        for no, line in enumerate(shipped_lines(path, brand), 1):
            for rule, rx in (("blocking-read", BLOCKING_READ), ("notification-wait", NOTIFICATION_WAIT),
                             ("bare-sleep", BARE_SLEEP)):
                m = rx.search(line)
                if m:
                    out.append((path, no, "AT-W-01 " + rule, "AT-W-01 {}: {!r}".format(rule, m.group(0)), line))
            m = FOREGROUND_WAIT.search(line)
            if m and not_negated(line, m) and not STORE_WAIT.search(line):
                out.append((path, no, "AT-W-01 foreground-wait",
                            "AT-W-01 foreground-wait: {!r} without `<store> wait` on the line".format(m.group(0)), line))
    resume = os.path.join(target, "skills", "resume", "SKILL.md") if os.path.isdir(target) else None
    if resume and os.path.isfile(resume):
        rules = [ln for ln in shipped_lines(resume, brand) if MAIN_RULE.search(ln)]
        if not rules or not all("run_in_background" in ln for ln in rules):
            out.append((resume, None, "AT-W-01 main-rule",
                        "AT-W-01 main-rule: no \"notification wakes you\" line naming run_in_background", ""))
    return out


def asset_bytes_hits(target, brand):
    """AT-W-02: the two Dev-7 assets within ASSET_BYTES."""
    out = []
    for name, limit in sorted(ASSET_BYTES.items()):
        path = os.path.join(target, "assets", name)
        if not os.path.isfile(path):
            continue
        text = "\n".join(shipped_lines(path, brand))
        text = re.sub(r"(?m)^\[[a-z-]+\] ", "", text)
        text = re.sub(r"@[a-z_]+@", "", text).strip() + "\n"
        n = len(text.encode("utf-8"))
        if n > limit:
            out.append((path, None, "AT-W-02 bytes", "AT-W-02 {} B > {}".format(n, limit), ""))
    return out


def spec_literals(target):
    path = os.path.join(target, "assets", "handoff-spec.md")
    if not os.path.isfile(path):
        return path, None
    with open(path, encoding="utf-8") as f:
        m = SPEC_BLOCK.search(f.read())
    try:
        return path, json.loads(m.group(1)) if m else None
    except ValueError:
        return path, None


def skill_budget_hits(target, brand):
    """AT-SK-01 extended per REVIEW B-7 over skills/handoff/SKILL.md."""
    out = []
    path = os.path.join(target, "skills", "handoff", "SKILL.md")
    if not os.path.isfile(path):
        return out
    lines = shipped_lines(path, brand)
    for no, line in enumerate(lines, 1):
        m = EDIT_PER_LINT.search(line)
        if m and not_negated(line, m):
            out.append((path, no, "AT-SK-01 edit-per-lint", "AT-SK-01 edit-per-lint: {!r}".format(m.group(0)), line))
    at = next((i for i, ln in enumerate(lines) if "**Budget.**" in ln), None)
    if at is None:
        out.append((path, None, "AT-SK-01 budget-line", "AT-SK-01 budget-line: no **Budget.** line", ""))
        return out
    line, no = lines[at], at + 1
    cap = re.search(r"hard cap (\d+)", line)
    seg = line[:line.find("Typical")] if "Typical" in line else line[:cap.start() if cap else len(line)]
    steps = [int(n) for n in re.findall(r"Step \d+ ≤?(\d+)", seg)]
    recipe = re.search(r"\(Step 5, ≤(\d+)\)", line)
    if not cap:
        out.append((path, no, "AT-SK-01 budget-sum", "AT-SK-01 budget-sum: no `hard cap N`", line))
    elif sum(steps) != int(cap.group(1)):
        out.append((path, no, "AT-SK-01 budget-sum", "AT-SK-01 budget-sum: steps {} sum to {}, hard cap {}".format(
            "+".join(map(str, steps)), sum(steps), cap.group(1)), line))
    spec_path, spec = spec_literals(target)
    for key, got, label in (("call_cap", cap, "hard cap"), ("recipe_cap", recipe, "(Step 5, ≤M)")):
        rule = key.replace("_", "-")
        want = spec.get(key) if isinstance(spec, dict) else None
        if want is None:
            out.append((spec_path, None, "AT-SK-01 {}-missing".format(rule),
                        "AT-SK-01 {}-missing: spec-literals has no {}".format(rule, key), ""))
        elif got is None or int(got.group(1)) != want:
            out.append((path, no, "AT-SK-01 " + rule, "AT-SK-01 {}: {} {} != spec {} {}".format(
                rule, label, got.group(1) if got else "missing", key, want), line))
    return out


def write_first_hits(target, brand):
    """AT-SK-03: the RV-31 write-first reminder is gone from every SKILL.md."""
    out = []
    sk = os.path.join(target, "skills")
    for name in sorted(os.listdir(sk)) if os.path.isdir(sk) else []:
        path = os.path.join(sk, name, "SKILL.md")
        if os.path.isfile(path):
            for no, line in enumerate(shipped_lines(path, brand), 1):
                if re.search(r"before your final message", line, re.I):
                    out.append((path, no, "AT-SK-03 before-final", "AT-SK-03 before-final: write-first reminder", line))
    return out


def self_heal_hits(target, brand):
    """AT-J-13: the Dev-1 decision table, the never-from-the-handoff line, the resume SKILL size."""
    out = []
    heal = os.path.join(target, "skills", "resume", "references", "self-heal.md")
    skill = os.path.join(target, "skills", "resume", "SKILL.md")
    if os.path.isfile(heal):
        lines = shipped_lines(heal, brand)
        heads = [i for i, ln in enumerate(lines) if HEAL_HEADER.match(ln)]
        if not heads:
            out.append((heal, None, "AT-J-13 table-missing", "AT-J-13 table-missing: no Dev-1 decision table", ""))
        for i in heads:
            ids = []
            for ln in lines[i + 1:]:
                if not ln.startswith("|"):
                    break
                cell = ln.strip("|").split("|")[0].strip()
                if not re.fullmatch(r"-+", cell):
                    ids.append(cell)
            if ids != HEAL_ROWS:
                out.append((heal, i + 1, "AT-J-13 table-rows",
                            "AT-J-13 table-rows: {} != {}".format(",".join(ids), ",".join(HEAL_ROWS)), lines[i]))
        texts = lines + (shipped_lines(skill, brand) if os.path.isfile(skill) else [])
        if not any(RELAUNCH_LINE.search(ln) for ln in texts):
            out.append((heal, None, "AT-J-13 relaunch-line-missing",
                        "AT-J-13 relaunch-line-missing: no \"never relaunch ... from the handoff's text\"", ""))
    if os.path.isfile(skill):
        n = len("\n".join(shipped_lines(skill, brand)).encode("utf-8"))
        if n > RESUME_SKILL_MAX:
            out.append((skill, None, "AT-J-13 size", "AT-J-13 size {} B > {}".format(n, RESUME_SKILL_MAX), ""))
    return out


TEXT_GATES = [("wait-text", wait_text_hits), ("asset-bytes", asset_bytes_hits), ("skill-budget", skill_budget_hits),
              ("write-first", write_first_hits), ("self-heal", self_heal_hits)]


def pending_row(gate, rule, rel, line):
    for row in PENDING:
        g, r, p, frag = row
        if g == gate and r == rule and p == rel and (frag is None or frag in line):
            return row
    return None


def npm_paths(target):
    """BT-06: npm manifests, lock files and node_modules folders inside a folder target."""
    if not os.path.isdir(target):
        return
    for d, dirs, files in os.walk(target):
        for x in sorted(dirs):
            if x in NPM_DIRS:
                yield os.path.join(d, x)
        dirs[:] = sorted(x for x in dirs if x not in NPM_DIRS and x != ".git")
        for f in sorted(files):
            if f in NPM_FILES:
                yield os.path.join(d, f)


def die(msg):
    print("gates: " + msg, file=sys.stderr)
    sys.exit(2)


def files_of(target):
    if os.path.isfile(target):
        yield target
        return
    for d, dirs, files in os.walk(target):
        dirs[:] = sorted(x for x in dirs if x not in SKIP_DIRS and
                         not (x == "types" and os.path.basename(d) == ".claude-plugin"))
        for f in sorted(files):
            yield os.path.join(d, f)


def text_of(path):
    with open(path, "rb") as f:
        data = f.read()
    if b"\0" in data[:8192]:
        return None
    return data.decode("utf-8", errors="replace")


def load_names(path):
    names = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                names.append(line)
    return names


def main(argv):
    names_file = None
    brand = None
    git_log = True
    use_pending = True
    only = None
    targets = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--names" and i + 1 < len(argv):
            names_file = argv[i + 1]
            i += 1
        elif a == "--brand" and i + 1 < len(argv):
            brand = argv[i + 1]
            i += 1
        elif a == "--only" and i + 1 < len(argv):
            only = argv[i + 1]
            i += 1
        elif a == "--no-git-log":
            git_log = False
        elif a == "--no-pending":
            use_pending = False
        elif a.startswith("--"):
            die("unknown flag " + a + "\n" + __doc__)
        else:
            targets.append(a)
        i += 1
    if not targets:
        die("no target\n" + __doc__)
    hits = []

    def hit(gate, where, text):
        hits.append((gate, where, text))

    if not names_file or not os.path.isfile(names_file):
        hit("names", names_file or "--names", "competitor-name list missing (E-7)")
        names = []
    else:
        names = load_names(names_file)
        if not names:
            hit("names", names_file, "competitor-name list is empty")
    if brand is None:
        with open(os.path.join(REPO, "brand.json"), encoding="utf-8") as f:
            brand = json.load(f)["name"]

    name_res = [(n, re.compile(B + re.escape(n) + E, re.I)) for n in names]
    user_res = [("/Users/", re.compile(r"/Users/")), ("/home/", re.compile(r"/home/"))]
    login = getpass.getuser()
    if login:
        user_res.append(("login", re.compile(B + re.escape(login) + E)))
    email = subprocess.run(["git", "-C", REPO, "config", "user.email"], capture_output=True, text=True).stdout.strip()
    if email:
        user_res.append(("email", re.compile(re.escape(email), re.I)))
    common = subprocess.run(["git", "-C", REPO, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    main_repo = os.path.dirname(common) if common else REPO
    parent = os.path.basename(os.path.dirname(main_repo))
    if parent:
        user_res.append(("projects folder", re.compile(B + re.escape(parent) + E)))
    # Other candidate names are substrings: a trailing letter, digit or `-` must not hide them.
    other_res = [(n, re.compile(re.escape(n), re.I)) for n in OTHER_NAMES]

    count = 0
    for target in targets:
        if not os.path.exists(target):
            hit("target", target, "missing")
            continue
        for path in npm_paths(target):
            shown = os.path.relpath(path) + ("/" if os.path.isdir(path) else "")
            hit("npm", shown, "BT-06: no npm manifest or node_modules inside the plugin")
        if os.path.isdir(target):
            for where, text in skill_desc_hits(target):
                hit("skill-desc", where, text)
        for path in files_of(target):
            text = text_of(path)
            if text is None:
                continue
            count += 1
            rel = os.path.relpath(path)
            for no, line in enumerate(text.splitlines(), 1):
                where = "{}:{}".format(rel, no)
                for n, rx in name_res:
                    if rx.search(line):
                        hit("names", where, n)
                for label, rx in user_res:
                    if rx.search(line):
                        hit("user-path", where, label)
                if MARKERS.search(line):
                    hit("markers", where, MARKERS.search(line).group(0))
                m = ATTRIBUTION.search(line)
                if m:
                    hit("attribution", where, m.group(0))
                for rx in NAME_SHAPES:
                    for m in rx.finditer(line):
                        if m.group(1) != brand:
                            hit("stale-name", where, m.group(0))
                for n, rx in other_res:
                    if rx.search(line):
                        hit("stale-name", where, n)
            base = os.path.basename(path)
            if base in ("plugin.json", "marketplace.json") and os.path.basename(os.path.dirname(path)) == ".claude-plugin":
                try:
                    doc = json.loads(text)
                except ValueError:
                    hit("stale-name", rel, "not valid JSON")
                    continue
                found = [doc.get("name")] if base == "plugin.json" else [p.get("name") for p in doc.get("plugins", [])]
                for n in found:
                    if n != brand:
                        hit("stale-name", rel, '"name": {}'.format(json.dumps(n)))

    pending, used, applicable = [], set(), set()
    for target in targets:
        if not os.path.exists(target):
            continue
        base = os.path.abspath(target if os.path.isdir(target) else os.path.dirname(os.path.abspath(target)))
        for gate, fn in TEXT_GATES:
            if only and only != gate:
                continue
            if os.path.isdir(target):
                applicable |= {row for row in PENDING if row[0] == gate and os.path.exists(os.path.join(target, row[2]))}
            if gate != "wait-text" and not os.path.isdir(target):
                continue
            for path, no, rule, text, line in fn(target, brand):
                where = os.path.relpath(path) + (":{}".format(no) if no else "")
                row = pending_row(gate, rule, os.path.relpath(os.path.abspath(path), base), line) if use_pending else None
                if row:
                    used.add(row)
                    pending.append((gate, where, text))
                else:
                    hit(gate, where, text)

    if git_log:
        r = subprocess.run(["git", "-C", REPO, "log", "--format=%H%n%B"], capture_output=True, text=True)
        sha = None
        for line in r.stdout.splitlines():
            if re.fullmatch(r"[0-9a-f]{40}", line):
                sha = line[:10]
                continue
            m = ATTRIBUTION.search(line)
            if m:
                hit("attribution", "commit " + str(sha), m.group(0))

    if only:
        hits = [h for h in hits if h[0] in (only, "target")]
    for gate, where, text in hits:
        print("GATE {} {}: {}".format(gate, where, text))
    for gate, where, text in pending:
        print("PENDING {} {}: {}".format(gate, where, text))
    if use_pending:
        for row in PENDING:
            if row in applicable and row not in used:
                print("PENDING-DONE {} {} {}: no hit left; remove the row from PENDING".format(row[0], row[2], row[1]))
    print("GATES: {} ({} files, {} names, brand {}, {} hits, {} pending)".format(
        "FAIL" if hits else "PASS", count, len(names), brand, len(hits), len(pending)))
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
