            if BASH_PATH.search(line):
                out.append((path, no, "AT-PK-01 bash-path",
                            "AT-PK-01 bash-path: nothing is on the Bash PATH (the launcher is called by its full path)", line))
            for m in bare_call.finditer(line):
                out.append((path, no, "AT-PK-01 bare-call",
                            "AT-PK-01 bare-call: {!r} (the launcher is not on the Bash PATH; call {}/{}-store "
                            "by its full path or through `<store>`)".format(m.group(0), LAUNCHER_DIR, brand), line))
    return out


