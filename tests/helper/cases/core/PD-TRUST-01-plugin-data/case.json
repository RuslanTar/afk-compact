{
 "id": "PD-TRUST-01",
 "note": "0.1.3 small fixes: SessionStart keeps last-version in CLAUDE_PLUGIN_DATA only when it names this plugin's own data folder (<config>/plugins/data/<brand>-<marketplace>); another plugin's (the codex plugin exports its own into session shells), one named like ours outside plugins/data (a relative one or one with a .. part too: the HOME guard keeps those out of a case), or none: this plugin's log folder, and the other plugin's folder is never written",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "codex's folder: not read, not written; the log folder gets last-version 2.1.305, no hint (nothing recorded there yet)",
   "env": {
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.305",
    "CLAUDE_PLUGIN_DATA": "$TMP/cfg/plugins/data/codex-openai-codex"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "stdout": "",
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "version_hint",
      "count": 0
     }
    ],
    "files": [
     {
      "path": "$TMP/cfg/plugins/data/codex-openai-codex/last-version",
      "has": [
       "\\A2\\.1\\.304\\n\\z"
      ]
     },
     {
      "path": "$WATCH/last-version",
      "has": [
       "\\A2\\.1\\.305\\n\\z"
      ]
     }
    ]
   },
   "setup": [
    {
     "write": "$TMP/cfg/plugins/data/codex-openai-codex/last-version",
     "text": "2.1.304\n"
    }
   ]
  },
  {
   "name": "codex's folder again, Claude Code 2.1.306: the hint reads the log folder's 2.1.305",
   "env": {
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.306",
    "CLAUDE_PLUGIN_DATA": "$TMP/cfg/plugins/data/codex-openai-codex"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "stdout": "",
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "version_hint",
      "count": 1,
      "fields": {
       "from": "2.1.305",
       "to": "2.1.306"
      }
     }
    ],
    "files": [
     {
      "path": "$TMP/cfg/plugins/data/codex-openai-codex/last-version",
      "has": [
       "\\A2\\.1\\.304\\n\\z"
      ]
     },
     {
      "path": "$WATCH/last-version",
      "has": [
       "\\A2\\.1\\.306\\n\\z"
      ]
     }
    ]
   }
  },
  {
   "name": "a folder named like ours outside plugins/data: not ours",
   "env": {
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.308",
    "CLAUDE_PLUGIN_DATA": "$TMP/elsewhere/$BRAND-inline"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "stdout": "",
    "rows": [],
    "files": [
     {
      "path": "$TMP/elsewhere/$BRAND-inline/last-version",
      "exists": false
     },
     {
      "path": "$WATCH/last-version",
      "has": [
       "\\A2\\.1\\.308\\n\\z"
      ]
     }
    ]
   }
  },
  {
   "name": "this plugin's own data folder (a trailing slash too): written there; the log folder's copy stays",
   "env": {
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.309",
    "CLAUDE_PLUGIN_DATA": "$TMP/cfg/plugins/data/$BRAND-afk-market/"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "stdout": "",
    "rows": [],
    "files": [
     {
      "path": "$TMP/cfg/plugins/data/$BRAND-afk-market/last-version",
      "has": [
       "\\A2\\.1\\.309\\n\\z"
      ]
     },
     {
      "path": "$WATCH/last-version",
      "has": [
       "\\A2\\.1\\.308\\n\\z"
      ]
     }
    ]
   }
  }
 ]
}
