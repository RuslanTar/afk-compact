    def noc8_refusals(d):
        """Every --no-c8 call that is not a render to another file exits 2 and leaves the baseline
        as it was."""
        # fresh each run: the planted copy is copied from the clean one after its run
        link, gone = os.path.join("tmp", "baseline-link.json"), os.path.join("tmp", "canary-noc8-check.json")
        os.makedirs(os.path.join(d, "tmp"), exist_ok=True)
        for x in (link, gone):
            if os.path.lexists(os.path.join(d, x)):
                os.unlink(os.path.join(d, x))
        os.symlink(os.path.join("..", base_rel), os.path.join(d, link))
        calls = [[], ["--check"], ["--check", "--out", gone], ["--out", base_rel],
                 ["--out", os.path.join("plugin", "assets", "..", "assets", "canary-baseline.json")], ["--out", link]]
        with open(os.path.join(d, base_rel), "rb") as f:
            keep = f.read()
        out, bad = [], 0
        for c in calls:
            r = subprocess.run([os.path.join(d, "tools", "canary-baseline"), "--no-c8"] + c, cwd=d,
                               capture_output=True, text=True, env=no_claude_home(d))
            with open(os.path.join(d, base_rel), "rb") as f:
                same = f.read() == keep
            shown = " ".join(["--no-c8"] + c)
            if r.returncode == 2 and same:
                out.append("NOC8 refused: " + shown)
                continue
            bad += 1
            out.append("NOC8 not refused: {} (exit {}{})".format(shown, r.returncode, "" if same else ", baseline changed"))
            with open(os.path.join(d, base_rel), "wb") as f:
                f.write(keep)
        return (1 if bad else 0), "\n".join(out) + "\n"

