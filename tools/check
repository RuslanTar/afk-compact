def write_text(path, text, mode="w"):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, mode, encoding="utf-8", newline="") as f:
        f.write(text)


def to_crlf(path):
    with open(path, "rb") as f:
        data = f.read()
    with open(path, "wb") as f:
        f.write(data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n"))


GIT_ID = ["-c", "user.name=selftest", "-c", "user.email=selftest@example.invalid", "-c", "commit.gpgsign=false",
          "-c", "core.hooksPath=/dev/null", "-c", "init.defaultBranch=main", "-c", "core.autocrlf=false"]


def git_in(d, *args):
    r = subprocess.run(["git"] + GIT_ID + ["-C", d] + list(args), capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail("X-tools: git {} in {}: {}".format(" ".join(args), d, r.stderr.strip()[-300:]))
    return r.stdout


def same_dir(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def git_repo(d):
    """The copy as a one-commit repo on main (the probes that need git history)."""
    git_in(d, "init", "-q")
    git_in(d, "add", "-A")
    git_in(d, "commit", "-q", "-m", "selftest base")


def pinned_claude(root=REPO):
    """The Claude Code binary the canary baseline's C8 counts were taken from, if installed."""
    try:
        with open(os.path.join(root, "plugin", "assets", "canary-baseline.json"), encoding="utf-8") as f:
            v = json.load(f)["c8"]["binary_version"]
    except (OSError, ValueError, KeyError, TypeError):
        return None, None
    b = os.path.join(os.path.expanduser("~"), ".local", "share", "claude", "versions", str(v))
    return v, (b if os.path.isfile(b) else None)


def probes(name):
    """(id, finding, argv relative to the copy or a callable(dir) -> (exit, stdout), plant(copy),
    [regex every stdout must hold], prep(copy) or None: run on the clean and the planted copy)."""
    gates_only = lambda g: ["tools/gates", "plugin", "--names", os.devnull, "--brand", name,
                            "--no-git-log", "--only", g]

    def crlf(d):
        to_crlf(os.path.join(d, *launcher_rel(name).split("/")))
        to_crlf(os.path.join(d, "plugin", "hooks", "hooks.json"))

    def stray(d):
        for rel in ("plugin/assets/old-asset.txt", "plugin/hooks/lib/old.gen.ts",
                    "plugin/tests/unit/_gen/stray.gen.ts", "plugin/.claude-plugin/extra.json",
                    "plugin/notes.txt", "plugin/skills/handoff/.hidden"):
            write_text(os.path.join(d, rel), "stray\n")

    def other_names(d):
        write_text(os.path.join(d, "plugin", "README.md"),
                   "\nP5 cache at ~/.cache/compact-handoff-research and the compact-handoffs folder\n"
                   "P6 the compactseams and wheelover2 variants, and HOLD-THREADS\n"
                   "P7 options left under the old Compactinue2 key\n", "a")
        # xxxxxxxx-32: the former name is allowed on the FORMER_NAMES line only, not on another
        # line of the same file, and not for another candidate name on that line.
        p = os.path.join(d, "plugin", "helper", "lib", "settings.pm")
        with open(p, encoding="utf-8", newline="") as f:
            t = f.read()
        t2 = t.replace("our @FORMER_NAMES = ('compactinue');", "our @FORMER_NAMES = ('compactinue', 'wheelover');", 1)
        if t2 == t:
            raise Fail("X-tools: other-names found no FORMER_NAMES line to plant on")
        write_text(p, t2 + "# options left under compactinue@inline\n")

    def planning_track(d):
        """xxxxxxxx-36: a commit that added a .planning/ note (since untracked again), and a nested
        .planning/ note forced into the index past any ignore rule."""
        write_text(os.path.join(d, ".planning", "old.md"), "old notes\n")
        git_in(d, "add", "-f", ".planning/old.md")
        git_in(d, "commit", "-q", "-m", "add notes")
        git_in(d, "rm", "-q", "--cached", ".planning/old.md")
        git_in(d, "commit", "-q", "-m", "untrack notes")
        write_text(os.path.join(d, "plugin", ".planning", "nested.md"), "nested notes\n")
        git_in(d, "add", "-f", "plugin/.planning/nested.md")

    def launcher_flags(d):
        """SESSION-RESTART §3.3: a visible flag dropped from the restart launcher's table, a
        variadic flag made single-valued and a subcommand dropped."""
        p = os.path.join(d, "src", "claude-launcher.tmpl")
        with open(p, encoding="utf-8") as f:
            t = f.read()
        for old, new in (("  --verbose) _c=keep _a=none ;;\n", ""),
                         ("  --tools) _c=keep _a=var ;;", "  --tools) _c=keep _a=val ;;"),
                         ("|auto-mode|doctor|", "|auto-mode|")):
            if old not in t:
                raise Fail("X-tools launcher-flags: the template has no " + old.strip())
            t = t.replace(old, new)
        write_text(p, t)

    def respawn_keepset(d):
        """SESSION-RESTART B9: a variadic flag dropped from the keep-set and a flag a restart drops
        added to it."""
        p = os.path.join(d, "plugin", "helper", "lib", "restart.pm")
        with open(p, encoding="utf-8") as f:
            t = f.read()
        for old, new in (("--disallowedTools --tools --mcp-config --betas", "--disallowedTools --mcp-config --betas"),
                         ("--strict-mcp-config\n", "--strict-mcp-config --resume\n")):
            if old not in t:
                raise Fail("X-tools respawn-keepset: restart.pm has no " + old.strip())
            t = t.replace(old, new, 1)
        write_text(p, t)

    def npm(d):
        write_text(os.path.join(d, "plugin", "package.json"), '{"dependencies":{"left-pad":"1.3.0"}}\n')
        write_text(os.path.join(d, "plugin", "node_modules", "left-pad", "index.js"), "module.exports = 1\n")
        write_text(os.path.join(d, "plugin", "helper", "package-lock.json"), "{}\n")

    def crlf_file(*rel):
        return lambda d: to_crlf(os.path.join(d, *rel))

    def run_seq(*argvs):
        """A probe command that runs each argv in the copy: exit 1 if any exits 1, else the
        highest exit; the outputs joined."""
        def go(d):
            codes, out = [], ""
            for argv in argvs:
                r = subprocess.run([os.path.join(d, argv[0])] + argv[1:], cwd=d, capture_output=True, text=True)
                codes.append(r.returncode)
                out += r.stdout + r.stderr
            return (1 if 1 in codes else max(codes)), out
        go.__name__ = " ; ".join(" ".join(a) for a in argvs)
        return go

    def stray_goldens(d):
        write_text(os.path.join(d, "plugin", "tests", "unit", "_gen", "goldens.stray.gen.ts"), "stray\n")

    # goldens-split (0.1.2): the goldens modules under a small test cap, so the big assets fill
    # overflow modules (.2, .3, ...); the same cap's --check passes on them and tools/build accepts
    # them, and a CRLF overflow module is caught.
    CHUNK_TEST = "65536"

    def goldens_chunks_prep(d):
        r = subprocess.run([os.path.join(d, "tools", "assemble"), "--goldens", "--chunk-bytes", CHUNK_TEST],
                           cwd=d, capture_output=True, text=True)
        if r.returncode != 0:
            raise Fail("X-tools goldens-chunks: tools/assemble --goldens --chunk-bytes {} exit {}:\n{}".format(
                CHUNK_TEST, r.returncode, (r.stdout + r.stderr)[-1500:]))

