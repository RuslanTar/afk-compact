      "writer": "classic", "alert_id": "a11-00000005", "rule": "A-11", "severity": "warn", "key": {}, "evidence": {}},
     {"v": 1, "ts": "2026-10-01T10:05:00+03:00", "ev": "alert", "sid": "5e55a0ff-0000-4000-8000-0000000000a1", "actor": "main",
      "writer": "classic", "alert_id": "a01-00000006", "rule": "A-01", "severity": "critical", "key": {}, "evidence": {}}]}
   ],
   "argv": ["status", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
