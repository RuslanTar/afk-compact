BUILTIN_DENY = [r"^\.env(?:\..+)?$", r"^id_(?:rsa|dsa|ecdsa|ed25519)$", r"\.pem$", r"\.key$",
                r"^\.netrc$", r"^\.npmrc$", r"^\.claude\.json$", r"^\.(?:bash|zsh|sh)_history$",
                r"\.har$", r"\.sqlite3?$"]
DENY_EXCEPT = r"^\.env\.(?:example|sample|template|dist)$"
ENTROPY_RUN = re.compile(r"[A-Za-z0-9+/]{32,}={0,2}")


def entropy(s):
    counts = {}
    for c in s:
        counts[c] = counts.get(c, 0) + 1
    return -sum(n / len(s) * math.log2(n / len(s)) for n in counts.values())


def load_rules():
    spec = os.path.join(REPO, "src", "assets", "handoff-spec.md")
    if os.path.exists(spec):
        m = re.search(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", read(spec), re.S | re.M)
        if m:
            try:
                lit = json.loads(m.group(1))
                rules = [(r["id"], r["class"], r["re"]) for r in lit.get("secret_rules", [])]
                if rules:
                    compiled = [(i, c, re.compile(x)) for i, c, x in rules]
                    return compiled, "src/assets/handoff-spec.md"
            except (ValueError, KeyError, re.error) as e:
                print("fixtures-gen: spec secret_rules unusable ({}); built-in set used".format(e))
    return [(i, c, None if x == "@entropy@" else re.compile(x)) for i, c, x in BUILTIN_RULES], "built-in"


def scan(text, rules):
    hits = []
    for rid, cls, rx in rules:
        if rx is None:
            for m in ENTROPY_RUN.finditer(text):
                if entropy(m.group(0)) >= 4.0:
                    hits.append((rid, cls))
                    break
        elif rx.search(text):
            hits.append((rid, cls))
    return hits


def deny_name(name):
    if re.search(DENY_EXCEPT, name):
        return False
    return any(re.search(p, name) for p in BUILTIN_DENY)


def load_corpus():
    with open(os.path.join(FIX, "secrets", "corpus.json"), encoding="utf-8") as f:
        return json.load(f)


# ---------------------------------------------------------------- generated modules

HEADER = "// GEN by tools/fixtures-gen from tests/fixtures. Do not edit; edit the fixtures and run tools/fixtures-gen.\n"


def js(v):
    # ASCII-only output keeps markers out of the plain text of plugin/ (gates scan raw text).
    return json.dumps(v, ensure_ascii=True, indent=1, sort_keys=False)


def render(b, rows=None):
    out = {}
    out["brand.gen.ts"] = HEADER + "export const BRAND = " + js(
        {"name": b["name"], "marketplace": b["marketplace"], "version": b["version"],
         "plugin_id": b["name"] + "@" + b["marketplace"]}) + " as const\n"

    rows = read_expected() if rows is None else rows
    dispatch_refs = {r["file"]: r["dispatch"] for r in rows}
    corpus = []
    for r in rows:
        text = read(os.path.join(SUMMARIES, r["file"]))
        if SECRET_MARK in text:
            continue
        d = load_dispatch(dispatch_refs.get(r["file"], ""))
        corpus.append({"file": r["file"], "text": fill(text, b), "verdict": r["verdict"],
                       "marker_line": None if r["marker_line"] == "-" else int(r["marker_line"]),
                       "sentinel_from_end": None if r["sentinel_from_end"] == "-" else int(r["sentinel_from_end"]),
                       "nonce": None if r["nonce"] == "-" else r["nonce"],
                       "scope": None if r["scope"] == "-" else r["scope"],
                       "normalized_sha256": r["normalized_sha256"],
                       "dispatch": json.loads(fill(json.dumps(d), b)) if isinstance(d, dict) else d})
    out["corpus.gen.ts"] = (HEADER +
        "export type CorpusEntry = {\n  file: string; text: string; verdict: string;\n"
        "  marker_line: number | null; sentinel_from_end: number | null; nonce: string | null;\n"
        "  scope: string | null; normalized_sha256: string;\n"
        "  dispatch: null | 'none' | Readonly<Record<string, unknown>>\n}\n"
        "export const CORPUS: readonly CorpusEntry[] = " + js(corpus) + "\n")

    payloads, raw = {}, {}
    for ev in sorted(os.listdir(PAYLOADS)):
        d = os.path.join(PAYLOADS, ev)
        if not os.path.isdir(d):
            continue
        for f in sorted(os.listdir(d)):
            text = read(os.path.join(d, f))
            if SECRET_MARK in text:
                continue
            key = ev + "/" + f.rsplit(".", 1)[0]
            if f.endswith(".json"):
                payloads[key] = json.loads(fill(text, b))
            elif f.endswith(".invalid"):
                raw[key] = fill(text, b)
    out["payloads.gen.ts"] = (HEADER +
        "export const PAYLOADS: Readonly<Record<string, Readonly<Record<string, unknown>>>> = " + js(payloads) + "\n" +
        "export const PAYLOADS_INVALID: Readonly<Record<string, string>> = " + js(raw) + "\n")
    return out


# ---------------------------------------------------------------- checks

def walk(base):
    for d, dirs, files in os.walk(base):
        dirs[:] = sorted(x for x in dirs if x not in SKIP_DIRS)
        for f in sorted(files):
            yield os.path.join(d, f)


# Sequences (README "Sequences"): ordered hook steps with the main transcript's state per step.
def transcript_counts(text):
    """(compact_boundary rows of the main thread, isCompactSummary rows) in transcript text."""
    nb = ns = 0
    for line in text.split("\n"):
        try:
            r = json.loads(line) if line.strip() else None
        except ValueError:
            continue
        if not isinstance(r, dict):
            continue
        if r.get("type") == "system" and r.get("subtype") == "compact_boundary" and not r.get("isSidechain"):
            nb += 1
        if r.get("isCompactSummary") is True:
            ns += 1
    return nb, ns


def check_sequences():
    problems, count = [], 0
    if not os.path.isdir(SEQUENCES):
        return problems, count
    for name in sorted(os.listdir(SEQUENCES)):
        d = os.path.join(SEQUENCES, name)
        if not os.path.isdir(d):
            continue
        count += 1
        where = "sequences/" + name
        try:
            inp = json.loads(read(os.path.join(d, "input.json")))
            exp = json.loads(read(os.path.join(d, "expected.json")))
        except (OSError, ValueError) as e:
            problems.append("{}: {}".format(where, e))
            continue
        if inp.get("id") != name or exp.get("id") != name:
            problems.append("{}: input.json and expected.json ids must equal the folder name".format(where))
        for s in inp.get("seed", []):
            if not os.path.exists(os.path.join(FIX, s.get("copy", ""))):
                problems.append("{}: seed file {} missing".format(where, s.get("copy")))
        steps, text, at_pre = inp.get("steps", []), "", None
        for i, st in enumerate(steps, 1):
            argv = st.get("argv", [])
            ev = argv[1] if len(argv) > 1 and argv[0] == "hook" else None
            label = "{} step {} {}".format(where, i, ev)
            if st.get("transcript_append"):
                p = os.path.join(FIX, st["transcript_append"])
                if not os.path.exists(p):
                    problems.append("{}: transcript_append {} missing".format(label, st["transcript_append"]))
                    continue
                text += read(p)
            try:
                payload = json.loads(read(os.path.join(FIX, st.get("stdin", ""))))
            except (OSError, ValueError) as e:
                problems.append("{}: stdin {}: {}".format(label, st.get("stdin"), e))
                continue
            if payload.get("hook_event_name") != ev or payload.get("session_id") != inp.get("sid"):
                problems.append("{}: stdin {} is a {} payload for {}".format(
                    label, st.get("stdin"), payload.get("hook_event_name"), payload.get("session_id")))
            nb, ns = transcript_counts(text)
            want = st.get("transcript_state")
            if want is not None and (want.get("boundaries"), want.get("summaries")) != (nb, ns):
                problems.append("{}: the replayed transcript holds {} boundary and {} summary rows, "
                                "transcript_state says {} and {}".format(label, nb, ns, want.get("boundaries"),
                                                                          want.get("summaries")))
            if ev == "PreCompact":
                at_pre = nb
            in_hook = ev == "PostCompact" or (ev == "SessionStart" and payload.get("source") == "compact")
            if inp.get("order") == "S-21" and in_hook and at_pre is not None and nb != at_pre:
                problems.append("{}: S-21 order: the boundary row lands after PostCompact, but this step sees "
                                "{} new since PreCompact".format(label, nb - at_pre))
        for a in exp.get("step_asserts", []):
            if not 1 <= a.get("after_step", 0) <= len(steps):
                problems.append("{}: step_asserts after_step {} is not a step".format(where, a.get("after_step")))
    return problems, count


# RV-24 (small-rulings §3a): a time in fixture text is a stamp, `YYYY-MM-DD HH:MM ±hhmm`, or an
# ISO timestamp with seconds. The short forms stay only in the files below, because the case
# they feed checks that the legacy reading still works (WATCHER-SPEC T-10, M-10 `time_legacy_re`).
WHOLE_TIME_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} [+-][0-9]{4}"
                           r"|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\.[0-9]+)?)?(?:Z|[+-][0-9]{2}:?[0-9]{2})?")
SHORT_TIME_RE = re.compile(r"(?<![0-9:.+\-])[0-2][0-9]:[0-5][0-9](?![0-9:.])"
                           r"|[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}")
LEGACY_TIME_OK = {
    "tests/fixtures/watcher/T-10/payloads/01-PostCompact.json",   # `checked 14:05`, summary (a)
    "tests/fixtures/transcripts/T-10/main.jsonl",                 # the same summary as a transcript row
    "tests/fixtures/watcher/T-10/expected.json",                  # quotes the legacy form
}


def check_stamps():
    problems, seen_legacy, nfiles = [], set(), 0
    for p in walk(FIX):
        rel = os.path.relpath(p, REPO)
        if rel.startswith(os.path.join("tests", "fixtures", "assembly", "expected") + os.sep):
            continue   # goldens: tools/assemble renders them from runtime.json, which is scanned
        try:
            text = read(p)
        except UnicodeDecodeError:
            continue
        nfiles += 1
        hits = [m.group(0) for m in SHORT_TIME_RE.finditer(WHOLE_TIME_RE.sub("@", text))]
        if not hits:
            continue
        if rel in LEGACY_TIME_OK:
            seen_legacy.add(rel)
        else:
            problems.append("stamps {}: short time {!r} (RV-24: write a stamp `YYYY-MM-DD HH:MM ±hhmm`)".format(rel, hits[0]))
    for rel in sorted(LEGACY_TIME_OK - seen_legacy):
        problems.append("stamps {}: listed in LEGACY_TIME_OK but holds no short time any more".format(rel))
    return problems, nfiles, len(seen_legacy)


# Setups (README "Setups"): tests/fixtures/setups/<id>.json holds `setup`, a list of the case
# runner's setup steps (tests/helper/run.pl `setup`) that builds one scenario: temp repos with
# worktrees and a submodule (D-12), process records, sidecar slots, job rows and transcript
# stubs (Dev-1). The reference interpreter below runs them in a temp dir with the runner's
# placeholders, so the recipes are proven to build, and then checks what they built.
SETUPS = os.path.join(FIX, "setups")
SETUP_ACTIONS = ("write", "repo", "git", "mkdir", "symlink", "copy", "touch")
CLOCK_NOW = "2026-10-21T14:05:12+03:00"   # ids.json now: the case clock of every scenario
GIT_DATE = "2026-10-21T09:30:00+03:00"
DEFAULT_SID = "5e55a001-0c0f-4f1e-9a00-00000000a001"
JOB_STATUSES = {"RUNNING-ELSEWHERE", "RUNNING", "ENDED-UNEXPLAINED", "LEFTOVER", "DONE-UNREPORTED", "FAILED",
                "STOPPED", "LOST", "NOT-LOST"}
RECORD_RE = re.compile(r"^(\d+)-(\d+)\.(live|ended)-([0-9a-f]{8})\.json$")
_LITERALS = {}


def literals():
    """The spec-literals block of src/assets/handoff-spec.md ({} when the file is absent)."""
    if "v" not in _LITERALS:
        spec = os.path.join(REPO, "src", "assets", "handoff-spec.md")
        lit = {}
        if os.path.exists(spec):
            m = re.search(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", read(spec), re.S | re.M)
            if m:
                try:
                    lit = json.loads(m.group(1))
                except ValueError:
                    lit = {}
        _LITERALS["v"] = lit
    return _LITERALS["v"]


def parse_iso(s):
    """ISO 8601 with an offset (or Z) -> epoch seconds (float), or None."""
    m = re.match(r"^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d)(?::(\d\d)(\.\d+)?)?(Z|[+-]\d\d:?\d\d)$", s or "")
    if not m:
        return None
    y, mo, d, h, mi, se, frac, tz = m.groups()
    t = datetime.datetime(int(y), int(mo), int(d), int(h), int(mi), int(se or 0), tzinfo=datetime.timezone.utc).timestamp()
    t += float(frac) if frac else 0
    if tz != "Z":
        sign = 1 if tz[0] == "+" else -1
        t -= sign * (int(tz[1:3]) * 3600 + int(tz[-2:]) * 60)
    return t


def process_lstart(pid):
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           universal_newlines=True, timeout=10)
        return " ".join(r.stdout.split()) or "Thu Jan  1 00:00:00 1970"
    except (OSError, subprocess.SubprocessError):
        return "Thu Jan  1 00:00:00 1970"


class Scenario:
    """A temp dir in which one setup recipe is materialised, with the runner's placeholders."""

    def __init__(self, b, sid=DEFAULT_SID):
        self.b = b
        self.tmp = os.path.realpath(tempfile.mkdtemp(prefix="fixtures-gen-setup-"))
        home = self.tmp + "/home"
        os.makedirs(home)
        root = home + "/.claude/handoffs"
        self.v = {"TMP": self.tmp, "HOME": home, "ROOT": root, "WATCH": root + "/.watch", "SID": sid, "SID8": sid[:8],
                  "BRAND": b["name"], "FIX": FIX, "FIXTURES": FIX, "LSTART1": process_lstart(1)}
        self.touched = {}

    def sub(self, x):
        if isinstance(x, list):
            return [self.sub(i) for i in x]
        if isinstance(x, dict):
            return {self.sub(k): self.sub(v) for k, v in x.items()}
        if not isinstance(x, str):
            return x
        x = fill(x, self.b)
        return re.sub(r"\$\{?(TMP|HOME|ROOT|WATCH|SID8|SID|BRAND|FIXTURES|FIX|LSTART1)\b\}?", lambda m: self.v[m.group(1)], x)

    def env(self):
        e = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": self.v["HOME"], "GIT_CONFIG_NOSYSTEM": "1",
             "GIT_CONFIG_GLOBAL": os.devnull, "GIT_AUTHOR_NAME": "Test", "GIT_AUTHOR_EMAIL": "test@example.invalid",
             "GIT_COMMITTER_NAME": "Test", "GIT_COMMITTER_EMAIL": "test@example.invalid",
             "GIT_AUTHOR_DATE": GIT_DATE, "GIT_COMMITTER_DATE": GIT_DATE}
        return e

    def git(self, cwd, *args):
        r = subprocess.run(["git", "-C", cwd] + list(args), env=self.env(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           universal_newlines=True, timeout=60)
        if r.returncode != 0:
            raise RuntimeError("git {} in {}: exit {}: {}".format(" ".join(args), cwd, r.returncode, r.stdout.strip()[:200]))
        return r.stdout

    def write(self, path, text, mode=None):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        if mode:
            os.chmod(path, int(mode, 8))

    def run(self, step):
        s = self.sub(step)
        if "write" in s:
            if "json" in s:
                text = json.dumps(s["json"], ensure_ascii=False) + "\n"
            elif "jsonl" in s:
                text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in s["jsonl"])
            else:
                text = s.get("content", s.get("text", ""))
            self.write(s["write"], text, s.get("mode"))
        elif isinstance(s.get("repo"), dict):
            rc, at = s["repo"], s["at"]
            base = rc.get("base", "main")
            os.makedirs(at, exist_ok=True)
            self.git(at, "init", "-q", "-b", base)
            for cm in rc.get("commits", [{"files": {"README.md": "seed\n"}, "msg": "seed"}]):
                for rel, text in sorted(cm.get("files", {}).items()):
                    self.write(os.path.join(at, rel), text)
                self.git(at, "add", "-A")
                self.git(at, "commit", "-q", "--allow-empty", "-m", cm.get("msg", "commit"))
            if rc.get("branch") and rc["branch"] != base:
                self.git(at, "checkout", "-q", "-b", rc["branch"])
            if rc.get("ignored"):
                self.write(os.path.join(at, ".gitignore"), "\n".join(rc["ignored"]) + "\n")
                self.git(at, "add", ".gitignore")
                self.git(at, "commit", "-q", "-m", "ignore")
            for key in ("dirty", "untracked"):
                for rel, text in sorted(rc.get(key, {}).items()):
                    self.write(os.path.join(at, rel), text)
        elif "git" in s:
            self.git(s.get("cwd", self.tmp), *s["git"])
        elif "mkdir" in s:
            os.makedirs(s["mkdir"], exist_ok=True)
        elif "symlink" in s:
            os.makedirs(os.path.dirname(s["symlink"]), exist_ok=True)
            os.symlink(s["to"], s["symlink"])
        elif "copy" in s:
            text = read(os.path.join(FIX, s["copy"]))
            self.write(s["to"], self.sub(text) if s.get("subst") else text, s.get("mode", "0600"))
        elif "touch" in s:
            t = parse_iso(s["at"])
            if t is None:
                raise RuntimeError("touch {}: bad time {!r}".format(s["touch"], s["at"]))
            os.utime(s["touch"], (t, t))
            self.touched[s["touch"]] = t
        else:
            raise RuntimeError("unknown setup action: " + ",".join(sorted(s)))

    def done(self):
        shutil.rmtree(self.tmp, ignore_errors=True)


def read_jsonl(path):
    return [json.loads(l) for l in read(path).split("\n") if l.strip()]


def jobs_semantics(doc, sc):
    """What a Dev-1 setup must have built (AT-J-04 and friends)."""
    p = []
    ex = doc.get("expect", {})
    sid = doc["invoke"]["argv"][doc["invoke"]["argv"].index("--origin") + 1]
    task = doc["invoke"]["argv"][doc["invoke"]["argv"].index("--item") + 1]
    watch, odir = sc.v["WATCH"], sc.v["WATCH"] + "/" + sid
    now = parse_iso(CLOCK_NOW)
    if ex.get("status") is not None and ex["status"] not in JOB_STATUSES:
        p.append("expect.status {} is not a verdict name".format(ex["status"]))
    if ex.get("result") not in ("ok", "REFUSED"):
        p.append("expect.result must be ok or REFUSED")
    if ex.get("result") == "ok" and not ex.get("relaunch"):
        p.append("expect.result ok means a relaunch; set expect.relaunch true")
    if ex.get("result") == "REFUSED" and ex.get("relaunch"):
        p.append("expect.result REFUSED cannot relaunch")
    # process records
    byp = sc.v["ROOT"] + "/.sessions/by-pid"
    live, ended = {}, {}
    if os.path.isdir(byp):
        for f in sorted(os.listdir(byp)):
            m = RECORD_RE.match(f)
            if not m:
                p.append("process record name {} does not match <pid>-<epoch>.<live|ended>-<sid8>.json".format(f))
                continue
            d = json.loads(read(os.path.join(byp, f)))
            (live if m.group(3) == "live" else ended)[(m.group(1), m.group(2), m.group(4))] = d
            if d.get("session_id", "")[:8] != m.group(4):
                p.append("process record {}: session_id does not start with {}".format(f, m.group(4)))
            if m.group(3) == "live" and not (isinstance(d.get("pid"), int) and d.get("pid_lstart")):
                p.append("process record {}: a live record needs pid and pid_lstart".format(f))
            if parse_iso(d.get("ts")) is None:
                p.append("process record {}: ts is not an ISO time with an offset".format(f))
    for k in ended:
        if k not in live:
            p.append("ended record {} has no live twin".format("-".join(k)))
    # job rows
    rows = read_jsonl(odir + "/jobs.jsonl") if os.path.exists(odir + "/jobs.jsonl") else []
    mine = [r for r in rows if r.get("task_id") == task and r.get("kind") == "job"]
    if len(mine) != 1:
        p.append("jobs.jsonl: expected one job row for {}, found {}".format(task, len(mine)))
    for r in rows:
        if r.get("kind") == "job":
            cmd = r.get("command")
            if cmd is None:
                if not r.get("command_withheld"):
                    p.append("job {}: a null command needs command_withheld rule ids".format(r.get("task_id")))
            elif hashlib.sha256(cmd.encode("utf-8")).hexdigest() != r.get("command_sha256"):
                p.append("job {}: command_sha256 is not the sha256 of the command".format(r.get("task_id")))
            la = parse_iso(r.get("launched_at"))
            if la is None or la >= now:
                p.append("job {}: launched_at must be an earlier time of the case day".format(r.get("task_id")))
        if r.get("sid") != sid:
            p.append("jobs.jsonl row for {} names another session".format(r.get("task_id")))
    # output files and the touched times
    for r in mine:
        out = r.get("output_path")
        if out and not out.startswith(sc.tmp):
            p.append("job {}: output_path is outside $TMP".format(task))
        if out and os.path.exists(out) and out not in sc.touched:
            p.append("job {}: the output file has no touch step (its mtime would be the run time)".format(task))
        if out and ex.get("signals", {}).get("V5") == "pass" and out in sc.touched and mine[0].get("launched_at"):
            if sc.touched[out] < parse_iso(mine[0]["launched_at"]):
                p.append("job {}: output mtime precedes the launch".format(task))
    # transcript stub: V1 as the helper reads it
    tpath = sc.v["HOME"] + "/.claude/projects/-tmp-example-repo/{}.jsonl".format(sid)
    matches = False
    if os.path.exists(tpath) and mine:
        use = {}
        for row in read_jsonl(tpath):
            msg = row.get("message") if isinstance(row.get("message"), dict) else {}
            for c in (msg.get("content") if isinstance(msg.get("content"), list) else []):
                if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == "Bash":
                    cmd = (c.get("input") or {}).get("command")
                    if cmd is not None and hashlib.sha256(cmd.encode("utf-8")).hexdigest() == mine[0].get("command_sha256"):
                        use[c.get("id")] = True
            tr = row.get("toolUseResult") if isinstance(row.get("toolUseResult"), dict) else {}
            if use and tr.get("backgroundTaskId") == task:
                for c in (msg.get("content") if isinstance(msg.get("content"), list) else []):
                    if isinstance(c, dict) and c.get("tool_use_id") in use:
                        matches = True
        want = ex.get("signals", {}).get("V1") != "fail"
        if matches != want:
            p.append("transcript stub: V1 would {} but the scenario expects V1 {}".format(
                "pass" if matches else "fail", "pass" if want else "fail"))
    elif mine and ex.get("signals", {}).get("V1") != "fail":
        p.append("no transcript stub at the path the helper reads")
    # sidecar slots: seq and the ring counter
    bg = odir + "/bg"
    if os.path.isdir(bg):
        slots = {}
        for f in os.listdir(bg):
            m = re.match(r"^slot-(\d+)\.json$", f)
            if m:
                d = json.loads(read(os.path.join(bg, f)))
                if int(m.group(1)) >= 20:
                    p.append("slot file {}: the ring has 20 slots (0-19)".format(f))
                if not isinstance(d.get("seq"), int):
                    p.append("slot file {}: seq must be an integer".format(f))
                slots[int(m.group(1))] = (d.get("seq", 0), os.path.getmtime(os.path.join(bg, f)))
        seqs = [s for s, _ in slots.values()]
        if len(set(seqs)) != len(seqs):
            p.append("slot seq values are not unique")
        lock = bg + "/slot.lock"
        if slots and os.path.exists(lock):
            if json.loads(read(lock)).get("n") != max(seqs):
                p.append("slot.lock n must equal the highest seq")
        if doc["id"] == "jobs-slot-ring":
            by_seq = [i for _, i in sorted((v[0], i) for i, v in slots.items())]
            by_mtime = [i for _, i in sorted((v[1], i) for i, v in slots.items())]
            if by_seq[-1] == by_mtime[-1]:
                p.append("jobs-slot-ring: the newest slot by seq must not be the newest by mtime")
    elif doc["id"] == "jobs-slot-ring":
        p.append("jobs-slot-ring has no slots")
    return p


def rm_declaration_valid(text):
    """D-12 §1.5.2 declaration validation (the reference reading)."""
    if len(text.encode("utf-8")) > 4096:
        return False
    try:
        d = json.loads(text)
    except ValueError:
        return False
    if not isinstance(d, dict) or d.get("version") != 1 or d.get("mode") != "repo":
        return False
    root = d.get("root")
    if not isinstance(root, str) or root.startswith("/"):
        return False
    parts = root.split("/")
    if not 1 <= len(parts) <= 4:
        return False
    return all(re.match(r"^[A-Za-z0-9._-]+$", c) and c not in (".", "..") and not c.startswith(".git") and c != ".planning"
               for c in parts)


def frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    return dict(l.split(": ", 1) for l in m.group(1).split("\n") if ": " in l) if m else None


def rm_semantics(doc, sc):
    p = []
    top = sc.tmp + "/example-repo"
    id_ = doc["id"]
    if id_ == "rm-bad-declarations":
        for name, want in doc["expect"]["reasons"].items():
            f = "{}/{}/.claude/handoffs.json".format(sc.tmp, name)
            if not os.path.exists(f):
                p.append("{}: no declaration file".format(name))
                continue
            valid = rm_declaration_valid(read(f))
            if valid != want.startswith("repo ("):
                p.append("{}: the reference reading of §1.5.2 says valid={}, the recipe expects {!r}".format(name, valid, want))
        return p
    decl = top + "/.claude/handoffs.json"
    if not os.path.exists(decl):
        return ["no declaration at " + decl]
    if id_ == "rm-declared" or id_ == "rm-worktrees" or id_ == "rm-exports":
        if not rm_declaration_valid(read(decl)):
            p.append("the declaration is not valid by the §1.5.2 reading")
        tracked = sc.git(top, "ls-files").split()
        for f in ("README.md", "src/a.rb", ".claude/handoffs.json"):
            if f not in tracked:
                p.append("{} is not tracked".format(f))
        if sc.git(top, "rev-parse", "--abbrev-ref", "HEAD").strip() != "feature/LAB-42-retry":
            p.append("the main checkout is not on feature/LAB-42-retry")
    if id_ == "rm-worktrees":
        listing = sc.git(top, "worktree", "list", "--porcelain")
        paths = [l[len("worktree "):] for l in listing.split("\n") if l.startswith("worktree ")]
        if sorted(os.path.realpath(x) for x in paths) != sorted(sc.tmp + "/" + n for n in ("example-repo", "example-repo-old", "example-repo-wt")):
            p.append("git worktree list names {}".format(paths))
        if not os.path.exists(sc.tmp + "/example-repo-wt/.claude/handoffs.json"):
            p.append("the declared worktree has no declaration")
        if os.path.exists(sc.tmp + "/example-repo-old/.claude/handoffs.json"):
            p.append("the old worktree must have no declaration")
        if sc.git(sc.tmp + "/example-repo-old", "rev-parse", "--abbrev-ref", "HEAD").strip() != "HEAD":
            p.append("the old worktree must be a detached checkout")
    if id_ == "rm-submodule":
        if not os.path.isfile(top + "/vendor/lib/.git"):
            p.append("vendor/lib/.git must be a file (a submodule checkout)")
        if "vendor/lib" not in sc.git(top, "submodule", "status"):
            p.append("git submodule status does not list vendor/lib")
        if not os.path.exists(top + "/.gitmodules"):
            p.append("no .gitmodules")
        if not json.loads(read(decl))["root"].startswith("vendor/lib/"):
            p.append("the declared root must lie inside the submodule")
    if id_ == "rm-symlink-root":
        link = top + "/docs"
        if not os.path.islink(link):
            p.append("docs must be a symlink")
        elif os.path.commonpath([os.path.realpath(link), os.path.realpath(top)]) == os.path.realpath(top):
            p.append("docs must point outside the repository")
        if not json.loads(read(decl))["root"].startswith("docs/"):
            p.append("the declared root must pass through docs")
    if id_ == "rm-exports":
        keys = set(literals().get("frontmatter_keys_export") or [])
        machine = {"transcript_path", "claude_pid", "worktree"}
        base = top + "/.claude/handoffs"
        for need in ("README.md", ".gitignore"):
            if not os.path.exists(base + "/" + need):
                p.append("export folder lacks the generated " + need)
        exports = {}
        for f in sorted(os.listdir(base + "/LAB-42")):
            text = read(base + "/LAB-42/" + f)
            fm = frontmatter(text)
            if fm is None:
                p.append("export {}: no frontmatter".format(f))
                continue
            exports[f] = fm
            if keys and set(fm) - keys:
                p.append("export {}: keys {} are not in frontmatter_keys_export".format(f, sorted(set(fm) - keys)))
            if machine & set(fm):
                p.append("export {}: machine-only keys {}".format(f, sorted(machine & set(fm))))
            if fm.get("export") != (literals().get("export_value") or "repo"):
                p.append("export {}: export key is {!r}".format(f, fm.get("export")))
            for private in (sc.tmp, sc.v["HOME"]):
                if private in text:
                    p.append("export {}: holds the machine path {}".format(f, private))
        own = [f for f, fm in exports.items() if fm.get("session_id") == DEFAULT_SID]
        mate = [f for f, fm in exports.items() if fm.get("session_id") != DEFAULT_SID]
        if len(own) != 1 or len(mate) != 1:
            p.append("rm-exports needs one own and one teammate export")
        else:
            twins = [f for f in os.listdir(sc.v["ROOT"] + "/example-repo/LAB-42") if f == own[0]]
            if not twins:
                p.append("the own export has no private twin with the same file name")
            else:
                twin = frontmatter(read(sc.v["ROOT"] + "/example-repo/LAB-42/" + own[0]))
                if twin.get("nonce") != exports[own[0]].get("nonce") or twin.get("session_id") != DEFAULT_SID:
                    p.append("the private twin and the own export must share nonce and session")
                if not machine <= set(twin):
                    p.append("the private twin must keep transcript_path, claude_pid and worktree")
            if exports[mate[0]].get("nonce") == exports[own[0]].get("nonce"):
                p.append("the teammate export must have its own nonce")
            if "approved: deploy" not in read(base + "/LAB-42/" + mate[0]) or "approved: deploy" in read(base + "/LAB-42/" + own[0]):
                p.append("only the teammate export holds `approved: deploy`")
    return p


def check_setups(b):
    problems, n = [], 0
    if not os.path.isdir(SETUPS):
        return problems, n
    for fname in sorted(os.listdir(SETUPS)):
        if not fname.endswith(".json"):
            problems.append("setups/{}: only .json recipes belong here".format(fname))
            continue
        n += 1
        where = "setups/" + fname
        try:
            doc = json.loads(read(os.path.join(SETUPS, fname)))
        except ValueError as e:
            problems.append("{}: {}".format(where, e))
            continue
        if doc.get("id") != fname[:-5]:
            problems.append("{}: id {!r} must equal the file name".format(where, doc.get("id")))
        for k in ("ruling", "tests", "note", "setup", "expect"):
            if k not in doc:
                problems.append("{}: missing {}".format(where, k))
        if not doc.get("setup"):
            continue
        sc = Scenario(b)
        try:
            for i, step in enumerate(doc["setup"], 1):
                try:
                    sc.run(step)
                except (RuntimeError, OSError, subprocess.SubprocessError, KeyError, ValueError) as e:
                    problems.append("{} step {}: {}".format(where, i, e))
                    break
            else:
                if doc["id"].startswith("jobs-"):
                    sem = jobs_semantics(doc, sc)
                elif doc["id"].startswith("rm-"):
                    sem = rm_semantics(doc, sc)
                else:
                    sem = []
                problems += ["{}: {}".format(where, x) for x in sem]
        except (RuntimeError, OSError, subprocess.SubprocessError, KeyError, ValueError, IndexError) as e:
            problems.append("{}: {}: {}".format(where, type(e).__name__, e))
        finally:
            sc.done()
    return problems, n


def check_settings():
    """settings/*.json: pluginConfigs options name keys the plugin declares (src/plugin.json userConfig)."""
    problems, n = [], 0
    manifest = os.path.join(REPO, "src", "plugin.json")
    keys = None
    if os.path.exists(manifest):
        try:
            keys = set(json.loads(read(manifest)).get("userConfig", {}))
        except ValueError:
            keys = None
    sdir = os.path.join(FIX, "settings")
    for fname in sorted(os.listdir(sdir)) if os.path.isdir(sdir) else []:
        if not fname.endswith(".json"):
            continue
        n += 1
        try:
            d = json.loads(read(os.path.join(sdir, fname)))
        except ValueError:
            continue   # the parse check reports it
        for plug, cfg in (d.get("pluginConfigs") or {}).items():
            if not plug.startswith("{{plugin}}@"):
                continue   # another plugin's block (plugin-configs-other-plugin.json)
            for k in (cfg.get("options") or {}):
                if keys is not None and k not in keys:
                    problems.append("settings/{}: option {} is not a userConfig key of src/plugin.json".format(fname, k))
    return problems, n


# Canned queue_cmd answers (queue/<case>/<subcommand>.out, read by bin/queue-stub). A JSON `list`
# answer has the queue-stub/v1 shape that ROOT-RULINGS F2-8 adopts as the v1 contract.
QUEUE = os.path.join(FIX, "queue")
QUEUE_V1_KEYS = ["schema", "session", "lane", "open", "pending", "preview", "held_by", "lanes"]
QUEUE_V1_LANE_KEYS = ["id", "holder", "open", "preview"]
LANE_RE = re.compile(r"^(lane|auto):[A-Za-z0-9._/-]+$")   # MOD-SPEC §10 checkpoint lane rule


QUEUE_COMMANDS = {"list", "adopt", "add"}
QUEUE_ADD_STATUS = {"queued", "exists"}
CLIENT_ID_RE = re.compile(r"^ck-[0-9a-f]{12}$")


def check_queue():
    """List answers in the queue-stub/v1 shape (optional `commands`); add answers per D-10
    (small-rulings §1.2): rc 0 prints a queue-add/v1 object, rc 2 has no REFUSED line, rc 5 a
    `REFUSED: draft: <rule>` line, rc 3, 4 and 6 are the other refusals."""
    problems, njson = [], 0
    for case in sorted(os.listdir(QUEUE)) if os.path.isdir(QUEUE) else []:
        p = os.path.join(QUEUE, case, "list.out")
        text = read(p) if os.path.exists(p) else ""
        where = "queue/{}/list.out".format(case)
        if text.lstrip().startswith("{"):
            njson += 1
            try:
                doc = json.loads(text)
            except ValueError as e:
                problems.append("{}: {}".format(where, e))
                continue
            commands = doc.pop("commands", None)
            int_ok = all(isinstance(doc.get(k), int) and not isinstance(doc.get(k), bool) for k in ("open", "pending"))
            if (sorted(doc) != sorted(QUEUE_V1_KEYS) or doc["schema"] != "queue-stub/v1" or not int_ok
                    or not isinstance(doc["preview"], bool) or not isinstance(doc["lanes"], list)
                    or not (doc["lane"] is None or LANE_RE.match(doc["lane"]))
                    or any(not isinstance(x, dict) or sorted(x) != sorted(QUEUE_V1_LANE_KEYS) for x in doc["lanes"])):
                problems.append("{}: not the queue-stub/v1 shape {} with lanes[] {}".format(
                    where, QUEUE_V1_KEYS, QUEUE_V1_LANE_KEYS))
            if commands is not None and (not isinstance(commands, list) or not set(commands) <= QUEUE_COMMANDS):
                problems.append("{}: commands must be a list within {}".format(where, sorted(QUEUE_COMMANDS)))
        rc_file = os.path.join(QUEUE, case, "add.rc")
        if not os.path.exists(rc_file):
            continue
        where = "queue/{}/add".format(case)
        rc = read(rc_file).strip()
        out_file = os.path.join(QUEUE, case, "add.out")
        out = read(out_file) if os.path.exists(out_file) else ""
        err_file = os.path.join(QUEUE, case, "add.err")
        err = read(err_file) if os.path.exists(err_file) else ""
        if not rc.isdigit() or int(rc) > 6:
            problems.append("{}.rc: {!r} is not an exit code of the D-10 table (0-6)".format(where, rc))
            continue
        rc = int(rc)
        if rc == 0:
            try:
                d = json.loads(out)
            except ValueError:
                d = None
            if (not isinstance(d, dict) or d.get("schema") != "queue-add/v1" or d.get("status") not in QUEUE_ADD_STATUS
                    or not CLIENT_ID_RE.match(str(d.get("client_id"))) or not d.get("id") or not d.get("lane")):
                problems.append("{}.out: rc 0 needs a queue-add/v1 object with status, id, lane and client_id ck-<12 hex>".format(where))
        elif rc == 2 and "REFUSED:" in out + err:
            problems.append("{}: exit 2 must carry no REFUSED line (it means an old tool without add)".format(where))
        elif rc == 5 and not re.search(r"^REFUSED: draft: \S+", out + err, re.M):
            problems.append("{}: exit 5 needs a `REFUSED: draft: <rule>` line".format(where))
        sleep_file = os.path.join(QUEUE, case, "add.sleep")
        if os.path.exists(sleep_file) and not read(sleep_file).strip().isdigit():
            problems.append("{}.sleep must be whole seconds".format(where))
    return problems, njson


# The scope-proof table (transcripts/scope-cases.json; MOD-SPEC §2.4 as amended by ROOT-RULINGS F2-1).
SCOPE_CASES = os.path.join(FIX, "transcripts", "scope-cases.json")
SCOPE_KEYS = {"expect_scope": True, "expect_scope_postcompact": False}   # key -> P3 counted


def iso(ts):
    return datetime.datetime.fromisoformat(ts[:-1] + "+00:00" if ts.endswith("Z") else ts)


def ref_scope(case, b, with_p3):
    """main | sub | unknown by the §2.4 rule: main = P1-main, or P3-main with no subagent signal;
    subagent = P1-sub, P2-sub or P3-sub; both or neither = unknown. with_p3=False is the reading
    inside SessionStart(compact) and PostCompact (F2-1: the boundary row lands after them)."""
    d = load_dispatch(case["dispatch"]) if case["dispatch"] else None
    name, _, swap = case["summary"].partition("#nonce=")
    text = fill(read(os.path.join(SUMMARIES, name)), b)
    nonce = detect(text, b["name"])[3]
    if swap and nonce:
        text, nonce = text.replace(nonce, swap), swap
    mscope = detect(text, b["name"])[4]
    p1 = d if d and nonce and d["nonce"] == nonce else None
    main = bool(p1 and p1.get("agent_id") is None and p1.get("channel") in ("mod-hook", "mod-self"))
    sub = bool(p1 and p1.get("agent_id") is not None) or mscope == "sub"
    if with_p3:
        tdir = os.path.join(FIX, case["transcripts"])
        p3_main = transcript_counts(read(os.path.join(tdir, "main.jsonl")))[0] > case["boundaries_count"]
        agent_new = False
        sdir = os.path.join(tdir, "subagents")
        for f in sorted(os.listdir(sdir)) if os.path.isdir(sdir) else []:
            for line in read(os.path.join(sdir, f)).split("\n"):
                r = json.loads(line) if line.strip() else {}
                if r.get("subtype") == "compact_boundary" and (d is None or iso(r["timestamp"]) > iso(d["ts"])):
                    agent_new = True
        main = main or (p3_main and not agent_new and not sub)
        sub = sub or (agent_new and not p3_main)
    return "unknown" if main == sub else ("main" if main else "sub")


def check_scope_cases(b):
    problems = []
    table = json.loads(read(SCOPE_CASES))
    for case in table["cases"]:
        for key, with_p3 in sorted(SCOPE_KEYS.items()):
            want = ref_scope(case, b, with_p3)
            if case.get(key) != want:
                problems.append("scope-cases {}: {} is {}, the §2.4 rule{} gives {}".format(
                    case["id"], key, case.get(key), "" if with_p3 else " without P3 (F2-1)", want))
    return problems, len(table["cases"])


# The rename drill (BUILD-PLAN §4.6, fixture side): a temp copy with another brand must pass
# --check after the plain regenerate step alone. The corpus sha column depends on the brand
# (README "Corpus"), so this fails whenever the regenerate step leaves that column stale.
DRILL_BRAND = {"name": "zq-rename-drill", "marketplace": "zq-rename-market"}
NO_DRILL_ENV = "FIXTURES_GEN_NO_DRILL"   # set for the drill's own inner --check (no recursion)


def rename_drill(b):
    problems = []
    tmp = tempfile.mkdtemp(prefix="fixtures-gen-drill-")
    try:
        for rel in (os.path.join("tools", "fixtures-gen"), os.path.join("src", "assets", "handoff-spec.md")):
            if os.path.exists(os.path.join(REPO, rel)):
                os.makedirs(os.path.dirname(os.path.join(tmp, rel)), exist_ok=True)
                shutil.copy2(os.path.join(REPO, rel), os.path.join(tmp, rel))
        shutil.copytree(FIX, os.path.join(tmp, "tests", "fixtures"), symlinks=True)
        with open(os.path.join(tmp, "brand.json"), "w", encoding="utf-8", newline="\n") as f:
            json.dump(dict(b, **DRILL_BRAND), f, indent=2)
        tool = os.path.join(tmp, "tools", "fixtures-gen")
        env = dict(os.environ, **{NO_DRILL_ENV: "1"})
        for args in ([], ["--check"]):
            r = subprocess.run([sys.executable, tool] + args, env=env, cwd=tmp, timeout=120,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
            if r.returncode != 0:
                lines = [ln for ln in r.stdout.splitlines() if not ln.startswith(("parse:", "expected:", "secrets:"))]
                problems.append("rename drill: `tools/fixtures-gen {}` exit {} after renaming to {}: {}".format(
                    " ".join(args), r.returncode, DRILL_BRAND["name"], " | ".join(lines[:4])))
                break
        before = {r["file"]: r["normalized_sha256"] for r in read_expected()}
        after = {r["file"]: r["normalized_sha256"]
                 for r in read_expected(os.path.join(tmp, "tests", "fixtures", "summaries", "expected.tsv"))}
        changed = sum(1 for k in before if after.get(k) != before[k])
        if changed == 0 and not problems:
            problems.append("rename drill: no normalized_sha256 changed with the brand, so the drill proves nothing")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print("rename: regenerate + check in a copy renamed to {} ({} sha rows changed)".format(DRILL_BRAND["name"], changed))
    return problems


def check(b):
    problems = []
    # parse
    njson = 0
    for p in walk(FIX):
        rel = os.path.relpath(p, REPO)
        if p.endswith(".json"):
            njson += 1
            try:
                json.loads(read(p))
            except ValueError as e:
                problems.append("parse {}: {}".format(rel, e))
        elif p.endswith(".jsonl"):
            for no, line in enumerate(read(p).split("\n"), 1):
                if line.strip() and no not in INTENDED_MALFORMED.get(rel, ()):
                    try:
                        json.loads(line)
                    except ValueError as e:
                        problems.append("parse {}:{}: {}".format(rel, no, e))
    print("parse: {} json files and every jsonl line checked".format(njson))
    # expected
    rows = read_expected()
    want = {r["file"]: r for r in rows}
    files = summary_files()
    if sorted(want) != files:
        problems.append("expected.tsv files {} != summaries {}".format(sorted(set(want) ^ set(files)), ""))
    for r in expected_rows(b, {k: v["dispatch"] for k, v in want.items()}):
        w = want.get(r["file"])
        if w and w != r:
            diff = ["{} {}!={}".format(c, w[c], r[c]) for c in COLUMNS if w[c] != r[c]]
            problems.append("expected {}: {}".format(r["file"], ", ".join(diff)))
    print("expected: {} corpus files against the reference detector".format(len(files)))
    # secrets
    rules, source = load_rules()
    targets = list(walk(FIX)) + [os.path.join(REPO, "tools", "fixtures-gen")]
    rendered = render(b)
    texts = [(os.path.relpath(p, REPO), read(p)) for p in targets]
    texts += [(os.path.join(GEN_REL, n), t) for n, t in rendered.items()]
    for rel, text in texts:
        for rid, cls in scan(fill(text, b), rules):
            problems.append("secret-shaped {} in {}".format(rid, rel))
    corpus = load_corpus()
    joined_by_id = {e["id"]: "".join(e["fragments"]) for e in corpus["entries"]}
    for e in corpus["entries"]:
        joined = "".join(e["fragments"])
        hit = scan(joined, rules)
        classes = {c for _, c in hit}
        if e["class"] == "none":
            if hit:
                problems.append("secrets {}: control hits {}".format(e["id"], hit))
        elif e["class"] not in classes:
            problems.append("secrets {}: joined value does not hit class {} ({})".format(e["id"], e["class"], hit))
        if e.get("rule", "-") != "-" and e["rule"] not in {r for r, _ in hit}:
            problems.append("secrets {}: joined value does not hit its rule id {} ({} rule set hits {})".format(
                e["id"], e["rule"], source, sorted({r for r, _ in hit})))
        for parent in e.get("part_of", []):
            if parent not in joined_by_id:
                problems.append("secrets {}: part_of names no entry {}".format(e["id"], parent))
            elif joined not in joined_by_id[parent]:
                problems.append("secrets {}: joined value is not inside entry {}".format(e["id"], parent))
        for frag in e["fragments"]:
            if scan(frag, rules):
                problems.append("secrets {}: a single fragment is secret-shaped".format(e["id"]))
    for n in corpus["names"]:
        if deny_name(n["name"]) != (n["expect"] == "withheld"):
            problems.append("secrets name {}: deny-list says {}".format(n["name"], deny_name(n["name"])))
    print("secrets: {} files scanned with the {} rule set; {} corpus entries, {} names".format(
        len(texts), source, len(corpus["entries"]), len(corpus["names"])))
    # sequences
    seq_problems, nseq = check_sequences()
    problems += seq_problems
    print("sequences: {} replayed (transcript state per step, S-21 order)".format(nseq))
    # scope
    scope_problems, nscope = check_scope_cases(b)
    problems += scope_problems
    print("scope: {} scope-cases rows against the §2.4 rule, at reconcile and inside PostCompact".format(nscope))
    # queue
    queue_problems, nqueue = check_queue()
    problems += queue_problems
    print("queue: {} JSON list answers in the queue-stub/v1 shape, add answers per the D-10 exit table".format(nqueue))
    # setups, settings
    setup_problems, nsetup = check_setups(b)
    problems += setup_problems
    print("setups: {} recipes built in temp dirs and checked (D-12 repos, Dev-1 scenarios)".format(nsetup))
    settings_problems, nsettings = check_settings()
    problems += settings_problems
    print("settings: {} files name only declared userConfig keys".format(nsettings))
    # stamps
    stamp_problems, nstamp, nlegacy = check_stamps()
    problems += stamp_problems
    print("stamps: {} fixture files, no short time outside the {} legacy-reading files".format(nstamp, nlegacy))
    # drift
    gen_dir = os.path.join(REPO, GEN_REL)
    for name, text in sorted(rendered.items()):
        p = os.path.join(gen_dir, name)
        if not os.path.exists(p):
            problems.append("drift missing " + os.path.join(GEN_REL, name))
        elif read(p) != text:
            problems.append("drift differs " + os.path.join(GEN_REL, name))
    if os.path.isdir(gen_dir):
        for f in sorted(os.listdir(gen_dir)):
            if f.endswith(".gen.ts") and f not in rendered and f.startswith(("brand", "corpus", "payloads")):
                problems.append("drift stale " + os.path.join(GEN_REL, f))
    # rename
    if not os.environ.get(NO_DRILL_ENV):
        problems += rename_drill(b)
    for p in problems:
        print(p)
    print("FIXTURES CHECK: " + ("FAIL ({} problems)".format(len(problems)) if problems else "PASS"))
    return 1 if problems else 0


def write(root, b, rows=None):
    d = os.path.join(root, GEN_REL)
    os.makedirs(d, exist_ok=True)
    for name, text in render(b, rows).items():
        with open(os.path.join(d, name), "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
    print("fixtures-gen: wrote {} files in {}".format(len(GEN_FILES), os.path.relpath(d, REPO) if root == REPO else d))


def main(argv):
    b = brand()
    if argv == []:
        refresh_sha(b)
        write(REPO, b)
        return 0
    if argv == ["--check"]:
        return check(b)
    if len(argv) == 2 and argv[0] == "--out":
        root = os.path.abspath(argv[1])
        if root == REPO:
            die("--out must not be the repo; run without arguments instead")
        write(root, b, sha_refreshed(b)[0])
        return 0
    if argv == ["--clean"]:
        for name in GEN_FILES:
            p = os.path.join(REPO, GEN_REL, name)
            if os.path.exists(p):
                os.unlink(p)
                print("removed " + os.path.join(GEN_REL, name))
        return 0
    if argv == ["--print-expected"]:
        refs = {r["file"]: r["dispatch"] for r in read_expected()} if os.path.exists(EXPECTED) else {}
        sys.stdout.write(tsv(expected_rows(b, refs)))
        return 0
    if argv == ["--refresh-sha"]:
        if not refresh_sha(b):
            print("fixtures-gen: normalized_sha256 already current for brand {}".format(b["name"]))
        return 0
    die("unknown arguments {}\n{}".format(argv, __doc__))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
