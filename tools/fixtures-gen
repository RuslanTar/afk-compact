    return problems, 1


# Production and relaunch settings (settings/prod-cases.json; S-SETTINGS B, C; BUILD-PLAN §3.7):
# a reference of the effects order, the prod_patterns validation and the no-chaining rule.
PROD_TOKEN = [("prod-token", r"(^|[^A-Za-z0-9])([Pp][Rr][Oo][Dd]|[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ii][Oo][Nn]|[Pp][Rr][Dd])([^A-Za-z0-9]|$)")]
PATTERN_MAX, PATTERN_CHARS = 32, 200


def options_of(rel):
    d = json.loads(read(os.path.join(FIX, rel)))
    for plug, cfg in (d.get("pluginConfigs") or {}).items():
        if plug.startswith("{{plugin}}@"):
            return cfg.get("options") or {}
    return {}


def split_patterns(value, need_caret=False):
    """(kept regexes, dropped indexes) by the S-SETTINGS limits: at most 32, each <= 200 chars,
    no Dev-7 forbidden construct, compiles (relaunch_allow also needs a leading ^)."""
    forbidden = (literals().get("wait") or {}).get("marker_regex_forbidden") or ["(?{", "(??{", "(*"]
    kept, dropped = [], []
    for i, p in enumerate(x for x in (value or "").split(";") if x != ""):
        ok = i < PATTERN_MAX and len(p) <= PATTERN_CHARS and not any(f in p for f in forbidden) and (p.startswith("^") or not need_caret)
        if ok:
            try:
                kept.append((p, re.compile(p)))
            except re.error:
                ok = False
        if not ok:
            dropped.append(i)
    return kept, dropped


def chained(cmd):
    """An unquoted ; && || | & or newline, or a $( or backquote outside single quotes."""
    q = None
    i = 0
    while i < len(cmd):
        ch = cmd[i]
        if q == "'":
            q = None if ch == "'" else q
        elif ch == "\\":
            i += 1
        elif ch == "`" or cmd.startswith("$(", i):
            return True
        elif q == '"':
            q = None if ch == '"' else q
        elif ch in "'\"":
            q = ch
        elif ch in ";&|\n":
            return True
        i += 1
    return False


def effects_ref(case, options):
    cmd = case["command"]
    outward = [re.compile(c["re"]) for c in literals().get("outward_classes") or []]
    shipped = literals().get("prod_classes") or [{"id": i, "re": r} for i, r in PROD_TOKEN]
    prod = [re.compile(c["re"]) for c in shipped] + [rx for _, rx in split_patterns(options.get("prod_patterns"))[0]]
    if any(rx.search(cmd) for rx in outward):
        return "outward"
    is_prod = any(rx.search(cmd) for rx in prod)
    if is_prod:
        return "prod-read" if case["is_read_only"] else "prod-write"
    if case["is_read_only"]:
        return "none"
    suffix = (literals().get("wait") or {}).get("end_suffix") or ""
    core = cmd[:-len(suffix)] if suffix and cmd.endswith(suffix) else cmd
    allow = [rx for _, rx in split_patterns(options.get("relaunch_allow"), need_caret=True)[0]]
    if case.get("recipe_expected_outputs") and any(rx.search(core) for rx in allow) and not chained(core):
        return "local"
    return "unknown"


def reads_value(raw):
    v = (raw or "").strip().lower() if isinstance(raw, str) else ""
    return v if v in ("forbid", "allow") else "forbid"


def check_prod():
    path = os.path.join(FIX, "settings", "prod-cases.json")
    if not os.path.exists(path):
        return ["prod: settings/prod-cases.json missing"], 0
    m = json.loads(read(path))
    p = []
    for c in m["commands"]:
        options = options_of(c["settings"]) if c.get("settings") else {}
        got = effects_ref(c, options)
        if got != c["effects"]:
            p.append("prod {}: the §3.7 order gives {}, the case says {}".format(c["id"], got, c["effects"]))
    for name, pl in sorted(m["placements"].items()):
        if pl.get("settings_path") is None or name == "foreign":
            got = "forbid"
        else:
            got = reads_value(options_of(pl.get("file") or m["placement_file"]).get("unattended_prod_reads"))
        if got != pl["reads"]:
            p.append("prod placement {}: reads {}, the case says {}".format(name, got, pl["reads"]))
    for rel, want in sorted(m["patterns"].items()):
        if not rel.startswith("settings/"):
            continue
        kept, dropped = split_patterns(options_of(rel).get("prod_patterns"))
        if dropped != want["dropped"] or ("kept" in want and [k for k, _ in kept] != want["kept"]) or \
                ("kept_count" in want and len(kept) != want["kept_count"]):
            p.append("prod patterns {}: kept {} dropped {}, the case says {}".format(rel, len(kept), dropped, want))
    return p, len(m["commands"])


# W-BETA fixtures (README "Beta"): the canary install (setups/wb-canary-install.json, AT-WB-02) and
# the analyzer zips (beta/, AT-WB-13). The zip checks are a reference of W-BETA F.1 intake and F.2
# verify, read-only (zipfile infolist and member reads; nothing is extracted).
BETA = os.path.join(FIX, "beta")
B5_NAME = re.compile(r"^(README\.txt|manifest\.json|config\.json|probes\.json|sizes\.json|rows/[0-9a-f]{12}\.jsonl)$")
PATTERN_CLASSES = [re.compile(r"(^|[\s\"'=(])/(?:[A-Za-z0-9._-]+/)+[A-Za-z0-9._-]*"), re.compile(r"/Users/|/home/"),
                   re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"), re.compile(r"\b[a-z][a-z0-9+.-]*://[^/\s\"']+")]


def zip_texts(path):
    """[(entry name, text)] of a zip, members decoded as UTF-8 (replacement for bad bytes)."""
    with zipfile.ZipFile(path) as z:
        return [(i.filename, z.read(i).decode("utf-8", "replace")) for i in z.infolist()
                if not stat.S_ISLNK(i.external_attr >> 16) and i.file_size <= 4 * 1024 * 1024]


def intake_ref(path):
    """W-BETA F.1: `accept`, or `refuse` with the first reason."""
    with zipfile.ZipFile(path) as z:
        infos = z.infolist()
    total = 0
    for i in infos:
        n = i.filename
        if n.startswith("/") or ".." in n.split("/"):
            return "refuse", "absolute or .. name"
        if stat.S_ISLNK(i.external_attr >> 16):
            return "refuse", "symlink"
        if not B5_NAME.match(n):
            return "refuse", "name outside B.5"
        if i.file_size > 50 * 1024 * 1024:
            return "refuse", "entry over 50 MB"
        if i.compress_size and i.file_size / i.compress_size > 100:
            return "refuse", "ratio over 100"
        total += i.file_size
    if total > 200 * 1024 * 1024:
        return "refuse", "total over 200 MB"
    return "accept", None


def verify_ref(path):
    """W-BETA F.2: `valid`, or `quarantined` with the reason (manifest hashes, pattern classes)."""
    texts = dict(zip_texts(path))
    man = json.loads(texts.get("manifest.json", "{}"))
    with zipfile.ZipFile(path) as z:
        for f in man.get("files", []):
            if hashlib.sha256(z.read(f["name"])).hexdigest() != f["sha256"]:
                return "quarantined", "sha256 " + f["name"]
    for n, t in sorted(texts.items()):
        if n.startswith("rows/") or n in ("config.json", "probes.json", "sizes.json"):
            for rx in PATTERN_CLASSES:
                if rx.search(t):
                    return "quarantined", "pattern " + n
    return "valid", None


def check_beta():
    p = []
    cases_path = os.path.join(BETA, "cases.json")
    if not os.path.exists(cases_path):
        return ["beta: beta/cases.json missing"], 0
    cases = json.loads(read(cases_path))
    present = sorted(f for f in os.listdir(BETA) if f.endswith(".zip"))
    if present != sorted(cases["zips"]):
        p.append("beta: zips {} and cases.json {} differ".format(present, sorted(cases["zips"])))
    for name, want in sorted(cases["zips"].items()):
        path = os.path.join(BETA, name)
        if not os.path.exists(path):
            continue
        got, why = intake_ref(path)
        if got != want["intake"]:
            p.append("beta {}: intake {} ({}), cases.json says {}".format(name, got, why, want["intake"]))
            continue
        if got == "accept":
            v, why = verify_ref(path)
            if v != want["verify"]:
                p.append("beta {}: verify {} ({}), cases.json says {}".format(name, v, why, want["verify"]))
        if want.get("dedupe_with"):
            with open(path, "rb") as a, open(os.path.join(BETA, want["dedupe_with"]), "rb") as b2:
                if a.read() != b2.read():
                    p.append("beta {}: not byte-identical to {}".format(name, want["dedupe_with"]))
    return p, len(cases["zips"])


def wb_semantics(doc, sc):
    """The canary install: every canary is planted somewhere it can leak from, and grep-safe."""
    p = []
    canaries = doc["expect"]["canaries"]
    vals = sorted(canaries.values())
    for a in vals:
        if len(a) < 4:
            p.append("canary {!r} is shorter than 4 characters (the identity scan skips it)".format(a))
        for b2 in vals:
            if a != b2 and a in b2:
                p.append("canary {!r} is inside canary {!r}; a grep could not tell them apart".format(a, b2))
    blob = []
    for f in walk(sc.tmp):
        if os.path.islink(f):
            continue
        try:
            blob.append(read(f))
        except (UnicodeDecodeError, OSError):
            pass
    blob = "\n".join(blob) + "\n" + json.dumps(doc["invoke"].get("env", {}))
    for cid, v in sorted(canaries.items()):
        if v not in blob:
            p.append("canary {} ({}) is planted nowhere".format(cid, v))
    if SECRET_MARK not in blob:
        p.append("no $SECRET{} token: the shared secret corpus is not planted")
    if sc.v["HOME"] not in blob:
        p.append("no $HOME path is planted")
    p += wb_identity(doc, sc)
    return p


def wb_identity(doc, sc):
    """W-BETA B.3 for the built install: the identity list a reference computes ($HOME, the account,
    the host as `hostname -s` prints it with the recipe's PATH, every repo_roots entry and its
    basename, the basenames of the repo and bucket folders under the handoff root, the git remote
    hosts and owner paths; strings under 4 characters skipped) must equal expect.identity_list.
    The bucket canary is a bucket folder; each transform_only canary neither contains nor sits
    inside an identity string (case-insensitive), and every other canary is one."""
    p, e = [], doc["expect"]
    env = dict(sc.env(), **sc.sub(doc["invoke"].get("env", {})))
    env.pop("STORE_TEST_HOSTNAME", None)
    env["PATH"] = os.pathsep.join(sc.sub(doc["invoke"].get("path_prepend", [])) + [env["PATH"]])
    host = subprocess.run(["hostname", "-s"], env=env, stdout=subprocess.PIPE, universal_newlines=True, timeout=10).stdout.strip()
    ids = {sc.v["HOME"], env.get("USER", ""), host}
    opts = json.loads(read(sc.v["HOME"] + "/.claude/settings.json"))["pluginConfigs"]
    roots = [r for o in opts.values() for r in (o.get("options", {}).get("repo_roots") or "").split(";") if r]
    for r in roots:
        ids |= {r, os.path.basename(r.rstrip("/"))}
        for line in sc.git(r, "remote", "-v").splitlines():
            m = re.match(r"^\S+\s+(?:[^@\s]+@)?([^:/\s]+)[:/](\S+?)(?:\.git)?\s", line + " ")
            if m:
                ids |= {m.group(1), m.group(2)}
    buckets = set()
    root = sc.v["ROOT"]
    for repo in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        if repo.startswith(".") or not os.path.isdir(os.path.join(root, repo)):
            continue
        ids.add(repo)
        for bk in sorted(os.listdir(os.path.join(root, repo))):
            if not bk.startswith(".") and os.path.isdir(os.path.join(root, repo, bk)):
                ids.add(bk)
                buckets.add(bk)
    ids = sorted(x for x in ids if len(x) >= 4)
    if ids != sorted(sc.sub(e.get("identity_list", []))):
        p.append("identity_list {} but the B.3 reference gives {}".format(sorted(sc.sub(e.get("identity_list", []))), ids))
    can = e["canaries"]
    if host != can.get("host"):
        p.append("`hostname -s` with the recipe's PATH prints {!r}, not the host canary".format(host))
    if can.get("bucket") not in buckets:
        p.append("the bucket canary {!r} is no bucket folder (built: {})".format(can.get("bucket"), sorted(buckets)))
    low = [x.lower() for x in ids]
    for cid, v in sorted(can.items()):
        hit = [x for x in low if x in v.lower() or v.lower() in x]
        if cid in e.get("transform_only", []) and hit:
            p.append("canary {} ({}) overlaps the identity strings {}: the identity scan, not the transform, would stop it".format(cid, v, hit))
        if cid not in e.get("transform_only", []) and v.lower() not in low:
            p.append("canary {} ({}) is neither transform_only nor an identity string".format(cid, v))
    return p


def check_settings():
    """settings/*.json: pluginConfigs options name keys the plugin declares (src/plugin.json userConfig)."""
    problems, n = [], 0
    manifest = os.path.join(REPO, "src", "plugin.json")
    keys = None
    if os.path.exists(manifest):
        try:
            keys = set(json.loads(read(manifest)).get("userConfig", {}))
        except ValueError:
            keys = None
    sdir = os.path.join(FIX, "settings")
    for fname in sorted(os.listdir(sdir)) if os.path.isdir(sdir) else []:
        if not fname.endswith(".json"):
            continue
        n += 1
        try:
            d = json.loads(read(os.path.join(sdir, fname)))
        except ValueError:
            continue   # the parse check reports it
        for plug, cfg in (d.get("pluginConfigs") or {}).items():
            if not plug.startswith("{{plugin}}@"):
                continue   # another plugin's block (plugin-configs-other-plugin.json)
            for k in (cfg.get("options") or {}):
                if keys is not None and k not in keys:
                    problems.append("settings/{}: option {} is not a userConfig key of src/plugin.json".format(fname, k))
    return problems, n


RUNTIME_JSON = os.path.join(FIX, "assembly", "runtime.json")


def assemble_runtime_keys():
    """The keys of tools/assemble's worst-case RUNTIME dict, read from its source (the tool runs at
    import, so it is parsed, not imported); None when the file or the dict is absent."""
    import ast
    path = os.path.join(REPO, "tools", "assemble")
    if not os.path.exists(path):
        return None
    for node in ast.walk(ast.parse(read(path))):
        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "RUNTIME" for t in node.targets) \
                and isinstance(node.value, ast.Dict):
            return {k.value for k in node.value.keys if isinstance(k, ast.Constant) and isinstance(k.value, str)}
    return None


def check_runtime():
    """assembly/runtime.json names every token tools/assemble fills (BT-04-H, text-to-fix F-1): the
    helper's golden check fills only runtime.json keys, so a key tools/assemble fills from its own
    worst case (e.g. idle_min) would make the helper render differ from the goldens."""
    problems = []
    keys = assemble_runtime_keys()
    try:
        have = set(json.loads(read(RUNTIME_JSON)))
    except (OSError, ValueError):
        return problems, 0   # the parse check reports a bad file
    if keys is None:
        return problems, len(have)
    for k in sorted(keys - have):
        problems.append("runtime assembly/runtime.json: no {!r}; tools/assemble fills it with its own worst case, "
                        "so the helper's BT-04-H render differs from the goldens".format(k))
    return problems, len(have)


# Canned queue_cmd answers (queue/<case>/<subcommand>.out, read by bin/queue-stub). A JSON `list`
# answer follows the strict contract of Q-ADAPTER QA-2 (MOD-SPEC §10.3 as amended): `schema`
# `queue-stub/v1` required, `lanes` optional in either shape, unknown keys ignored. `list.expect`
# names the mode a reply gives (`on: …`, `degraded (untagged)`, `degraded (schema)`); a reply that
# breaks the contract on purpose must say so there. `adopt.rc` / `adopt.out` / `adopt.expect` are
# the QA-2 adopt refusals and the plugin's mapping of them (AT-QA-04).
QUEUE = os.path.join(FIX, "queue")
QUEUE_V1_REQUIRED = ["schema", "session", "lane", "open", "pending", "preview", "held_by"]
QUEUE_V1_OPTIONAL = ["label", "commands", "lanes"]
QUEUE_V1_LANE_KEYS = ["id", "holder", "open", "preview"]
LANE_RE = re.compile(r"^(lane|auto):[A-Za-z0-9._/-]+$")   # MOD-SPEC §10 checkpoint lane rule
LANE_IN_RE = re.compile(r"(?:lane|auto):[A-Za-z0-9._/-]+")


QUEUE_COMMANDS = {"list", "adopt", "adopt:must-exist", "add"}
QUEUE_ADD_STATUS = {"queued", "exists"}
CLIENT_ID_RE = re.compile(r"^ck-[0-9a-f]{12}$")
ADOPT_REFUSAL = {3: r"^REFUSED: held: holder=([0-9a-f-]{36}) kind=(process|heartbeat) lane=\S+$",
                 4: r"^REFUSED: no-lane: \S.*$", 6: r"^REFUSED: (untrusted|damaged|no-process): \S.*$"}


def queue_list_mode(doc):
    """The mode a parsed list reply gives under the strict contract, and the shape problems."""
    if "schema" not in doc:
        return "degraded (untagged)", []
    if doc["schema"] != "queue-stub/v1":
        return "degraded (schema)", []
    bad = []
    missing = [k for k in QUEUE_V1_REQUIRED if k not in doc]
    if missing:
        bad.append("missing {}".format(missing))
    op = doc.get("open")
    if not (isinstance(op, list) and all(isinstance(x, str) for x in op)) and not (isinstance(op, int) and not isinstance(op, bool)):
        bad.append("open is neither an id list nor a count")
    if not (isinstance(doc.get("pending"), int) and not isinstance(doc.get("pending"), bool)):
        bad.append("pending is not a count")
    if not isinstance(doc.get("preview"), bool):
        bad.append("preview is not a bool")
    if not (doc.get("lane") is None or (isinstance(doc.get("lane"), str) and LANE_RE.match(doc["lane"]))):
        bad.append("lane is not lane:/auto: or null")
    cmds = doc.get("commands")
    if cmds is not None and (not isinstance(cmds, list) or not set(cmds) <= QUEUE_COMMANDS):
        bad.append("commands must be a list within {}".format(sorted(QUEUE_COMMANDS)))
    lanes = doc.get("lanes")
    if lanes is not None and (not isinstance(lanes, list) or any(
            not (isinstance(x, str) or (isinstance(x, dict) and sorted(x) == sorted(QUEUE_V1_LANE_KEYS))) for x in lanes)):
        bad.append("lanes must be strings or {} objects".format(QUEUE_V1_LANE_KEYS))
    n = len(op) if isinstance(op, list) else op
    return "on: Queued: {} open".format(n), bad


def check_queue():
    """List answers per the strict v1 contract (QA-2) and their list.expect; adopt answers per
    the QA-2 exit table; add answers per D-10 (small-rulings §1.2): rc 0 prints a queue-add/v1
    object, rc 2 has no REFUSED line, rc 5 a `REFUSED: draft: <rule>` line, rc 3, 4 and 6 are the
    other refusals."""
    problems, njson = [], 0
    for case in sorted(os.listdir(QUEUE)) if os.path.isdir(QUEUE) else []:
        p = os.path.join(QUEUE, case, "list.out")
        text = read(p) if os.path.exists(p) else ""
        where = "queue/{}/list.out".format(case)
        exp_file = os.path.join(QUEUE, case, "list.expect")
        expect = read(exp_file).strip() if os.path.exists(exp_file) else None
        commands = None
        if text.lstrip().startswith("{"):
            njson += 1
            try:
                doc = json.loads(text)
            except ValueError as e:
                problems.append("{}: {}".format(where, e))
                continue
            commands = doc.get("commands")
            mode, bad = queue_list_mode(doc)
            problems += ["{}: {}".format(where, b) for b in bad]
            if expect is not None and expect != mode:
                problems.append("{}: the strict contract gives `{}`, list.expect says `{}`".format(where, mode, expect))
            if expect is None and not mode.startswith("on"):
                problems.append("{}: gives `{}`; a reply that breaks the contract on purpose needs a list.expect".format(where, mode))
        elif expect is not None:
            problems.append("{}: list.expect is only for JSON replies".format(where))
        problems += check_adopt(case, commands)
        rc_file = os.path.join(QUEUE, case, "add.rc")
        if not os.path.exists(rc_file):
            continue
        where = "queue/{}/add".format(case)
        rc = read(rc_file).strip()
        out_file = os.path.join(QUEUE, case, "add.out")
        out = read(out_file) if os.path.exists(out_file) else ""
        err_file = os.path.join(QUEUE, case, "add.err")
        err = read(err_file) if os.path.exists(err_file) else ""
        if not rc.isdigit() or int(rc) > 6:
            problems.append("{}.rc: {!r} is not an exit code of the D-10 table (0-6)".format(where, rc))
            continue
        rc = int(rc)
        if rc == 0:
            try:
                d = json.loads(out)
            except ValueError:
                d = None
            if (not isinstance(d, dict) or d.get("schema") != "queue-add/v1" or d.get("status") not in QUEUE_ADD_STATUS
                    or not CLIENT_ID_RE.match(str(d.get("client_id"))) or not d.get("id") or not d.get("lane")):
                problems.append("{}.out: rc 0 needs a queue-add/v1 object with status, id, lane and client_id ck-<12 hex>".format(where))
        elif rc == 2 and "REFUSED:" in out + err:
            problems.append("{}: exit 2 must carry no REFUSED line (it means an old tool without add)".format(where))
        elif rc == 5 and not re.search(r"^REFUSED: draft: \S+", out + err, re.M):
            problems.append("{}: exit 5 needs a `REFUSED: draft: <rule>` line".format(where))
        sleep_file = os.path.join(QUEUE, case, "add.sleep")
        if os.path.exists(sleep_file) and not read(sleep_file).strip().isdigit():
            problems.append("{}.sleep must be whole seconds".format(where))
    return problems, njson


def check_adopt(case, commands):
    """QA-2 adopt: rc 0 with the bound lane id in the first stdout line; rc 3/4/6 with one stdout
    `REFUSED: <kind>: <reason>` line (<= 200 B, no command text); rc 2 usage. adopt.expect is the
    plugin's mapping (AT-QA-04): `lane: <id>`, `held holder=<sid> kind=<k>`, `no-lane`, `error`,
    `unsupported`."""
    p = []
    d = os.path.join(QUEUE, case)
    if not os.path.exists(os.path.join(d, "adopt.rc")):
        return p
    where = "queue/{}/adopt".format(case)
    rc = read(os.path.join(d, "adopt.rc")).strip()
    out = read(os.path.join(d, "adopt.out")) if os.path.exists(os.path.join(d, "adopt.out")) else ""
    expect = read(os.path.join(d, "adopt.expect")).strip() if os.path.exists(os.path.join(d, "adopt.expect")) else None
    if rc not in ("0", "2", "3", "4", "6"):
        return ["{}.rc: {!r} is not a QA-2 adopt exit code (0, 2, 3, 4, 6)".format(where, rc)]
    rc = int(rc)
    first = out.split("\n", 1)[0]
    if rc == 0:
        m = LANE_IN_RE.search(first)
        want = "lane: " + m.group(0) if m else None
        if not m:
            p.append("{}.out: rc 0 needs the bound lane id in the first line".format(where))
    elif rc == 2:
        want = "unsupported"
        if "REFUSED:" in out:
            p.append("{}: exit 2 is usage and carries no REFUSED line".format(where))
    else:
        m = re.match(ADOPT_REFUSAL[rc], first)
        if not m or len(first.encode("utf-8")) > 200 or "`" in first or "queue-stub" in first:
            p.append("{}.out: exit {} needs one line matching {} (<= 200 B, no command text)".format(where, rc, ADOPT_REFUSAL[rc]))
        want = ("held holder={} kind={}".format(m.group(1), m.group(2)) if m else "held") if rc == 3 else ("no-lane" if rc == 4 else "error")
    if expect is None:
        p.append("{}: adopt.expect missing".format(where))
    elif want is not None and expect.split(" (")[0] != want:
        p.append("{}: the QA-2 mapping gives `{}`, adopt.expect says `{}`".format(where, want, expect))
    if "(no --must-exist" in (expect or "") and commands is not None and "adopt:must-exist" in commands:
        p.append("{}: adopt.expect says no --must-exist but the caps hold adopt:must-exist".format(where))
    return p


# Transcript manifests (README "Transcripts"): FIX-03 inputs that tie transcripts to payloads, records
# and corpus files. P5-replay (C-STORE D5 fill, AT-ST-08), fill-joins (AT-ST-09), idle-cases (IC-1 D1,
# AT-IC-02). Each check proves the pieces agree, so a core case can rely on them.
TRANSCRIPTS = os.path.join(FIX, "transcripts")


def jsonl_rows(rel):
    return [json.loads(l) for l in read(os.path.join(FIX, rel)).split("\n") if l.strip()]


def row_text(r):
    c = (r.get("message") or {}).get("content")
    if isinstance(c, list):
        c = "".join(x.get("text", "") for x in c if isinstance(x, dict))
    return c if isinstance(c, str) else ""


def body_lines_in(post_text, row, b):
    """Every non-blank normalized-body line of a PostCompact text is a line of the summary row text."""
    body, _ = normalize(fill(post_text, b), b["name"])
    have = set(fill(row_text(row), b).split("\n"))
    return [ln for ln in body.split("\n") if ln.strip() and ln not in have]


def payload_of(rel, sid):
    d = json.loads(read(os.path.join(FIX, rel)))
    if d.get("hook_event_name") != "PostCompact" or d.get("session_id") != sid:
        raise ValueError("{} is not a PostCompact payload of {}".format(rel, sid))
    return d


def check_replay(b):
    p = []
    m = json.loads(read(os.path.join(TRANSCRIPTS, "P5-replay", "replay.json")))
    rows = jsonl_rows(m["agent_transcript"])
    jsonl_rows(m["main_transcript"])
    seen = set()
    for c in m["compactions"]:
        w = "P5-replay c{}".format(c["seq"])
        try:
            pay = payload_of(c["payload"], m["sid"])
        except (OSError, ValueError) as e:
            p.append("{}: {}".format(w, e))
            continue
        if pay["compact_summary"] != read(os.path.join(FIX, c["corpus"])):
            p.append("{}: the payload compact_summary is not the corpus file {}".format(w, c["corpus"]))
        d = json.loads(read(os.path.join(FIX, c["dispatch"])))
        if (d.get("nonce"), d.get("agent_id"), d.get("channel")) != (c["nonce"], None, "classic"):
            p.append("{}: {} must be a classic dispatch, agent_id null, nonce {}".format(w, c["dispatch"], c["nonce"]))
        bl, sl = rows[c["boundary_line"] - 1], rows[c["summary_line"] - 1]
        meta = bl.get("compactMetadata") or {}
        if (bl.get("subtype") != "compact_boundary" or bl.get("agentId") != m["agent"] or not bl.get("isSidechain")
                or (meta.get("preTokens"), meta.get("postTokens"), meta.get("durationMs")) != (c["pre_tokens"], c["post_tokens"], c["duration_ms"])):
            p.append("{}: agent line {} is not its boundary row with the listed sizes".format(w, c["boundary_line"]))
        if sl.get("isCompactSummary") is not True or detect(fill(row_text(sl), b), b["name"])[3] != c["nonce"]:
            p.append("{}: agent line {} is not a summary row with marker nonce {}".format(w, c["summary_line"], c["nonce"]))
        missing = body_lines_in(pay["compact_summary"], sl, b)
        if missing:
            p.append("{}: the summary row lacks {} body lines of the PostCompact text, first {!r}".format(w, len(missing), missing[0][:60]))
        t_pre, t_b, t_post = parse_iso(c["precompact_now"]), parse_iso(bl.get("timestamp")), parse_iso(c["postcompact_now"])
        if not (t_pre is not None and t_b is not None and t_post is not None and t_pre < t_b <= t_post):
            p.append("{}: want PreCompact < boundary row <= PostCompact (lab order)".format(w))
        seen.add(c["nonce"])
    if len(seen) != len(m["compactions"]) or len(m["compactions"]) != 6:
        p.append("P5-replay: six compactions with distinct nonces")
    nb = sum(1 for r in rows if r.get("subtype") == "compact_boundary")
    ns = sum(1 for r in rows if r.get("isCompactSummary") is True)
    if (nb, ns) != (6, 6):
        p.append("P5-replay: the agent file holds {} boundary and {} summary rows, want 6 and 6".format(nb, ns))
    return p


# The engine's trailer lines after a transcript summary row's body (fix-escalations item 1). Core
# built option (b): the transcript-row reader cuts them itself (transcript.pm @ENGINE_TRAILERS,
# core-escalations E-C9-12) and the shipped copy_trailers stay empty. The joins reference cuts the
# same three prefixes, so join (b) is proven the way core reads a row (and under option (a) alike).
ENGINE_TRAILERS = [re.compile(r"^If you need specific details from before compaction \("),
                   re.compile(r"^Continue the conversation from where it left off without asking"),
                   re.compile(r"^The messages after this summary are the most recent messages from before compaction")]


def join_ref(c, summ, bounds, pay, b, taken=()):
    """C-STORE D5 join order for an unmarked copy (no nonce, so no join a), over the boundary rows
    no earlier copy has joined (`taken`: the case's joined_before agents): (b) one agent whose
    summary row's normalized body (engine trailers cut) has the copy's sha; else (c) by time, with
    the candidate count of core-escalations E-C9-10 (core-to-fix 3; provisional until the root
    rules on it): every agent with a free boundary row within SUB_WINDOW_S on either side of the
    PostCompact time t counts; exactly one, with its row in the P3 sub window
    [t - TOL_S, t + SUB_WINDOW_S] -> fill; several -> copy_attribution_ambiguous with them;
    else no fill, no row. Returns (outcome, all sha holders, the candidates)."""
    sha = detect(fill(pay["compact_summary"], b), b["name"])[5]
    holders = sorted(a for a, r in summ.items() if detect(fill(row_text(r), b), b["name"], trailers=ENGINE_TRAILERS)[5] == sha)
    free = [a for a in holders if a not in taken]
    if len(free) == 1:
        return {"filled": True, "agent": free[0], "attributed_by": "reconcile-b"}, holders, []
    t = parse_iso(c["postcompact_now"])
    cands = sorted(a for a, e in bounds.items()
                   if a not in taken and t is not None and e is not None and abs(e - t) <= SUB_WINDOW_S)
    if len(cands) == 1:
        if t - TOL_S <= bounds[cands[0]] <= t + SUB_WINDOW_S:
            return {"filled": True, "agent": cands[0], "attributed_by": "reconcile-c"}, holders, cands
        return {"filled": False}, holders, cands
    if cands:
        return {"filled": False, "row": "copy_attribution_ambiguous", "candidates": cands}, holders, cands
    return {"filled": False}, holders, cands


def check_joins(b):
    p = []
    m = json.loads(read(os.path.join(TRANSCRIPTS, "fill-joins", "joins.json")))
    summ, bounds = {}, {}
    for k, agent in m["agents"].items():
        rows = jsonl_rows("transcripts/fill-joins/subagents/agent-{}.jsonl".format(agent))
        bs = [r for r in rows if r.get("subtype") == "compact_boundary"]
        ss = [r for r in rows if r.get("isCompactSummary") is True]
        if len(bs) != 1 or len(ss) != 1 or bs[0]["timestamp"] != m["boundaries"][k]:
            p.append("fill-joins {}: one boundary row at {} and one summary row".format(k, m["boundaries"][k]))
            continue
        if detect(fill(row_text(ss[0]), b), b["name"])[3] is not None:
            p.append("fill-joins {}: the summary row must be unmarked".format(k))
        if detect(fill(row_text(ss[0]), b), b["name"])[5] == detect(fill(row_text(ss[0]), b), b["name"], trailers=ENGINE_TRAILERS)[5]:
            p.append("fill-joins {}: the summary row must end with the engine trailers (the transcript form)".format(k))
        summ[agent], bounds[agent] = ss[0], parse_iso(bs[0]["timestamp"])
    times = [parse_iso(t) for t in m["boundaries"].values()]
    if None in times or max(times) - min(times) >= SUB_WINDOW_S:
        p.append("fill-joins: both boundary rows must sit inside one {} s window".format(SUB_WINDOW_S))
    seen = set()
    for c in m["cases"]:
        w = "fill-joins {}".format(c["id"])
        seen.add(c["id"])
        try:
            pay = payload_of(c["payload"], m["sid"])
        except (OSError, ValueError) as e:
            p.append("{}: {}".format(w, e))
            continue
        if detect(fill(pay["compact_summary"], b), b["name"])[3] is not None:
            p.append("{}: the payload summary must be unmarked".format(w))
        before = c.get("joined_before", [])
        if not set(before) <= set(m["agents"]):
            p.append("{}: joined_before names no agent of the manifest: {}".format(w, sorted(set(before) - set(m["agents"]))))
        taken = {m["agents"][k] for k in before if k in m["agents"]}
        ref, holders, cands = join_ref(c, summ, bounds, pay, b, taken)
        if c["id"] == "two-sided":   # the E-C9-10 pin must separate the readings
            t = parse_iso(c["postcompact_now"])
            one = [a for a, e in bounds.items() if a not in taken and t is not None and e is not None
                   and t - TOL_S <= e <= t + SUB_WINDOW_S]
            if len(one) != 1 or len(cands) < 2:
                p.append("{}: the one-sided P3 window must hold exactly one candidate ({}) and the two-sided "
                         "count several ({}), or the case does not pin E-C9-10".format(w, one, cands))
        lines = sorted(a for a, r in summ.items() if not body_lines_in(pay["compact_summary"], r, b))
        if lines != holders:
            p.append("{}: every body line is in the rows of {}, but the sha (engine trailers cut) matches {}".format(w, lines, holders))
        e = c["expect"]
        if "fault" in c:
            if not ref.get("filled"):
                p.append("{}: without the fault the join gives {}, so the fault proves nothing".format(w, ref))
            if not (c["fault"].get("env") and e.get("filled") is False and e.get("row") == "copy_attribution_failed"
                    and e.get("old_file", "").startswith("kept") and e.get("new_file") == "absent"
                    and "copy_attributed" in e.get("rows_absent", [])):
                p.append("{}: a verify failure keeps the old file, leaves no new file and writes copy_attribution_failed "
                         "and no copy_attributed (C-STORE D5 step 3)".format(w))
            continue
        got = {k: e.get(k) for k in ref}
        if got != ref or set(e) - set(ref) - {"note"}:
            p.append("{}: expect {} but the D5 join order gives {} (sha holders {}, window candidates {})".format(
                w, e, ref, holders, cands))
    for need in ("sha-join", "ambiguous", "time-join", "verify-fail", "two-sided"):
        if need not in seen:
            p.append("fill-joins: no {} case (AT-ST-09)".format(need))
    return p


def check_idle(b):
    p = []
    m = json.loads(read(os.path.join(TRANSCRIPTS, "idle-cases.json")))
    for c in m["cases"]:
        w = "idle-cases {}".format(c["id"])
        rows = jsonl_rows(c["transcript"] + "/main.jsonl")
        main_b = [i for i, r in enumerate(rows) if r.get("subtype") == "compact_boundary" and not r.get("isSidechain")]
        if len(main_b) != 1 or (rows[main_b[0]].get("compactMetadata") or {}).get("trigger") != "auto":
            p.append("{}: one main boundary row with trigger auto".format(w))
            continue
        native = None
        for r in rows[main_b[0] + 1:]:
            if r.get("type") == "system":
                for k, pre in sorted(m["prefixes"].items()):
                    if str(r.get("content", "")).startswith(pre):
                        native = k
                if native:
                    break
        summ = [r for r in rows if r.get("isCompactSummary") is True]
        if len(summ) != 1 or detect(fill(row_text(summ[0]), b), b["name"])[3] != m["nonce"]:
            p.append("{}: one summary row with marker nonce {}".format(w, m["nonce"]))
        d = json.loads(read(os.path.join(FIX, c["dispatch"])))
        if d.get("nonce") != m["nonce"] or not isinstance(d.get("idle"), bool) or d.get("channel") != "mod-hook":
            p.append("{}: {} must be a mod-hook dispatch for {} with a boolean idle".format(w, c["dispatch"], m["nonce"]))
            continue
        mod = d["idle"]
        source = "both" if mod and native else "mod" if mod else native or "none"
        want = {"idle": bool(mod or native), "idle_source": source, "idle_mismatch": int(bool(mod) != bool(native))}
        got = {k: c["expect"].get(k) for k in want}
        if got != want:
            p.append("{}: expect {} but the IC-1 D1 rule gives {}".format(w, got, want))
        ends = [r for r in rows if r.get("type") == "assistant" and not r.get("isSidechain")]
        if not ends or ends[-1]["timestamp"] != m["last_turn_end"]:
            p.append("{}: the last main assistant row must end at last_turn_end".format(w))
        gap = parse_iso(m["dispatch_ts"]) - parse_iso(m["last_turn_end"])
        if int(gap) != m["idle_gap_s"] or gap < 1500:
            p.append("{}: idle_gap_s {} must be the dispatch ts minus the last turn end and at least 1,500 s".format(w, m["idle_gap_s"]))
    return p


def check_manifests(b):
    problems, n = [], 0
    for name, fn in (("P5-replay/replay.json", check_replay), ("fill-joins/joins.json", check_joins), ("idle-cases.json", check_idle)):
        if not os.path.exists(os.path.join(TRANSCRIPTS, name)):
            problems.append("manifests: transcripts/{} missing".format(name))
            continue
        n += 1
        try:
            problems += fn(b)
        except (OSError, ValueError, KeyError, IndexError, TypeError) as e:
            problems.append("manifests transcripts/{}: {}: {}".format(name, type(e).__name__, e))
    return problems, n
# The scope-proof table (transcripts/scope-cases.json; MOD-SPEC §2.4 as amended by ROOT-RULINGS F2-1).
SCOPE_CASES = os.path.join(FIX, "transcripts", "scope-cases.json")
SCOPE_KEYS = {"expect_scope": True, "expect_scope_postcompact": False}   # key -> P3 counted


def iso(ts):
    return datetime.datetime.fromisoformat(ts[:-1] + "+00:00" if ts.endswith("Z") else ts)


def ref_scope(case, b, with_p3):
    """main | sub | unknown by the §2.4 rule: main = P1-main, or P3-main with no subagent signal;
    subagent = P1-sub, P2-sub or P3-sub; both or neither = unknown. with_p3=False is the reading
    inside SessionStart(compact) and PostCompact (F2-1: the boundary row lands after them)."""
    d = load_dispatch(case["dispatch"]) if case["dispatch"] else None
    name, _, swap = case["summary"].partition("#nonce=")
    text = fill(read(os.path.join(SUMMARIES, name)), b)
    nonce = detect(text, b["name"])[3]
    if swap and nonce:
        text, nonce = text.replace(nonce, swap), swap
    mscope = detect(text, b["name"])[4]
    p1 = d if d and nonce and d["nonce"] == nonce else None
    main = bool(p1 and p1.get("agent_id") is None and p1.get("channel") in ("mod-hook", "mod-self"))
    sub = bool(p1 and p1.get("agent_id") is not None) or mscope == "sub"
    if with_p3:
        tdir = os.path.join(FIX, case["transcripts"])
        p3_main = transcript_counts(read(os.path.join(tdir, "main.jsonl")))[0] > case["boundaries_count"]
        agent_new = False
        sdir = os.path.join(tdir, "subagents")
        for f in sorted(os.listdir(sdir)) if os.path.isdir(sdir) else []:
            for line in read(os.path.join(sdir, f)).split("\n"):
                r = json.loads(line) if line.strip() else {}
                if r.get("subtype") == "compact_boundary" and (d is None or iso(r["timestamp"]) > iso(d["ts"])):
                    agent_new = True
        main = main or (p3_main and not agent_new and not sub)
        sub = sub or (agent_new and not p3_main)
    return "unknown" if main == sub else ("main" if main else "sub")


def check_scope_cases(b):
    problems = []
    table = json.loads(read(SCOPE_CASES))
    for case in table["cases"]:
        for key, with_p3 in sorted(SCOPE_KEYS.items()):
            want = ref_scope(case, b, with_p3)
            if case.get(key) != want:
                problems.append("scope-cases {}: {} is {}, the §2.4 rule{} gives {}".format(
                    case["id"], key, case.get(key), "" if with_p3 else " without P3 (F2-1)", want))
    return problems, len(table["cases"])


# The rename drill (BUILD-PLAN §4.6, fixture side): a temp copy with another brand must pass
# --check after the plain regenerate step alone. The corpus sha column depends on the brand
# (README "Corpus"), so this fails whenever the regenerate step leaves that column stale.
DRILL_BRAND = {"name": "zq-rename-drill", "marketplace": "zq-rename-market"}
NO_DRILL_ENV = "FIXTURES_GEN_NO_DRILL"   # set for the drill's own inner --check (no recursion)


def rename_drill(b):
    problems = []
    tmp = tempfile.mkdtemp(prefix="fixtures-gen-drill-")
    try:
        for rel in (os.path.join("tools", "fixtures-gen"), os.path.join("src", "assets", "handoff-spec.md"),
                    os.path.join("plugin", "assets", "canary-baseline.json")):
            if os.path.exists(os.path.join(REPO, rel)):
                os.makedirs(os.path.dirname(os.path.join(tmp, rel)), exist_ok=True)
                shutil.copy2(os.path.join(REPO, rel), os.path.join(tmp, rel))
        shutil.copytree(FIX, os.path.join(tmp, "tests", "fixtures"), symlinks=True)
        with open(os.path.join(tmp, "brand.json"), "w", encoding="utf-8", newline="\n") as f:
            json.dump(dict(b, **DRILL_BRAND), f, indent=2)
        tool = os.path.join(tmp, "tools", "fixtures-gen")
        env = dict(os.environ, **{NO_DRILL_ENV: "1"})
        for args in ([], ["--check"]):
            r = subprocess.run([sys.executable, tool] + args, env=env, cwd=tmp, timeout=120,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
            if r.returncode != 0:
                lines = [ln for ln in r.stdout.splitlines() if not ln.startswith(("parse:", "expected:", "secrets:"))]
                problems.append("rename drill: `tools/fixtures-gen {}` exit {} after renaming to {}: {}".format(
                    " ".join(args), r.returncode, DRILL_BRAND["name"], " | ".join(lines[:4])))
                break
        before = {r["file"]: r["normalized_sha256"] for r in read_expected()}
        after = {r["file"]: r["normalized_sha256"]
                 for r in read_expected(os.path.join(tmp, "tests", "fixtures", "summaries", "expected.tsv"))}
        changed = sum(1 for k in before if after.get(k) != before[k])
        if changed == 0 and not problems:
            problems.append("rename drill: no normalized_sha256 changed with the brand, so the drill proves nothing")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print("rename: regenerate + check in a copy renamed to {} ({} sha rows changed)".format(DRILL_BRAND["name"], changed))
    return problems


def check(b):
    problems = []
    # parse
    njson = 0
    for p in walk(FIX):
        rel = os.path.relpath(p, REPO)
        if p.endswith(".json"):
            njson += 1
            try:
                json.loads(read(p))
            except ValueError as e:
                problems.append("parse {}: {}".format(rel, e))
        elif p.endswith(".jsonl"):
            for no, line in enumerate(read(p).split("\n"), 1):
                if line.strip() and no not in INTENDED_MALFORMED.get(rel, ()):
                    try:
                        json.loads(line)
                    except ValueError as e:
                        problems.append("parse {}:{}: {}".format(rel, no, e))
    print("parse: {} json files and every jsonl line checked".format(njson))
    # expected (every corpus table: the main corpus and summaries/p5)
    nfiles, ntables = 0, 0
    for d, path in tables():
        ntables += 1
        tname = os.path.relpath(path, FIX)
        if not os.path.exists(path):
            problems.append("expected {}: missing".format(tname))
            continue
        rows = read_expected(path)
        want = {r["file"]: r for r in rows}
        files = summary_files(d)
        nfiles += len(files)
        if sorted(want) != files:
            problems.append("{} files and the .txt files differ: {}".format(tname, sorted(set(want) ^ set(files))))
        for r in expected_rows(b, {k: v["dispatch"] for k, v in want.items()}, d):
            w = want.get(r["file"])
            if w and w != r:
                diff = ["{} {}!={}".format(c, w[c], r[c]) for c in COLUMNS if w[c] != r[c]]
                problems.append("expected {}: {}".format(os.path.relpath(os.path.join(d, r["file"]), SUMMARIES), ", ".join(diff)))
    print("expected: {} corpus files in {} tables against the reference detector".format(nfiles, ntables))
    # secrets
    rules, source = load_rules()
    targets = list(walk(FIX)) + [os.path.join(REPO, "tools", "fixtures-gen")]
    rendered = render(b)
    texts = []
    for p in targets:
        rel = os.path.relpath(p, REPO)
        if p.endswith(".zip"):
            texts += [(rel + "!" + n, t) for n, t in zip_texts(p)]
            continue
        try:
            texts.append((rel, read(p)))
        except UnicodeDecodeError:
            problems.append("secrets {}: not UTF-8 text and not a zip, so it cannot be scanned".format(rel))
    texts += [(os.path.join(GEN_REL, n), t) for n, t in rendered.items()]
    for rel, text in texts:
        for rid, cls in scan(fill(text, b), rules):
            problems.append("secret-shaped {} in {}".format(rid, rel))
    corpus = load_corpus()
    joined_by_id = {e["id"]: "".join(e["fragments"]) for e in corpus["entries"]}
    for e in corpus["entries"]:
        joined = "".join(e["fragments"])
        hit = scan(joined, rules)
        classes = {c for _, c in hit}
        if e["class"] == "none":
            if hit:
                problems.append("secrets {}: control hits {}".format(e["id"], hit))
        elif e["class"] not in classes:
            problems.append("secrets {}: joined value does not hit class {} ({})".format(e["id"], e["class"], hit))
        if e.get("rule", "-") != "-" and e["rule"] not in {r for r, _ in hit}:
            problems.append("secrets {}: joined value does not hit its rule id {} ({} rule set hits {})".format(
                e["id"], e["rule"], source, sorted({r for r, _ in hit})))
        for parent in e.get("part_of", []):
            if parent not in joined_by_id:
                problems.append("secrets {}: part_of names no entry {}".format(e["id"], parent))
            elif joined not in joined_by_id[parent]:
                problems.append("secrets {}: joined value is not inside entry {}".format(e["id"], parent))
        for frag in e["fragments"]:
            if scan(frag, rules):
                problems.append("secrets {}: a single fragment is secret-shaped".format(e["id"]))
    for n in corpus["names"]:
        if deny_name(n["name"]) != (n["expect"] == "withheld"):
            problems.append("secrets name {}: deny-list says {}".format(n["name"], deny_name(n["name"])))
    print("secrets: {} files scanned with the {} rule set; {} corpus entries, {} names".format(
        len(texts), source, len(corpus["entries"]), len(corpus["names"])))
    bd2_problems, nbd2 = check_bd2(corpus)
    problems += bd2_problems
    print("bd2: every corpus entry redacted once per merged span (C-STORE D6); {} pins checked".format(nbd2))
    # sequences
    seq_problems, nseq = check_sequences()
    problems += seq_problems
    print("sequences: {} replayed (transcript state per step, S-21 order)".format(nseq))
    # scope
    scope_problems, nscope = check_scope_cases(b)
    problems += scope_problems
    print("scope: {} scope-cases rows against the §2.4 rule, at reconcile and inside PostCompact".format(nscope))
    # queue
    queue_problems, nqueue = check_queue()
    problems += queue_problems
    print("queue: {} JSON list answers against the strict v1 contract (QA-2), adopt answers per the QA-2 exit table, add answers per D-10".format(nqueue))
    # setups, settings
    setup_problems, nsetup = check_setups(b)
    problems += setup_problems
    print("setups: {} recipes built in temp dirs and checked (D-12 repos, Dev-1 scenarios)".format(nsetup))
    stub_problems, nstub = check_stubs(b)
    problems += stub_problems
    print("stubs: {} PATH stub proven on a temp repo (bin/git-noexclude keeps a path the real git excludes)".format(nstub))
    settings_problems, nsettings = check_settings()
    prod_problems, nprod = check_prod()
    problems += prod_problems
    print("prod: {} recorded commands classed by the BUILD-PLAN §3.7 effects order (S-SETTINGS B, C)".format(nprod))
    problems += settings_problems
    print("settings: {} files name only declared userConfig keys".format(nsettings))
    runtime_problems, nruntime = check_runtime()
    problems += runtime_problems
    print("runtime: assembly/runtime.json's {} keys cover every token tools/assemble fills (BT-04-H)".format(nruntime))
    # beta
    beta_problems, nbeta = check_beta()
    problems += beta_problems
    print("beta: {} analyzer zips against the W-BETA F.1 intake and F.2 verify reference".format(nbeta))
    # manifests
    man_problems, nman = check_manifests(b)
    problems += man_problems
    print("manifests: {} transcript manifests agree with their payloads, records and corpus files".format(nman))
    # stamps
    stamp_problems, nstamp, nlegacy = check_stamps()
    problems += stamp_problems
    print("stamps: {} fixture files, no short time outside the {} legacy-reading files".format(nstamp, nlegacy))
    # drift
    gen_dir = os.path.join(REPO, GEN_REL)
    for name, text in sorted(rendered.items()):
        p = os.path.join(gen_dir, name)
        if not os.path.exists(p):
            problems.append("drift missing " + os.path.join(GEN_REL, name))
        elif read(p) != text:
            problems.append("drift differs " + os.path.join(GEN_REL, name))
    if os.path.isdir(gen_dir):
        for f in sorted(os.listdir(gen_dir)):
            if f.endswith(".gen.ts") and f not in rendered and f.startswith(("brand", "corpus", "payloads")):
                problems.append("drift stale " + os.path.join(GEN_REL, f))
    # rename
    if not os.environ.get(NO_DRILL_ENV):
        problems += rename_drill(b)
    for p in problems:
        print(p)
    print("FIXTURES CHECK: " + ("FAIL ({} problems)".format(len(problems)) if problems else "PASS"))
    return 1 if problems else 0


def write(root, b, rows=None):
    d = os.path.join(root, GEN_REL)
    os.makedirs(d, exist_ok=True)
    for name, text in render(b, rows).items():
        with open(os.path.join(d, name), "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
    print("fixtures-gen: wrote {} files in {}".format(len(GEN_FILES), os.path.relpath(d, REPO) if root == REPO else d))


def main(argv):
    b = brand()
    if argv == []:
        refresh_sha(b)
        write(REPO, b)
        return 0
    if argv == ["--check"]:
        return check(b)
    if len(argv) == 2 and argv[0] == "--out":
        root = os.path.abspath(argv[1])
        if root == REPO:
            die("--out must not be the repo; run without arguments instead")
        write(root, b, {path: sha_refreshed(b, d, path)[0] for d, path in tables()})
        return 0
    if argv == ["--clean"]:
        for name in GEN_FILES:
            p = os.path.join(REPO, GEN_REL, name)
            if os.path.exists(p):
                os.unlink(p)
                print("removed " + os.path.join(GEN_REL, name))
        return 0
    if argv[:1] == ["--print-expected"] and len(argv) <= 2 and set(argv[1:]) <= set(SUB_TABLES):
        d = os.path.join(SUMMARIES, argv[1]) if argv[1:] else SUMMARIES
        path = os.path.join(d, "expected.tsv")
        refs = {}
        if os.path.exists(path):   # only the file and dispatch columns, by header name (authoring aid)
            with open(path, encoding="utf-8") as f:
                head = f.readline().rstrip("\n").split("\t")
                for line in f:
                    r = dict(zip(head, line.rstrip("\n").split("\t")))
                    if r.get("file"):
                        refs[r["file"]] = r.get("dispatch", "")
        sys.stdout.write(tsv(expected_rows(b, refs, d)))
        return 0
    if argv == ["--refresh-sha"]:
        if not refresh_sha(b):
            print("fixtures-gen: normalized_sha256 already current for brand {}".format(b["name"]))
        return 0
    die("unknown arguments {}\n{}".format(argv, __doc__))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
