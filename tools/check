#!/usr/bin/python3
"""tools/check: run one phase's exit checks (BUILD-PLAN §4) in order; stop at the first failure.

Usage: tools/check PHASE [--names FILE] [--no-drill]
  PHASE    phase0       X-validate (skeleton), X-test, X-types, X-gen, X-assemble, X-gates,
                        X-name, X-tools, BT-02 rename drill
           integration  the same with every skill required, plus X-H (every helper case:
                        tests/helper/run.* over tests/helper/cases, then the WP-watch driver;
                        only the KNOWN_RED cases may fail, each for its stated reason)
           selftest     X-tools alone
           xgen         X-gen alone (used by the X-tools probe of the canary baseline)
  --names  the competitor-name list (E-7); default $GATE_NAMES_FILE. Missing = X-gates fails.
  --no-drill  skip X-tools and BT-02 (used for the drill's own run inside its renamed copy)

X-gen: tools/build --check, tools/fixtures-gen --check, tools/helper-replies-gen --check,
tools/canary-baseline --check (pinned to the Claude Code binary the baseline records, so an
update does not make it flaky; when that binary is gone, every part but the C8 counts is
compared with a render from the newest binary) and tools/assemble --check (goldens and
goldens.gen.ts), each byte for byte (BH-4, BH-5).

X-tools: plant known faults in temp copies of the work tree (tmp/selftest/) and confirm that
the tool reports every one, while the unplanted copy passes the same command: CRLF line ends
in GEN files (tools/build, helper-replies-gen, canary-baseline, assemble), stray files where
only GEN tools write, other candidate names inside longer words, npm manifests or
node_modules under plugin/ (BT-06), a hand edit of the canary baseline (X-gen), a SKILL.md
description over the BT-09 rule, the text gates of the 2026-10-21 rulings (AT-W-01 wait text,
AT-W-02 asset bytes, AT-SK-01 budget line and caps, AT-SK-03 write-first line, AT-J-13
self-heal table and resume SKILL size), a resume protocol over its DP-8 hard cap (assemble),
a cross-WP `git mv` (owners-check) and a checkout with core.autocrlf=true without the repo's
.gitattributes (the launcher must keep LF and run).

BT-02 (BUILD-PLAN §4.6, a real rename): copy the work tree to tmp/rename, set brand.json there
to the drill name, run the §4.6 regenerate steps (tools/build, tools/assemble --goldens,
tools/fixtures-gen) in the copy, then the copy's own `tools/check PHASE --no-drill`, so every
check of the phase (X-test and X-H included) runs under the new name. Then the old name must
be gone from the copy's plugin/, README.md and marketplace file, the old launcher removed, and
the repo's own tree unchanged.

Environment: CC_TYPES_DIR (tools/typecheck), NODE or node on PATH, `claude` on PATH.
"""
import json, os, re, shutil, subprocess, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
EVENTS = {"PreCompact": 5, "PostCompact": 15, "SessionStart": 5, "SessionEnd": 5,
          "Stop": 8, "SubagentStop": 3, "StopFailure": 2, "PermissionDenied": 2}   # MOD §1.3, D-4
SESSION_START_MATCHER = "startup|resume|clear|compact|fork"
SKILLS_ALL = ["handoff", "resume", "status"]
WATCH_DRIVERS = ["tests/helper/cases/watch/_driver/run-watch.pl"]
DRILL_NAME = "x" * 14
DRILL_DIR = os.path.join(REPO, "tmp", "rename")
SELFTEST_DIR = os.path.join(REPO, "tmp", "selftest")
RENAME_STEPS = [["tools", "build"], ["tools", "assemble", "--goldens"], ["tools", "fixtures-gen"]]   # §4.6
COPY_SKIP_TOP = {".git", "node_modules", "tmp"}
COPY_SKIP = {"__pycache__", ".DS_Store", os.path.join("plugin", ".claude-plugin", "types")}


class Fail(Exception):
    pass


def run(argv, label, cwd=REPO, capture=False):
    print("$ " + " ".join(argv), flush=True)
    r = subprocess.run(argv, cwd=cwd, capture_output=capture, text=True)
    if capture and r.stdout and not argv[-1] == "--json":
        sys.stdout.write(r.stdout[-4000:])
    if r.returncode != 0:
        if capture:
            sys.stdout.write((r.stdout or "")[-4000:] + (r.stderr or "")[-2000:])
        raise Fail("{}: exit {}".format(label, r.returncode))
    return r


def brand(root=REPO):
    with open(os.path.join(root, "brand.json"), encoding="utf-8") as f:
        return json.load(f)


def x_validate(plugin_dir, root_dir, name, skills_required):
    r = run(["claude", "plugin", "validate", plugin_dir, "--strict", "--json"], "X-validate plugin", capture=True)
    rep = json.loads(r.stdout)
    if not rep.get("success"):
        raise Fail("X-validate: success is false")
    hooks = [c for c in rep.get("contents", []) if c.get("type") == "hooks"]
    if len(hooks) != 1 or not any(n.startswith("./register.ts hooks:") for n in hooks[0].get("notes", [])):
        raise Fail("X-validate: the report does not name one hooks module (./register.ts)")
    with open(os.path.join(plugin_dir, "hooks", "hooks.json"), encoding="utf-8") as f:
        hj = json.load(f)
    if hj.get("modules") != ["./register.ts"]:
        raise Fail("X-validate: hooks.json modules is {}".format(hj.get("modules")))
    if set(hj.get("hooks", {})) != set(EVENTS):
        raise Fail("X-validate: classic events {} != MOD §1.3".format(sorted(hj.get("hooks", {}))))
    for ev, timeout in EVENTS.items():
        groups = hj["hooks"][ev]
        cmds = [h for g in groups for h in g.get("hooks", [])]
        want = '"${{CLAUDE_PLUGIN_ROOT}}/bin/{}-store" hook {}'.format(name, ev)
        if len(cmds) != 1 or cmds[0].get("type") != "command" or cmds[0].get("command") != want:
            raise Fail("X-validate: {} command is not the quoted shell form {}".format(ev, want))
        if cmds[0].get("timeout") != timeout:
            raise Fail("X-validate: {} timeout {} != {}".format(ev, cmds[0].get("timeout"), timeout))
        matcher = groups[0].get("matcher")
        if ev == "SessionStart" and matcher != SESSION_START_MATCHER:
            raise Fail("X-validate: SessionStart matcher {}".format(matcher))
        if ev != "SessionStart" and matcher not in (None, "", "*"):
            raise Fail("X-validate: {} has matcher {}".format(ev, matcher))
    sk_dir = os.path.join(plugin_dir, "skills")
    present = sorted(d for d in os.listdir(sk_dir) if os.path.isfile(os.path.join(sk_dir, d, "SKILL.md")))
    missing = [s for s in skills_required if s not in present]
    if missing:
        raise Fail("X-validate: skills missing: {}".format(missing))
    extra = [s for s in present if s not in SKILLS_ALL]
    if extra:
        raise Fail("X-validate: unexpected skills: {}".format(extra))
    pending = [s for s in SKILLS_ALL if s not in present]
    run(["claude", "plugin", "validate", root_dir, "--strict"], "X-validate marketplace", capture=True)
    print("X-validate: PASS (1 module, {} classic events, skills {}{})".format(
        len(EVENTS), ", ".join(present), "; pending: " + ", ".join(pending) if pending else ""))


def x_assemble(name_first):
    for n in (name_first, "x" * 14, "x" * 16):
        r = run([os.path.join(REPO, "tools", "assemble"), "--name", n, "--path-len", "141"],
                "X-assemble " + n, capture=True)
        if "RESULT: PASS" not in r.stdout:
            raise Fail("X-assemble {}: no RESULT: PASS".format(n))


def gates(targets, names, brand_name, only=None):
    argv = [os.path.join(REPO, "tools", "gates")] + targets + ["--names", names or "", "--brand", brand_name]
    if only:
        argv += ["--only", only]
    run(argv, "gates " + " ".join(targets) + (" --only " + only if only else ""), capture=True)


def tree_state():
    return subprocess.run(["git", "-C", REPO, "status", "--porcelain", "--untracked-files=all"],
                          capture_output=True, text=True).stdout


def copy_tree(dst):
    """Copy the work tree (tracked and untracked files; no .git, node_modules or tmp/) to dst.

    node_modules is linked, not copied, so X-types runs in the copy. Symlinks stay links.
    """
    if os.path.lexists(dst):
        shutil.rmtree(dst)
    for d, dirs, files in os.walk(REPO):
        rel = os.path.relpath(d, REPO)
        keep = []
        for x in sorted(dirs):
            xrel = os.path.normpath(os.path.join(rel, x))
            if (rel == "." and x in COPY_SKIP_TOP) or x in COPY_SKIP or xrel in COPY_SKIP:
                continue
            if os.path.islink(os.path.join(d, x)):
                os.makedirs(os.path.join(dst, rel), exist_ok=True)
                os.symlink(os.readlink(os.path.join(d, x)), os.path.join(dst, xrel))
                continue
            keep.append(x)
        dirs[:] = keep
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for f in files:
            if f not in COPY_SKIP:
                shutil.copy2(os.path.join(d, f), os.path.join(dst, rel, f), follow_symlinks=False)
    if os.path.isdir(os.path.join(REPO, "node_modules")):
        os.symlink(os.path.join(REPO, "node_modules"), os.path.join(dst, "node_modules"))


# ---------------------------------------------------------------- X-tools (self-test)

def write_text(path, text, mode="w"):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, mode, encoding="utf-8", newline="") as f:
        f.write(text)


def to_crlf(path):
    with open(path, "rb") as f:
        data = f.read()
    with open(path, "wb") as f:
        f.write(data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n"))


GIT_ID = ["-c", "user.name=selftest", "-c", "user.email=selftest@example.invalid", "-c", "commit.gpgsign=false",
          "-c", "core.hooksPath=/dev/null", "-c", "init.defaultBranch=main", "-c", "core.autocrlf=false"]


def git_in(d, *args):
    r = subprocess.run(["git"] + GIT_ID + ["-C", d] + list(args), capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail("X-tools: git {} in {}: {}".format(" ".join(args), d, r.stderr.strip()[-300:]))
    return r.stdout


def git_repo(d):
    """The copy as a one-commit repo on main (the probes that need git history)."""
    git_in(d, "init", "-q")
    git_in(d, "add", "-A")
    git_in(d, "commit", "-q", "-m", "selftest base")


def pinned_claude(root=REPO):
    """The Claude Code binary the canary baseline's C8 counts were taken from, if installed."""
    try:
        with open(os.path.join(root, "plugin", "assets", "canary-baseline.json"), encoding="utf-8") as f:
            v = json.load(f)["c8"]["binary_version"]
    except (OSError, ValueError, KeyError, TypeError):
        return None, None
    b = os.path.join(os.path.expanduser("~"), ".local", "share", "claude", "versions", str(v))
    return v, (b if os.path.isfile(b) else None)


def probes(name):
    """(id, finding, argv relative to the copy or a callable(dir) -> (exit, stdout), plant(copy),
    [regex every stdout must hold], prep(copy) or None: run on the clean and the planted copy)."""
    gates_only = lambda g: ["tools/gates", "plugin", "--names", os.devnull, "--brand", name,
                            "--no-git-log", "--only", g]

    def crlf(d):
        to_crlf(os.path.join(d, "plugin", "bin", name + "-store"))
        to_crlf(os.path.join(d, "plugin", "hooks", "hooks.json"))

    def stray(d):
        for rel in ("plugin/assets/old-asset.txt", "plugin/hooks/lib/old.gen.ts",
                    "plugin/tests/unit/_gen/stray.gen.ts", "plugin/.claude-plugin/extra.json",
                    "plugin/notes.txt", "plugin/skills/handoff/.hidden"):
            write_text(os.path.join(d, rel), "stray\n")

    def other_names(d):
        write_text(os.path.join(d, "plugin", "README.md"),
                   "\nP5 cache at ~/.cache/compact-handoff-research and the compact-handoffs folder\n"
                   "P6 the compactseams and wheelover2 variants, and HOLD-THREADS\n", "a")

    def npm(d):
        write_text(os.path.join(d, "plugin", "package.json"), '{"dependencies":{"left-pad":"1.3.0"}}\n')
        write_text(os.path.join(d, "plugin", "node_modules", "left-pad", "index.js"), "module.exports = 1\n")
        write_text(os.path.join(d, "plugin", "helper", "package-lock.json"), "{}\n")

    def crlf_file(*rel):
        return lambda d: to_crlf(os.path.join(d, *rel))

    def canary_edit(d):
        p = os.path.join(d, "plugin", "assets", "canary-baseline.json")
        with open(p, encoding="utf-8", newline="") as f:
            doc = json.load(f)
        counts = doc["c8"]["counts"]
        k = sorted(counts)[0]
        counts[k] = counts[k] + 9
        write_text(p, json.dumps(doc, indent=2, sort_keys=True, ensure_ascii=False) + "\n")

    def long_desc(d):
        p = os.path.join(d, "plugin", "skills", "handoff", "SKILL.md")
        with open(p, encoding="utf-8", newline="") as f:
            t = f.read()
        desc = ("Writes a document that a fresh session can pick up from later, with the state, the "
                "decisions, the evidence and the next steps, kept outside the repo for the next run. "
                "Use on handoff.")
        t = re.sub(r"(?m)^description:.*$", "description: " + desc, t, count=1)
        write_text(p, t)

    def append(d, rel, text):
        write_text(os.path.join(d, *rel.split("/")), text, "a")

    def wait_text(d):
        append(d, "plugin/assets/subagent-instructions.txt",
               "Subagent: do a blocking read of the output, run sleep 30, then wait for the task notification.\n")
        append(d, "plugin/skills/handoff/SKILL.md", "\nWait in the foreground until the job ends.\n")

    def asset_grow(d):
        append(d, "plugin/assets/resume-context.txt", "x" * 600 + "\n")
        append(d, "plugin/assets/subagent-instructions.txt", "y" * 200 + "\n")

    def budget_drift(d):
        p = os.path.join(d, "plugin", "skills", "handoff", "SKILL.md")
        with open(p, encoding="utf-8", newline="") as f:
            t = f.read()
        t = re.sub(r"Step 2 ≤\d+", "Step 2 ≤13", t, count=1)
        write_text(p, t + "\n- `LINT` → one Edit per LINT line, then publish again.\n")
        p = os.path.join(d, "plugin", "assets", "handoff-spec.md")
        with open(p, encoding="utf-8", newline="") as f:
            t = f.read()
        m = re.search(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", t, re.S | re.M)
        spec = json.loads(m.group(1))
        spec.update({"call_cap": 30, "recipe_cap": 9})
        write_text(p, t[:m.start(1)] + json.dumps(spec, indent=2, ensure_ascii=False) + t[m.end(1):])

    def write_first(d):
        append(d, "plugin/skills/handoff/SKILL.md",
               "\nIf the turn ends with a question, write the handoff before your final message.\n")

    def self_heal(d):
        append(d, "plugin/skills/resume/SKILL.md", "\n" + "z" * 4000 + "\n")
        rows = ["| # | Finding (first matching row wins) | Status | Same session or successor | Other relation |",
                "|---|---|---|---|---|"] + ["| {} | f | s | a | b |".format(r) for r in ("1", "2a", "2b", "3", "4", "5", "6", "7")]
        append(d, "plugin/skills/resume/references/self-heal.md", "\n" + "\n".join(rows) + "\n")

    def resume_hard(d):
        append(d, "src/assets/resume-context.txt", "x" * 600 + "\n")

    def owners_prep(d):
        git_repo(d)
        git_in(d, "checkout", "-q", "-b", "wp/skills")

    def owners_move(d):
        git_in(d, "mv", "plugin/helper/lib/util.pm", "plugin/helper/lib/skills/moved_util.pm")
        git_in(d, "commit", "-q", "-m", "move a core file into skills")

    def drop_gitattributes(d):
        git_in(d, "rm", "-q", ".gitattributes")
        git_in(d, "commit", "-q", "-m", "no attributes")

    def autocrlf_clone(d):
        """Clone the copy with core.autocrlf=true (the Git for Windows default): the launcher,
        hooks.json and the helper entry must come out with LF and the launcher must run."""
        dst = d + "-autocrlf"
        if os.path.lexists(dst):
            shutil.rmtree(dst)
        r = subprocess.run(["git", "-c", "core.autocrlf=true", "clone", "-q", "--no-local", d, dst], capture_output=True, text=True)
        if r.returncode != 0:
            return 2, "clone failed: " + r.stderr[-300:]
        out, bad = [], 0
        for rel in ("plugin/bin/{}-store".format(name), "plugin/hooks/hooks.json", "plugin/helper/main.pl"):
            with open(os.path.join(dst, rel), "rb") as f:
                data = f.read()
            if b"\r\n" in data:
                out.append("eol {}: CRLF".format(rel))
                bad = 1
        launcher = os.path.join(dst, "plugin", "bin", name + "-store")
        try:
            code = subprocess.run([launcher], capture_output=True, text=True).returncode
        except OSError as e:    # `#!/bin/sh\r`: exec finds no such interpreter
            code = "exec: " + (e.strerror or str(e))
        if code in (126, 127) or not isinstance(code, int):
            out.append("eol {}: does not run ({})".format("plugin/bin/{}-store".format(name), code))
            bad = 1
        out.append("EOL CLONE: " + ("FAIL" if bad else "PASS"))
        return bad, "\n".join(out) + "\n"

    readme = r"plugin/README\.md:\d+: "
    v, pinned = pinned_claude()
    canary = ["tools/canary-baseline", "--check"] + (["--claude", pinned] if pinned else [])
    out = [
        ("crlf", "RN-4", ["tools/build", "--check"], crlf,
         [r"^differs plugin/bin/" + re.escape(name) + r"-store$", r"^differs plugin/hooks/hooks\.json$"], None),
        ("stray", "RN-5", ["tools/build", "--check"], stray,
         [r"^stale plugin/assets/old-asset\.txt$", r"^stale plugin/hooks/lib/old\.gen\.ts$",
          r"^stale plugin/tests/unit/_gen/stray\.gen\.ts$", r"^stale plugin/\.claude-plugin/extra\.json$",
          r"^stale plugin/notes\.txt$", r"^stale plugin/skills/handoff/\.hidden$"], None),
        ("other-names", "RN-3", gates_only("stale-name"), other_names,
         ["^GATE stale-name " + readme + n + "$" for n in ("compact-handoff", "compactseam", "wheelover", "hold-thread")], None),
        ("npm", "RN-6", gates_only("npm"), npm,
         [r"^GATE npm plugin/package\.json: BT-06", r"^GATE npm plugin/node_modules/: BT-06",
          r"^GATE npm plugin/helper/package-lock\.json: BT-06"], None),
        ("crlf-replies", "BH-5", ["tools/helper-replies-gen", "--check"],
         crlf_file("plugin", "tests", "unit", "_gen", "helper-replies.gen.ts"), [r"^HELPER REPLIES CHECK: FAIL"], None),
        ("crlf-goldens", "BH-5", ["tools/assemble", "--check"],
         lambda d: (crlf_file("plugin", "tests", "unit", "_gen", "goldens.gen.ts")(d),
                    crlf_file("tests", "fixtures", "assembly", "expected", "handoff-instructions__base.txt")(d)),
         [r"^differs plugin/tests/unit/_gen/goldens\.gen\.ts$",
          r"^differs tests/fixtures/assembly/expected/handoff-instructions__base\.txt$", r"^GOLDENS CHECK: FAIL"], None),
        ("skill-desc", "BH-3", gates_only("skill-desc"), long_desc,
         [r"^GATE skill-desc plugin/skills/handoff/SKILL\.md:\d+: BT-09: description \d+ chars > 150$",
          r"^GATE skill-desc plugin/skills/handoff/SKILL\.md:\d+: BT-09: trigger 'handoff' not in the first 50 chars$"], None),
        ("wait-text", "AT-W-01", gates_only("wait-text"), wait_text,
         [r"^GATE wait-text plugin/assets/subagent-instructions\.txt:\d+: AT-W-01 " + r for r in
          ("blocking-read", "bare-sleep", "notification-wait")]
         + [r"^GATE wait-text plugin/skills/handoff/SKILL\.md:\d+: AT-W-01 foreground-wait"], None),
        ("asset-bytes", "AT-W-02", gates_only("asset-bytes"), asset_grow,
         [r"^GATE asset-bytes plugin/assets/resume-context\.txt: AT-W-02 \d+ B > 2500$",
          r"^GATE asset-bytes plugin/assets/subagent-instructions\.txt: AT-W-02 \d+ B > 1100$"], None),
        ("skill-budget", "AT-SK-01", gates_only("skill-budget"), budget_drift,
         [r"^GATE skill-budget plugin/skills/handoff/SKILL\.md:\d+: AT-SK-01 " + r for r in
          ("budget-sum", "edit-per-lint", "call-cap", "recipe-cap")], None),
        ("write-first", "AT-SK-03", gates_only("write-first"), write_first,
         [r"^GATE write-first plugin/skills/handoff/SKILL\.md:\d+: AT-SK-03 before-final"], None),
        ("self-heal", "AT-J-13", gates_only("self-heal"), self_heal,
         [r"^GATE self-heal plugin/skills/resume/SKILL\.md: AT-J-13 size \d+ B > 20480$",
          r"^GATE self-heal plugin/skills/resume/references/self-heal\.md:\d+: AT-J-13 table-rows"], None),
        ("resume-hard", "DP-8", ["tools/assemble"], resume_hard,
         [r"^resume protocol .* OVER$", r"^RESULT: FAIL$"], None),
        ("owners-move", "BH-1", ["tools/owners-check", "skills", "main"], owners_move,
         [r"^NOT OWNED plugin/helper/lib/util\.pm  \(owner: core", r"^OWNERS: FAIL"], owners_prep),
        ("autocrlf", "BH-2", autocrlf_clone, drop_gitattributes,
         [r"^eol plugin/bin/" + re.escape(name) + r"-store: CRLF$", r"^EOL CLONE: FAIL$"], git_repo),
    ]
    if pinned:
        out += [
            ("crlf-canary", "BH-5", canary, crlf_file("plugin", "assets", "canary-baseline.json"),
             [r"differs from a fresh render"], None),
            ("canary-edit", "BH-4", ["tools/check", "xgen"], canary_edit,
             [r"differs from a fresh render", r"^CHECK xgen: FAIL at X-gen"], None),
        ]
    else:
        print("X-tools: the canary probes are skipped: Claude Code {} (the baseline's C8 binary) is not "
              "installed".format(v))
    return out


def probe_run(argv, d):
    if callable(argv):
        return argv(d)
    r = subprocess.run([os.path.join(d, argv[0])] + argv[1:], cwd=d, capture_output=True, text=True)
    return r.returncode, r.stdout + r.stderr


def x_tools():
    name = brand()["name"]
    if os.path.lexists(SELFTEST_DIR):
        shutil.rmtree(SELFTEST_DIR)
    clean = os.path.join(SELFTEST_DIR, "clean")
    copy_tree(clean)
    failures = []
    plist = probes(name)
    for pid, finding, argv, plant, want, prep in plist:
        shown = argv.__name__ if callable(argv) else " ".join(argv)
        base = clean
        if prep:
            base = os.path.join(SELFTEST_DIR, pid + "-clean")
            shutil.copytree(clean, base, symlinks=True)
            prep(base)
        code, out = probe_run(argv, base)
        if code != 0:
            failures.append("{} ({}): `{}` fails on the unplanted copy:\n{}".format(pid, finding, shown, out[-1500:]))
            continue
        d = os.path.join(SELFTEST_DIR, pid)
        shutil.copytree(clean, d, symlinks=True)
        if prep:
            prep(d)
        plant(d)
        code, out = probe_run(argv, d)
        lines = out.splitlines()
        missing = [w for w in want if not any(re.search(w, ln) for ln in lines)]
        if code != 1 or missing:
            failures.append("{} ({}): `{}` exit {}; not reported: {}\n{}".format(
                pid, finding, shown, code, missing, out[-1500:]))
        else:
            print("X-tools {} ({}): {} planted faults reported".format(pid, finding, len(want)))
    if failures:
        for f in failures:
            print("X-tools FAIL " + f)
        raise Fail("X-tools: {} of {} probes not caught".format(len(failures), len(plist)))
    shutil.rmtree(SELFTEST_DIR)
    print("X-tools: PASS ({} probes)".format(len(plist)))


# ---------------------------------------------------------------- X-gen

def canary_check(root=REPO):
    """canary-baseline --check pinned to the binary the file records (BH-4). When that binary is
    gone, render with the newest one to a temp file and compare all but the C8 part."""
    tool = os.path.join(root, "tools", "canary-baseline")
    if not os.path.exists(tool):
        return
    v, pinned = pinned_claude(root)
    if pinned:
        run([tool, "--check", "--claude", pinned], "X-gen canary-baseline", cwd=root)
        return
    tmp = os.path.join(root, "tmp", "canary-render.json")
    os.makedirs(os.path.dirname(tmp), exist_ok=True)
    run([tool, "--out", tmp], "X-gen canary-baseline render", cwd=root, capture=True)
    with open(os.path.join(root, "plugin", "assets", "canary-baseline.json"), encoding="utf-8") as f:
        cur = json.load(f)
    with open(tmp, encoding="utf-8") as f:
        fresh = json.load(f)
    os.unlink(tmp)
    strip = lambda doc: {k: x for k, x in doc.items() if k not in ("c8", "cc_version")}
    if strip(cur) != strip(fresh):
        raise Fail("X-gen: canary-baseline.json differs from a fresh render (C8 not compared: Claude Code {} "
                   "is not installed)".format(v))
    print("canary-baseline: current except C8 (Claude Code {} not installed)".format(v))


def x_gen(phase, root=REPO):
    tools = os.path.join(root, "tools")
    run([os.path.join(tools, "build"), "--check"], "X-gen build", cwd=root)
    if os.path.exists(os.path.join(tools, "fixtures-gen")):
        run([os.path.join(tools, "fixtures-gen"), "--check"], "X-gen fixtures", cwd=root)
    elif phase == "integration":
        raise Fail("X-gen: tools/fixtures-gen missing")
    else:
        print("X-gen: tools/fixtures-gen not present yet (WP-fix); build part only")
    if os.path.exists(os.path.join(tools, "helper-replies-gen")):
        run([os.path.join(tools, "helper-replies-gen"), "--check"], "X-gen helper replies", cwd=root)
    canary_check(root)
    run([os.path.join(tools, "assemble"), "--check"], "X-gen goldens", cwd=root, capture=True)


# ---------------------------------------------------------------- BT-02 (rename drill)

def old_name_left(root, old):
    """Lines in the renamed copy's shipped files that still hold the old name (substring)."""
    targets = [os.path.join(root, "README.md"), os.path.join(root, ".claude-plugin", "marketplace.json")]
    for d, dirs, files in os.walk(os.path.join(root, "plugin")):
        dirs[:] = sorted(x for x in dirs if x not in ("node_modules", ".git") and
                         not (x == "types" and os.path.basename(d) == ".claude-plugin"))
        targets += [os.path.join(d, f) for f in sorted(files)]
    left = []
    for p in targets:
        if not os.path.isfile(p):
            continue
        with open(p, "rb") as f:
            data = f.read()
        if b"\0" in data[:8192]:
            continue
        for no, line in enumerate(data.decode("utf-8", errors="replace").splitlines(), 1):
            if old in line:
                left.append("{}:{}".format(os.path.relpath(p, root), no))
    return left


def bt02(phase, names):
    old = brand()["name"]
    if old in DRILL_NAME:
        raise Fail("BT-02: the drill name {} contains the brand {}".format(DRILL_NAME, old))
    before = tree_state()
    copy_tree(DRILL_DIR)
    b = brand(DRILL_DIR)
    if b["marketplace"] == b["name"]:
        b["marketplace"] = DRILL_NAME
    b["name"] = DRILL_NAME
    write_text(os.path.join(DRILL_DIR, "brand.json"), json.dumps(b, indent=2, ensure_ascii=False) + "\n")
    for step in RENAME_STEPS:
        run([os.path.join(DRILL_DIR, *step[:2])] + step[2:], "BT-02 " + " ".join(step), cwd=DRILL_DIR)
    inner = [os.path.join(DRILL_DIR, "tools", "check"), phase, "--no-drill"] + (["--names", names] if names else [])
    run(inner, "BT-02 tools/check {} under {}".format(phase, DRILL_NAME), cwd=DRILL_DIR)
    left = old_name_left(DRILL_DIR, old)
    if left:
        raise Fail("BT-02: the old name {} is left in {} lines of the renamed copy: {}".format(
            old, len(left), ", ".join(left[:12])))
    if os.path.exists(os.path.join(DRILL_DIR, "plugin", "bin", old + "-store")):
        raise Fail("BT-02: the old launcher survived in the renamed copy")
    run([os.path.join(REPO, "tools", "build"), "--check"], "BT-02 committed tree")
    if tree_state() != before:
        raise Fail("BT-02: the drill changed the working tree")
    shutil.rmtree(DRILL_DIR)
    print("BT-02: PASS (renamed to {} by the §4.6 steps; tools/check {} passed in the copy; "
          "no {} left; committed tree unchanged)".format(DRILL_NAME, phase, old))


# ---------------------------------------------------------------- X-H

# Helper cases accepted as failing until a named later merge, each with the regex its first
# failure line must match (any other failure, or another first failure, fails X-H). Remove a
# row when it prints KNOWN-RED-DONE.
KNOWN_RED = {
    # wp/text part 1 made time_re a full stamp, so `checked 14:05` no longer trips
    # unprinted-time; WP-skills' time-format rule (RV-24, AT-TS-02) closes it (round 3).
    "HT-PB-01": r"stdout lacks /\^LINT unprinted-time /",
    "HT-PB-04": r"stdout lacks /\^LINT unprinted-time /",
}


def x_h(argv):
    """X-H: the helper runner, with the KNOWN_RED cases allowed to fail as stated."""
    print("$ " + " ".join(argv), flush=True)
    r = subprocess.run(argv, cwd=REPO, capture_output=True, text=True)
    out = r.stdout + r.stderr
    sys.stdout.write(out[-4000:])
    failed, first, cur = [], {}, None
    for line in out.splitlines():
        m = re.match(r"^(not )?ok \d+ - (.*)$", line)
        if m:
            cur = m.group(2).strip() if m.group(1) else None
            if cur:
                failed.append(cur)
            continue
        if cur and cur not in first and line.startswith("#   "):
            first[cur] = line
    if r.returncode == 0:
        for case in sorted(KNOWN_RED):
            print("KNOWN-RED-DONE {}: passes now; remove it from KNOWN_RED".format(case))
        return
    bad = [c for c in failed if c not in KNOWN_RED or not re.search(KNOWN_RED[c], first.get(c, ""))]
    if bad or not failed:
        raise Fail("X-H: exit {}; failed beyond KNOWN_RED: {}".format(r.returncode, ", ".join(bad) or "(none parsed)"))
    for case in sorted(KNOWN_RED):
        if case in failed:
            print("KNOWN-RED {}: {}".format(case, first[case].strip()[:160]))
        else:
            print("KNOWN-RED-DONE {}: passes now; remove it from KNOWN_RED".format(case))
    print("X-H: PASS except KNOWN_RED ({} cases)".format(len(failed)))


def main(argv):
    if not argv or argv[0] not in ("phase0", "integration", "selftest", "xgen"):
        sys.exit(__doc__)
    phase = argv[0]
    names = os.environ.get("GATE_NAMES_FILE")
    if "--names" in argv:
        names = argv[argv.index("--names") + 1]
    drill = "--no-drill" not in argv
    steps = []
    if phase == "selftest":
        try:
            steps.append("X-tools")
            x_tools()
        except Fail as e:
            print("CHECK selftest: FAIL at X-tools ({})".format(e))
            return 1
        print("CHECK selftest: PASS (X-tools)")
        return 0
    if phase == "xgen":
        try:
            steps.append("X-gen")
            x_gen("integration")
        except Fail as e:
            print("CHECK xgen: FAIL at X-gen ({})".format(e))
            return 1
        print("CHECK xgen: PASS (X-gen)")
        return 0
    b = brand()
    name = b["name"]
    skills_required = ["handoff", "resume"] if phase == "phase0" else SKILLS_ALL
    plugin = os.path.join(REPO, "plugin")
    tools = os.path.join(REPO, "tools")
    try:
        steps.append("X-validate")
        x_validate(plugin, REPO, name, skills_required)
        steps.append("X-test")
        run(["claude", "plugin", "test", plugin], "X-test")
        steps.append("X-types")
        run([os.path.join(tools, "typecheck")], "X-types")
        steps.append("X-gen")
        x_gen(phase)
        steps.append("X-assemble")
        x_assemble(name)
        steps.append("X-gates")
        gates(["plugin"], names, name)
        gates(["README.md"], names, name)
        steps.append("X-name")
        gates(["plugin", "README.md"], names, name, only="stale-name")
        if phase == "integration":
            steps.append("X-H")
            runners = [f for f in os.listdir(os.path.join(REPO, "tests", "helper"))
                       if f.startswith("run.")] if os.path.isdir(os.path.join(REPO, "tests", "helper")) else []
            if not runners:
                raise Fail("X-H: no tests/helper/run.* yet")
            cases = os.path.join(REPO, "tests", "helper", "cases")
            x_h([os.path.join(REPO, "tests", "helper", runners[0]), cases])
            # WP-watch's cases are case.pl files run in-process by their own driver, which
            # the case.json runner does not read (escalated); X-H runs that driver as well.
            for drv in WATCH_DRIVERS:
                p = os.path.join(REPO, drv)
                if os.path.exists(p):
                    run(["/usr/bin/perl", p], "X-H " + drv)
        if drill:
            steps.append("X-tools")
            x_tools()
            steps.append("BT-02")
            bt02(phase, names)
    except Fail as e:
        print("CHECK {}: FAIL at {} ({})".format(phase, steps[-1], e))
        return 1
    print("CHECK {}: PASS ({})".format(phase, ", ".join(steps)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
