{
 "id": "AT-DH-23-trial-save",
 "note": "a skip record is content-free; both replies are secret-scanned and redacted before disk (rule ids only in the record), saved 0600 under the trial folder with the slug from the frame line, the native body sha by the engine's rule; nothing under the handoff root; unknown moment fields dropped; a bad slug -> handoff; REUSE of this bucket's old shadow -> reuse, REUSE of any other path -> bad-reuse; a config that is off writes nothing; not the owner's config -> no shadow",
 "now": "2026-10-27T10:00:00+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "skip record",
   "setup": [
    {
     "mkdir": "$TMP/work"
    },
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-save",
    "--sid",
    "$SID"
   ],
   "stdin_json": {
    "kind": "skip",
    "moment_id": "$SID8-0000aaaa",
    "moment": {
     "kind": "m3-idle",
     "status": "skipped:cold",
     "reply": "NOT-A-FIELD"
    }
   },
   "expect": {
    "exit": 0,
    "json": {
     "written": true
    },
    "files": [
     {
      "path": "$HOME/.cache/$BRAND-trial/moments/2026-10/$SID8-0000aaaa.json",
      "mode": "0600",
      "json": {
       "v": 1,
       "moment_id": "$SID8-0000aaaa",
       "kind": "m3-idle",
       "status": "skipped:cold",
       "session_id": "$SID"
      },
      "keys_absent": [
       "reply"
      ]
     }
    ]
   }
  },
