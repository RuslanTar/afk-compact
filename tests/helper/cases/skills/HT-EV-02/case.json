     {
      "path": "$ROOT/repo/LAB-7/evidence/$STEM/0002-*",
      "count": 0
     },
     {
      "path": "$ROOT/repo/LAB-7/evidence/$STEM/0003-*",
      "count": 0
     },
     {
      "path": "$ROOT/repo/LAB-7/evidence/$STEM/uncommitted*",
      "count": 0
     },
     {
      "path": "$STAGE/evidence.jsonl",
      "has": [
       "\"label\":\"partial \\(1 withheld\\)\"",
       "\"meaning\":\"partial patch: 1 path\\(s\\) left out\"",
       "\"origin\":\"[^\"]+/clone#[0-9a-f]{8}:app\\.sqlite\""
      ]
     }
