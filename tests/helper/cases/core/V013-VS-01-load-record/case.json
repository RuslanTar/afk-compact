{
 "id": "V013-VS-01-load-record",
 "note": "0.1.3 version skew (lib/plugver.pm): SessionStart writes one load record per Claude Code process and plugin version, <root>/.sessions/loads/<load epoch>_<pid>-<lstart epoch>_<version>.json {v, plugin_version, plugin_root, host, session_id, source, ts}, the first time that process starts a session under this copy. A /clear or a compaction in the same process keeps its copy and adds none; another process adds its own. The session row carries plugin_version in its envelope, as every row does.",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "manifest": {"version": "0.1.3"},
 "steps": [
  {"name": "startup: one record, the session row names the version",
   "argv": ["hook", "SessionStart"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP/work", "hook_event_name": "SessionStart", "source": "startup"},
   "expect": {"exit": 0, "stdout": "",
    "files": [{"path": "$ROOT/.sessions/loads/1792580712_424242-1792562400_0.1.3.json", "mode": "0600",
               "json": {"v": 1, "plugin_version": "0.1.3", "host": "$HOST", "session_id": "$SID", "source": "startup", "ts": "2026-10-21T14:05:12+03:00"},
               "has": ["\"plugin_root\": ?\"/[^\"]+\""]},
              {"path": "$ROOT/.sessions/loads/*", "count": 1}],
    "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "session", "count": 1, "fields": {"phase": "start", "source": "startup", "plugin_version": "0.1.3"}}]}},
  {"name": "/clear in the same process: no second record",
   "now": "2026-10-21T14:06:00+03:00",
   "argv": ["hook", "SessionStart"],
   "stdin_json": {"session_id": "77777777-1111-4222-8333-444444444444", "transcript_path": "$TMP/proj/x.jsonl", "cwd": "$TMP/work", "hook_event_name": "SessionStart", "source": "clear"},
   "expect": {"exit": 0, "files": [{"path": "$ROOT/.sessions/loads/*", "count": 1}]}},
  {"name": "a compaction in the same process: none",
   "now": "2026-10-21T14:07:00+03:00",
   "argv": ["hook", "SessionStart"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP/work", "hook_event_name": "SessionStart", "source": "compact"},
   "expect": {"exit": 0, "files": [{"path": "$ROOT/.sessions/loads/*", "count": 1}]}},
  {"name": "another process: its own record",
   "now": "2026-10-21T14:08:00+03:00",
   "env": {"STORE_TEST_CLAUDE_PID": "515151:Tue Oct 21 14:07:50 2026"},
   "argv": ["hook", "SessionStart"],
   "stdin_json": {"session_id": "88888888-1111-4222-8333-444444444444", "transcript_path": "$TMP/proj/y.jsonl", "cwd": "$TMP/work", "hook_event_name": "SessionStart", "source": "resume"},
   "expect": {"exit": 0, "files": [{"path": "$ROOT/.sessions/loads/1792580880_515151-1792580870_0.1.3.json", "json": {"source": "resume", "session_id": "88888888-1111-4222-8333-444444444444"}},
                                   {"path": "$ROOT/.sessions/loads/*", "count": 2}]}}
 ]
}
