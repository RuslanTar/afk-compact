{
 "id": "AT-RS-14 (helper part), AT-RS-22, AT-RS-41, AT-RS-42 (SESSION-RESTART §2.1-§2.3, B7, R5)",
 "note": "The background route. The gate: the job folder's state.json must name this session (job-unknown); respawnFlags with --dangerously-skip-permissions or --permission-mode bypassPermissions (the = form too) while the fresh mode is not bypass refuse bypass-left, --allow-dangerously-skip-permissions alone passes; a background task or a session cron in the newest Stop slot refuses background-work (with the task types) or crons. respawn sets the carry note sent and starts `claude respawn <short>` detached: the stub claude finds itself in its own process group under a parent that is no child of the helper, with stdin from /dev/null and no CLAUDE_JOB_DIR, CLAUDE_BG_* or $st name in its env; the result file holds rc and the B6 code from its output, the output file is 0600, and a non-zero rc writes one refresh_failed {why: respawn-failed, code} row. respawn-cancel with another nonce kills nothing. A minute later ident reports the after-kill failure once (the note becomes reported), and status prints the claude respawn and claude attach line",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "options": {"restart_on_update": "on"},
 "steps": [
  {"setup": [
    {"write": "$TMP/jobs/job1/state.json", "json": {"state": "running", "sessionId": "$SID", "respawnFlags": ["--model", "opus", "--dangerously-skip-permissions", "--permission-mode", "default"]}},
    {"write": "$TMP/proj/$SID.jsonl", "content": "{\"type\":\"user\"}\n"},
    {"write": "$HOME/.claude.json", "json": {}},
    {"stub": "claude", "script": "{ echo \"argv=$*\"; env | grep -E '^(CLAUDE_JOB_DIR|CLAUDE_BG_|CLAUDE_CODE_SESSION_KIND|CLAUDE_CODE_RESUME_)' ; echo \"self=$$ parent=$PPID\"; ps -o pgid= -p $$ | tr -d ' ' | sed 's/^/pgid=/'; ps -o ppid= -p $PPID | tr -d ' ' | sed 's/^/grandparent=/'; if [ -t 0 ]; then echo stdin=tty; else echo stdin=not-tty; fi; } > \"$STUB_OUT\"; echo 'Error: job_respawn_spawn_failed (cwd_gone)'; exit 1"}
  ]},
  {"name": "(a main Stop with nothing in the background)", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "default", "background_tasks": [], "session_crons": []},
   "expect": {"exit": 0}},
  {"name": "(the main PostCompact)", "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto", "permission_mode": "default", "compact_summary": "x"},
   "expect": {"exit": 0}},
  {"name": "a launch bypass left in respawnFlags while the mode is default: bypass-left", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": false, "why": "bypass-left", "job_short": "job1"}}},
  {"setup": [{"write": "$TMP/jobs/job1/state.json", "json": {"sessionId": "$SID", "respawnFlags": ["--permission-mode=bypassPermissions"]}}]},
  {"name": "the = form too", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "bypass-left"}}},
  {"setup": [{"write": "$TMP/jobs/job1/state.json", "json": {"sessionId": "$SID", "respawnFlags": ["--allow-dangerously-skip-permissions", "--permission-mode", "default"]}}]},
  {"name": "availability alone is carried: ok", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": true, "route": "bg", "job_short": "job1", "mode": "default"}}},
  {"name": "another session's job: job-unknown", "argv": ["restart", "gate", "--sid", "11111111-2222-4333-8444-000000000000", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "job-unknown"}}},
  {"name": "no job folder: job-unknown", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "job-unknown"}}},
  {"name": "(a Stop with a shell and a monitor in flight)", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "default",
                  "background_tasks": [{"id": "b1", "type": "shell", "status": "running", "description": "x"}, {"id": "m1", "type": "monitor", "status": "running", "description": "y"}], "session_crons": []},
   "expect": {"exit": 0}},
  {"name": "background-work with the types", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "background-work", "types": ["monitor", "shell"]}}},
  {"name": "(a Stop with a session cron only)", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "default",
                  "background_tasks": [], "session_crons": [{"id": "c1"}]},
   "expect": {"exit": 0}},
  {"name": "crons", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "crons"}}},
  {"name": "arm the background route: the carry note only", "argv": ["restart", "arm", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--nonce", "aabbccddeeff0011", "--from", "2.1.311", "--to", "2.1.312", "--continue", "1", "--mode", "default", "--now-ms", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": true}, "files": [{"path": "$WATCH/$SID/restart.json", "json": {"route": "bg", "state": "armed", "job_short": "job1"}, "has": ["\"launch_token\":null"]}]}},
  {"name": "respawn: detached, the env cleaned, the result and one row", "argv": ["restart", "respawn", "--sid", "$SID", "--short", "job1", "--nonce", "aabbccddeeff0011", "--to", "2.1.312", "--wait-ms", "8000"],
   "path_prepend": ["$TMP/bin"],
   "env": {"STUB_OUT": "$TMP/stub.out", "CLAUDE_JOB_DIR": "$TMP/jobs/job1", "CLAUDE_BG_BACKEND": "daemon", "CLAUDE_BG_X": "1", "CLAUDE_CODE_SESSION_KIND": "bg", "CLAUDE_CODE_RESUME_PROMPT": "p"},
   "expect": {"exit": 0, "json": {"ok": true, "pid": {"re": "^[0-9]+$"}},
              "files": [{"path": "$WATCH/$SID/restart.json", "json": {"state": "sent"}},
                        {"path": "$WATCH/$SID/restart-respawn.json", "mode": "0600", "json": {"nonce": "aabbccddeeff0011", "rc": 1, "code": "cwd_gone"}},
                        {"path": "$WATCH/$SID/restart-respawn.out", "mode": "0600", "has": ["cwd_gone"]},
                        {"path": "$TMP/stub.out", "has": ["^argv=respawn job1$", "^stdin=not-tty$", "parent=([0-9]+)\\npgid=\\1$"], "lacks": ["CLAUDE_JOB_DIR", "CLAUDE_BG_", "CLAUDE_CODE_SESSION_KIND", "CLAUDE_CODE_RESUME_"]}],
              "rows": [{"file": "$WATCH/$SID.jsonl", "ev": "refresh_failed", "count": 1, "fields": {"route": "bg", "why": "respawn-failed", "code": "cwd_gone", "to": "2.1.312"}}]}},
  {"name": "respawn-cancel with another nonce kills nothing", "argv": ["restart", "respawn-cancel", "--sid", "$SID", "--nonce", "0000000000000000"],
   "expect": {"exit": 0, "json": {"ok": true, "killed": false}}},
  {"name": "a minute later ident reports the failure once, the note reported", "argv": ["ident", "--sid", "$SID"], "now": "2026-10-21T14:06:30+03:00",
   "expect": {"exit": 0, "json": {"restart_reports": {"len": 1}, "restart_reports.0.short": "job1", "restart_reports.0.code": "cwd_gone", "restart_reports.0.to": "2.1.312"},
              "files": [{"path": "$WATCH/$SID/restart.json", "json": {"state": "reported"}}]}},
  {"name": "and not twice", "argv": ["ident", "--sid", "$SID"], "now": "2026-10-21T14:06:40+03:00",
   "expect": {"exit": 0, "json": {"restart_reports": {"len": 0}}}},
  {"name": "status prints how to start it again", "argv": ["status", "--sid", "$SID"], "now": "2026-10-21T14:06:40+03:00",
   "expect": {"exit": 0, "stdout_has": ["^  restart of background session job1 failed \\(cwd_gone, \\d\\d:\\d\\d\\)\\. Start it again with: claude respawn job1   or look at it with: claude attach job1$"]}}
 ]
}
