{
 "id": "CW-1 (begin and locate without a session id)",
 "tmp_base": "repo",
 "layer": "H",
 "owner": "skills",
 "note": "Cowork check 2026-10-26, finding CW-1 (review): the handoff skill sends begin, and the resume skill sends locate, a --sid that may be empty, missing or the unsubstituted ${CLAUDE_SESSION_ID}. begin and locate take all three as unset (lib/skills/util.pm unset_value) and resolve the id from this process's per-process record. Without a record (pid 2 has none; these steps run first): begin uses an anon- id with identity `degraded (no-session-id)`; locate calls no file same-session or successor and picks none; neither writes the record session's pin or session folder. With the record (pid 1): the record's id, not degraded, and locate picks this session's own handoff (tier 3, same-session)",
 "now": "2026-10-26T02:30:00+02:00",
 "tz": "Etc/GMT-2",
 "env": {
  "STORE_TEST_CLAUDE_PID": "1:$LSTART1"
 },
 "steps": [
  {"name": "a repo, pid 1's record naming $SID and $SID's own handoff",
   "setup": [
    {"repo": {"branch": "feature/retry", "commits": [{"files": {"app/retry.rb": "x = 1\n"}, "msg": "seed"}]}, "at": "$TMP/repo"},
    {"write": "$ROOT/.sessions/by-pid/1-1792580000.live-11111111.json",
     "content": "{\"pid\":1,\"pid_lstart\":\"$LSTART1\",\"session_id\":\"$SID\",\"cwd\":\"$TMP/repo\",\"worktree\":\"$TMP/repo\",\"source\":\"startup\",\"ts\":\"2026-10-26T01:00:00+02:00\"}"},
    {"write": "$ROOT/repo/retry/2026-10-26_01-30-00_11111111_own.md",
     "content": "---\nkind: handoff\nwriter: handoff\nnonce: 0a0b0c0d\ndate: 2026-10-26T01:30:00+02:00\nsession_id: $SID\nactor: main\n---\n⟪$BRAND v1 n=0a0b0c0d s=manual⟫\n# retry — work\n⟪/$BRAND n=0a0b0c0d⟫\n"}
   ]},
  {"name": "begin, empty --sid, no record: an anon- id, degraded (no-session-id), nothing of $SID written",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--sid", "", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "begin, no --sid, no record: an anon- id, degraded",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "locate, empty --sid, no record: nothing same-session or successor, no pick, nothing of $SID written",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--sid", "", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "locate, no --sid, no record: the same",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "locate, unsubstituted ${CLAUDE_SESSION_ID}, no record: the same",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--sid", "${CLAUDE_SESSION_ID}", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$", "CLAUDE_SESSION_ID"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "begin, empty --sid, with the record: the record's id, not degraded",
   "cwd": "$TMP/repo",
   "argv": ["begin", "--sid", "", "--topic", "retry"],
   "expect": {"exit": 0, "json": {"session.id": "$SID", "session.identity": {"null": 1}}}},
  {"name": "begin, no --sid, with the record: the same",
   "cwd": "$TMP/repo",
   "argv": ["begin", "--topic", "retry"],
   "expect": {"exit": 0, "json": {"session.id": "$SID", "session.identity": {"null": 1}}}},
  {"name": "locate, empty --sid, with the record: this session's own handoff (tier 3, same-session)",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--sid", "", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"]}},
  {"name": "locate, no --sid, with the record: the same",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"]}},
  {"name": "locate, unsubstituted ${CLAUDE_SESSION_ID}, with the record: the same",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--sid", "${CLAUDE_SESSION_ID}", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"],
    "stdout_lacks": ["CLAUDE_SESSION_ID"]}}
 ]
}
