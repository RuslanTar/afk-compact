  "secret_rules": [
    {
      "id": "pem",
      "class": "HARD",
      "re": "-----BEGIN ([A-Z0-9 ]+)-----(?:(?:(?!-----BEGIN )[\\s\\S])*?-----END \\1-----|(?:(?:\\r?\\n|(?:\\\\r)?\\\\n)[ \\t]*(?:[A-Za-z0-9+/=]+|(?:Proc-Type|DEK-Info|Version|Comment|Hash|Charset): [^\\r\\n\\\\\"]*)?(?=[\\r\\n\\\\\"']|$))*)"
    },
    {
      "id": "aws-key-id",
      "class": "HARD",
      "re": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "github-token",
      "class": "HARD",
      "re": "\\bgh[pousr]_[A-Za-z0-9]{36,}"
    },
    {
      "id": "github-pat",
      "class": "HARD",
      "re": "\\bgithub_pat_[A-Za-z0-9_]{50,}"
    },
    {
      "id": "gitlab-token",
      "class": "HARD",
      "re": "\\bglpat-[A-Za-z0-9_-]{20,}"
    },
    {
      "id": "slack-token",
      "class": "HARD",
      "re": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
    },
    {
      "id": "anthropic-key",
      "class": "HARD",
      "re": "\\bsk-ant-[A-Za-z0-9_-]{20,}"
    },
    {
      "id": "openai-key",
      "class": "HARD",
      "re": "\\bsk-(proj-)?[A-Za-z0-9]{20,}"
    },
    {
      "id": "google-api-key",
      "class": "HARD",
      "re": "\\bAIza[0-9A-Za-z_-]{35}"
    },
    {
      "id": "stripe-key",
      "class": "HARD",
      "re": "\\b[rs]k_live_[A-Za-z0-9]{20,}"
    },
    {
      "id": "npm-token",
      "class": "HARD",
      "re": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "jwt",
      "class": "HARD",
      "re": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    },
    {
      "id": "auth-header",
      "class": "HARD",
      "re": "\\b([Bb]earer|[Bb]asic)[ \\t]+[A-Za-z0-9._~+/-]{16,}=*"
    },
    {
      "id": "url-userinfo",
      "class": "HARD",
      "re": "\\b[A-Za-z][A-Za-z0-9+.-]*://[^/\\s:@]*:[^/\\s@]+@[^/\\s]+"
    },
    {
      "id": "key-value",
      "class": "WARN",
      "re": "([Pp][Aa][Ss][Ss]([Ww][Oo][Rr][Dd]|[Ww][Dd])?|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy])[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"',;]{6,}"
    },
    {
      "id": "cloud-key-bare",
      "class": "WARN",
      "re": "(^|[^A-Za-z0-9/+])(?=[A-Za-z0-9/+]{0,39}[A-Z])(?=[A-Za-z0-9/+]{0,39}[a-z])(?=[A-Za-z0-9/+]{0,39}[0-9])[A-Za-z0-9/+]{40}($|[^A-Za-z0-9/+=])"
    },
    {
      "id": "high-entropy",
      "class": "WARN",
      "re": "(^|[^A-Za-z0-9+/])(?=[A-Za-z0-9+/]{0,200}[0-9])(?=[A-Za-z0-9+/]{0,200}[A-Z])(?=[A-Za-z0-9+/]{0,200}[a-z])[A-Za-z0-9+/]{32,}={0,2}",
      "min_entropy": 4.0
    },
    {
      "id": "cookie",
      "class": "WARN",
      "re": "([Ss]et-)?[Cc]ookie\\\\?[\"']?[ \\t]*:[ \\t]*(\\\\?[\"'\\[][ \\t]*)*([^=\\s;\"'\\\\]+=\\\\?\"?[^;\\s\"'\\\\]*(\\\\?\")?;[ \\t]*)*[^=\\s;\"'\\\\]+=\\\\?\"?[^;\\s\"'\\\\]{8,}((\\\\?\")?;[ \\t]*[^=\\s;\"'\\\\]+=\\\\?\"?[^;\\s\"'\\\\]*)*"
    }
  ],
  "deny_names": {
    "globs": [
      ".env*",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "id_rsa*",
      "id_dsa*",
      "id_ecdsa*",
      "id_ed25519*",
      ".netrc",
      ".npmrc",
      ".claude.json",
      ".credentials.json",
      ".bash_history",
      ".zsh_history",
      ".sh_history",
      "fish_history",
      "history.jsonl",
      "*.har",
      "*.sqlite",
      "*.sqlite3",
      "*.heapsnapshot"
    ],
    "except_globs": [
      ".env.example",
      ".env.sample",
      ".env.template",
      ".env.dist",
      ".env.*.example",
      ".env.*.sample",
      ".env.*.template",
      ".env.*.dist"
    ]
  },
  "log_like_globs": [
    "*.log",
    "*.json",
    "*.jsonl",
    "*.ndjson",
    "*.output"
  ],
  "clutter_classes": [
    {
      "id": "abs-path-line",
      "re": "^[ \\t]*([-*][ \\t]+)?(/|~/)[^ \\t]+[ \\t]*$"
    },
    {
      "id": "code-block",
      "re": "^[ \\t]*(```|~~~)",
      "max_lines": 5
    },
    {
      "id": "log-line",
      "re": "^[ \\t]*(\\[?[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}|\\[?(TRACE|DEBUG|INFO|WARN|WARNING|ERROR|FATAL|CRITICAL)\\]?[ :])"
    },
    {
      "id": "stack-line",
      "re": "^([ \\t]+at [^ ]+.*[(:][0-9]+|[ \\t]*File \"[^\"]+\", line [0-9]+|Traceback \\(most recent call last\\)|[ \\t]*(from )?[^ \\t]+\\.[a-z]+:[0-9]+:in )"
    },
    {
      "id": "arithmetic-line",
      "re": "^[ \\t]*([-*][ \\t]+)?[0-9][0-9.,_]*([ \\t]*[-+*/×x÷][ \\t]*[0-9][0-9.,_]*)+[ \\t]*=[ \\t]*[-+]?[0-9]"
    },
    {
      "id": "hash-run",
      "re": "^[ \\t]*([-*][ \\t]+)?`?[0-9a-f]{7,64}`?([ \\t]|$)",
      "min_run": 4
    },
    {
      "id": "tmp-path",
      "re": "(^|[\\s'\"(=:`])(/tmp/|/private/tmp/|/var/folders/|/private/var/folders/|\\$TMPDIR/|\\$\\{TMPDIR\\}/|[^\\s'\"`]*/scratchpad/|[^\\s'\"`]*/tasks/[^/\\s'\"`]+\\.output)"
    }
  ],
  "outward_classes": [
    {
      "id": "env-write",
      "re": "\\b(gh|glab)[ \\t]+(secret|variable)[ \\t]+(set|delete|remove)\\b|\\bheroku[ \\t]+config:(set|unset)\\b|\\bvercel[ \\t]+env[ \\t]+(add|rm)\\b|\\bfly(ctl)?[ \\t]+secrets[ \\t]+(set|unset|import)\\b|\\bkubectl[ \\t]+(create|delete)[ \\t]+(secret|configmap)\\b|\\baws[ \\t]+(ssm[ \\t]+(put|delete)-parameter|secretsmanager[ \\t]+(create|put|update|delete)-secret(-value)?)\\b"
    },
    {
      "id": "infra-write",
      "re": "\\b(terraform|tofu)[ \\t]+(apply|destroy|import|state[ \\t]+(rm|mv|push))\\b|\\bpulumi[ \\t]+(up|destroy)\\b|\\bkubectl[ \\t]+(apply|create|delete|patch|replace|scale|rollout|set|edit|drain|cordon|uncordon|taint)\\b|\\bhelm[ \\t]+(install|upgrade|uninstall|rollback)\\b|\\baws[ \\t]+cloudformation[ \\t]+(deploy|create-stack|update-stack|delete-stack)\\b"
    },
    {
      "id": "push",
      "re": "\\bgit\\b.*\\bpush\\b"
    },
    {
      "id": "force-push",
      "re": "\\bgit\\b.*\\bpush\\b.*(--force|--force-with-lease|[ \\t]-[A-Za-z]*f\\b|[ \\t]\\+[^ \\t]+)"
    },
    {
      "id": "mr-write",
      "re": "\\b(gh[ \\t]+(pr|issue)[ \\t]+(create|merge|close|reopen|comment|edit|review|ready)|glab[ \\t]+(mr|issue)[ \\t]+(create|merge|close|reopen|note|update|approve))\\b"
    },
    {
      "id": "http-write",
      "re": "\\b(curl\\b.*([ \\t](-X|--request)[ \\t]*(POST|PUT|PATCH|DELETE)\\b|[ \\t](-d|--data[a-z-]*|-F|--form|-T|--upload-file)\\b)|wget\\b.*--(post|method)|gh[ \\t]+api\\b.*([ \\t](-X|--method)[ \\t]*(POST|PUT|PATCH|DELETE)|[ \\t](-f|-F|--field|--raw-field|--input)\\b))"
    },
    {
      "id": "deploy",
      "re": "\\b(deploy|kubectl[ \\t]+(apply|create|delete|patch|replace|rollout|scale|set|edit)|helm[ \\t]+(install|upgrade|uninstall|rollback)|terraform[ \\t]+(apply|destroy|import)|tofu[ \\t]+(apply|destroy))\\b"
    },
    {
      "id": "publish",
      "re": "\\b((npm|yarn|pnpm)[ \\t]+publish|gem[ \\t]+push|twine[ \\t]+upload|cargo[ \\t]+publish|docker[ \\t]+push|gh[ \\t]+release[ \\t]+(create|upload|edit))\\b"
    },
    {
      "id": "history-rewrite",
      "re": "\\bgit\\b.*\\b(rebase|filter-branch|filter-repo|commit[ \\t]+.*--amend|reset[ \\t]+.*--hard|update-ref[ \\t]+-d)\\b"
    },
    {
      "id": "recursive-delete",
      "re": "\\b(rm[ \\t]+(-[A-Za-z]*[rR][A-Za-z]*|--recursive)\\b|find\\b.*[ \\t]-delete\\b|git[ \\t]+(.*[ \\t])?clean\\b|rsync\\b.*--delete)"
    },
    {
      "id": "mcp-write",
      "re": "^mcp__.+__([A-Za-z]+_)?([Cc]reate|[Uu]pdate|[Dd]elete|[Rr]emove|[Pp]ost|[Ss]end|[Mm]erge|[Pp]ublish|[Ww]rite|[Aa]dd|[Ee]dit|[Cc]omment|[Tt]ransition|[Aa]pprove|[Cc]lose)"
    }
  ],
  "prod_classes": [
    {
      "id": "prod-token",
      "re": "(^|[^A-Za-z0-9])([Pp][Rr][Oo][Dd]|[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ii][Oo][Nn]|[Pp][Rr][Dd])([^A-Za-z0-9]|$)"
    }
  ],
  "explicit_gate_classes": [
    "deploy",
    "env-write",
    "infra-write",
    "prod-write",
    "protected-push"
  ],
  "protected_branch_re": "^(main|master|trunk|develop|development|stable|staging|gh-pages|prod|production|(prod|production)[/_-].+|releases?([/_-].+)?|hotfix/.+)$",
  "approval_re": "^[-*]?[ \\t]*U-([0-9]+): approval \"(.+)\" — action (.+?) · targets (.+?) · (once|standing( \\([^)]*\\))?) · (not yet used|used [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} [+-][0-9]{4})( · given .+)?$",
  "risk_classes": [
    {
      "id": "gate",
      "from": "explicit_gate_classes"
    },
    {
      "id": "outward",
      "from": "outward_classes"
    },
    {
      "id": "production",
      "from": "prod_classes"
    },
    {
      "id": "credential-value",
      "from": "secret_rules"
    },
    {
      "id": "credential-read",
      "re": "(~|\\$HOME|\\$\\{HOME\\})/\\.(ssh|aws|kube|docker|gnupg|config/gh)(/|\\b)|(^|[\\s/'\\\"=])\\.env(?!\\.(example|sample|template|dist)\\b)[A-Za-z0-9_.-]*($|[\\s'\\\";|&)])|\\.(netrc|npmrc|pypirc|pgpass|git-credentials)\\b|\\b(id_rsa|id_dsa|id_ecdsa|id_ed25519)\\b|\\.(pem|key|p12|pfx|keystore|jks|p8|ppk)($|[\\s'\\\";|&)])|\\bcredentials(\\.json)?\\b|(^|[\\s/'\\\"=])\\.?[A-Za-z_]*_history\\b|\\bhistory\\.jsonl\\b|/proc/|\\.git/config\\b|\\b(security[ \\t]+find-(generic|internet)-password|op[ \\t]+(read|item[ \\t]+get)|pass[ \\t]+show)\\b"
    },
    {
      "id": "network",
      "re": "[A-Za-z][A-Za-z0-9+.-]*://|(^|[;&|(][ \\t]*)(sudo[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*=[^ \\t]*[ \\t]+)*(curl|wget|ssh|scp|sftp|ftp|telnet|nc|ncat|socat|aws|gcloud|gsutil|az|kubectl|helm|terraform|tofu|pulumi|gh|glab|heroku|vercel|fly|flyctl|doctl|npx)\\b|\\brsync\\b[^|;&]*[ \\t][^ \\t:/]+:|\\bgit\\b[^|;&]*[ \\t](fetch|pull|push|clone|ls-remote|submodule[ \\t]+update|remote[ \\t]+update)\\b|\\bdocker[ \\t]+(pull|push|login|run|build|compose[ \\t]+(pull|up|build))\\b|\\b(npm|pnpm)[ \\t]+(install|i|ci|add|update|publish|view|info|audit|outdated)\\b|\\byarn([ \\t]+(install|add|upgrade|publish|info|audit)\\b|[ \\t]*$)|\\bpip[0-9.]*[ \\t]+(install|download)\\b|\\b(gem|bundle|bundler)[ \\t]+(install|update|push|fetch|outdated)\\b|\\bcargo[ \\t]+(install|update|publish|fetch|search)\\b|\\bgo[ \\t]+(get|install|mod[ \\t]+download)\\b|\\bbrew[ \\t]+(install|upgrade|update|fetch)\\b"
    },
    {
      "id": "opaque",
      "re": "'|\\$\\(|`|<\\(|>\\(|(^|[;&|(][ \\t]*)(eval|source|exec|\\.)[ \\t]|\\b(sh|bash|zsh|dash|ksh|fish)[ \\t]+-[a-z]*[cs]\\b|\\|[ \\t]*(sudo[ \\t]+)?(env[ \\t]+)?(sh|bash|zsh|dash|ksh|fish|python[0-9.]*|perl|ruby|node|php|osascript|xargs)\\b|\\bbase64[ \\t]+(-d|--decode|-D)\\b|\\bxxd[ \\t]+-r\\b|\\b(python[0-9.]*|perl|ruby|node|php)[ \\t]+-[a-zA-Z]*[ce]\\b"
    },
    {
      "id": "write-outside",
      "from": "code"
    },
    {
      "id": "read-outside",
      "from": "code"
    },
    {
      "id": "not-read-only",
      "from": "code"
    }
  ],
  "readonly_cmd_re": "^(?![^\\n]*[<>$`*?\\[])(?![^\\n]*\\{[^}]*(,|\\.\\.))(?![^\\n]*(^|[ \\t=\\\"'])(~|/|\\.\\.(/|$|[ \\t\\\"'])))(git([ \\t]+-C[ \\t]+[^ \\t]+)?[ \\t]+((status|log|diff|show|blame|rev-parse|ls-files|ls-tree|describe|shortlog|grep|cat-file|show-ref|merge-base|rev-list|worktree[ \\t]+list|stash[ \\t]+list)(?![^\\n]*[ \\t][\\\"']?(-O|--output|--open-files-in-pager|--ext-diff|--textconv|--filters|--no-index))([ \\t]|$)|reflog(?![ \\t]+(?!show\\b)[a-z])([ \\t]|$)|(branch([ \\t]+(-a|-r|-v|-vv|--list|--all|--show-current|--contains|--merged|--no-merged))*|tag([ \\t]+(-l|--list))*|remote([ \\t]+-v)?)[ \\t]*$)|(rg|grep|egrep|fgrep)(?![^\\n]*[ \\t][\\\"']?(--pre|--pre-glob|--hostname-bin))([ \\t]|$)|sort(?![^\\n]*[ \\t][\\\"']?(-[A-Za-z]*o|--output|--compress-program))([ \\t]|$)|tree(?![^\\n]*[ \\t][\\\"']?(-[A-Za-z]*[oR]|--fromfile))([ \\t]|$)|uniq([ \\t]+-[A-Za-z0-9-]+)*([ \\t]+[^- \\t][^ \\t]*)?[ \\t]*$|file(?![^\\n]*[ \\t][\\\"']?-[A-Za-z]*C)([ \\t]|$)|date(?![^\\n]*[ \\t][\\\"']?(-[A-Za-z]*s|--set))([ \\t]|$)|(ls|cat|head|tail|wc|stat|pwd|which|type|du|df|sha256sum|shasum|md5|md5sum|cut|diff|cmp|basename|dirname|realpath|readlink)([ \\t]|$))",
  "test_build_re": "^(make|rake|bundle[ \\t]+exec[ \\t]+rake|gradle|\\./gradlew|(npm|pnpm|yarn)[ \\t]+run|yarn|pnpm)[ \\t]+(?![^ \\t]*([Dd]eploy|[Rr]elease|[Pp]ublish|[Pp]ush|[Ii]nstall|[Pp]rod|[Uu]pload))(test|check|spec|lint|typecheck|build)(:[A-Za-z0-9_]+)?([ \\t]+-[A-Za-z0-9-]+)*[ \\t]*$|^(npm|pnpm)[ \\t]+test([ \\t]+-[A-Za-z0-9-]+)*[ \\t]*$|^cargo[ \\t]+(test|build|check)(?![^\\n]*[ \\t]--config\\b)([ \\t]|$)|^go[ \\t]+(test|vet|build)(?![^\\n]*[ \\t]-(exec|toolexec)\\b)([ \\t]|$)|^(pytest|python3?[ \\t]+-m[ \\t]+pytest)(?![^\\n]*[ \\t]-p[ \\t])([ \\t]|$)",
  "notice": {
    "id": "watcher-1",
    "version": 1,
    "text": "compactinue: local compaction logs are on (content-free; nothing is sent). To share them: /compactinue:report. To turn them off: set watcher to off in /config."
  },
  "clamp": {
    "native_offset": 33000,
    "min_target": 120000,
    "reserve_base": 52000,
    "reserve_no_handoff": 100000,
    "window_floor": 100000,
    "soft_ratio": 0.8,
    "target_num": 2,
    "target_den": 3,
    "handoff_tokens_min": 20000,
    "handoff_tokens_max": 150000
  },
  "alert_texts": {
    "A-01": "summary copy missing",
    "A-02": "unshaped or truncated shaped compaction",
    "A-03": "scope leak",
    "A-04": "fabricated check lines",
    "A-05": "compaction outside the band",
    "A-06": "cold large compaction",
    "A-07": "thrash",
    "A-08": "nudge unresolved",
    "A-09": "ledger loss",
    "A-10": "summary growth",
    "A-11": "stalled background item",
    "A-12": "outward action without consent",
    "A-13": "session-id canary",
    "A-14": "slow resume",
    "A-15": "version, arm or hook-surface change",
    "A-16": "compactinue: the plugin's compaction hook was skipped by a managed plugin (possibly in a subagent); the classic hooks shaped and saved it.",
    "A-17": "failed or blocked compaction",
    "A-18": "auto-continue stopped",
    "A-19": "auto-continue cap breached",
    "A-20": "workflow stopped after compaction",
    "A-21": "secret-shaped content in a summary or copy",
    "A-22": "heal on an unproven relation",
    "A-23": "resume block missing, doubled or degraded",
    "A-24": "storage growth",
    "A-25": "watcher unhealthy",
    "A-26": "plugin layers not running",
    "A-27": "auto-continue without a nudge"
  }
}
