   "expect": {
    "exit": 0,
    "stdout_has": [
     "\\Aprune: dry run, nothing deleted",
     "^disposable_root ~/\\.local/state/$BRAND/disposable: 1 folder, ",
     "^plan: [0-9a-f]{12} "
