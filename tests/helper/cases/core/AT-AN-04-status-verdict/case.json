{
 "id": "AT-AN-04 (0.1.3 alert noise: the status verdict line)",
 "layer": "H",
 "owner": "watch",
 "note": "0.1.3 alert noise item 4: `status` opens with one verdict line before the watcher line. With a session id: this session's main and unattributed compactions in the rollup (precomputed and subagent rows left out; an unattributed one counts because the compactions block lists it in this session, 0.1.3 integration review; the last row of a nonce counts) with a saved copy (saved, exists, late, unattributed), and its open alerts, the warn and critical ones (an info alert is a note). `ok: <saved>/<n> compactions saved this session, no open alerts` only when every compaction has its copy and no alert is open; else `attention:`, with the open alert count and rules, or the copies alone. Without a session id the same over every session's last 7 days (rows by their ts). With watcher off there is no verdict line (AT-PK-05 asserts the off line comes first)",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "an empty store without a session id",
   "setup": [{"mkdir": "$TMP/work"}],
   "argv": ["status", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\Aok: no compactions in the last 7 days, no open alerts\\nwatcher: true · "]}},
  {"name": "every compaction saved, one info alert",
   "setup": [
    {"write": "$WATCH/$SID/compactions.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-21T13:00:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00001", "copy": "saved", "copy_path": "repo/general/compact/a.md", "precomputed": false},
     {"v": 1, "ts": "2026-10-21T13:10:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00002", "copy": "failed:io", "copy_path": null, "precomputed": false},
     {"v": 1, "ts": "2026-10-21T13:12:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00002", "copy": "late", "copy_path": "repo/general/compact/b.md", "precomputed": false},
     {"v": 1, "ts": "2026-10-21T13:20:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00003", "copy": "failed:io", "copy_path": null, "precomputed": true},
     {"v": 1, "ts": "2026-10-21T13:30:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "a9a00b3f36332744e", "writer": "helper",
      "nonce": "a0a00004", "copy": "failed:io", "copy_path": null, "precomputed": false}]},
    {"write": "$WATCH/$SID.alerts.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-21T13:40:00+03:00", "ev": "alert", "sid": "$SID", "actor": "main", "writer": "classic",
      "alert_id": "a15-00000001", "rule": "A-15", "severity": "info", "key": {"session_id": "$SID"}, "evidence": {}}]}
   ],
   "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\Aok: 2/2 compactions saved this session, no open alerts\\nwatcher: true · ",
                   "^Alerts this session: 1 \\(critical 0, warn 0, info 1\\)$"]}},
  {"name": "an unattributed compaction counts (the compactions block lists it in this session); a subagent one does not",
   "setup": [
    {"write": "$WATCH/$SID/compactions.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-21T13:00:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "unattributed", "writer": "helper",
      "nonce": "a0a00001", "verdict": "ok-unclosed", "copy": "unattributed", "copy_path": "repo/general/compact/unattributed/a.md", "precomputed": false},
     {"v": 1, "ts": "2026-10-21T13:30:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "a9a00b3f36332744e", "writer": "helper",
      "nonce": "a0a00004", "copy": "failed:io", "copy_path": null, "precomputed": false}]}
   ],
   "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\Aok: 1/1 compactions saved this session, no open alerts\\nwatcher: true · ",
                   "^  2026-10-21T13:00:00\\+03:00 · unattributed · "]}},
  {"name": "a compaction without its copy and no open alert",
   "setup": [
    {"write": "$WATCH/$SID/compactions.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-21T13:00:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00001", "copy": "saved", "copy_path": "repo/general/compact/a.md", "precomputed": false},
     {"v": 1, "ts": "2026-10-21T13:12:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00002", "copy": "exists", "copy_path": "repo/general/compact/b.md", "precomputed": false},
     {"v": 1, "ts": "2026-10-21T13:50:00+03:00", "ev": "compaction", "sid": "$SID", "actor": "main", "writer": "helper",
      "nonce": "a0a00005", "copy": "failed:io", "copy_path": null, "precomputed": false}]}
   ],
   "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/work"],
