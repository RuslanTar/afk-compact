{
 "id": "CW-1 (begin and locate without a session id)",
 "tmp_base": "repo",
 "layer": "H",
 "owner": "skills",
 "note": "Cowork check 2026-10-26, finding CW-1 (review): the handoff skill sends begin, and the resume skill sends locate, a --sid that may be empty, missing or the unsubstituted ${CLAUDE_SESSION_ID}. begin and locate take all three as unset (lib/skills/util.pm unset_value) and resolve the id from this process's per-process record. Without a record (pid 2 has none; these steps run first): begin uses an anon- id with identity `degraded (no-session-id)`; locate calls no file same-session or successor and picks none; neither writes the record session's pin or session folder. With the record (pid 1): the record's id, not degraded, and locate picks this session's own handoff (tier 3, same-session). CW-1 review 2: a placeholder id (anon-…, as begin prints and degraded handoffs carry, or a bare CLAUDE_SESSION_ID) is taken as unset too: without a record begin gets a fresh anon- id marked degraded, locate never calls that anon- handoff own, and pin refuses (no-session); with the record the record wins, not degraded",
 "now": "2026-10-26T02:30:00+02:00",
 "tz": "Etc/GMT-2",
 "env": {
  "STORE_TEST_CLAUDE_PID": "1:$LSTART1"
 },
 "steps": [
  {"name": "a repo, pid 1's record naming $SID and $SID's own handoff",
   "setup": [
    {"repo": {"branch": "feature/retry", "commits": [{"files": {"app/retry.rb": "x = 1\n"}, "msg": "seed"}]}, "at": "$TMP/repo"},
    {"write": "$ROOT/.sessions/by-pid/1-1792580000.live-11111111.json",
     "content": "{\"pid\":1,\"pid_lstart\":\"$LSTART1\",\"session_id\":\"$SID\",\"cwd\":\"$TMP/repo\",\"worktree\":\"$TMP/repo\",\"source\":\"startup\",\"ts\":\"2026-10-26T01:00:00+02:00\"}"},
    {"write": "$ROOT/repo/retry/2026-10-26_01-30-00_11111111_own.md",
     "content": "---\nkind: handoff\nwriter: handoff\nnonce: 0a0b0c0d\ndate: 2026-10-26T01:30:00+02:00\nsession_id: $SID\nactor: main\n---\n⟪$BRAND v1 n=0a0b0c0d s=manual⟫\n# retry — work\n⟪/$BRAND n=0a0b0c0d⟫\n"}
   ]},
  {"name": "begin, empty --sid, no record: an anon- id, degraded (no-session-id), nothing of $SID written",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--sid", "", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "begin, no --sid, no record: an anon- id, degraded",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "begin, unsubstituted ${CLAUDE_SESSION_ID}, no record: an anon- id, degraded (no-session-id), nothing of $SID written",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--sid", "${CLAUDE_SESSION_ID}", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "stdout_lacks": ["CLAUDE_SESSION_ID"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "locate, empty --sid, no record: nothing same-session or successor, no pick, nothing of $SID written",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--sid", "", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "locate, no --sid, no record: the same",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "locate, unsubstituted ${CLAUDE_SESSION_ID}, no record: the same",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--sid", "${CLAUDE_SESSION_ID}", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$", "CLAUDE_SESSION_ID"],
    "absent": ["$ROOT/.sessions/$SID.json", "$WATCH/$SID", "$WATCH/$SID.classic.jsonl", "$WATCH/unknown"]}},
  {"name": "begin, empty --sid, with the record: the record's id, not degraded",
   "cwd": "$TMP/repo",
   "argv": ["begin", "--sid", "", "--topic", "retry"],
   "expect": {"exit": 0, "json": {"session.id": "$SID", "session.identity": {"null": 1}}}},
  {"name": "begin, no --sid, with the record: the same",
   "cwd": "$TMP/repo",
   "argv": ["begin", "--topic", "retry"],
   "expect": {"exit": 0, "json": {"session.id": "$SID", "session.identity": {"null": 1}}}},
  {"name": "locate, empty --sid, with the record: this session's own handoff (tier 3, same-session)",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--sid", "", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"]}},
  {"name": "locate, no --sid, with the record: the same",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"]}},
  {"name": "locate, unsubstituted ${CLAUDE_SESSION_ID}, with the record: the same",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--sid", "${CLAUDE_SESSION_ID}", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"],
    "stdout_lacks": ["CLAUDE_SESSION_ID"]}},
  {"name": "CW-1 review 2: a degraded handoff written under a placeholder anon- id",
   "setup": [
    {"write": "$ROOT/repo/retry/2026-10-26_00-30-00_anon0123_anon.md",
     "content": "---\nkind: handoff\nwriter: handoff\nnonce: 0e0f0a0b\ndate: 2026-10-26T00:30:00+02:00\nsession_id: anon-0123456789abcdef\nactor: main\n---\n⟪$BRAND v1 n=0e0f0a0b s=manual⟫\n# retry — degraded\n⟪/$BRAND n=0e0f0a0b⟫\n"}
   ]},
  {"name": "begin, a placeholder anon- id copied from a degraded handoff, no record: a fresh anon- id, degraded, never that one",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--sid", "anon-0123456789abcdef", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-(?!0123456789abcdef$)[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "absent": ["$ROOT/.sessions/anon-0123456789abcdef.json", "$ROOT/.sessions/$SID.json", "$WATCH/anon-0123456789abcdef"]}},
  {"name": "begin, a bare CLAUDE_SESSION_ID, no record: the same",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["begin", "--sid", "CLAUDE_SESSION_ID", "--topic", "retry"],
   "expect": {"exit": 0,
    "json": {"session.id": {"re": "^anon-[0-9a-f]{16}$"}, "session.identity": "degraded (no-session-id)"},
    "absent": ["$ROOT/.sessions/CLAUDE_SESSION_ID.json", "$WATCH/CLAUDE_SESSION_ID"]}},
  {"name": "locate, the anon- id, no record: its handoff is not own (never same-session or successor)",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--sid", "anon-0123456789abcdef", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 6\\npick: none\\nrelation: unselected\\n"],
    "stdout_lacks": ["^tier: [1-5]$", "^relation: (same-session|successor)$"],
    "absent": ["$ROOT/.sessions/anon-0123456789abcdef.json", "$WATCH/anon-0123456789abcdef"]}},
  {"name": "locate, the anon- id and that handoff's path, no record: other, not same-session",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["locate", "--sid", "anon-0123456789abcdef", "--cwd", "$TMP/repo", "--arg", "$ROOT/repo/retry/2026-10-26_00-30-00_anon0123_anon.md"],
   "expect": {"exit": 0,
    "stdout_has": ["^pick: $ROOT/repo/retry/2026-10-26_00-30-00_anon0123_anon\\.md$", "^relation: other"],
    "stdout_lacks": ["^relation: (same-session|successor)$"]}},
  {"name": "pin, the anon- id, no record: refused (no-session), no pin for the placeholder",
   "cwd": "$TMP/repo",
   "env": {"STORE_TEST_CLAUDE_PID": "2:Thu Jan  1 00:00:00 2026"},
   "argv": ["pin", "--sid", "anon-0123456789abcdef", "--resumed-from", "$ROOT/repo/retry/2026-10-26_00-30-00_anon0123_anon.md"],
   "expect": {"exit": 3, "stdout": "REFUSED: no-session\n",
    "absent": ["$ROOT/.sessions/anon-0123456789abcdef.json", "$ROOT/.sessions/$SID.json"]}},
  {"name": "begin, the anon- id, with the record: the record's id, not degraded",
   "cwd": "$TMP/repo",
   "argv": ["begin", "--sid", "anon-0123456789abcdef", "--topic", "retry"],
   "expect": {"exit": 0, "json": {"session.id": "$SID", "session.identity": {"null": 1}}}},
  {"name": "locate, the anon- id, with the record: this session's own handoff, the anon one is not own",
   "cwd": "$TMP/repo",
   "argv": ["locate", "--sid", "anon-0123456789abcdef", "--cwd", "$TMP/repo", "--arg", ""],
   "expect": {"exit": 0,
    "stdout_has": ["\\Atier: 3\\npick: $ROOT/repo/retry/2026-10-26_01-30-00_11111111_own\\.md\\nrelation: same-session\\n"]}}
 ]
}
