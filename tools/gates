def _description(path):
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    for ln in lines[1:]:
        if ln == "---":
            break
        m = re.match(r"description:[ \t]*(.*)$", ln)
        if m:
            d = m.group(1).strip()
            if len(d) >= 2 and d[0] == d[-1] and d[0] in "'\"":
                d = d[1:-1].replace("''", "'") if d[0] == "'" else d[1:-1]
            return d
    return None


