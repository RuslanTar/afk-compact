     {"path": "$ROOT/.sessions/loads/1791540000_12045-1792573200_0.1.0_aaaaaaaa.json", "count": 1},
     {"path": "$ROOT/.sessions/loads/1791367200_22193-1792573200_0.1.0_aaaaaaaa.json", "count": 1},
     {"path": "$ROOT/.sessions/loads/1791626400_33333-0_0.1.0_aaaaaaaa.json", "count": 0},
     {"path": "$ROOT/.sessions/loads/1791453600_12046-1792570000_0.1.0_aaaaaaaa.json", "count": 0},
     {"path": "$ROOT/.sessions/loads/*_12044-1792573200_*.json", "count": 1},
     {"path": "$ROOT/.sessions/by-pid/33335-0.live-c4c4c4c4.json", "count": 1},
     {"path": "$ROOT/.sessions/by-pid/22192-0.live-c4c4c4c4.json", "count": 1},
     {"path": "$ROOT/.sessions/by-pid/12045-1792573200.live-c4c4c4c4.json", "count": 1},
     {"path": "$ROOT/.sessions/by-pid/22193-1792573200.live-c4c4c4c4.json", "count": 1},
     {"path": "$ROOT/.sessions/by-pid/33333-0.live-c4c4c4c4.json", "count": 0},
     {"path": "$ROOT/.sessions/by-pid/12046-1792570000.live-c4c4c4c4.json", "count": 0}
    ]}},
  {"name": "the next day with no ps -W listing (a missing file): 33336, not mapped, is unknown, not gone: its old records are kept",
   "now": "2026-10-22T10:30:00+00:00",
   "setup": [
    {"write": "$ROOT/.sessions/loads/1791280800_33336-0_0.1.0_aaaaaaaa.json", "json": {"v": 1, "plugin_version": "0.1.0", "host": "$HOST", "session_id": "$SID", "source": "startup", "ts": "2026-10-06T10:00:00+00:00"}},
    {"write": "$ROOT/.sessions/by-pid/33336-0.live-c4c4c4c4.json",
