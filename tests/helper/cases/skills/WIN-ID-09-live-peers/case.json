   "cwd" : "$TMP/repo",
   "env" : {
    "CLAUDE_PID" : "12044",
    "STORE_TEST_CLAUDE_PID" : null,
    "STORE_TEST_OS" : "msys",
    "STORE_TEST_PPID" : "885",
    "STORE_TEST_PROC" : "$TMP/ptable",
    "STORE_TEST_PROC_ROOT" : "$TMP/proc",
    "STORE_TEST_PS_W" : "$TMP/psw",
    "STORE_TEST_WINPIDS" : "$TMP/winpids"
   },
   "expect" : {
    "exit" : 0,
    "stdout_has" : [
     "^handoff session live in another process: pid 22192$",
     "^handoff session live in another process: pid 22194$",
     "^live session: a9a9a9a9 pid 22192 on this checkout$",
     "^live session: a6a6a6a6 pid 22193 on this checkout$"
    ],
    "stdout_lacks" : [
