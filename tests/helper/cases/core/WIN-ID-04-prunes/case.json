   ],
   "env": {"STORE_TEST_CLAUDE_PID": null, "STORE_TEST_PPID": "1", "CLAUDE_PID": "12046", "STORE_TEST_OS": "msys", "STORE_TEST_PROC_STARTS": null,
           "STORE_TEST_PROC_ROOT": "$TMP/proc", "STORE_TEST_WINPIDS": "$TMP/winpids", "STORE_TEST_PS_W": "$TMP/no-such-listing"},
   "argv": ["hook", "SessionStart"],
