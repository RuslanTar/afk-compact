{
 "id": "PF-6-since-real-dates",
 "note": "owner ruling PF-6 (2026-10-27 22:40, small flaw 2; reference scenario pf-since-real-dates on the port branch): `report --since`, `watch report --since` and `watch audit --since` take a YYYY-MM-DD date only when it is a real calendar date. 2026-02-31, 2026-02-30, 2026-13-01, 2026-00-10, 2026-04-31 and 2026-02-29 (not a leap year) get the usage text any other bad --since gives (the `--since xyz` steps), exit 64; 2026-02-28, 2026-12-31 and 2028-02-29 (a leap year) are taken, exit 0. Before the fix POSIX::mktime shifted the impossible dates (2026-02-31 became 3 March) and the command ran",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "env": {"STORE_TEST_NO_GIT": "1"},
 "steps": [
  {"name": "report --since xyz: the usage text",
   "argv": ["report", "--dry-run", "--since", "xyz"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: report \\[--dry-run\\] \\[--since <N>d\\|<YYYY-MM-DD>\\] \\[--out DIR\\] \\[--max-mb N\\] \\[--with-summaries\\]\\n {14}\\[--with-handoffs\\]\\n {7}report verify --zip FILE\\n\\z"]}},
  {"name": "report --since 2026-02-31", "argv": ["report", "--dry-run", "--since", "2026-02-31"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: report \\[--dry-run\\] \\[--since <N>d\\|<YYYY-MM-DD>\\] \\[--out DIR\\] \\[--max-mb N\\] \\[--with-summaries\\]\\n {14}\\[--with-handoffs\\]\\n {7}report verify --zip FILE\\n\\z"]}},
  {"name": "report --since 2026-13-01", "argv": ["report", "--dry-run", "--since", "2026-13-01"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: report \\[--dry-run\\] \\[--since <N>d\\|<YYYY-MM-DD>\\] \\[--out DIR\\] \\[--max-mb N\\] \\[--with-summaries\\]\\n {14}\\[--with-handoffs\\]\\n {7}report verify --zip FILE\\n\\z"]}},
  {"name": "report --since 2026-00-10", "argv": ["report", "--dry-run", "--since", "2026-00-10"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: report \\[--dry-run\\] \\[--since <N>d\\|<YYYY-MM-DD>\\] \\[--out DIR\\] \\[--max-mb N\\] \\[--with-summaries\\]\\n {14}\\[--with-handoffs\\]\\n {7}report verify --zip FILE\\n\\z"]}},
  {"name": "report --since 2026-04-31", "argv": ["report", "--dry-run", "--since", "2026-04-31"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: report \\[--dry-run\\] \\[--since <N>d\\|<YYYY-MM-DD>\\] \\[--out DIR\\] \\[--max-mb N\\] \\[--with-summaries\\]\\n {14}\\[--with-handoffs\\]\\n {7}report verify --zip FILE\\n\\z"]}},
  {"name": "report --since 2026-02-29 (2026 is not a leap year)", "argv": ["report", "--dry-run", "--since", "2026-02-29"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: report \\[--dry-run\\] \\[--since <N>d\\|<YYYY-MM-DD>\\] \\[--out DIR\\] \\[--max-mb N\\] \\[--with-summaries\\]\\n {14}\\[--with-handoffs\\]\\n {7}report verify --zip FILE\\n\\z"]}},
  {"name": "report --since 2026-02-28 is taken", "argv": ["report", "--dry-run", "--since", "2026-02-28"],
   "expect": {"exit": 0, "stderr_empty": true}},
  {"name": "report --since 2026-12-31 is taken", "argv": ["report", "--dry-run", "--since", "2026-12-31"],
   "expect": {"exit": 0, "stderr_empty": true}},
  {"name": "report --since 2028-02-29 is taken (a leap year)", "argv": ["report", "--dry-run", "--since", "2028-02-29"],
   "expect": {"exit": 0, "stderr_empty": true}},
  {"name": "watch report --since xyz: the usage text",
   "argv": ["watch", "report", "--since", "xyz"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: watch prune --days N \\[--sid S\\]\\n {7}watch report \\[--since <N>d\\|<YYYY-MM-DD>\\|all\\] \\[--input DIR\\] \\[--export\\] \\[--out FILE\\]\\n {7}watch audit \\[--since <N>d\\|<YYYY-MM-DD>\\|all\\] \\[--input DIR\\]\\n\\z"]}},
  {"name": "watch report --since 2026-02-30", "argv": ["watch", "report", "--since", "2026-02-30"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: watch prune --days N \\[--sid S\\]\\n {7}watch report \\[--since <N>d\\|<YYYY-MM-DD>\\|all\\] \\[--input DIR\\] \\[--export\\] \\[--out FILE\\]\\n {7}watch audit \\[--since <N>d\\|<YYYY-MM-DD>\\|all\\] \\[--input DIR\\]\\n\\z"]}},
  {"name": "watch audit --since 2026-02-29", "argv": ["watch", "audit", "--since", "2026-02-29"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["\\Ausage: watch prune --days N \\[--sid S\\]\\n {7}watch report \\[--since <N>d\\|<YYYY-MM-DD>\\|all\\] \\[--input DIR\\] \\[--export\\] \\[--out FILE\\]\\n {7}watch audit \\[--since <N>d\\|<YYYY-MM-DD>\\|all\\] \\[--input DIR\\]\\n\\z"]}},
  {"name": "watch report --since 2028-02-29 is taken", "argv": ["watch", "report", "--since", "2028-02-29"],
   "expect": {"exit": 0, "stderr_empty": true, "stdout_has": ["\\AWATCH-REPORT "]}},
  {"name": "watch audit --since 2028-02-29 is taken", "argv": ["watch", "audit", "--since", "2028-02-29"],
   "expect": {"exit": 0, "stderr_empty": true, "stdout_has": ["^AUDIT: PASS"]}}
 ]
}
