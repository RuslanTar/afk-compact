{
 "id": "V013-VS-10-drain-waits-for-prune",
 "note": "0.1.3 version skew (lib/plugver.pm), review round 2 (scen.sh race): a prune moves loads/ aside, then moves its kept records back, holding loads-drop/.lock. A process that starts between the two steps must not drain that folder: its drain takes the same lock, and while another process holds it, it drains nothing (the kept record of a live process, dated before the move, is not unlinked) and does not prune. Once the prune has moved its kept records back and let go of the lock, the next start drains the rest and removes the folder.",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "manifest": {
  "version": "0.1.3"
 },
 "plugin_at": "$HOME/.claude/plugins/cache/m/$BRAND/0.1.3",
 "steps": [
  {
   "name": "mid-prune: loads/ moved aside with the kept record of a live process not yet moved back, the lock held: no drain, no prune",
   "now": "2026-10-21T14:05:12+03:00",
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "setup": [
    {
     "sha_tag": "user\n$PLUGIN_PARENT",
     "var": "UTAG"
    },
    {
     "mkdir": "$TMP/work"
    },
    {
     "write": "$ROOT/.sessions/loads-drop/1792580700-99999/1792500000_$RUNNER_PID-1792499990_0.1.3_$UTAG.json",
     "json": {
      "v": 1,
      "plugin_version": "0.1.3",
      "plugin_root": "$PLUGIN_PARENT/0.1.3",
      "host": "$HOST",
      "session_id": "50000000-1111-4222-8333-444444444444",
      "source": "startup",
      "ts": "fixture",
      "scope": "user"
     }
    },
    {
     "write": "$ROOT/.sessions/loads-drop/1792580700-99999/1792400000_50000031-1792399990_0.1.4_$UTAG.json",
     "json": {
      "v": 1,
      "plugin_version": "0.1.4",
      "plugin_root": "$PLUGIN_PARENT/0.1.4",
      "host": "$HOST",
      "session_id": "50000000-1111-4222-8333-444444444444",
      "source": "startup",
      "ts": "fixture",
      "scope": "user"
     }
    },
    {
     "write": "$ROOT/.sessions/loads-drop/.lock",
     "content": "99999\n"
    }
   ],
   "expect": {
    "exit": 0,
    "files": [
     {
      "path": "$ROOT/.sessions/loads-drop/1792580700-99999/1792500000_$RUNNER_PID-1792499990_0.1.3_$UTAG.json"
     },
     {
      "path": "$ROOT/.sessions/loads-drop/1792580700-99999/1792400000_50000031-1792399990_0.1.4_$UTAG.json"
     },
     {
      "path": "$ROOT/.sessions/loads-drop/.lock"
     },
     {
      "path": "$ROOT/.sessions/loads/1792580712_424242-1792562400_0.1.3_$UTAG.json"
     },
     {
      "path": "$ROOT/.sessions/loads/*.json",
      "count": 1
     }
    ],
    "absent": [
     "$ROOT/.sessions/loads/.pruned"
    ]
   }
  },
  {
   "name": "the prune moved its kept record back and let go of the lock: the next start drains the rest and removes the folder",
   "now": "2026-10-21T14:06:12+03:00",
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "52525252-1111-4222-8333-444444444444",
    "transcript_path": "$TMP/proj/52525252-1111-4222-8333-444444444444.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "env": {
    "STORE_TEST_CLAUDE_PID": "525252:Tue Oct 21 14:06:00 2026"
   },
   "setup": [
    {
     "rename": "$ROOT/.sessions/loads-drop/1792580700-99999/1792500000_$RUNNER_PID-1792499990_0.1.3_$UTAG.json",
     "to": "$ROOT/.sessions/loads/1792500000_$RUNNER_PID-1792499990_0.1.3_$UTAG.json"
    },
    {
     "rename": "$ROOT/.sessions/loads-drop/.lock",
     "to": "$TMP/prune-lock-released"
    }
   ],
   "expect": {
    "exit": 0,
    "files": [
     {
      "path": "$ROOT/.sessions/loads/1792500000_$RUNNER_PID-1792499990_0.1.3_$UTAG.json"
     },
     {
      "path": "$ROOT/.sessions/loads-drop/*",
      "count": 0
     }
    ],
    "absent": [
     "$ROOT/.sessions/loads-drop/1792580700-99999",
     "$ROOT/.sessions/loads/1792400000_50000031-1792399990_0.1.4_$UTAG.json",
     "$ROOT/.sessions/loads-drop/.lock"
    ]
   }
  }
 ]
}
