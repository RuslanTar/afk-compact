   "expect": {"exit": 0, "json": {"ok": true, "l": "written", "c": "written"}}},
  {"name": "(go)", "argv": ["restart", "set", "--sid", "$SID", "--nonce", "00112233445566ff", "--state", "go", "--exiting-at", "1792580713500", "--launch", "$TMP/rt/L-0123456789abcdef", "--now-ms", "1792580714200"],
   "expect": {"exit": 0, "json": {"l": "written", "c": "written"},
              "files": [{"path": "$TMP/rt/L-0123456789abcdef/restart.note", "has": ["^state=go$", "^at=1792580714$", "^exiting_at=1792580713500$"]},
                        {"path": "$WATCH/$SID/restart.json", "json": {"state": "go", "exiting_at": 1792580713500}}]}},
  {"name": "another nonce changes nothing", "argv": ["restart", "set", "--sid", "$SID", "--nonce", "ffffffffffffffff", "--state", "cancelled", "--launch", "$TMP/rt/L-0123456789abcdef", "--now-ms", "1792580714300"],
