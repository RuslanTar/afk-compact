    def autocrlf_clone(d):
        """Clone the copy with core.autocrlf=true (the Git for Windows default): the launcher,
        hooks.json and the helper entry must come out with LF and the launcher must run."""
        dst = d + "-autocrlf"
        if os.path.lexists(dst):
            shutil.rmtree(dst)
        r = subprocess.run(["git", "-c", "core.autocrlf=true", "clone", "-q", "--no-local", d, dst], capture_output=True, text=True)
        if r.returncode != 0:
            return 2, "clone failed: " + r.stderr[-300:]
        out, bad = [], 0
        for rel in ("plugin/bin/{}-store".format(name), "plugin/hooks/hooks.json", "plugin/helper/main.pl"):
            with open(os.path.join(dst, rel), "rb") as f:
                data = f.read()
            if b"\r\n" in data:
                out.append("eol {}: CRLF".format(rel))
                bad = 1
        launcher = os.path.join(dst, "plugin", "bin", name + "-store")
        try:
            code = subprocess.run([launcher], capture_output=True, text=True).returncode
        except OSError as e:    # `#!/bin/sh\r`: exec finds no such interpreter
            code = "exec: " + (e.strerror or str(e))
        if code in (126, 127) or not isinstance(code, int):
            out.append("eol {}: does not run ({})".format("plugin/bin/{}-store".format(name), code))
            bad = 1
        out.append("EOL CLONE: " + ("FAIL" if bad else "PASS"))
        return bad, "\n".join(out) + "\n"

    def build_out(d):
        """CR-F40/F44: every --out at, above or inside the repo (but tmp/<name>/), through a
        symlink or in other letter case, and an unmarked full folder elsewhere, is refused and
        nothing is deleted. CR-F41/F45: a variant from a tree that differs from HEAD is refused
        (exit 1 with VARIANT REFUSED); a clean one names its commit (exit 0)."""
        tool = os.path.join(d, "tools", "build")
        build = lambda *a: subprocess.run([tool] + list(a), cwd=d, capture_output=True, text=True)
        count = lambda: sum(len(f) for top in ("plugin", "src", "tools")
                            for _, _, f in os.walk(os.path.join(d, top)))
        link, other = d + "-link", d + "-other"
        for p in (link, other):
            if os.path.islink(p):
                os.unlink(p)
            elif os.path.lexists(p):
                shutil.rmtree(p)
        os.symlink(d, link)
        write_text(os.path.join(other, "keep.txt"), "user data\n")
        outs = ["plugin", "src", "plugin/helper", ".", "..", "tmp", "tmp/store-h-1-ab", os.path.join(link, "src"), link, other]
        if d.upper() != d and same_dir(d.upper(), d):
            outs += [d.upper(), os.path.join(d.upper(), "plugin")]
        before, msgs, bad = count(), [], []
        for o in outs:
            for args in (["--variant", "skills-only", "--allow-dirty"], ["--name", "zz-drill"]):
                r = build(*(args + ["--out", o]))
                if r.returncode != 2 or "build: --out" not in r.stderr:
                    bad.append("not refused: --out {} {} (exit {})".format(o, " ".join(args), r.returncode))
        if count() != before or not os.path.isfile(os.path.join(other, "keep.txt")):
            bad.append("files were deleted")
        os.unlink(link)
        shutil.rmtree(other)
        r = build("--variant", "skills-only", "--out", "tmp/variant")
        if r.returncode == 0 and re.search(r"^tree sha256 [0-9a-f]{64} skills-only commit [0-9a-f]{40}$", r.stdout, re.M):
            msgs.append("VARIANT BUILT from a commit")
            code = 0
        elif r.returncode == 2 and "differ from HEAD" in r.stderr:
            u = build("--variant", "skills-only", "--out", "tmp/variant", "--allow-dirty")
            if u.returncode != 0 or " UNVERIFIED (" not in u.stdout:
                bad.append("--allow-dirty: exit {} {}".format(u.returncode, u.stdout[-300:]))
            msgs.append("VARIANT REFUSED: " + r.stderr.strip()[-300:])
            code = 1
        else:
            bad.append("variant build: exit {} {}{}".format(r.returncode, r.stdout[-300:], r.stderr[-300:]))
        if bad:
            return 2, "\n".join(bad) + "\n"
        return code, "\n".join(msgs) + "\n"

    def stray_helper_file(d):
        write_text(os.path.join(d, "plugin", "helper", "lib", "foo.pm.orig"), "stray\n")

    def xh_truncated(d):
        """CR-F42: X-H takes a failing run as KNOWN_RED-only only when the runner finished (its
        `1..N` and `# passed` lines, exit 1). The fake runner fails a known-red case and then,
        when planted, dies before its plan line."""
        runner = os.path.join(d, "fake-run.pl")
        write_text(runner, "print \"ok 1 - FAKE-A\\nnot ok 2 - FAKE-KR\\n#   step 1: the known reason\\n\";\n"
                   "if (-e \"$ARGV[0]/die\") { exit 255 }\n"
                   "print \"ok 3 - FAKE-B\\n1..3\\n# passed 2, failed 1, skipped 0\\n\"; exit 1;\n")
        saved = dict(KNOWN_RED)
        KNOWN_RED.clear()
        KNOWN_RED["FAKE-KR"] = r"the known reason"
        try:
            x_h(["/usr/bin/perl", runner, d])
            return 0, "X-H ACCEPTED\n"
        except Fail as e:
            return 1, "X-H REFUSED: {}\n".format(e)
        finally:
            KNOWN_RED.clear()
            KNOWN_RED.update(saved)

    def xh_die(d):
        write_text(os.path.join(d, "die"), "")

    readme = r"plugin/README\.md:\d+: "
    v, pinned = pinned_claude()
    canary = ["tools/canary-baseline", "--check"] + (["--claude", pinned] if pinned else [])
    out = [
        ("crlf", "RN-4", ["tools/build", "--check"], crlf,
         [r"^differs plugin/bin/" + re.escape(name) + r"-store$", r"^differs plugin/hooks/hooks\.json$"], None),
        ("stray", "RN-5", ["tools/build", "--check"], stray,
         [r"^stale plugin/assets/old-asset\.txt$", r"^stale plugin/hooks/lib/old\.gen\.ts$",
          r"^stale plugin/tests/unit/_gen/stray\.gen\.ts$", r"^stale plugin/\.claude-plugin/extra\.json$",
          r"^stale plugin/notes\.txt$", r"^stale plugin/skills/handoff/\.hidden$"], None),
        ("other-names", "RN-3", gates_only("stale-name"), other_names,
