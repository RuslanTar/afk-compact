        },
        "msg": "add netrc"
       },
       {
        "files": {
         "config.txt": "token_ref $SECRET{github-token}\n"
        },
        "msg": "add config"
       },
       {
        "files": {
         "app/retry.rb": "x = 2\n"
        },
        "msg": "plain change"
       }
      ],
      "dirty": {
       "app.sqlite": "SQLite format 3 RRP01-SQLITE-CANARY-two\n"
      }
     },
     "at": "$TMP/clone"
    }
   ],
   "cwd": "$TMP/repo",
   "argv": [
    "begin",
    "--sid",
    "$SID",
    "--topic",
    "retry"
   ],
