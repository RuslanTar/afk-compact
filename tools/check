def canary_check(root=REPO):
    """canary-baseline --check pinned to the binary the file records (BH-4). When that binary is
    gone, render with the newest one to a temp file and compare all but the C8 part."""
    tool = os.path.join(root, "tools", "canary-baseline")
    if not os.path.exists(tool):
        return
    v, pinned = pinned_claude(root)
    if pinned:
        run([tool, "--check", "--claude", pinned], "X-gen canary-baseline", cwd=root)
        return
    tmp = os.path.join(root, "tmp", "canary-render.json")
    os.makedirs(os.path.dirname(tmp), exist_ok=True)
    run([tool, "--out", tmp], "X-gen canary-baseline render", cwd=root, capture=True)
    with open(os.path.join(root, "plugin", "assets", "canary-baseline.json"), encoding="utf-8") as f:
        cur = json.load(f)
    with open(tmp, encoding="utf-8") as f:
        fresh = json.load(f)
    os.unlink(tmp)
    strip = lambda doc: {k: x for k, x in doc.items() if k not in ("c8", "cc_version")}
    if strip(cur) != strip(fresh):
        raise Fail("X-gen: canary-baseline.json differs from a fresh render (C8 not compared: Claude Code {} "
                   "is not installed)".format(v))
    print("canary-baseline: current except C8 (Claude Code {} not installed)".format(v))


def x_gen(phase, root=REPO):
    tools = os.path.join(root, "tools")
    run([os.path.join(tools, "build"), "--check"], "X-gen build", cwd=root)
    if os.path.exists(os.path.join(tools, "fixtures-gen")):
