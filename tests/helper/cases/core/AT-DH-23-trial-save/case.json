   "stdin_json": {
    "kind": "moment",
    "moment_id": "$SID8-1a2b3c4d",
    "repo": "work",
    "ticket": "LAB-42",
    "moment": {
     "kind": "m3-auto",
     "trigger": "auto",
     "nonce": "1a2b3c4d",
     "position": 1,
     "plugin_side": "n/a",
     "reply": "NOT-A-FIELD",
     "facts": "NOT-A-FIELD"
    },
    "old": {
     "status": "ok",
     "reply": "Here it is.\n=== OLD-HANDOFF START retry-work ===\n---\nrepository: work\n---\ntoken $SECRET{github-token} here\n=== OLD-HANDOFF END ===\n",
     "input_tokens": 900,
     "cache_read_input_tokens": 300000
    },
    "native": {
     "status": "ok",
     "reply": "<analysis>ANALYSIS-TEXT</analysis>\n<summary>SUMMARY-BODY</summary>\n",
     "prompt_arm": "control",
     "cache_prefix_flag": false
    }
   },
   "expect": {
    "exit": 0,
    "json": {
     "written": true,
     "old.status": "ok",
     "native.status": "ok"
    },
    "files": [
     {
      "path": "$HOME/.cache/$BRAND-trial/old/work/LAB-42/*_${SID8}_retry-work.old-handoff.txt",
      "count": 1
     },
     {
      "path": "$HOME/.cache/$BRAND-trial/old/work/LAB-42/*_${SID8}_retry-work.old-handoff.txt",
      "mode": "0600",
      "contains": [
       "[redacted:",
       "repository: work"
      ],
      "absent_text": [
       "OLD-HANDOFF",
       "Here it is.",
       "$SECRET{github-token}"
      ]
     },
     {
      "path": "$HOME/.cache/$BRAND-trial/native/work/LAB-42/*_${SID8}_m3-auto.native-summary.txt",
      "mode": "0600",
      "contains": [
       "SUMMARY-BODY",
       "ANALYSIS-TEXT"
      ]
     },
     {
      "path": "$HOME/.cache/$BRAND-trial/moments/2026-10/$SID8-1a2b3c4d.json",
      "mode": "0600",
      "json": {
       "moment_id": "$SID8-1a2b3c4d",
       "kind": "m3-auto",
       "nonce": "1a2b3c4d",
       "repo": "work",
       "ticket": "LAB-42",
       "old": {
        "status": "ok",
        "framed": true,
        "input_tokens": 900
       },
       "native": {
        "status": "ok",
        "body_sha256": "9516301accc6cad27b874aca0fcdf86aeff63ad94f2f28b05d8bd0a83e85a7ae",
        "prompt_arm": "control",
        "cache_prefix_flag": false
       }
      },
      "absent_text": [
       "SUMMARY-BODY",
       "ANALYSIS-TEXT",
       "NOT-A-FIELD",
       "repository: work",
       "$SECRET{github-token}"
      ],
      "has": [
       "\"redacted\": \\[\\s*\"github-token\""
      ]
