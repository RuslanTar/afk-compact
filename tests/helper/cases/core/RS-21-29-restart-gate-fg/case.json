   "expect": {"exit": 0, "json": {"ok": false, "why": "fg-not-shipped", "mode": "default", "effort": "high"}}},
  {"name": "with the ship gate open: ok", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--model", "opus"],
