def probe_run(argv, d):
    if callable(argv):
        return argv(d)
    r = subprocess.run([os.path.join(d, argv[0])] + argv[1:], cwd=d, capture_output=True, text=True)
    return r.returncode, r.stdout + r.stderr


def x_tools():
    name = brand()["name"]
    if os.path.lexists(SELFTEST_DIR):
        shutil.rmtree(SELFTEST_DIR)
    clean = os.path.join(SELFTEST_DIR, "clean")
    copy_tree(clean)
    failures = []
    plist = probes(name)
    for pid, finding, argv, plant, want, prep in plist:
        shown = argv.__name__ if callable(argv) else " ".join(argv)
        base = clean
        if prep:
            base = os.path.join(SELFTEST_DIR, pid + "-clean")
            shutil.copytree(clean, base, symlinks=True)
            prep(base)
        code, out = probe_run(argv, base)
        if code != 0:
            failures.append("{} ({}): `{}` fails on the unplanted copy:\n{}".format(pid, finding, shown, out[-1500:]))
            continue
        d = os.path.join(SELFTEST_DIR, pid)
        shutil.copytree(clean, d, symlinks=True)
        if prep:
            prep(d)
        plant(d)
        code, out = probe_run(argv, d)
        lines = out.splitlines()
        missing = [w for w in want if not any(re.search(w, ln) for ln in lines)]
        if code != 1 or missing:
            failures.append("{} ({}): `{}` exit {}; not reported: {}\n{}".format(
                pid, finding, shown, code, missing, out[-1500:]))
        else:
            print("X-tools {} ({}): {} planted faults reported".format(pid, finding, len(want)))
    if failures:
        for f in failures:
            print("X-tools FAIL " + f)
        raise Fail("X-tools: {} of {} probes not caught".format(len(failures), len(plist)))
    shutil.rmtree(SELFTEST_DIR)
    print("X-tools: PASS ({} probes)".format(len(plist)))


