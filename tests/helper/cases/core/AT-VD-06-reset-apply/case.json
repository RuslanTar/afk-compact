{
 "id": "AT-VD-06 (visible defaults: settings reset --apply)",
 "owner": "core",
 "note": "0.1.2 visible defaults (spec Behaviour 4): `settings reset … --apply` removes exactly the named members of this plugin's pluginConfigs options by a text splice, so every other byte of the settings file stays (order, spacing, other plugins' options, unknown keys; jsonc::decode returns unordered hashes and a re-encode would reorder the file). Before it writes it saves a backup of the whole file next to it (settings.json.<plugin>-<stamp>.bak, mode 0600; a second one in the same second gets -2), checks that the new text decodes to the old settings minus those members, and writes atomically to the file's real path with its mode (a symlinked settings.json keeps its link). An emptied options object stays {}. Each removal prints as old -> default. All of it is the settings writer's (lib/settings_write.pm). --all leaves the consent and protective keys and keys the plugin does not know; a consent key named is refused, the writer never writes one. Refused (exit 3, nothing written, no backup): a consent key, a file changed since the dry run (--plan), a file with comments, a file that is not JSON, and a file that names a member on the path twice.",
 "now": "2026-10-30T09:00:00+02:00",
 "tz": "Etc/GMT-2",
 "steps": [
  {
   "setup": [
    {
     "write": "$HOME/.claude/settings.json",
     "mode": "0644",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"compact_target_tokens\": 350000,\n        \"cooldown_ms\": 20000,\n        \"relaunch_auto\": \"off\"\n      }\n    }\n  },\n  \"alpha\": [1, 2]\n}\n"
    },
    {
     "write": "$TMP/expect/orig.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"compact_target_tokens\": 350000,\n        \"cooldown_ms\": 20000,\n        \"relaunch_auto\": \"off\"\n      }\n    }\n  },\n  \"alpha\": [1, 2]\n}\n"
    },
    {
     "write": "$TMP/expect/a1.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"cooldown_ms\": 20000,\n        \"relaunch_auto\": \"off\"\n      }\n    }\n  },\n  \"alpha\": [1, 2]\n}\n"
    },
    {
     "write": "$TMP/expect/a2.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"relaunch_auto\": \"off\"\n      }\n    }\n  },\n  \"alpha\": [1, 2]\n}\n"
    },
    {
     "write": "$TMP/expect/a3.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1\n      }\n    }\n  },\n  \"alpha\": [1, 2]\n}\n"
    }
   ]
  },
  {
   "name": "one key: only that member goes; a backup of the whole file; mode kept",
   "argv": [
    "settings",
    "reset",
    "compact_target_tokens",
    "--apply"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^settings reset: removed compact_target_tokens from ~/\\.claude/settings\\.json \\(plugin options under \"$BRAND@m\"\\)$",
     "^  compact_target_tokens: 350000 -> default 400000 \\(removed\\)$",
     "^  backup: ~/\\.claude/settings\\.json\\.$BRAND-2026-10-30_09-00-00\\.bak \\(the file as it was\\)$",
     "^  takes effect: "
    ],
    "files": [
     {
      "path": "$TMP/expect/orig.json",
      "snapshot": "orig"
     },
     {
      "path": "$TMP/expect/a1.json",
      "snapshot": "a1"
     },
     {
      "path": "$HOME/.claude/settings.json",
      "same_bytes_as": "a1",
      "mode": "0644"
     },
     {
      "path": "$HOME/.claude/settings.json.$BRAND-*.bak",
      "count": 1
     },
     {
      "path": "$HOME/.claude/settings.json.$BRAND-2026-10-30_09-00-00.bak",
      "same_bytes_as": "orig",
      "mode": "0600"
     }
