        if not os.path.exists(log) or read(log) != "dropped 1\n":
            problems.append("stubs: bin/git-noexclude wrote no `dropped 1` line to GIT_NOEXCLUDE_LOG")
    except (RuntimeError, OSError, subprocess.SubprocessError) as e:
