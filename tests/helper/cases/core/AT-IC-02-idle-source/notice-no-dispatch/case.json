    "transcript_path": "$TMP/projects/-tmp-example-repo/$SID.jsonl",
    "cwd": "$TMP/example-repo",
    "hook_event_name": "Stop",
    "stop_hook_active": false
   },
   "expect": {
    "exit": 0,
    "rows": [
     {
