{
 "id": "AT-SW-01 (settings writer: settings set, dry run and apply)",
 "owner": "core",
 "note": "0.1.2 settings writer (helper writer for the non-consent keys): `settings set <key>=<value>...` is a dry run unless --apply; it lists each change as old -> new and the --plan of the file. The apply edits exactly those members of pluginConfigs[\"<plugin>@<marketplace>\"].options by a text splice (a value replaced, a member inserted after the last one with its spacing, a member removed), so every other key keeps its bytes (and so its meaning: env, permissions, another plugin's options, an unknown option key, numbers written 2.50, a \\u escape, non-ASCII text). A value equal to its default (or empty) removes the member, so a default is never written. It saves the whole file as settings.json.<plugin>-<stamp>.bak next to it (mode 0600; -2 for a second one in the same second), keeps the file's mode and writes through a symbolic link. A missing options object, plugin entry or pluginConfigs is created, the key taken from the one enabledPlugins entry of the plugin (or its installed folder); the file's indent (tabs here) and line break (CRLF) are kept. A number the clamp lowers once the change is in (a target over two thirds of the soft max, a soft max or target over what a configured window allows) is written as given with a note in the dry run and the apply (a removal: put back to its default; a key the plan does not touch: not changed); one the clamp leaves gets none.",
 "now": "2026-10-30T09:00:00+02:00",
 "tz": "Etc/GMT-2",
 "steps": [
  {
   "setup": [
    {
     "write": "$HOME/.claude/settings.json",
     "mode": "0644",
     "mtime_ago_s": 3600,
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"env\": {\"ZZ_UNRELATED\": \"keep me\"},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"compact_target_tokens\": 300000,\n        \"cooldown_ms\": 20000\n      }\n    }\n  },\n  \"alpha\": [1, 2.50, {\"b\": null}],\n  \"note\": \"naïve \\u00e9\"\n}\n"
    },
    {
     "write": "$TMP/expect/orig.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"env\": {\"ZZ_UNRELATED\": \"keep me\"},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"compact_target_tokens\": 300000,\n        \"cooldown_ms\": 20000\n      }\n    }\n  },\n  \"alpha\": [1, 2.50, {\"b\": null}],\n  \"note\": \"naïve \\u00e9\"\n}\n"
    },
    {
     "write": "$TMP/expect/a1.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"env\": {\"ZZ_UNRELATED\": \"keep me\"},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"compact_target_tokens\": 350000,\n        \"watcher\": \"false\"\n      }\n    }\n  },\n  \"alpha\": [1, 2.50, {\"b\": null}],\n  \"note\": \"naïve \\u00e9\"\n}\n"
    },
    {
     "write": "$TMP/expect/a2.json",
     "text": "{\n  \"model\": \"opus\",\n  \"permissions\": {\"allow\": [\"Bash(ls)\"]},\n  \"env\": {\"ZZ_UNRELATED\": \"keep me\"},\n  \"pluginConfigs\": {\n    \"other@m\": {\"options\": {\"compact_target_tokens\": 1}},\n    \"$BRAND@m\": {\n      \"options\": {\n        \"zeta_unknown\": 1,\n        \"compact_target_tokens\": 350000,\n        \"watcher\": \"false\",\n        \"triggers\": false,\n        \"log_dir\": \"~/afk logs\"\n      }\n    }\n  },\n  \"alpha\": [1, 2.50, {\"b\": null}],\n  \"note\": \"naïve \\u00e9\"\n}\n"
    }
   ]
  },
  {
   "name": "snapshots",
   "argv": [
    "settings",
    "show"
   ],
   "expect": {
    "exit": 0,
    "files": [
     {
      "path": "$HOME/.claude/settings.json",
      "snapshot": "live"
     },
     {
      "path": "$TMP/expect/orig.json",
      "snapshot": "orig"
     },
     {
      "path": "$TMP/expect/a1.json",
      "snapshot": "a1"
     },
     {
      "path": "$TMP/expect/a2.json",
      "snapshot": "a2"
     }
    ]
   }
  },
