{
 "id": "HT-ST-01",
 "tmp_base": "repo",
 "layer": "H",
 "owner": "skills",
 "note": "stamp: a full stamp YYYY-MM-DD HH:MM +hhmm on the stage's day and after midnight alike (RV-24, AT-TS-01); each stamp appended to stamps.log; a directory that is not a stage -> REFUSED: no-stage",
 "now": "2026-10-21T23:58:00+03:00",
 "tz": "Etc/GMT-3",
 "setup": [
  {
   "repo": {
    "branch": "feature/LAB-7-retry",
    "commits": [
     {
      "files": {
       "app/retry.rb": "x = 1\n"
      },
      "msg": "seed"
     }
    ]
   },
   "at": "$TMP/repo"
  }
 ],
 "cwd": "$TMP/repo",
 "argv": [
  "begin",
  "--sid",
  "$SID",
  "--topic",
  "retry"
 ],
 "capture": {
  "STAGE": "json:stage",
  "NONCE": "json:nonce",
  "STEM": "json:stem"
 },
 "expect": {
  "exit": 0
 },
 "then": [
  {
   "argv": [
    "stamp",
    "--stage",
    "$STAGE"
   ],
   "now": "2026-10-21T23:59:30+03:00",
   "expect": {
    "exit": 0,
    "stdout": "2026-10-21 23:59 +0300\n"
   }
  },
  {
   "argv": [
    "stamp",
    "--stage",
    "$STAGE"
   ],
   "now": "2026-10-22T00:01:00+03:00",
   "expect": {
    "exit": 0,
    "stdout": "2026-10-22 00:01 +0300\n",
    "files": [
     {
      "path": "$STAGE/stamps.log",
      "mode": "0600",
      "has": [
       "\\A2026-10-21T23:59:30\\+03:00\\t2026-10-21 23:59 \\+0300\\n2026-10-22T00:01:00\\+03:00\\t2026-10-22 00:01 \\+0300\\n\\z"
      ]
     }
    ]
   }
  },
  {
   "argv": [
    "stamp",
    "--stage",
    "$TMP/repo"
   ],
   "expect": {
    "exit": 3,
    "stdout": "REFUSED: no-stage\n"
   }
  },
  {
   "argv": [
    "stamp"
   ],
   "expect": {
    "exit": 64
   }
  }
 ]
}
