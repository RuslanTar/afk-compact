{
 "id": "USAGE-01-record",
 "note": "The shared usage record, <state>/<plugin>/usage.v1.json (0600): `usage --sid S --stdin` adds the session's own reading (source plugin, sid8 the id's first 8 characters; an entry out of form is dropped), `cache --stdin --note-usage` adds the status line's rate_limits (source statusline, read now), plain `cache --stdin` writes nothing. One entry per sid8, source and kind: the later `at` wins, an older one changes nothing. An entry is kept until its resets_at, however old; one past it, or one with no reset read or seen more than 10 minutes ago, is dropped at the next write; a torn file reads as empty; a reserved or missing --sid writes nothing. Every call exits 0 and prints the record. `usage` loads only util, jsonc, ctx, args, cachestate and usagerec (no setup path runs: no handoffs folder on a fresh HOME).",
 "now": "2026-11-09T12:00:00Z",
 "tz": "UTC",
 "steps": [
  {
   "name": "the own reading, and the libraries loaded",
   "argv": [
    "usage",
    "--sid",
    "$SID",
    "--stdin"
   ],
   "env": {
    "STORE_TEST_INC_OUT": "$TMP/inc.txt"
   },
   "stdin_json": {
    "at": 1794225570,
    "windows": [
     {
      "kind": "five_hour",
      "pct": 44,
      "resets_at": 1794240000
     },
     {
      "kind": "seven_day",
      "pct": 21,
      "resets_at": null
     },
     {
      "kind": "Bad Kind",
      "pct": 3
     },
     {
      "kind": "spend_limit",
      "pct": "x"
     }
    ]
   },
   "expect": {
    "exit": 0,
    "json": {
     "schema": "$BRAND-usage/v1",
     "now": 1794225600,
     "readings": {
      "len": 2
     },
     "readings.0.kind": "five_hour",
     "readings.0.pct": 44,
     "readings.0.resets_at": 1794240000,
     "readings.0.at": 1794225570,
     "readings.0.src": "plugin",
     "readings.0.sid8": "$SID8",
     "readings.1.kind": "seven_day",
     "readings.1.resets_at": {
      "null": true
     }
    },
    "files": [
     {
      "path": "$HOME/.local/state/$BRAND/usage.v1.json",
      "mode": "0600",
      "json": {
       "schema": "$BRAND-usage/v1"
      }
     },
     {
      "path": "$TMP/inc.txt",
      "lines": 1,
      "has": [
       "^args cachestate ctx jsonc usagerec util$"
      ]
     }
    ],
    "absent": [
     "$HOME/.local/state/$BRAND/handoffs"
    ]
   }
  },
  {
   "name": "the status line's rate_limits through cache --note-usage (the line itself unchanged: nothing to read)",
   "argv": [
    "cache",
    "--stdin",
    "--note-usage"
   ],
   "stdin_json": {
    "session_id": "5e55a002-0000-4000-8000-0000000000b2",
    "rate_limits": {
     "five_hour": {
      "used_percentage": 93,
      "resets_at": 1794240000
     },
     "seven_day": {
      "used_percentage": 96,
      "resets_at": 1794492000
     }
    }
   },
   "expect": {
    "exit": 0,
    "stdout": ""
   }
  },
  {
   "name": "read back: the status line's two entries first (read now)",
   "argv": [
    "usage"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 4
     },
     "readings.0.src": "statusline",
     "readings.0.sid8": "5e55a002",
     "readings.0.kind": "five_hour",
     "readings.0.pct": 93,
     "readings.0.at": 1794225600,
     "readings.1.kind": "seven_day",
     "readings.1.pct": 96
    }
   }
  },
  {
   "name": "cache --stdin without --note-usage writes nothing",
   "argv": [
    "cache",
    "--stdin"
   ],
   "stdin_json": {
    "session_id": "5e55a003-0000-4000-8000-0000000000c3",
    "rate_limits": {
     "five_hour": {
      "used_percentage": 10,
      "resets_at": 1794240000
     }
    }
   },
   "expect": {
    "exit": 0,
    "stdout": ""
   }
  },
  {
   "name": "still four entries",
   "argv": [
    "usage"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 4
     }
    }
   }
  },
  {
   "name": "an older reading of the same session and kind changes nothing",
   "argv": [
    "usage",
    "--sid",
    "$SID",
    "--stdin"
   ],
   "stdin_json": {
    "at": 1794225500,
    "windows": [
     {
      "kind": "five_hour",
      "pct": 50,
      "resets_at": 1794240000
     }
    ]
   },
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 4
     },
     "readings.2.pct": 44,
     "readings.2.at": 1794225570
    }
   }
  },
  {
   "name": "a later one replaces it",
   "argv": [
    "usage",
    "--sid",
    "$SID",
    "--stdin"
   ],
   "stdin_json": {
    "at": 1794225590,
    "windows": [
     {
      "kind": "five_hour",
      "pct": 45,
      "resets_at": 1794240000
     }
    ]
   },
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 4
     },
     "readings.2.pct": 45,
     "readings.2.at": 1794225590,
     "readings.2.src": "plugin"
    }
   }
  },
  {
   "name": "a reserved session id writes nothing",
   "argv": [
    "usage",
    "--sid",
    "unknown",
    "--stdin"
   ],
   "stdin_json": {
    "at": 1794225599,
    "windows": [
     {
      "kind": "five_hour",
      "pct": 1,
      "resets_at": 1794240000
     }
    ]
   },
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 4
     }
    }
   }
  },
  {
   "name": "an entry 76 min old whose window resets later is kept; one past its reset, and one with no reset time 11 min old, are dropped at the next write (one with none 8 min old is kept)",
   "setup": [
    {
     "write": "$HOME/.local/state/$BRAND/usage.v1.json",
     "json": {
      "schema": "$BRAND-usage/v1",
      "updated_at": 1794221000,
      "readings": [
       {
        "kind": "five_hour",
        "pct": 30,
        "resets_at": 1794240000,
        "at": 1794221000,
        "src": "plugin",
        "sid8": "5e55a004"
       },
       {
        "kind": "five_hour",
        "pct": 31,
        "resets_at": 1794225000,
        "at": 1794225500,
        "src": "plugin",
        "sid8": "5e55a005"
       },
       {
        "kind": "five_hour",
        "pct": 32,
        "resets_at": null,
        "at": 1794224900,
        "src": "plugin",
        "sid8": "5e55a006"
       },
       {
        "kind": "five_hour",
        "pct": 33,
        "resets_at": null,
        "at": 1794225100,
        "src": "plugin",
        "sid8": "5e55a007"
       }
      ]
     }
    }
   ],
   "argv": [
    "usage",
    "--sid",
    "$SID",
    "--stdin"
   ],
   "stdin_json": {
    "at": 1794225600,
    "windows": [
     {
      "kind": "seven_day",
      "pct": 22,
      "resets_at": 1794492000
     }
    ]
   },
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 3
     },
     "readings.0.sid8": "$SID8",
     "readings.1.sid8": "5e55a007",
     "readings.2.sid8": "5e55a004",
     "readings.2.at": 1794221000
    }
   }
  },
  {
   "name": "a torn file reads as empty",
   "setup": [
    {
     "write": "$HOME/.local/state/$BRAND/usage.v1.json",
     "content": "{\"schema\": \"x"
    }
   ],
   "argv": [
    "usage"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "readings": {
      "len": 0
     }
    }
   }
  }
 ]
}
