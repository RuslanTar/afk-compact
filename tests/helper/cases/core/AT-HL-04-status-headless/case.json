{
 "id": "AT-HL-04 (status, headless session)",
 "note": "Headless probe 2026-10-27: under claude -p or the Agent SDK, Claude Code rejects $.session.compact, so the mod logs one headless row (via session-start or compact-rejected) and neither nudges nor compacts. status then says automatic compaction needs an interactive session; a later session start row of the same session (an interactive load) clears the line.",
 "now": "2026-10-27T10:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "no headless row: no line",
   "setup": [{"write": "$WATCH/$SID.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-27T10:00:00+03:00", "ev": "session", "sid": "$SID", "actor": "main", "writer": "mod", "phase": "start", "mod_loaded": true}]}],
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_lacks": ["^automatic compaction: "]}},
  {"name": "a headless row after the session start: the line",
   "setup": [{"write": "$WATCH/$SID.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-27T10:00:00+03:00", "ev": "session", "sid": "$SID", "actor": "main", "writer": "mod", "phase": "start", "mod_loaded": true},
     {"v": 1, "ts": "2026-10-27T10:00:00+03:00", "ev": "headless", "sid": "$SID", "actor": "main", "writer": "mod", "via": "session-start"}]}],
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0,
    "stdout_has": ["^automatic compaction: needs an interactive session; this one is headless \\(claude -p or the Agent SDK\\), so the plugin does not nudge or start compactions here; Claude Code's own automatic compaction still runs$"]}},
  {"name": "found by a rejection, no session row: the line",
   "setup": [{"write": "$WATCH/$SID.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-27T10:01:00+03:00", "ev": "compact_rejected", "sid": "$SID", "actor": "main", "writer": "mod", "nonce": "1a2b3c4d", "attempt": 1, "error_class": "headless", "error": "not available in a headless (-p / SDK) session yet"},
     {"v": 1, "ts": "2026-10-27T10:01:00+03:00", "ev": "headless", "sid": "$SID", "actor": "main", "writer": "mod", "via": "compact-rejected"}]}],
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["^automatic compaction: needs an interactive session; "]}},
  {"name": "a later interactive start of the same session: no line",
   "setup": [{"write": "$WATCH/$SID.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-27T10:00:00+03:00", "ev": "session", "sid": "$SID", "actor": "main", "writer": "mod", "phase": "start", "mod_loaded": true},
     {"v": 1, "ts": "2026-10-27T10:00:00+03:00", "ev": "headless", "sid": "$SID", "actor": "main", "writer": "mod", "via": "session-start"},
     {"v": 1, "ts": "2026-10-27T10:04:00+03:00", "ev": "session", "sid": "$SID", "actor": "main", "writer": "mod", "phase": "start", "mod_loaded": true}]}],
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_lacks": ["^automatic compaction: "]}}
 ]
}
