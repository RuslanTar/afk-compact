    ],
    "absent": [
     "$WATCH/$SID/swept/4d5e6f",
     "$TMP/rel"
    ],
    "files": [
     {
      "path": "$TMP/trace-5.log",
      "same_bytes_as": "no-root-git"
     }
    ]
   }
  },
