{
 "id": "CACHE-07-shim-directory-marketplace",
 "note": "0.1.9: a copy Claude Code reads in place from a directory marketplace (`claude plugin install <name> --marketplace <folder>`; `claude plugin list` names it under \"Read from\", while installed_plugins.json still records a cache installPath) counts as installed: its folder lies at or under a marketplace in <config>/plugins/known_marketplaces.json (installLocation, or a directory or file source's folder) that installed_plugins.json has the plugin installed from (settings::load_source). So its SessionStart keeps the status line's shim and points an older version's at itself, its data folder is <name>-<marketplace>, the options are pluginConfigs[<name>@<marketplace>], and its load records take the scope of that install's cache folder. The same folder loaded with --plugin-dir (CLAUDE_PLUGIN_DATA the <name>-inline folder) and a marketplace the plugin is not installed from stay dev loads: no shim. CACHE-05 holds the cache layout, CACHE-06 the --plugin-dir one.",
 "now": "2026-11-11T07:00:00Z",
 "tz": "UTC",
 "plugin_at": "$HOME/mkt/rel/plugin",
 "manifest": {
  "version": "9.0.0"
 },
 "options": {
  "watcher": "false"
 },
 "env": {
  "STORE_TEST_MACHINE_ID": "TEST-MACHINE-1"
 },
 "steps": [
  {
   "name": "a directory marketplace's copy: an older version's shim pointed here, data folder <name>-m, user scope",
   "env": {
    "CLAUDE_PLUGIN_ROOT": "$PLUGIN",
    "CLAUDE_PLUGIN_DATA": "$HOME/.claude/plugins/data/$BRAND-m",
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.322"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "trace_has": [
     "cache-shim written"
    ],
    "files": [
     {
      "path": "$HOME/.local/state/$BRAND/bin/$BRAND-store",
      "contains": [
       "#!/bin/sh\n# $BRAND: a fixed path to the installed plugin's helper, for status lines (README: the cache state in your status line); kept by its SessionStart hook.\nexec '$STORE' \"$@\"\n"
      ]
     },
     {
      "path": "$HOME/.claude/plugins/data/$BRAND-m/last-version",
      "has": [
       "\\A2\\.1\\.322\\n\\z"
      ]
     },
     {
      "path": "$ROOT/.sessions/loads/*_9.0.0_$UTAG.json",
      "count": 1
     }
    ],
    "absent": [
     "$HOME/.claude/plugins/data/$BRAND-inline"
    ]
   },
   "setup": [
    {
     "mkdir": "$TMP/work"
    },
    {
     "write": "$HOME/.claude/plugins/known_marketplaces.json",
     "json": {
      "m": {
       "source": {
        "source": "directory",
        "path": "$HOME/mkt/rel"
       },
       "installLocation": "$HOME/mkt/rel",
       "lastUpdated": "2026-11-11T04:26:08.577Z"
      }
     }
    },
    {
     "write": "$HOME/.claude/plugins/installed_plugins.json",
     "json": {
      "version": 2,
      "plugins": {
       "$BRAND@m": [
        {
         "scope": "user",
         "installPath": "$HOME/.claude/plugins/cache/m/$BRAND/9.0.0",
         "version": "9.0.0",
         "installedAt": "2026-11-11T04:26:09.257Z",
         "lastUpdated": "2026-11-11T04:26:09.257Z"
        }
       ]
      }
     }
    },
    {
     "write": "$HOME/old/.claude-plugin/plugin.json",
     "json": {
      "name": "$BRAND",
      "version": "0.1.8"
     }
    },
    {
     "write": "$HOME/old/scripts/$BRAND-store",
     "content": "#!/bin/sh\n",
     "mode": "0755"
    },
    {
     "write": "$HOME/.local/state/$BRAND/bin/$BRAND-store",
     "content": "#!/bin/sh\n# $BRAND: a fixed path to the installed plugin's helper, for status lines (README: the cache state in your status line); kept by its SessionStart hook.\nexec '$HOME/old/scripts/$BRAND-store' \"$@\"\n",
     "mode": "0755"
    },
    {
     "sha_tag": "user\n$HOME/.claude/plugins/cache/m/$BRAND",
     "var": "UTAG"
    }
   ]
  },
  {
   "name": "its options: pluginConfigs[<name>@m], not @inline",
   "env": {
    "CLAUDE_PLUGIN_ROOT": "$PLUGIN"
   },
   "argv": [
    "settings",
    "show",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "config_key": "$BRAND@m",
     "config_key_state": "found",
     "settings.watcher.value": "false",
     "settings.watcher.source": "settings"
    }
   }
  },
  {
   "name": "the same folder as a --plugin-dir load (<name>-inline data folder): no shim change",
   "env": {
    "CLAUDE_PLUGIN_ROOT": "$PLUGIN",
    "CLAUDE_PLUGIN_DATA": "$HOME/.claude/plugins/data/$BRAND-inline",
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.322"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "trace_has": [
     "cache-shim dev-load"
    ],
    "files": [
     {
      "path": "$HOME/.local/state/$BRAND/bin/$BRAND-store",
      "contains": [
       "#!/bin/sh\n# $BRAND: a fixed path to the installed plugin's helper, for status lines (README: the cache state in your status line); kept by its SessionStart hook.\nexec '$HOME/old/scripts/$BRAND-store' \"$@\"\n"
      ]
     }
    ]
   },
   "setup": [
    {
     "write": "$HOME/old/.claude-plugin/plugin.json",
     "json": {
      "name": "$BRAND",
      "version": "0.1.8"
     }
    },
    {
     "write": "$HOME/old/scripts/$BRAND-store",
     "content": "#!/bin/sh\n",
     "mode": "0755"
    },
    {
     "write": "$HOME/.local/state/$BRAND/bin/$BRAND-store",
     "content": "#!/bin/sh\n# $BRAND: a fixed path to the installed plugin's helper, for status lines (README: the cache state in your status line); kept by its SessionStart hook.\nexec '$HOME/old/scripts/$BRAND-store' \"$@\"\n",
     "mode": "0755"
    }
   ]
  },
  {
   "name": "a marketplace the plugin is not installed from: a dev load",
   "env": {
    "CLAUDE_PLUGIN_ROOT": "$PLUGIN",
    "CLAUDE_PLUGIN_DATA": "$HOME/.claude/plugins/data/$BRAND-m",
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.322"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "trace_has": [
     "cache-shim dev-load"
    ],
    "files": [
     {
      "path": "$HOME/.local/state/$BRAND/bin/$BRAND-store",
      "contains": [
       "#!/bin/sh\n# $BRAND: a fixed path to the installed plugin's helper, for status lines (README: the cache state in your status line); kept by its SessionStart hook.\nexec '$HOME/old/scripts/$BRAND-store' \"$@\"\n"
      ]
     }
    ]
   },
   "setup": [
    {
     "write": "$HOME/.claude/plugins/installed_plugins.json",
     "json": {
      "version": 2,
      "plugins": {
       "$BRAND@other": [
        {
         "scope": "user",
         "installPath": "$HOME/.claude/plugins/cache/m/$BRAND/9.0.0",
         "version": "9.0.0",
         "installedAt": "2026-11-11T04:26:09.257Z",
         "lastUpdated": "2026-11-11T04:26:09.257Z"
        }
       ]
      }
     }
    }
   ]
  },
  {
   "name": "a file-source marketplace (<folder>/.claude-plugin/marketplace.json) it is installed from: written",
   "env": {
    "CLAUDE_PLUGIN_ROOT": "$PLUGIN",
    "CLAUDE_PLUGIN_DATA": "$HOME/.claude/plugins/data/$BRAND-m",
    "CLAUDE_CODE_EXECPATH": "$TMP/versions/2.1.322"
   },
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "trace_has": [
     "cache-shim written"
    ],
    "files": [
     {
      "path": "$HOME/.local/state/$BRAND/bin/$BRAND-store",
      "contains": [
       "#!/bin/sh\n# $BRAND: a fixed path to the installed plugin's helper, for status lines (README: the cache state in your status line); kept by its SessionStart hook.\nexec '$STORE' \"$@\"\n"
      ]
     }
    ]
   },
   "setup": [
    {
     "write": "$HOME/.claude/plugins/known_marketplaces.json",
     "json": {
      "m": {
       "source": {
        "source": "file",
        "path": "$HOME/mkt/rel/.claude-plugin/marketplace.json"
       },
       "installLocation": "$HOME/.claude/plugins/marketplaces/m",
       "lastUpdated": "2026-11-11T04:26:08.577Z"
      }
     }
    },
    {
     "write": "$HOME/.claude/plugins/installed_plugins.json",
     "json": {
      "version": 2,
      "plugins": {
       "$BRAND@m": [
        {
         "scope": "user",
         "installPath": "$HOME/.claude/plugins/cache/m/$BRAND/9.0.0",
         "version": "9.0.0",
         "installedAt": "2026-11-11T04:26:09.257Z",
         "lastUpdated": "2026-11-11T04:26:09.257Z"
        }
       ]
      }
     }
    }
   ]
  }
 ]
}
