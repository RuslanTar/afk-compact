     {"v": 1, "ts": "2026-10-21T13:40:00+03:00", "ev": "alert", "sid": "$SID", "actor": "main", "writer": "classic",
      "alert_id": "a15-00000001", "rule": "A-15", "severity": "info", "key": {"session_id": "$SID"}, "evidence": {}},
     {"v": 1, "ts": "2026-10-21T13:51:00+03:00", "ev": "alert", "sid": "$SID", "actor": "main", "writer": "classic",
      "alert_id": "a05-00000002", "rule": "A-05", "severity": "warn", "key": {"session_id": "$SID"}, "evidence": {}},
     {"v": 1, "ts": "2026-10-21T13:52:00+03:00", "ev": "alert", "sid": "$SID", "actor": "main", "writer": "classic",
      "alert_id": "a01-00000003", "rule": "A-01", "severity": "critical", "key": {"session_id": "$SID"}, "evidence": {}},
     {"v": 1, "ts": "2026-10-21T13:53:00+03:00", "ev": "alert", "sid": "$SID", "actor": "main", "writer": "classic",
      "alert_id": "a05-00000004", "rule": "A-05", "severity": "warn", "key": {"session_id": "$SID"}, "evidence": {}}]}
   ],
   "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\Aattention: 3 open alerts \\(A-01, A-05\\); 2/3 compactions saved this session\\nwatcher: true · "]}},
  {"name": "without a session id: every session's last 7 days",
   "setup": [
    {"write": "$WATCH/5e55a0ff-0000-4000-8000-0000000000a1/compactions.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-20T10:00:00+03:00", "ev": "compaction", "sid": "5e55a0ff-0000-4000-8000-0000000000a1", "actor": "main",
      "writer": "helper", "nonce": "b0b00001", "copy": "saved", "copy_path": "repo/general/compact/c.md", "precomputed": false},
     {"v": 1, "ts": "2026-10-01T10:00:00+03:00", "ev": "compaction", "sid": "5e55a0ff-0000-4000-8000-0000000000a1", "actor": "main",
      "writer": "helper", "nonce": "b0b00002", "copy": "failed:io", "copy_path": null, "precomputed": false}]},
    {"write": "$WATCH/5e55a0ff-0000-4000-8000-0000000000a1.alerts.jsonl", "jsonl": [
