{
 "id": "AT-ON-01 (settings show: the data of the onboarding settings flow)",
 "note": "0.1.2 onboarding, Load step: `settings show --json` prints one object per userConfig key (key, title, section, tier, kind, default, min, max, values, value, source, class) in the section order of settings.pm @SECTIONS, the pluginConfigs key in use and why a write there would be refused (config-dir-foreign, home-foreign, unreadable, unparseable, inline, ambiguous: a file that exists but cannot be read, or whose plugin entry or options is not an object, is never absent or found). Defaults, min and max come from the manifest (the settings_view builtin checks every row against it and each key's tier against the case's common list, and each section's key count is pinned for both tiers); `clamped` is true for a number the clamp moves (the watcher's export flag); value and source from settings::resolve (flag, env, settings, default, safe). Every manifest key is in a section (`unsectioned` is empty; the settings-sections gate checks the table too). Read-only: the settings file is unchanged. `--tier` filters the rows; the text form prints one line per key. No write verb yet (OPEN-1)",
 "now": "2026-10-30T12:00:00+02:00",
 "tz": "Etc/GMT-2",
 "steps": [
  {"name": "no settings file: every key at its manifest default",
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"unsectioned": {"len": 0}, "sections": {"len": 6},
              "sections.0.id": "compaction", "sections.5.id": "safety",
              "sections.0.keys": {"len": 12}, "sections.1.keys": {"len": 6}, "sections.2.keys": {"len": 9},
              "sections.3.keys": {"len": 7}, "sections.4.keys": {"len": 4}, "sections.5.keys": {"len": 7},
              "sections.0.keys.0": "triggers",
              "config_key": {"null": true}, "config_key_state": "absent", "write_refused": {"null": true},
              "settings.watcher.default": "shadow", "settings.watcher.value": "shadow", "settings.watcher.source": "default",
              "settings.watcher.section": "logs", "settings.watcher.tier": "common", "settings.watcher.kind": "enum",
              "settings.watcher.values": {"len": 2}, "settings.watcher.values.0": "shadow",
              "settings.watcher.title": "Local compaction logs [default shadow]",
              "settings.triggers.default": true, "settings.triggers.value": true, "settings.triggers.kind": "boolean",
              "settings.max_auto_continues_per_hour.default": 6, "settings.max_auto_continues_per_hour.min": 0,
              "settings.max_auto_continues_per_hour.max": 10, "settings.max_auto_continues_per_hour.kind": "number",
              "settings.compact_target_tokens.min": 100000, "settings.compact_target_tokens.max": {"null": true},
              "settings.cooldown_ms.tier": "advanced", "settings.cooldown_ms.section": "compaction",
              "settings.handoff_root.kind": "path", "settings.handoff_root.value": {"re": "/handoffs$"},
              "settings.disposable_root.kind": "path", "settings.disposable_root.default": "~/.local/state/$BRAND/disposable",
              "settings.disposable_root.value": {"re": "/\\.local/state/[^/]+/disposable$"},
              "settings.ticket_pattern.kind": "text", "settings.prod_patterns.kind": "list",
              "settings.repo_roots.class": "consent", "settings.queue_cmd.class": "consent",
              "settings.restart_on_update.class": "consent", "settings.prod_patterns.class": "protective",
              "settings.protected_branches.class": "protective", "settings.watcher.class": {"null": true},
              "settings.repo_roots.section": "safety", "settings.relaunch_auto.section": "jobs"}}},
  {"name": "every manifest key has one row in one section, its title, default, min and max the manifest's",
   "lib": "settings_view", "args": {"home": "$HOME",
     "common": ["triggers", "compact_target_tokens", "native_window_tokens", "max_auto_continues_per_hour", "handoff_turn",
                "precompact_turn", "idle_compact", "idle_handoff_turn", "idle_digest", "idle_handoff_min_tokens", "idle_handoff_near_limit", "keep_warm_hours", "handoff_root",
                "log_dir", "disposable_root", "resume_proceed", "handoff_reuse_window_min", "warn_ui", "watcher", "stall_min",
                "measured_block", "auto_evidence", "relaunch_quiet_s", "relaunch_auto", "relaunch_allow", "queue_cmd",
                "repo_roots", "unattended_prod_reads", "restart_on_update", "prod_patterns", "secret_extra_rules",
                "protected_branches"]}},
  {"name": "the settings file's values, the env and a flag; consent keys ignore env and flags",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"theme": "dark", "pluginConfigs": {"other@x": {"options": {"a": 1}},
              "$BRAND@m": {"options": {"cooldown_ms": 20000, "watcher": "off", "relaunch_auto": "shadow"}}}}}],
   "argv": ["settings", "show", "--json", "--keep-days", "3"],
   "env": {"CLAUDE_PLUGIN_OPTION_STALL_MIN": "90", "CLAUDE_PLUGIN_OPTION_RELAUNCH_AUTO": "off"},
   "expect": {"exit": 0,
     "json": {"config_key": "$BRAND@m", "config_key_state": "found", "write_refused": {"null": true},
              "settings.cooldown_ms.value": 20000, "settings.cooldown_ms.source": "settings", "settings.cooldown_ms.default": 30000,
              "settings.watcher.value": "off", "settings.watcher.source": "settings",
              "settings.stall_min.value": 90, "settings.stall_min.source": "env",
              "settings.disposable_keep_days.value": 3, "settings.disposable_keep_days.source": "flag",
              "settings.relaunch_auto.value": "shadow", "settings.relaunch_auto.source": "settings",
              "notes.0": "relaunch_auto: settings file only"},
     "files": [{"path": "$HOME/.claude/settings.json", "has": ["\"theme\"", "other@x", "\"cooldown_ms\": ?20000"]}]}},
  {"name": "--tier advanced: only the advanced rows, in their sections",
   "argv": ["settings", "show", "--json", "--tier", "advanced"],
   "expect": {"exit": 0,
     "json": {"settings.cooldown_ms.tier": "advanced", "settings.watcher": {"null": true},
              "sections.0.id": "compaction", "sections.0.keys.0": "compact_soft_max_tokens",
              "sections": {"len": 4}, "sections.1.id": "handoffs", "sections.2.id": "logs", "sections.3.id": "safety",
              "sections.0.keys": {"len": 6}, "sections.1.keys": {"len": 4}, "sections.2.keys": {"len": 2},
              "sections.3.keys": {"len": 1}}}},
  {"name": "--tier common: each section's common keys pinned (32 common, 13 advanced)",
   "argv": ["settings", "show", "--json", "--tier", "common"],
   "expect": {"exit": 0,
     "json": {"settings.cooldown_ms": {"null": true}, "settings.otel_log_path": {"null": true}, "sections": {"len": 6},
              "sections.0.keys": {"len": 6}, "sections.1.keys": {"len": 6}, "sections.2.keys": {"len": 5},
              "sections.3.keys": {"len": 5}, "sections.4.keys": {"len": 4}, "sections.5.keys": {"len": 6}}}},
  {"name": "the text form: a heading per section, one line per key with its source",
   "argv": ["settings", "show", "--tier", "common"],
   "expect": {"exit": 0,
     "stdout_has": ["^Compaction$", "^  watcher = off \\(settings\\)$", "^  triggers = true \\(default\\)$",
                    "^  repo_roots = \\(empty\\) \\(default; consent key, settings file only\\)$",
                    "^pluginConfigs key: $BRAND@m$"],
     "stdout_lacks": ["cooldown_ms"]}},
  {"name": "two keys for the plugin: ambiguous, no key in use, writes refused",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {"watcher": "off"}},
              "$BRAND@n": {"options": {"watcher": "shadow"}}}}}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": {"null": true}, "config_key_state": "ambiguous", "write_refused": "ambiguous",
              "settings.watcher.source": "default"}}},
  {"name": "a settings file that does not parse: unparseable, no key in use, writes refused",
   "setup": [{"write": "$HOME/.claude/settings.json", "content": "{\"pluginConfigs\": {\"$BRAND@m\": {\"options\": {\"watcher\": \"off\"}}},"}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": {"null": true}, "config_key_state": "unparseable", "write_refused": "unparseable",
              "settings.watcher.source": "default"}}},
  {"name": "pluginConfigs not an object: unparseable too",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"theme": "dark", "pluginConfigs": ["$BRAND@m"]}}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0, "json": {"config_key_state": "unparseable", "write_refused": "unparseable"}}},
  {"name": "the plugin's key with no options: found, the key kept",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"enabled": true}}}}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": "$BRAND@m", "config_key_state": "found", "write_refused": {"null": true},
              "settings.watcher.source": "default"}}},
  {"name": "the plugin's entry not an object: unparseable, the key named, writes refused",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": "x"}}}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": "$BRAND@m", "config_key_state": "unparseable", "write_refused": "unparseable",
              "settings.watcher.source": "default"}}},
  {"name": "the plugin's options not an object: unparseable too",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": ["watcher", "off"]}}}}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": "$BRAND@m", "config_key_state": "unparseable", "write_refused": "unparseable",
              "settings.watcher.source": "default"}}},
  {"name": "a number the clamp moves: the configured value, clamped true; one within its limits and a non-number false",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {
              "max_auto_continues_per_hour": 50, "native_window_tokens": 50000, "cooldown_ms": 20000, "watcher": "off"}}}}}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"settings.max_auto_continues_per_hour.value": 50, "settings.max_auto_continues_per_hour.clamped": true,
              "settings.native_window_tokens.value": 50000, "settings.native_window_tokens.clamped": true,
              "settings.cooldown_ms.clamped": false, "settings.stall_min.clamped": false,
              "settings.watcher.clamped": false, "settings.triggers.clamped": false}}},
  {"name": "a --plugin-dir run (the plugin folder is not under the config dir's plugins/): the @inline key, writes refused",
   "setup": [{"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@inline": {"options": {"watcher": "off"}}}}}],
   "argv": ["settings", "show", "--json"],
   "env": {"CLAUDE_PLUGIN_ROOT": "$PLUGIN"},
   "expect": {"exit": 0,
     "json": {"config_key": "$BRAND@inline", "config_key_state": "found", "inline": true, "write_refused": "inline",
              "settings.watcher.value": "off"}}},
  {"name": "a foreign CLAUDE_CONFIG_DIR: consent keys take their safe values, writes refused",
   "setup": [{"write": "$TMP/cfg/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {"relaunch_auto": "on", "watcher": "off"}}}}}],
   "argv": ["settings", "show", "--json"],
   "env": {"CLAUDE_CONFIG_DIR": "$TMP/cfg"},
   "expect": {"exit": 0,
     "json": {"config_dir_foreign": true, "write_refused": "config-dir-foreign", "config_key": "$BRAND@m",
              "settings.relaunch_auto.value": "off", "settings.relaunch_auto.source": "safe",
              "settings.watcher.value": "off", "settings.watcher.source": "settings"}}},
  {"name": "a settings file that cannot be read (mode 0000): unreadable, writes refused, never absent",
   "setup": [{"write": "$HOME/.claude/settings.json", "content": "{\"pluginConfigs\": {}}", "mode": "0000"}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": {"null": true}, "config_key_state": "unreadable", "write_refused": "unreadable",
              "settings.watcher.source": "default"}}},
  {"name": "settings.json a folder: unreadable too",
   "setup": [{"rename": "$HOME/.claude/settings.json", "to": "$TMP/settings.json.0000"}, {"mkdir": "$HOME/.claude/settings.json"}],
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"config_key": {"null": true}, "config_key_state": "unreadable", "write_refused": "unreadable"}}},
  {"name": "usage: settings set takes <key>=<value> words, not flags; a bad tier",
   "argv": ["settings", "set", "--key", "watcher", "--value", "off"],
   "expect": {"exit": 64, "stderr_has": ["^usage: unknown flag --(key|value)$"]}},
  {"argv": ["settings", "show", "--tier", "rare"],
   "expect": {"exit": 64, "stderr_has": ["^usage: --tier common\\|advanced\\|all"]}},
  {"name": "a leftover argument is refused",
   "argv": ["settings", "show", "bogus"],
   "expect": {"exit": 64, "stderr_has": ["^usage: settings show takes no argument \\(bogus\\)$"]}}
 ]
}
