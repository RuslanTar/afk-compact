def _shipped(target, rel, brand):
    path = os.path.join(target, *rel.split("/"))
    return path, (shipped_lines(path, brand) if os.path.isfile(path) else None)


def _section(lines, start, end):
    """Lines after the first line matching start, up to (not including) the next matching end."""
    out, on = [], False
    for ln in lines:
        if on and re.match(end, ln):
            break
        if on:
            out.append(ln)
        elif re.match(start, ln):
            on = True
    return out if on else None


def _missing(path, gate_rule):
    return (path, None, gate_rule, "{}: file missing".format(gate_rule), "")


