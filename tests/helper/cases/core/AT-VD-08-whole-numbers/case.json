{
 "id": "AT-VD-08 (visible defaults: whole-number keys read as the plugin reads them)",
 "owner": "core",
 "note": "0.1.2 visible defaults: the mod's config.ts rounds max_auto_continues_per_hour, handoff_turn_max_tokens and idle_handoff_min_tokens down (Math.floor) before its clamp, so /status, settings show and the settings view (settings show --json) show them rounded down too (settings.pm %WHOLE, whole()): 2.9 shows 2, 150000.7 shows 150000, and 19999.5 is 19999 before the clamp lifts it to 20000 (clamped from 19999, as the mod's config_clamped note says). 150000.5 is 150000, inside its limits: not clamped. Every other number key keeps its fraction, as the plugin reads it: handoff_reuse_window_min 0.5 (the helper's begin reads it with num_clamped, no rounding) and evidence_total_max_mb 12.5.",
 "now": "2026-10-30T09:00:00+02:00",
 "tz": "Etc/GMT-2",
 "steps": [
  {"setup": [
    {"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {
      "max_auto_continues_per_hour": 2.9, "handoff_turn_max_tokens": 19999.5, "idle_handoff_min_tokens": 150000.7,
      "handoff_reuse_window_min": 0.5, "evidence_total_max_mb": 12.5}}}}}
  ]},
  {"name": "settings show: the whole-number keys rounded down, the others with their fraction",
   "argv": ["settings", "show"],
   "expect": {"exit": 0,
     "stdout_has": ["^max_auto_continues_per_hour 2 \\(your settings\\.json; default 6\\)$",
                    "^handoff_turn_max_tokens 20000, clamped from 19999 \\(your settings\\.json; default 64000\\)$",
                    "^idle_handoff_min_tokens 150000 \\(your settings\\.json; default 200000\\)$",
                    "^handoff_reuse_window_min 0\\.5 \\(your settings\\.json; default 15\\)$",
                    "^evidence_total_max_mb 12\\.5 \\(your settings\\.json; default 50\\)$"],
     "stdout_lacks": ["2\\.9", "19999\\.5", "150000\\.7"]}},
  {"name": "/status: the same values, and the continues line's limit rounded down",
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0,
     "stdout_has": ["^  max_auto_continues_per_hour 2 \\(your settings\\.json; default 6\\)$",
                    "^  handoff_turn_max_tokens 20000, clamped from 19999 \\(your settings\\.json; default 64000\\)$",
                    "^  idle_handoff_min_tokens 150000 \\(your settings\\.json; default 200000\\)$",
                    "^  handoff_reuse_window_min 0\\.5 \\(your settings\\.json; default 15\\)$",
                    "^halt: \\S+ · continues this hour: 0 of 2$",
                    "· handoff_reuse_window_min 0\\.5 ·"],
     "stdout_lacks": ["2\\.9", "19999\\.5", "150000\\.7"]}},
  {"name": "the settings view: the configured value rounded down, clamped by the rounded value",
   "argv": ["settings", "show", "--json"],
   "expect": {"exit": 0,
     "json": {"settings.max_auto_continues_per_hour.value": 2, "settings.max_auto_continues_per_hour.clamped": false,
              "settings.handoff_turn_max_tokens.value": 19999, "settings.handoff_turn_max_tokens.clamped": true,
              "settings.idle_handoff_min_tokens.value": 150000, "settings.idle_handoff_min_tokens.clamped": false,
              "settings.handoff_reuse_window_min.value": 0.5, "settings.evidence_total_max_mb.value": 12.5}}},
  {"name": "a value over the maximum only by its fraction: rounded down, not clamped",
   "argv": ["settings", "show", "--json"],
   "env": {"CLAUDE_PLUGIN_OPTION_HANDOFF_TURN_MAX_TOKENS": "150000.5"},
   "expect": {"exit": 0,
     "json": {"settings.handoff_turn_max_tokens.value": 150000, "settings.handoff_turn_max_tokens.clamped": false,
              "settings.handoff_turn_max_tokens.source": "env"}}},
  {"name": "and its line: the rounded value, no clamp",
   "argv": ["settings", "show"],
   "env": {"CLAUDE_PLUGIN_OPTION_HANDOFF_TURN_MAX_TOKENS": "150000.5"},
   "expect": {"exit": 0,
     "stdout_has": ["^handoff_turn_max_tokens 150000 \\(plugin option; default 64000\\)$"]}}
 ]
}
