    with open(path, encoding="utf-8") as f:
        uc = json.load(f).get("userConfig") or {}
    return path, {k: (v or {}).get("default") for k, v in uc.items()}


def _is_plugin(target):
    return os.path.isfile(os.path.join(target, ".claude-plugin", "plugin.json"))


def _read(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


SETTINGS_REL = "helper/lib/settings.pm"
CONFIG_TS_REL = "hooks/lib/config.ts"
WATCH_CTX_REL = "helper/lib/watch/ctx.pm"
SETTINGS_ROW = re.compile(r"^\s*\[(\w+)\s*=>\s*'(\w+)',\s*('(?:[^'\\]|\\.)*'|-?\d+(?:\.\d+)?),\s*'(\w+)'\]")
EXPORT_CLASSES = ("num", "bool", "enum", "path", "list", "drop")


def _settings_rows(target):
    path = os.path.join(target, *SETTINGS_REL.split("/"))
    if not os.path.isfile(path):
        return path, None
    src = _read(path)
    m = re.search(r"^our @KEYS = \((.*?)^\);", src, re.S | re.M)
    rows = []
    for ln in (m.group(1).split("\n") if m else []):
        r = SETTINGS_ROW.match(ln)
        if r:
            rows.append((r.group(1), r.group(2), r.group(3), r.group(4)))
    return path, rows


def _lit(v):
    """A Perl or TypeScript literal as Python: 'x' -> x, numbers -> int/float, true/false."""
    v = v.strip().rstrip(",").strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    if v in ("true", "false"):
        return v == "true"
    try:
        return int(v)
    except ValueError:
        try:
            return float(v)
        except ValueError:
            return v


def _same(manifest, got, perl_bool=False):
    if isinstance(manifest, bool):
        if perl_bool and got in (0, 1, "0", "1", "true", "false"):
            got = got in (1, "1", "true")
        return got is manifest
    if isinstance(manifest, (int, float)) and not isinstance(got, bool):
        return isinstance(got, (int, float)) and got == manifest
    return got == manifest


def config_sources_hits(target, brand):
    """AT-CAP-02 (S-SETTINGS A, one source for defaults): every key's fallback in settings.pm
    @KEYS (column 3), config.ts DEFAULTS and watch/ctx.pm %DEFAULTS equals the manifest default;
    every manifest key has a settings.pm row and every row a manifest key."""
    if not _is_plugin(target):
        return []
    mpath, defaults = _manifest_defaults(target)
    out = []
    spath, rows = _settings_rows(target)
    if rows is None:
        return [_missing(spath, "AT-CAP-02 settings")]
    seen = set()
    for key, typ, fb, _exp in rows:
        seen.add(key)
        if key not in defaults:
            out.append((spath, None, "AT-CAP-02 extra", "AT-CAP-02 extra: settings.pm key {} is not in the manifest".format(key), ""))
        elif not _same(defaults[key], _lit(fb), perl_bool=(typ == "bool")):
            out.append((spath, None, "AT-CAP-02 differs", "AT-CAP-02 differs: settings.pm {} fallback {} != manifest {!r}".format(
                key, fb, defaults[key]), ""))
    for key in sorted(set(defaults) - seen):
        out.append((spath, None, "AT-CAP-02 missing", "AT-CAP-02 missing: manifest key {} has no settings.pm row".format(key), ""))
    cpath = os.path.join(target, *CONFIG_TS_REL.split("/"))
    if not os.path.isfile(cpath):
        out.append(_missing(cpath, "AT-CAP-02 config.ts"))
    else:
        m = re.search(r"^export const DEFAULTS: Config = \{(.*?)^\}", _read(cpath), re.S | re.M)
        if not m:
            out.append((cpath, None, "AT-CAP-02 config.ts", "AT-CAP-02 config.ts: no DEFAULTS block", ""))
        for ln in (m.group(1).split("\n") if m else []):
            r = re.match(r"^\s*(\w+):\s*(.+?),?\s*$", ln)
            if r and r.group(1) in defaults and not _same(defaults[r.group(1)], _lit(r.group(2))):
                out.append((cpath, None, "AT-CAP-02 differs", "AT-CAP-02 differs: config.ts DEFAULTS {} {} != manifest {!r}".format(
                    r.group(1), r.group(2), defaults[r.group(1)]), ""))
    wpath = os.path.join(target, *WATCH_CTX_REL.split("/"))
    if not os.path.isfile(wpath):
        out.append(_missing(wpath, "AT-CAP-02 ctx.pm"))
    else:
        m = re.search(r"^my %DEFAULTS = \((.*?)^\);", _read(wpath), re.S | re.M)
        if not m:
            out.append((wpath, None, "AT-CAP-02 ctx.pm", "AT-CAP-02 ctx.pm: no %DEFAULTS block", ""))
        for ln in (m.group(1).split("\n") if m else []):
            r = re.match(r"^\s*(\w+)\s*=>\s*(.+?),?\s*$", ln)
            if r and r.group(1) in defaults and not _same(defaults[r.group(1)], _lit(r.group(2)), perl_bool=True):
                out.append((wpath, None, "AT-CAP-02 differs", "AT-CAP-02 differs: watch/ctx.pm {} {} != manifest {!r}".format(
                    r.group(1), r.group(2), defaults[r.group(1)]), ""))
    return out


