  "lint_texts": {
    "headings": {
      "why": "readers find sections by their literal heading, in this order",
      "fix": "use the template §4 headings unchanged and in order; omit only an empty section without a none-form"
    },
    "meta-in-draft": {
      "why": "frontmatter, marker and sentinel come from code; typed ones break detection",
      "fix": "delete them from body.md; start at the # title"
    },
    "update-heading": {
      "why": "a handoff is rewritten, never appended",
      "fix": "fold the update into the sections and drop the heading"
    },
    "resume-lines": {
      "why": "the next session reads Resume here first; more lines bury Step 1",
      "fix": "keep the four §4.1 lines; move detail to its section"
    },
    "step1-mismatch": {
      "why": "two versions of the next action make the next session guess",
      "fix": "make Next steps item 1 the same command or edit as Step 1, character for character"
    },
    "none-form": {
      "why": "an empty section must say it was checked, not forgotten",
      "fix": "write the section's none-form from template §4"
    },
    "ephemeral-path": {
      "why": "temp paths vanish before a resume",
      "fix": "evidence --keep <path> and cite the durable path, or put it on Volatile: with a reason"
    },
    "live-asof": {
      "why": "a state claim without a time cannot be judged for age",
      "fix": "give the row an as-of from checked_at or a stamp"
    },
    "unprinted-time": {
      "why": "only a helper-printed time proves a check ran in this session",
      "fix": "use checked_at or a stamp time, or tag the line [unverified]"
    },
    "time-format": {
      "why": "readers compare stamps; a partial time is ambiguous",
      "fix": "write the whole stamp YYYY-MM-DD HH:MM +hhmm as printed"
    },
    "id-range": {
      "why": "a range hides which ids exist, so carried ids get lost",
      "fix": "list each id"
    },
    "carry-provenance": {
      "why": "another session's line is not this session's word",
      "fix": "add [from <sid8> · <their id> · <their stamp>] with the values from begin"
    },
    "carry-approval": {
      "why": "an approval carries only along your own chain, where its use is tracked; another session's approval is context",
      "fix": "write: context only, not valid here; re-ask, and drop used / not yet used"
    },
    "approval-shape": {
      "why": "the next session can act on an approval only when it can check its scope",
      "fix": "write the user's words, the action, each target with its state, once or standing, and not yet used or used <stamp>"
    },
    "approval-quote": {
      "why": "only the user's own words can approve an action",
      "fix": "quote the user exactly, or move the item to Open questions as ask user"
    },
    "private-path": {
      "why": "in repo mode the path would reach git",
      "fix": "use a durable bucket path or a pointer; Volatile: does not help here"
    },
    "recipe-placeholder": {
      "why": "a recipe with <…> cannot run as written",
      "fix": "write the literal value, or class the row ask"
    },
    "recipe-script": {
      "why": "a restart runs only a script whose sha256 is in the manifest",
      "fix": "evidence --keep <script> and cite the durable path"
    },
    "recipe-spawn": {
      "why": "a spawn without model and effort runs on defaults nobody chose",
      "fix": "add model <id>, effort <level>"
    },
    "secret-hard": {
      "why": "the file would hold a live credential",
      "fix": "remove the value and say where it lives; the rule ids name the pattern"
    },
    "queue-off": {
      "why": "no queue is configured, so nothing was queued",
      "fix": "keep the question in full and drop the Queued: line and the · queued mark"
    },
    "size": {
      "why": "past 20 KB the next session reads less of what matters",
      "fix": "cut in the template §2 order"
    },
    "section-cap": {
      "why": "one section crowds out the others",
      "fix": "cut that section toward its template §2 cap"
    },
    "code-block": {
      "why": "code is recoverable from the repository",
      "fix": "point to path#Symbol; keep ≤5 lines only mid-edit"
    },
    "log-lines": {
      "why": "pasted logs push out decisions",
      "fix": "write the conclusion and a reproducer command"
    },
    "hash-lines": {
      "why": "hash lists are recoverable from git",
      "fix": "write the commit range <base>..<head>"
    },
    "changes": {
      "why": "past 15 the list stops ranking",
      "fix": "keep the top 15 by importance; the commit range covers the rest"
    },
    "must-read": {
      "why": "more than 3 must-reads means none is",
      "fix": "keep the 3 that Step 1 needs"
    },
    "overlap": {
      "why": "a copied previous file carries stale state",
      "fix": "rewrite non-ledger lines with the latest values; carry only ledger lines unchanged"
    },
    "recipe-mismatch": {
      "why": "a recorded job is relaunched only byte for byte",
      "fix": "copy command: from the job record, or class the row ask"
    },
    "secret-warn": {
      "why": "a value that looks secret may leak",
      "fix": "take it out and say where it lives, or report the rule ids"
    },
    "acuity": {
      "why": "the next session sets its check depth from Acuity; a rating below the measured facts under-checks",
      "fix": "add Acuity: to the Status line, at least the floor shown (merge or rebase in progress: unstable; a running job: watch)"
    },
    "store-path": {
      "why": "the helper path changes with each plugin update and names your home folder",
      "fix": "write <store> instead of the path"
    },
    "approval-unchecked": {
      "why": "an unchecked approval cannot carry",
      "fix": "nothing to do; the next session re-asks"
    }
  },
