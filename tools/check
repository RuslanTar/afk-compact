                          for f in sorted(os.listdir(g)) if f.startswith("goldens"))

    def goldens_chunks(d):
        """assemble --check and build --check under the test cap; when both pass, the test kit
        too, so BT-04 reads every overflow module (about 50 s; skipped on a copy those checks
        already fail, as the kit adds nothing there)."""
        code, out = run_seq(["tools/assemble", "--check", "--chunk-bytes", CHUNK_TEST], ["tools/build", "--check"])(d)
        if code == 0:
            r = subprocess.run(["claude", "plugin", "test", os.path.join(d, "plugin")], cwd=d,
                               capture_output=True, text=True)
            code, out = r.returncode, out + r.stdout + r.stderr + "KIT EXIT {}\n".format(r.returncode)
        return code, out + goldens_modules(d)[1]

