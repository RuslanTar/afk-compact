   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "session_id": "99999999-2222-4333-8444-555555555555",
    "transcript_path": "$TMP/proj/99999999-2222-4333-8444-555555555555.jsonl",
