    "STORE_TEST_PS_W" : "$TMP/psw",
    "STORE_TEST_WINPIDS" : "$TMP/winpids"
   },
   "expect" : {
    "exit" : 0,
    "json" : {
     "bucket.path" : "repo/free",
     "ownership.repin.result" : "ok"
    }
   },
   "name" : "(4) control: H is gone, so its pin holds nothing: the re-pin is ok"
