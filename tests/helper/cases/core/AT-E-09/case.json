{
 "id": "AT-E-09",
 "note": "AT-E-09 (GSD re-entry per session): checkpoint --measured in tests/fixtures/repos/planning-state.json: a session whose transcript shows no GSD work gets no GSD lines although the worktree has .planning/STATE.md; once its transcript holds a typed /gsd-progress, the JSON and the measured block carry its flat GSD line (read from STATE.md's prose lines) and its passive GSD re-entry line (no Active driver: /gsd-progress is no loop); git status --porcelain and the STATE.md mtime are unchanged, and no pin is written",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "porcelain before",
   "setup": [
    {
     "repo_fixture": "planning-state.json",
     "at": "$TMP/example-repo"
    },
    {
     "age": "$TMP/example-repo/.planning/STATE.md",
     "minutes": 120
    }
   ],
   "exec": [
    "git",
    "-C",
    "$TMP/example-repo",
    "status",
    "--porcelain"
   ],
   "expect": {
    "exit": 0,
    "stdout": " M lib/retry_worker.rb\n"
   }
  },
  {
   "name": "checkpoint, no GSD work in the session's transcript: no GSD lines",
   "setup": [
    {
     "write": "$HOME/.claude/projects/-x/$SID.jsonl",
     "jsonl": [
      {
       "cwd": "$TMP/example-repo",
       "isSidechain": false,
       "message": {
        "role": "user",
        "content": "Why does the retry worker fail?"
       },
       "origin": {
        "kind": "human"
       },
       "sessionId": "$SID",
       "timestamp": "2026-10-21T10:00:00.000Z",
       "type": "user",
       "uuid": "u1"
      }
     ]
    }
   ],
   "argv": [
    "checkpoint",
    "--sid",
    "$SID",
    "--nonce",
    "0a1b2c3d",
    "--budget-ms",
    "10000",
    "--measured",
    "--cwd",
    "$TMP/example-repo"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "gsd": {
      "len": 0
     },
     "measured_block": {
      "re": "\\A(?![\\s\\S]*(?:GSD|Active driver))"
     }
    }
   }
  },
  {
   "name": "checkpoint, the session ran /gsd-progress",
   "argv": [
    "checkpoint",
    "--sid",
    "$SID",
    "--nonce",
    "1a2b3c4d",
    "--budget-ms",
    "10000",
    "--measured",
    "--cwd",
    "$TMP/example-repo"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "gsd": {
      "len": 2
     },
     "gsd.0": {
      "re": "^GSD \\(this session\\): no workstream named · \\S+/\\.planning/STATE\\.md: status in progress · phase 2 of 4 \\(retry worker\\) · last activity 2026-10-21 - plan 2\\.3 started$"
     },
     "gsd.1": {
      "re": "^GSD re-entry \\(new session only\\): /gsd-resume-work$"
     },
     "measured_block": {
      "re": "(?m)^GSD \\(this session\\): no workstream named · \\S+/\\.planning/STATE\\.md: status in progress"
     }
    },
    "absent": [
     "$ROOT/.sessions/*.json"
    ]
   },
   "setup": [
    {
     "write": "$HOME/.claude/projects/-x/$SID.jsonl",
     "jsonl": [
      {
       "cwd": "$TMP/example-repo",
       "isSidechain": false,
       "message": {
        "role": "user",
        "content": "<command-message>gsd-progress</command-message>\n<command-name>/gsd-progress</command-name>\n<command-args></command-args>"
       },
       "origin": {
        "kind": "human"
       },
       "sessionId": "$SID",
       "timestamp": "2026-10-21T10:00:00.000Z",
       "type": "user",
       "uuid": "u1"
      }
     ]
    }
   ]
  },
  {
   "name": "porcelain after",
   "exec": [
    "git",
    "-C",
    "$TMP/example-repo",
    "status",
    "--porcelain"
   ],
   "expect": {
    "exit": 0,
    "stdout": " M lib/retry_worker.rb\n"
   }
  },
  {
   "name": "STATE.md mtime unchanged (still 2 h old)",
   "exec": [
    "find",
