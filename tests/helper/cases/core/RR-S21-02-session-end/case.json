        "ts": "2026-10-21T14:05:00.865+03:00",
        "trigger": "manual",
        "pre": 37896,
        "post": 4537,
        "duration_ms": 12100,
        "precomputed": false
       }
      }
     ]
    }
   ],
   "argv": [
    "hook",
    "SessionEnd"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionEnd",
