def manifest_install(path):
    """The install id of a zip, read with the intake limits; None when unreadable or unsafe."""
    try:
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_size > TOTAL_MAX:
            return None
        with zipfile.ZipFile(path, "r") as zf:
            zi = zf.getinfo("manifest.json")
            if zi.file_size > MB or zi.file_size > RATIO_MAX * max(zi.compress_size, 1) or zi.flag_bits & 1:
                return None
            with zf.open(zi, "r") as fh:
                m = json.loads(fh.read(MB + 1).decode("utf-8"))
        return m.get("install_id") if isinstance(m, dict) else None
    except (KeyError, OSError, ValueError, UnicodeDecodeError, zipfile.BadZipFile, NotImplementedError, RuntimeError, EOFError):
        return None


def cmd_forget(argv):
    if len(argv) != 2 or not INSTALL_RE.match(argv[0]) or not os.path.isdir(argv[1]):
        raise Usage()
    iid, inbox = argv[0], _real(argv[1])
    found = []
    shas = set()
    for name in sorted(os.listdir(inbox)):
        p = os.path.join(inbox, name)
        if name.endswith(".zip") and manifest_install(p) == iid:
            found.append(("FILE", p))
            shas.add(sha256_file(p)[:8])
    ana = os.path.join(os.path.dirname(inbox), "beta-analysis")
    if os.path.isdir(ana) and not os.path.islink(ana):
        for run in sorted(os.listdir(ana)):
            rd = os.path.join(ana, run)
            if not os.path.isdir(rd) or os.path.islink(rd):
                continue
            raw = os.path.join(rd, "raw")
            if os.path.isdir(raw):
                for d in sorted(os.listdir(raw)):
                    if d.split("-")[0] in shas:
                        found.append(("FOLDER", os.path.join(raw, d)))
            inst = os.path.join(rd, "installs", iid)
            if os.path.isdir(inst):
                found.append(("FOLDER", inst))
            for f in sorted(os.listdir(rd)):
                fp = os.path.join(rd, f)
                if os.path.isfile(fp) and not os.path.islink(fp) and (f.endswith(".tsv") or f.endswith(".md")):
                    with open(fp, "rb") as fh:
                        if iid.encode() in fh.read(64 * MB):
                            found.append(("MENTIONS", fp))
    say("FORGET %s" % iid)
    for kind, p in found:
        say("%s %s" % (kind, p))
    if not found:
        say("NONE: no file of this install in %s or %s" % (inbox, ana))
    say("REMOVED NOTHING: delete the FILE and FOLDER paths yourself; a MENTIONS file is pooled output, so rerun"
        " `run` after the removal instead of editing it.")
    return 0


USAGE = ("usage: python3 -I tools/beta-analyze run INBOX [--out DIR] [--store LAUNCHER]\n"
         "       python3 -I tools/beta-analyze forget INSTALL_ID INBOX\n")


def main(argv):
    try:
        if argv[:1] == ["run"]:
            return cmd_run(argv[1:])
        if argv[:1] == ["forget"]:
            return cmd_forget(argv[1:])
        raise Usage()
    except Usage:
        sys.stderr.write(USAGE)
        return 64
    except Refuse as e:
        say("REFUSED: %s" % e)
        return 73


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except BaseException as e:  # noqa: B902
        sys.stderr.write("beta-analyze: internal error (%s: %s)\n" % (e.__class__.__name__, clean(e, 120)))
        sys.exit(70)
