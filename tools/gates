def _perl_code_lines(src):
    """(line no, line) of the code lines of a Perl file: no `#` comment line, no POD, nothing
    after __END__/__DATA__. A trailing comment on a code line counts as code (stricter)."""
    pod = False
    for no, ln in enumerate(src.split("\n"), 1):
        if ln.startswith("__END__") or ln.startswith("__DATA__"):
            return
        if re.match(r"^=[a-zA-Z]", ln):
            pod = not ln.startswith("=cut")
            continue
        if pod or re.match(r"^\s*#", ln):
            continue
        yield no, ln


