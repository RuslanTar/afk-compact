{
 "id": "HT-WA-07",
 "layer": "H",
 "owner": "skills",
 "note": "Dev-7 D2 guarantees: the HOME tree and the watched files are byte-identical (and keep their mtimes) after a done, a pending and a refused wait; one stdout line; the match text is cut to 120 chars, never the whole line; SIGTERM and SIGINT end the wait at once",
 "steps": [
  {
   "setup": [
    {
     "write": "$TMP/tree.pl",
     "content": "use strict; use warnings;\nmy ($out, @roots) = @ARGV; my @l;\nmy @st = @roots;\nwhile (@st) {\n    my $p = pop @st;\n    my @s = lstat $p or next;\n    push @l, join(' ', $p, $s[1], $s[2], $s[7], $s[9]);\n    if (-d _) { opendir(my $d, $p) or next; push @st, map { \"$p/$_\" } grep { !/^\\.\\.?$/ } readdir $d; next }\n    if (-f _) { open(my $f, '<:raw', $p) or next; local $/; my $c = <$f>; push @l, \"$p sum \" . unpack('%32C*', $c) }\n}\nopen(my $o, '>', $out) or die; print $o join(\"\\n\", sort @l), \"\\n\";\n"
    },
    {
     "write": "$TMP/w/log",
     "content": "\n__exit 0\n"
    },
    {
     "write": "$HOME/.claude/settings.json",
     "content": "{}\n"
    }
   ]
  },
  {
   "name": "tree before",
   "exec": [
    "/usr/bin/perl",
    "$TMP/tree.pl",
    "$TMP/before",
    "$HOME",
    "$TMP/w"
   ],
   "expect": {
    "exit": 0
   }
  },
  {
   "name": "match text cut",
   "argv": [
    "wait",
    "--for",
    "marker:$TMP/w/log:x+",
    "--max",
    "0"
   ],
   "expect": {
    "exit": 0,
    "stdout_lines": 1,
    "stdout_has": [
     " line=1 match=x{120}\\n\\z"
    ],
    "stdout_lacks": [
     "x{121}"
    ]
   }
  },
  {
   "name": "stalled",
   "argv": [
    "wait",
    "--for",
    "marker:$TMP/w/log:DONE",
    "--stall",
    "1",
    "--max",
    "1"
   ],
   "expect": {
    "exit": 11,
    "stdout_lines": 1
   }
  },
  {
   "name": "pending",
   "argv": [
    "wait",
    "--for",
    "file:$TMP/w/none",
    "--max",
    "0"
   ],
   "expect": {
    "exit": 10,
    "stdout_lines": 1
   }
  },
  {
   "name": "refused",
   "argv": [
    "wait",
    "--for",
    "file:$TMP/w",
    "--max",
    "0"
   ],
   "expect": {
    "exit": 3,
    "stdout_lines": 1
   }
  },
  {
   "name": "exit",
   "argv": [
    "wait",
    "--for",
    "exit:$TMP/w/log",
    "--max",
    "0"
   ],
   "expect": {
    "exit": 0,
    "stdout_lines": 1
   }
  },
  {
   "name": "tree after",
   "exec": [
    "/usr/bin/perl",
    "$TMP/tree.pl",
    "$TMP/after",
    "$HOME",
    "$TMP/w"
   ],
   "expect": {
    "exit": 0
   }
  },
  {
   "name": "byte-identical",
   "exec": [
    "/usr/bin/perl",
    "-e",
    "local $/; my ($x, $y) = map { open(my $f, '<:raw', $_) or die \"$_: $!\\n\"; scalar <$f> } @ARGV; exit($x eq $y ? 0 : 1)",
    "$TMP/before",
    "$TMP/after"
   ],
   "expect": {
    "exit": 0,
    "stdout": ""
   }
  },
  {
   "name": "SIGTERM",
   "argv": [
    "wait",
    "--for",
    "file:$TMP/none",
    "--max",
    "60"
   ],
   "expect": {
    "exit": 143,
    "ms_max": 1600,
    "stdout": ""
   },
   "kill_after_ms": 600,
   "kill_signal": "TERM"
  },
  {
   "name": "SIGINT",
   "argv": [
    "wait",
    "--for",
    "file:$TMP/none",
    "--max",
    "60"
   ],
   "expect": {
    "exit": 130,
    "ms_max": 1600,
    "stdout": ""
   },
   "kill_after_ms": 600,
   "kill_signal": "INT"
  }
 ]
}
