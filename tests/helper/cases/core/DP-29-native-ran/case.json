 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "four mod dispatches 11 minutes old: closed by native-ran, rejected, no outcome, rejected as headless",
   "now": "2026-10-21T14:16:12+03:00",
   "setup": [
    {"mkdir": "$TMP/work"},
    {"dispatch": {"nonce": "9a9a0001", "actor": "main", "channel": "mod-self", "trigger": "plugin", "ts": "2026-10-21T14:05:00+03:00"}},
    {"dispatch": {"nonce": "9a9a0002", "actor": "main", "channel": "mod-self", "trigger": "plugin", "ts": "2026-10-21T14:05:01+03:00"}},
    {"dispatch": {"nonce": "9a9a0003", "actor": "main", "channel": "mod-hook", "trigger": "auto", "ts": "2026-10-21T14:05:02+03:00"}},
    {"dispatch": {"nonce": "9a9a0004", "actor": "main", "channel": "mod-self", "trigger": "plugin", "ts": "2026-10-21T14:05:03+03:00"}},
    {"write": "$WATCH/$SID.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-21T14:05:00.500+03:00", "ev": "compacted", "sid": "$SID", "actor": "main", "writer": "mod", "nonce": "9a9a0001", "skip": "native-ran", "tokens_before": null, "tokens_after": null, "usage_present": false, "ms": null},
     {"v": 1, "ts": "2026-10-21T14:05:01.500+03:00", "ev": "compact_rejected", "sid": "$SID", "actor": "main", "writer": "mod", "nonce": "9a9a0002"},
