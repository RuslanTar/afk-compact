{
 "id": "W9-stop-deadline",
 "note": "W9, test mode and the Stop budget: hook Stop gives watch.on_stop a hard stop relative to the real clock (at most 3 s, within the 8 s Stop budget shared with reconcile). A fixed test clock a day in the past (STORE_TEST_NOW fixes the clock, never a budget) still sweeps: a sweep row and no sweep_partial",
 "now": "2026-10-20T10:00:00+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "setup": [
    {
     "mkdir": "$TMP/work"
    },
    {
     "transcript": "$TMP/proj/$SID.jsonl",
     "rows": [
      {
       "prompt": {
        "age_s": 60
       }
      },
      {
       "text": "working on it"
      }
     ]
    }
   ],
   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "Stop",
    "stop_hook_active": false,
    "background_tasks": [],
    "session_crons": []
   },
   "expect": {
    "exit": 0,
    "stdout": "",
    "ms_max": 8000,
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "sweep"
     }
    ],
    "rows_absent": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "sweep_partial"
     }
    ]
   }
  }
 ]
}