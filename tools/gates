    "on the Bash PATH" or calls it bare (`<brand>-store <subcommand>`, no folder before it)."""
    if not os.path.isfile(os.path.join(target, ".claude-plugin", "plugin.json")):
        return []
    out = []
    if os.path.lexists(os.path.join(target, "bin")):
