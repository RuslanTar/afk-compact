  "wait": {
    "cond_res": {
      "pid-exit": "^pid-exit:([0-9]+)(@([0-9]+))?$",
      "file": "^file:([^:]+)$",
      "marker": "^marker:([^:]+):(.+)$",
      "exit": "^exit:([^:]+)$"
    },
    "guard_res": {
      "pid": "^pid:([0-9]+)(@([0-9]+))?$",
      "file": "^file:([^:]+)$"
    },
    "max_default_s": 270,
    "max_range_s": [
      0,
      7200
    ],
    "main_max_s": 1740,
    "subagent_bash_timeout_ms": 300000,
    "marker_regex_max_chars": 200,
    "marker_regex_forbidden": [
      "(?{",
      "(??{",
      "(*"
    ],
    "alarm_slack_s": 5,
    "match_text_max_chars": 120,
    "first_scan_max_bytes": 268435456,
    "exit_codes": {
      "done": 0,
      "refused": 3,
      "pending": 10,
      "stalled": 11,
      "ended": 12,
      "overdue": 13,
      "usage": 64,
      "internal": 70
    },
    "exit_markers": [
      {
        "id": "echo",
        "re": "^__exit (-?[0-9]+)$",
        "active": true
      },
      {
        "id": "runtime",
        "re": "^\\[exited with code (-?[0-9]+)\\]$",
        "active": true
      },
      {
        "id": "killed",
        "re": "^\\[killed\\]$",
        "active": true,
        "means": "killed"
      }
    ],
    "end_suffix": "; echo \"__exit $?\"",
    "inflight_probe_cmd": "<store> wait --for <spec> --max 0"
  },
