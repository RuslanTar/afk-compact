  {"name": "and arm refuses it too: bg-not-shipped, no carry note", "argv": ["restart", "arm", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--nonce", "aabbccddeeff0022", "--from", "2.1.311", "--to", "2.1.312", "--continue", "1", "--mode", "default", "--now-ms", "1792580712000"], "env": {"STORE_TEST_RESTART_BG": "0"}, "expect": {"exit": 0, "json": {"ok": false, "why": "bg-not-shipped"}, "absent": ["$WATCH/$SID/restart.json"]}},
  {"name": "another session's job: job-unknown", "argv": ["restart", "gate", "--sid", "11111111-2222-4333-8444-000000000000", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312"],
   "expect": {"exit": 0, "json": {"why": "job-unknown"}}},
  {"name": "no job folder: job-unknown", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--from", "2.1.311", "--to", "2.1.312"],
