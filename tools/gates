def budget_reason(key):
    """(why, up_to or None) for a soft budget in tools/budget-reasons.json, (None, None) when it has
    none, or (None, "<what is wrong>") for a malformed entry (REVIEW-NIGHT NR-19: an `up_to` that
    is not a positive whole number, an empty reason or an unknown field never means "no limit")."""
    try:
        with open(REASONS_FILE, encoding="utf-8") as f:
            doc = json.load(f)
    except OSError:
        return None, None
    except ValueError:
        return None, "tools/budget-reasons.json is not JSON"
    v = doc.get(key) if isinstance(doc, dict) else None
    if v is None:
        return None, None
    if isinstance(v, str):
        return (v, None) if v.strip() else (None, "an empty reason")
    if not isinstance(v, dict) or set(v) - {"why", "up_to"} or not isinstance(v.get("why"), str) or not v["why"].strip():
        return None, "a malformed reason entry"
    up = v.get("up_to")
    if "up_to" in v and (not isinstance(up, int) or isinstance(up, bool) or up <= 0):
        return None, "up_to {!r} is not a positive whole number".format(up)
    return v["why"], up
