        if fresh.get("cc_version") != "unknown":
            bad.append("NOC8 render cc_version {} (want unknown)".format(json.dumps(fresh.get("cc_version"))))
        for k in sorted((set(cur) | set(fresh)) - {"c8", "cc_version"}):
            if cur.get(k) != fresh.get(k):
