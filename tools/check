    def version_ascii(d):
        """The copy's tools/canary-baseline (the newest binary it picks, and cc_version from a
        --claude file name), tools/launcher-flags (newest_claude), tools/respawn-keepset
        (binaries, picked and given) and tools/check (pinned_claude), under a HOME whose
        versions folder holds 2.1.300 and odd-digit names that would sort newer. No binary is
        run: each file is a one-line stand-in, and canary-baseline renders with --no-c8."""
        h = os.path.join(d, "tmp", "ascii-home")
        vd = os.path.join(h, ".local", "share", "claude", "versions")
        os.makedirs(vd, exist_ok=True)
        odd_names = [fullwidth("9.9.9"), arabic_indic("9.9.9")] + [o for _, o in odd_versions]
        for n in ["2.1.300"] + odd_names:
            write_text(os.path.join(vd, n), "#!/bin/sh\nexit 0\n")
            os.chmod(os.path.join(vd, n), 0o755)
        env = dict(os.environ, HOME=h)
        env.pop("CLAUDE_CODE_EXECPATH", None)
        out, bad = [], 0

        def note(what, got, want):
            nonlocal bad
            if got == want:
                out.append("ASCII ok: {}: {}".format(what, ascii(got)))
            else:
                bad += 1
                out.append("ASCII lax: {}: {} (want {})".format(what, ascii(got), ascii(want)))

        render = os.path.join("tmp", "ascii-render.json")

        def cc_version(extra):
            r = subprocess.run([os.path.join(d, "tools", "canary-baseline"), "--no-c8", "--out", render] + extra,
                               cwd=d, capture_output=True, text=True, env=env)
            if r.returncode != 0:
                return "exit {}: {}".format(r.returncode, (r.stdout + r.stderr).strip()[-200:])
            with open(os.path.join(d, render), encoding="utf-8") as f:
                return json.load(f).get("cc_version")
        note("canary-baseline cc_version (newest in the versions folder)", cc_version([]), "2.1.300")
        for what, o in odd_versions:
            note("canary-baseline cc_version (--claude named in {} digits)".format(what),
                 cc_version(["--claude", os.path.join(vd, o)]), "unknown")

        def load(rel, tag):
            loader = importlib.machinery.SourceFileLoader(tag, os.path.join(d, *rel.split("/")))
            mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(tag, loader))
            loader.exec_module(mod)
            return mod
        keep = {k: os.environ.get(k) for k in ("HOME", "CLAUDE_CODE_EXECPATH")}
        os.environ["HOME"] = h
        os.environ.pop("CLAUDE_CODE_EXECPATH", None)
        try:
            lf = load("tools/launcher-flags", "tools_launcher_flags_ascii")
            note("launcher-flags newest_claude", os.path.basename(lf.newest_claude() or ""), "2.1.300")
            rk = load("tools/respawn-keepset", "tools_respawn_keepset_ascii")
            note("respawn-keepset binaries (picked)", [x for x, _ in rk.binaries([])], ["2.1.300"])
            ck = load("tools/check", "tools_check_ascii")
            for what, o in odd_versions:
                with contextlib.redirect_stderr(io.StringIO()):
                    try:
                        got = "accepted " + rk.binaries([os.path.join(vd, o)])[0][0]
                    except SystemExit:
                        got = "refused"
                note("respawn-keepset --claude named in {} digits".format(what), got, "refused")
                root = os.path.join(d, "tmp", "ascii-root")
                write_text(os.path.join(root, "plugin", "assets", "canary-baseline.json"),
                           json.dumps({"cc_version": o, "c8": {"binary_version": o, "counts": {"x": 1}}}) + "\n")
                note("check pinned_claude on a baseline in {} digits".format(what),
                     "binary used" if ck.pinned_claude(root)[1] else "no binary", "no binary")
        finally:
            for k, x in keep.items():
                if x is None:
                    os.environ.pop(k, None)
                else:
                    os.environ[k] = x
            # the clean copy is copied for every later probe: leave no odd-named file in it
            for x in (h, os.path.join(d, "tmp", "ascii-root"), os.path.join(d, render)):
                if os.path.isdir(x):
                    shutil.rmtree(x)
                elif os.path.lexists(x):
                    os.unlink(x)
        return (1 if bad else 0), "\n".join(out) + "\n"

