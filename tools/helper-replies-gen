#!/usr/bin/python3
"""tools/helper-replies-gen: record real helper replies for BT-05 (ROOT-RULINGS: WP-core owns it).

Usage:
  tools/helper-replies-gen            write plugin/tests/unit/_gen/helper-replies.gen.ts
  tools/helper-replies-gen --check    exit 1 when the committed module differs from a fresh run

Runs the built launcher plugin/scripts/<name>-store (run tools/build first) through the calls the
mod makes (BUILD-PLAN §3.1, hooks/lib/helper.ts and log.ts), in one fresh temporary HOME with
STORE_TEST_MODE=1, a fixed clock and a fixed Claude pid, and records each call's argv, exit
code and stdout. The U test (plugin/tests/unit/replies.test.ts, WP-mod) replays the same argv
against the mod's fake helper and compares exit codes and output shapes.

Recorded text is made portable: the plugin folder becomes $PLUGIN (the helper prints its own
quoted launcher path in commands), the temp dir becomes $TMP, the temp HOME becomes ~ and the
plugin name is split out (each string is kept as parts; join them with a name), so the module
holds no user path and no name. ASCII escapes keep marker shapes out of plugin/'s plain text.
"""
import json, os, shutil, subprocess, sys, tempfile

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
OUT = os.path.join(REPO, "plugin", "tests", "unit", "_gen", "helper-replies.gen.ts")
PLUGIN = os.path.join(REPO, "plugin")
# The launcher folder (PKG-RUNTIME A.1): one constant, as in tools/build, deps.ts and ctx.pm.
LAUNCHER_DIR = "scripts"
SID = "5e55a001-0c0f-4f1e-9a00-00000000a001"
NONCE = "1a2b3c4d"
NOW = "2026-10-21T14:05:12+03:00"
CLAUDE_PID = "424242:Tue Oct 21 09:00:00 2026"
# D-18 handoff-turn ids (8 lowercase hex): open/supersede/superseded, none, staged with a draft,
# staged with no safe finish command, published, claimed with no file in place (publish-failed),
# and one never opened.
HT_OPEN, HT_NONE, HT_DRAFT, HT_NOFINISH, HT_PUBLISHED, HT_FAILED, HT_UNKNOWN = (
    "0a0b0c01", "0a0b0c02", "0a0b0c03", "0a0b0c04", "0a0b0c05", "0a0b0c06", "0a0b0c09")
# Stage nonces of the published and publish-failed hts (the sentinel's n= must match, CR-F9).
NONCE_PUBLISHED, NONCE_FAILED = "3c4d5e6f", "4d5e6f70"
# CR-F9 follow-up: the recorded reply of these rows must start so, else the generator fails
# (a claim alone answers publish-failed, so the published row needs its handoff file in place).
EXPECT_PREFIX = {"handoff-state-published": "published ", "handoff-state-publish-failed": "publish-failed "}


def brand():
    with open(os.path.join(REPO, "brand.json"), encoding="utf-8") as f:
        return json.load(f)["name"]


def summary(name):
    # A shaped main summary as the mod's after-step writes it (marker line 1, sentinel last).
    return ("<summary>\n⟪{0} v1 n={1} s=main⟫\n# LAB-42 — retry in progress\n"
            "## Resume here\nStatus: active\n⟪/{0} n={1}⟫\n</summary>\n").format(name, NONCE)


def ht_setup(tmp, home):
    """Files `begin` and `publish` (WP-skills) write for a bound ht, written here directly so the
    recorded `handoff-state` replies cover every form (core lib/handoff_turn.pm)."""
    root = os.path.join(home, ".claude", "handoffs")
    d = os.path.join(root, ".watch", SID, "handoff-turn")
    bucket = os.path.join(root, "repo", "LAB-42")
    stages = {HT_DRAFT: os.path.join(bucket, ".staging", "5e55a001-0a0b0c03"),
              HT_NOFINISH: os.path.join(bucket, ".staging", "it's-0a0b0c04")}
    for ht, st in stages.items():
        os.makedirs(st)
        with open(os.path.join(st, "body.md"), "w", encoding="utf-8") as f:
            f.write("# LAB-42 retry\n" if ht == HT_DRAFT else "")
        with open(os.path.join(d, ht + ".stage"), "w", encoding="utf-8") as f:
            f.write(st + "\n")
    # Published (CR-F9): a bound stage with its nonce, the claim, and the handoff file in place
    # as publish writes it (frontmatter, marker, body, the stage's sentinel last). Publish-failed:
    # a bound stage and a claim whose file was never placed.
    name = brand()
    claims = {HT_PUBLISHED: (NONCE_PUBLISHED, "2026-10-21_14-05-12_5e55a001_retry.md"),
              HT_FAILED: (NONCE_FAILED, "2026-10-21_14-05-12_5e55a001_retry-2.md")}
    for ht, (nonce, base) in claims.items():
        st = os.path.join(bucket, ".staging", "5e55a001-" + nonce)
        os.makedirs(st)
        with open(os.path.join(st, "body.md"), "w", encoding="utf-8") as f:
            f.write("# LAB-42 retry\n")
        with open(os.path.join(st, "settings.json"), "w", encoding="utf-8") as f:
            f.write(json.dumps({"nonce": nonce, "bucket": bucket, "stem": base[:-3]}) + "\n")
        with open(os.path.join(d, ht + ".stage"), "w", encoding="utf-8") as f:
            f.write(st + "\n")
        path = os.path.join(bucket, base)
        with open(os.path.join(d, ht + ".published"), "w", encoding="utf-8") as f:
            f.write(path + "\n")
        if ht == HT_PUBLISHED:
            with open(path, "w", encoding="utf-8") as f:
                f.write("---\ntype: handoff\nstatus: in-progress\n---\n"
                        "\u27ea{0} v1 n={1} s=manual\u27eb\n# LAB-42 retry\n"
                        "\u27ea/{0} n={1}\u27eb\n".format(name, nonce))
            with open(os.path.join(st, "published"), "w", encoding="utf-8") as f:
                f.write(path + "\n")


def calls(tmp):
    row = json.dumps({"v": 1, "ev": "nudge", "sid": SID, "actor": "main", "writer": "mod"}, separators=(",", ":"))
    prow = json.dumps({"v": 1, "ev": "temp_path", "path": "$TMP/out.log"}, separators=(",", ":"))
    disp = ["dispatch", "--sid", SID, "--nonce", NONCE, "--actor", "main", "--trigger", "auto",
            "--channel", "mod-hook", "--resume-pref", "prompt.context", "--tags", "midturn",
            "--midturn", "true", "--instr-sha8", "9f2c01ab", "--instr-bytes", "3994",
            "--cc-version", "2.1.306", "--load-id", "l0ad0001"]
    hto = lambda ht: ["handoff-turn", "open", "--sid", SID, "--ht", ht, "--reason", "cap", "--max-calls", "34",
                      "--max-tokens", "64000"]
    hts = lambda ht: ["handoff-state", "--sid", SID, "--ht", ht]
    trial_skip = json.dumps({"kind": "skip", "moment_id": SID[:8] + "-" + NONCE, "moment": {"kind": "m3-auto", "status": "skipped:cold"}},
                            separators=(",", ":"))
    job = json.dumps({"kind": "job", "task_id": "b1x2y3", "command": "rg -n retry src", "cwd": "$TMP/work",
                      "is_read_only": True, "backgrounded": "flag"}, separators=(",", ":"))
    save = ["save-copy", "--sid", SID, "--nonce", NONCE, "--from", tmp + "/summary.txt", "--writer", "mod",
            "--scope", "main", "--tokens", "612345,41000"]
    return [
        ("ident", ["ident", "--sid", SID]),
        ("prev-copy-none", ["prev-copy", "--sid", SID, "--actor", "main"]),
        ("dispatch-ok", disp),
        ("dispatch-exists", disp),
        ("checkpoint", ["checkpoint", "--sid", SID, "--nonce", NONCE, "--budget-ms", "10000"]),
        ("save-copy-saved", save),
        ("save-copy-exists", save),
        ("prev-copy-path", ["prev-copy", "--sid", SID, "--actor", "main"]),
        ("sweep", ["sweep", "--sid", SID, "--nonce", NONCE]),
        ("claim-claimed", ["claim", "--sid", SID, "--nonce", NONCE, "--channel", "prompt.context"]),
        ("claim-taken", ["claim", "--sid", SID, "--nonce", NONCE, "--channel", "prompt.submit"]),
        ("measure", ["measure", "--sid", SID, "--compact"]),
        ("log", ["log", "--sid", SID, "--json", row]),
        ("log-paths", ["log", "--sid", SID, "--stream", "paths", "--json", prow]),
        # D-18 B8 and Dev-1 D1 (needs/mod-to-build.md §1)
        ("handoff-turn-open", hto(HT_OPEN)),
        ("handoff-turn-open-exists", hto(HT_OPEN)),
        ("handoff-turn-supersede", ["handoff-turn", "supersede", "--sid", SID, "--ht", HT_OPEN, "--nonce", NONCE]),
        ("handoff-turn-supersede-exists", ["handoff-turn", "supersede", "--sid", SID, "--ht", HT_OPEN, "--nonce", NONCE]),
        ("handoff-turn-supersede-no-ht", ["handoff-turn", "supersede", "--sid", SID, "--ht", HT_UNKNOWN, "--nonce", NONCE]),
        (None, hto(HT_DRAFT)),
        (None, hto(HT_NOFINISH)),
        (None, ht_setup),
        ("handoff-state-none", hts(HT_NONE)),
        ("handoff-state-staged", hts(HT_DRAFT)),
        ("handoff-state-staged-no-finish", hts(HT_NOFINISH)),
        ("handoff-state-published", hts(HT_PUBLISHED)),
        ("handoff-state-publish-failed", hts(HT_FAILED)),
        ("handoff-state-superseded", hts(HT_OPEN)),
        ("log-jobs-caller", ["log", "--sid", SID, "--stream", "jobs", "--stdin"], job + "\n"),
        ("dispatch-handoff-ht", [a if a != NONCE else "2b3c4d5e" for a in disp] + ["--handoff-ht", HT_OPEN]),
        # The local shadow trial (TRIAL-DUAL-HANDOFF, P-DH-GEN): without its config both commands
        # answer that it is absent and write nothing.
        ("trial-measure-absent", ["trial-measure", "--sid", SID, "--budget-ms", "7500", "--cc-version", "2.1.306"]),
        ("trial-save-absent", ["trial-save", "--sid", SID], trial_skip + "\n"),
    ]


def portable(s, tmp, home, name):
    # The plugin folder first: the helper writes its own launcher path into the commands it
    # prints (ctx::store_cmd, PKG-RUNTIME A.1), and the repo path is a user path.
    for p in (os.path.realpath(PLUGIN), PLUGIN):
        s = s.replace(p, "$PLUGIN")
    s = s.replace(home, "~").replace(tmp, "$TMP")
    real = os.path.realpath(tmp)
    if real != tmp:
        s = s.replace(os.path.realpath(home), "~").replace(real, "$TMP")
    return s.split(name)


def record():
    name = brand()
    launcher = os.path.join(PLUGIN, LAUNCHER_DIR, name + "-store")
    if not os.access(launcher, os.X_OK):
        sys.exit("helper-replies-gen: no launcher at plugin/{}/{}-store (run tools/build)".format(LAUNCHER_DIR, name))
    tmp = tempfile.mkdtemp(prefix="replies-")
    try:
        home = os.path.join(tmp, "home")
        work = os.path.join(tmp, "work")
        os.makedirs(home)
        os.makedirs(work)
        text = summary(name)
        with open(os.path.join(tmp, "summary.txt"), "w", encoding="utf-8") as f:
            f.write(text)
        env = {"HOME": home, "PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "TZ": "Etc/GMT-3", "TMPDIR": tmp,
               "STORE_TEST_MODE": "1", "STORE_TEST_NOW": NOW, "STORE_TEST_CLAUDE_PID": CLAUDE_PID}
        rows = []
        for label, argv, *stdin in calls(tmp):
            if callable(argv):
                argv(tmp, home)
                continue
            data = stdin[0].replace("$TMP", tmp).encode("utf-8") if stdin else None
            r = subprocess.run([launcher] + argv, cwd=work, env=env, capture_output=True, timeout=60,
                               input=data, stdin=None if stdin else subprocess.DEVNULL)
            if label is None:   # a set-up call, not recorded
                continue
            out = r.stdout.decode("utf-8", "replace")
            if label == "checkpoint" and r.returncode == 0:
                # step timings vary per run; zero them so the module is reproducible
                j = json.loads(out)
                j["checkpoint_ms"] = {k: 0 for k in j.get("checkpoint_ms") or {}}
                out = json.dumps(j, separators=(",", ":"), ensure_ascii=False) + "\n"
            want = EXPECT_PREFIX.get(label)
            if want is not None and (r.returncode != 0 or not out.startswith(want)):
                sys.exit("helper-replies-gen: {} answered {!r} (exit {}), expected {!r}...".format(
                    label, out, r.returncode, want))
            rows.append({"name": label, "argv": [portable(a, tmp, home, name) for a in argv],
                         "exitCode": r.returncode, "stdout": portable(out, tmp, home, name)})
        inputs = {"$TMP/summary.txt": text.split(name)}
        stdins = {lab: s[0].split(name) for lab, _a, *s in calls(tmp) if s and lab}
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    for r in rows:
        if r["name"] in stdins:
            r["stdin"] = stdins[r["name"]]
    return render(rows, inputs)


def render(rows, inputs):
    return ("// GEN by tools/helper-replies-gen from real helper runs (BT-05). Do not edit; run the tool.\n"
            "// Strings are kept in parts split at the plugin name: join the parts with a name.\n"
            "// $PLUGIN stands for the plugin folder, $TMP for the run's temp dir and ~ for its HOME.\n\n"
            "export type RecordedReply = { name: string; argv: readonly (readonly string[])[]; exitCode: number;"
            " stdout: readonly string[]; stdin?: readonly string[] }\n\n"
            "export const REPLY_SID = " + json.dumps(SID) + "\n"
            "export const REPLY_NONCE = " + json.dumps(NONCE) + "\n\n"
            "/** Files the calls read, by recorded path (parts split at the name). */\n"
            "export const REPLY_INPUTS: Readonly<Record<string, readonly string[]>> = "
            + json.dumps(inputs, ensure_ascii=True, indent=1) + "\n\n"
            "export const HELPER_REPLIES: readonly RecordedReply[] = "
            + json.dumps(rows, ensure_ascii=True, indent=1) + "\n")


def main(argv):
    if argv not in ([], ["--check"]):
        sys.exit(__doc__)
    text = record()
    if argv == ["--check"]:
        # bytes as written (newline=""): CRLF drift is a difference too (BH-5)
        cur = open(OUT, encoding="utf-8", newline="").read() if os.path.exists(OUT) else None
        ok = cur == text
        print("HELPER REPLIES CHECK: " + ("PASS" if ok else "FAIL (run tools/helper-replies-gen)"))
        return 0 if ok else 1
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    print("helper-replies-gen: wrote {} replies to {}".format(text.count('"name":'), os.path.relpath(OUT, REPO)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
