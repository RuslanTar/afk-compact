#!/usr/bin/python3
"""tools/check: run one phase's exit checks in order; stop at the first failure.

Usage: tools/check PHASE [--names FILE] [--no-drill] | tools/check xgen [--no-c8]
  PHASE    phase0       X-validate (Claude Code's `claude plugin validate plugin --strict`, which
                        compiles the hooks module under the installed Claude Code's module
                        rules, then the skeleton), X-test, X-types, X-gen, X-launcher,
                        X-assemble, X-gates, X-name, X-tools, BT-02 rename drill
           integration  the same with every skill required, plus X-variants (the lab variant builds
                        skills-only and triggers-off, each validated) and X-H (every helper case:
                        tests/helper/run.* over tests/helper/cases, then the WP-watch driver;
                        only the KNOWN_RED cases may fail, each for its stated reason); its
                        X-launcher also runs the launcher cases on Linux in Docker
           selftest     X-tools alone
           xgen         X-gen alone (used by the X-tools probes of the canary baseline)
  --names  the competitor-name list; default $GATE_NAMES_FILE. Missing = X-gates fails.
  --no-drill  skip X-tools and BT-02 (used for the drill's own run inside its renamed copy)
  --no-c8  xgen only, the caller's opt-in to the weaker canary check when the Claude Code
           binary the baseline records is not installed (see X-gen); its PASS line says the C8
           counts were not compared. Every other phase refuses it (exit 2): the release path,
           phase0 and integration, always compares the C8 counts.

Time: integration runs every helper case twice (X-H here, and again in the BT-02 copy, whose own
`tools/check integration --no-drill` repeats every check), plus the X-tools probes. Give a full
run a wall-clock cap of at least 3,600 s, raised from the 1,700 s used before: in one measured
run at a load average of about 150 to 275 on 14 cores, the helper cases alone took 1,191 s and a full run
1,483 s, and an earlier run on that branch was cut at 1,700 s in its BT-02 pass. AT-CK-09 (case
AT-CK-02-03-05-06-08-09-12) is load-sensitive: under such load the evidence sweep's time budget
(sweep.pm) can run out before its last file, which is then listed referenced-budget instead of
withheld. It failed in 1 of 2 runs alone on that tree and on the one before it; re-run it alone
on a quiet machine before taking a failure for a regression.

X-gates: tools/gates over plugin, README.md and docs (all gates), then names, user-path,
attribution, stale-name and changelog (CHANGELOG.md only) alone over the community files that
exist (CONTRIBUTING.md, CODE_OF_CONDUCT.md, SECURITY.md, CHANGELOG.md, .github, bench). X-name:
stale-name over plugin, README.md and docs.

X-gen: tools/build --check, tools/fixtures-gen --check, tools/helper-replies-gen --check,
tools/canary-baseline --check (pinned to the Claude Code binary the baseline records, so an
update does not make it flaky; a baseline with no c8.counts, or whose c8.binary_version is not
a version string equal to its cc_version, fails; so does a baseline whose binary is not
installed, unless the caller gave `xgen --no-c8`: then the baseline's bytes are compared with
a render that reads no binary, tools/canary-baseline --no-c8, given the baseline's own c8 part
and cc_version, and every C8 part but the counts' values with the tool's constants: the count
keys, each count rare (1 to rare_max; never 0), rare_max and idle_prefixes) and
tools/assemble --check (goldens, the goldens index goldens.gen.ts and its data modules
goldens.<asset>[.<n>].gen.ts, stray _gen/goldens*.gen.ts files), each byte for byte.

X-launcher: tools/launcher-flags (the restart launcher's flag
table against `claude --help` of the newest installed Claude Code), tools/respawn-keepset (the
background restart's keep-set in restart.pm against the respawnFlags sanitizer of every
installed Claude Code, read from the binary, never run), then tests/launcher/run.sh
(its cases with a stub claude under every installed POSIX shell); integration adds
tests/launcher/docker.sh (the same cases on Linux: debian:bookworm-slim with dash as /bin/sh
and bash, and the local launcher-test-alpine:1 with busybox ash and zsh; no network, no
credentials; both images must be present locally, the alpine one from docker.sh
--build-alpine). LAUNCHER_DOCKER=skip skips the Docker part and says so.

X-tools: plant known faults in temp copies of the work tree (tmp/selftest/) and confirm that
the tool reports every one, while the unplanted copy passes the same command: CRLF line ends
in GEN files (tools/build, helper-replies-gen, canary-baseline, assemble), stray files where
only GEN tools write (a stray _gen/goldens*.gen.ts, which tools/build accepts, by assemble), the
goldens modules under a 64 KiB test cap (overflow modules that the same cap's checks and the
test kit pass; goldens-split), a golden larger than the module cap, other candidate names inside
longer words, npm manifests or node_modules under
plugin/ (BT-06), a hand edit of the canary baseline (X-gen), a canary baseline that would pick
the fallback (no c8, a c8.binary_version that is not cc_version, one with a trailing newline,
both versions renamed to one not installed with changed counts while the recorded one is
installed), the release path (phase0 and integration refuse --no-c8 and call the canary
check strict), the fallback under --no-c8 (its PASS line says the C8 counts were not compared;
its check of each C8 part that is a tool constant: count keys, count range, rare_max one below
the tool's, one above it and 0, idle_prefixes, on that renamed baseline; its text compare: a CRLF baseline,
an extra blank line), versions in fullwidth or Arabic-Indic digits (a baseline holding them,
and file names that canary-baseline, launcher-flags, respawn-keepset and pinned_claude would
pick), tools/canary-baseline --no-c8 (its
render equals the baseline but c8; each call that is not a render to another file exits 2), a
SKILL.md description over the BT-09 rule, the text gates (AT-W-01 wait text, AT-W-02 asset bytes, AT-SK-01 budget line and caps, AT-SK-03
write-first line, AT-J-13 self-heal table and resume SKILL size), a resume protocol over its
hard cap (assemble), AT-WD-02 manifest defaults and VD-01 title defaults and
pick lists, the content gates
(AT-TX-01/03/05/06/07/08/12/13, AT-PR-06, AT-PK-02, AT-IC-11: a moved template bullet, a lint
id without texts, a renumbered template § and a renamed Step, `$ARGUMENTS`, a starred read-back
line, run-from-text wording, a changed Stalled phrase, a `U-` item rule, a bare launcher call
and `allowed-tools`, a situational resume trigger, the nudge folder fallback gone, CL-01 work
said to die on `/clear`, CL-02 "Move to background and exit" said to keep all of it), the
built-folder gates (AT-CAP-02 a ctx.pm/settings.pm/config.ts default off the manifest,
AT-WB-08 a bad export class, AT-ON-02 a manifest key with no settings section, AT-WB-11 a
network module on the report path, AT-WB-01 an unlisted `ev`, AT-WB-15 a second helper call,
a log read and a REVEAL line to run, AT-ST-06 a file-time test,
AT-P5-06 a code-line `·` without `use utf8`), the approval and text-rule gates (AP-11
scoped approvals, the model pin, AT-QA-06 queue text; soft budgets over their logged
reason, AT-SR-10 the old never-run rule back; a gate list without the
production write, a dropped [from …] tag, foreign text inline in a risk call, the old
README promise, a queue line in the resume SKILL, a malformed budget reason, the AT-SR-09 risk
corpus against loosened literals), the restart launcher's flag table out of step with `claude
--help` (a dropped flag, a wrong arity, a dropped subcommand), the
background restart's keep-set out of step with Claude Code's sanitizer (a variadic flag
dropped, a flag the restart drops added),
the AT-PK-01 launcher layout (a bin/ launcher left behind, a non-executable scripts/
launcher, a hook command or a text line in bin/, "on the Bash PATH"), a cross-WP `git mv`
(owners-check), a checkout with core.autocrlf=true without the repo's
.gitattributes (the launcher must keep LF and run), tools/build --out at, above or inside the
repo and a variant from a tree that differs from HEAD, an X-H runner
that dies after a KNOWN_RED case, a hooks module that breaks a Claude Code module rule
(X-validate: `$` passed to a function not declared at the top of register.ts, the rule of
Claude Code 2.1.312), a `.planning/` note in the index or in a commit
(the planning gate fails the build), the pre-rename name outside its
one FORMER_NAMES line, the docs (a no-run phrase in docs/usage.md and in the landing README.md;
in src/docs a link to a missing anchor and to no page, a heading another shipped page has, a
relative image in a shipped page and a page in neither ORDER list, all refused by tools/build;
a renamed pinned heading in docs/ and plugin/README.md, installation.md without cc_min and a
landing badge with another version, readme-pins; installation.md and a ci.yml pin comment naming a
tested-against version other than the newest release summary's, readme-tested), the changelog gate (each
tests/changelog/bad/<rule>.md planted as a CHANGELOG.md, reported under its rule; the clean copy
also runs tests/changelog/run.py). The copies never hold `.planning/`.

BT-02 (a real rename): copy the work tree to tmp/rename, set brand.json there
to the drill name, run the regenerate steps (tools/build, tools/assemble --goldens,
tools/fixtures-gen) in the copy, then the copy's own `tools/check PHASE --no-drill`, so every
check of the phase (X-test and X-H included) runs under the new name; brand.json repo becomes
<owner>/<drill name> as well. Then the old name must be gone from the copy's plugin/, README.md,
docs/ and marketplace file, the old launcher removed
from scripts/ and from the old bin/ (which must be gone), the new one in scripts/, and the
repo's own tree unchanged.

Environment: CC_TYPES_DIR (tools/typecheck), NODE or node on PATH, `claude` on PATH;
LAUNCHER_DOCKER=skip (X-launcher without its Docker part).
"""
import contextlib, importlib.machinery, importlib.util, io, json, os, re, shutil, subprocess, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))


def _build_consts():
    """LAUNCHER_DIR and OLD_LAUNCHER_DIRS from this tree's tools/build: one spelling of the
    launcher folder."""
    loader = importlib.machinery.SourceFileLoader("tools_build", os.path.join(REPO, "tools", "build"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("tools_build", loader))
    loader.exec_module(mod)
    return mod.LAUNCHER_DIR, tuple(os.path.relpath(d, "plugin") for d in mod.OLD_LAUNCHER_DIRS)


LAUNCHER_DIR, OLD_LAUNCHER_DIRS = _build_consts()   # "scripts", ("bin",)


def launcher_rel(name, folder=LAUNCHER_DIR):
    return "plugin/{}/{}-store".format(folder, name)

EVENTS = {"PreCompact": 5, "PostCompact": 15, "SessionStart": 5, "SessionEnd": 5,
          "Stop": 8, "SubagentStop": 3, "StopFailure": 2, "PermissionDenied": 2}   # the classic events
SESSION_START_MATCHER = "startup|resume|clear|compact|fork"
SKILLS_ALL = ["handoff", "resume", "status", "report", "settings", "prune"]   # report: closed beta; settings: 0.1.2 onboarding; prune: 0.1.6
WATCH_DRIVERS = ["tests/helper/cases/watch/_driver/run-watch.pl"]
DRILL_NAME = "x" * 14
DRILL_DIR = os.path.join(REPO, "tmp", "rename")
SELFTEST_DIR = os.path.join(REPO, "tmp", "selftest")
RENAME_STEPS = [["tools", "build"], ["tools", "assemble", "--goldens"], ["tools", "fixtures-gen"]]   # regenerate steps
COPY_SKIP_TOP = {".git", "node_modules", "tmp", ".planning"}   # .planning: private notes, never copied
COPY_SKIP = {"__pycache__", ".DS_Store", os.path.join("plugin", ".claude-plugin", "types")}
# Hand-written files outside the build, scanned by four gates in X-gates (each when present).
COMMUNITY = ["CONTRIBUTING.md", "CODE_OF_CONDUCT.md", "SECURITY.md", "CHANGELOG.md", ".github", "bench"]


class Fail(Exception):
    pass


def run(argv, label, cwd=REPO, capture=False):
    print("$ " + " ".join(argv), flush=True)
    r = subprocess.run(argv, cwd=cwd, capture_output=capture, text=True)
    if capture and r.stdout and not argv[-1] == "--json":
        sys.stdout.write(r.stdout[-4000:])
    if r.returncode != 0:
        if capture:
            sys.stdout.write((r.stdout or "")[-4000:] + (r.stderr or "")[-2000:])
        raise Fail("{}: exit {}".format(label, r.returncode))
    return r


def brand(root=REPO):
    with open(os.path.join(root, "brand.json"), encoding="utf-8") as f:
        return json.load(f)


def validate_errors(rep):
    """The errors of a `claude plugin validate --json` report, as (where, message) pairs: the
    manifest's, and each content file's (the hooks module's compile and module rules among them)."""
    out = []
    for part in [rep.get("manifest") or {}] + list(rep.get("contents") or []):
        for e in part.get("errors") or []:
            where = os.path.basename(part.get("file") or "?") + (" " + e["path"] if e.get("path") else "")
            out.append((where, str(e.get("message", ""))))
    return out


def x_validate(plugin_dir, root_dir, name, skills_required):
    """Claude Code's own `claude plugin validate --strict` first: it compiles the hooks module and
    applies the module rules of the installed Claude Code (2.1.312 added one: `$` may go only to a
    function declared at the top of the module, or one it imports from its own files), so a new
    rule fails here, offline, before a session refuses to load the plugin (the X-tools probe
    `module-rule` plants such a fault). Then the plugin's own layout."""
    argv = ["claude", "plugin", "validate", plugin_dir, "--strict", "--json"]
    print("$ " + " ".join(argv), flush=True)
    r = subprocess.run(argv, capture_output=True, text=True)
    try:
        rep = json.loads(r.stdout)
    except ValueError:
        sys.stdout.write((r.stdout or "")[-4000:] + (r.stderr or "")[-2000:])
        raise Fail("X-validate plugin: exit {}, no JSON report".format(r.returncode))
    errors = validate_errors(rep) if isinstance(rep, dict) else []
    for where, msg in errors:
        print("X-validate error {}: {}".format(where, msg))
    if r.returncode != 0 or not isinstance(rep, dict) or not rep.get("success"):
        raise Fail("X-validate plugin: exit {}, {} error(s), success is {}".format(
            r.returncode, len(errors), rep.get("success") if isinstance(rep, dict) else None))
    hooks = [c for c in rep.get("contents", []) if c.get("type") == "hooks"]
    if len(hooks) != 1 or not any(n.startswith("./register.ts hooks:") for n in hooks[0].get("notes", [])):
        raise Fail("X-validate: the report does not name one hooks module (./register.ts)")
    with open(os.path.join(plugin_dir, "hooks", "hooks.json"), encoding="utf-8") as f:
        hj = json.load(f)
    if hj.get("modules") != ["./register.ts"]:
        raise Fail("X-validate: hooks.json modules is {}".format(hj.get("modules")))
    if set(hj.get("hooks", {})) != set(EVENTS):
        raise Fail("X-validate: classic events {} != EVENTS".format(sorted(hj.get("hooks", {}))))
    for ev, timeout in EVENTS.items():
        groups = hj["hooks"][ev]
        cmds = [h for g in groups for h in g.get("hooks", [])]
        want = '"${{CLAUDE_PLUGIN_ROOT}}/{}/{}-store" hook {}'.format(LAUNCHER_DIR, name, ev)
        if len(cmds) != 1 or cmds[0].get("type") != "command" or cmds[0].get("command") != want:
            raise Fail("X-validate: {} command is not the quoted shell form {}".format(ev, want))
        if cmds[0].get("timeout") != timeout:
            raise Fail("X-validate: {} timeout {} != {}".format(ev, cmds[0].get("timeout"), timeout))
        matcher = groups[0].get("matcher")
        if ev == "SessionStart" and matcher != SESSION_START_MATCHER:
            raise Fail("X-validate: SessionStart matcher {}".format(matcher))
        if ev != "SessionStart" and matcher not in (None, "", "*"):
            raise Fail("X-validate: {} has matcher {}".format(ev, matcher))
    sk_dir = os.path.join(plugin_dir, "skills")
    present = sorted(d for d in os.listdir(sk_dir) if os.path.isfile(os.path.join(sk_dir, d, "SKILL.md")))
    missing = [s for s in skills_required if s not in present]
    if missing:
        raise Fail("X-validate: skills missing: {}".format(missing))
    extra = [s for s in present if s not in SKILLS_ALL]
    if extra:
        raise Fail("X-validate: unexpected skills: {}".format(extra))
    pending = [s for s in SKILLS_ALL if s not in present]
    run(["claude", "plugin", "validate", root_dir, "--strict"], "X-validate marketplace", capture=True)
    print("X-validate: PASS (1 module, {} classic events, skills {}{})".format(
        len(EVENTS), ", ".join(present), "; pending: " + ", ".join(pending) if pending else ""))


def x_assemble(name_first):
    for n in (name_first, "x" * 14, "x" * 16):
        r = run([os.path.join(REPO, "tools", "assemble"), "--name", n, "--path-len", "141"],
                "X-assemble " + n, capture=True)
