     "write" : "$ROOT/.sessions/by-pid/22192-0.live-f1f1f1f1.json"
    },
    {
     "content" : "{\"cwd\":\"$TMP/repo\",\"host\":\"$HOST\",\"pid\":33333,\"pid_lstart\":null,\"session_id\":\"f2f2f2f2-1111-4222-8333-444444444444\",\"source\":\"startup\",\"ts\":\"2026-10-21T12:00:00+03:00\",\"worktree\":\"$TMP/repo\"}",
     "write" : "$ROOT/.sessions/by-pid/33333-0.live-f2f2f2f2.json"
    },
    {
     "content" : "{\"cwd\":\"$TMP/repo\",\"host\":\"$HOST\",\"pid\":12044,\"pid_lstart\":\"Wed Oct 21 12:00:00 2026\",\"session_id\":\"f3f3f3f3-1111-4222-8333-444444444444\",\"source\":\"startup\",\"ts\":\"2026-10-21T13:50:00+03:00\",\"worktree\":\"$TMP/repo\"}",
     "write" : "$ROOT/.sessions/by-pid/12044-1792573200.live-f3f3f3f3.json"
