{
 "id": "CW-1 (status without a session id)",
 "layer": "H",
 "owner": "core",
 "note": "Cowork check 2026-10-26, finding CW-1: in a Cowork task the skill text kept ${CLAUDE_SESSION_ID} and the task's Bash had CLAUDE_SESSION_ID empty, so `status --sid \"\"` refused and the model guessed an id. status only reads: a missing, empty or unsubstituted --sid prints `session: unknown (no session id)` and the store-wide lines (watcher, settings thresholds, smokeDue, allow rule, user-run lines without the reconcile line, handoff mode, relaunch state, prod reads, settings, queue, kept stashes, watcher counts), never this session's lines, and writes nothing (no session folder, no once markers, no rows). A value that is not a session id is still refused. Commands that work on one session's state keep refusing a missing, empty or unsubstituted --sid, with the reason on stderr. CW-1 review 2: a bare CLAUDE_SESSION_ID and a $CLAUDE_SESSION_ID without braces are unsubstituted too, and the no-id queue line says this session's queue state is unknown",
 "now": "2026-10-26T02:30:00+02:00",
 "tz": "Etc/GMT-2",
 "steps": [
  {"name": "this session's rows, a halt, a kept stash and smokeDue",
   "setup": [
    {"mkdir": "$TMP/work"},
    {"write": "$WATCH/version.json", "json": {"lastVersion": "2.1.310", "smokeDue": "2.1.310", "previousVersion": "2.1.309"}},
    {"write": "$WATCH/$SID.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-26T02:00:00+02:00", "ev": "config_effective", "sid": "$SID", "actor": "main", "writer": "mod",
      "window": 1000000, "native_trigger": 967000, "soft_max": 600000, "target": 400000, "min_window": 329000},
     {"v": 1, "ts": "2026-10-26T02:00:01+02:00", "ev": "policy", "sid": "$SID", "actor": "main", "writer": "mod",
      "mods_managed_only": false, "hooks_managed_only": false}]},
    {"write": "$WATCH/$SID.classic.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-26T02:10:00+02:00", "ev": "hook", "sid": "$SID", "actor": "main", "writer": "classic"}]},
    {"write": "$WATCH/$SID/halt.json", "json": {"active": true, "reason": "thrash", "since": "2026-10-26T02:05:00+02:00"}},
    {"write": "$WATCH/5e55a0ff-0000-4000-8000-000000000002/pending/1a2b3c4d.mod.mismatch.md", "text": "redacted"}
   ]},
  {"name": "empty --sid: session unknown, store-wide lines only, nothing written",
   "argv": ["status", "--sid", "", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\A(?:ok|attention): [^\\n]*\\nwatcher: true · ",
                   "^session: unknown \\(no session id\\); this session's compactions, escalations, halt, policy and hook rows are not shown$",
                   "^thresholds: settings only \\(target 400000 · soft max 600000 · min_window 329000\\)$",
                   "^smokeDue: 2\\.1\\.310 \\(Claude Code changed; run: ! \"/[^\"]+/scripts/$BRAND-store\" smoke\\)$",
                   "^allow rule \\(default mode\\): Bash\\(\"/[^\"]+/scripts/$BRAND-store\" wait \\*\\)$",
                   "^user-run commands \\(type them yourself, with the leading !\\):$",
                   "^  ! \"/[^\"]+/scripts/$BRAND-store\" report$",
                   "^handoff mode: private ",
                   "^automatic relaunch: ",
                   "^unattended_prod_reads: false ",
                   "^protected branches: the shipped list \\+ 0 yours ",
                   "^idle compaction: .*\\(from your user settings; the session decides at its next turn end\\)$",
                   "^settings: resume_proceed \\S+ \\([^)]+\\) · handoff_reuse_window_min ",
                   "^queue: off$",
                   "^kept mismatch stashes: 1 \\(redacted; the plugin never deletes them\\)$",
                   "^Alerts, last 7 days: none$",
                   "^Last watcher row: 2026-10-26T02:10:00\\+02:00$"],
    "stdout_lacks": ["^compactions: ", "^escalations: ", "^halt: ", "^policy: ", "^last hook row: ", "reconcile --sid",
                     "^Alerts this session", "^thresholds: window ", "$SID"],
    "absent": ["$WATCH/$SID/once", "$WATCH/unknown", "$WATCH/unknown.jsonl", "$WATCH/unknown.classic.jsonl", "$WATCH/anon-*",
               "$WATCH/*/once"]}},
  {"name": "no --sid at all: the same",
   "argv": ["status", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\A(?:ok|attention): [^\\n]*\\nwatcher: true · ", "^session: unknown \\(no session id\\); ", "^thresholds: settings only \\(",
                   "^kept mismatch stashes: 1 "],
    "stdout_lacks": ["^compactions: ", "^halt: ", "^policy: ", "^last hook row: ", "reconcile --sid", "$SID"],
    "absent": ["$WATCH/unknown", "$WATCH/unknown.jsonl", "$WATCH/unknown.classic.jsonl", "$WATCH/anon-*", "$WATCH/*/once"]}},
  {"name": "unsubstituted ${CLAUDE_SESSION_ID} (single quotes): the same",
   "argv": ["status", "--sid", "${CLAUDE_SESSION_ID}", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\A(?:ok|attention): [^\\n]*\\nwatcher: true · ", "^session: unknown \\(no session id\\); ", "^thresholds: settings only \\(",
                   "^queue: off$"],
    "stdout_lacks": ["^compactions: ", "^halt: ", "^policy: ", "^last hook row: ", "reconcile --sid", "CLAUDE_SESSION_ID", "$SID"],
    "absent": ["$WATCH/unknown", "$WATCH/unknown.jsonl", "$WATCH/unknown.classic.jsonl", "$WATCH/anon-*", "$WATCH/*/once"]}},
  {"name": "a value that is not a session id is still refused",
   "argv": ["status", "--sid", "not a sid", "--cwd", "$TMP/work"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is not a session id$"]}},
  {"name": "with the session id: this session's lines and the reconcile line, no unknown line",
   "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["\\A(?:ok|attention): [^\\n]*\\nwatcher: true · ",
                   "^thresholds: target 400000 · soft_max 600000 · window 1000000 · native_trigger 967000 · min_window 329000$",
                   "^compactions: 0 in this session; last 0 \\(0 not ok\\):$",
                   "^escalations: none$",
                   "^halt: on \\(thrash\\) · continues this hour: 0 of ",
                   "^policy: mods managed only no · hooks managed only no$",
                   "^  ! \"/[^\"]+/scripts/$BRAND-store\" reconcile --sid $SID --orphans --full$",
                   "^last hook row: 2026-10-26T02:30:00",
                   "^kept mismatch stashes: 1 "],
    "stdout_lacks": ["^session: unknown", "^thresholds: settings only"]}},
  {"name": "reconcile (writes this session's state): an empty --sid is refused with the reason",
   "argv": ["reconcile", "--sid", "", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "",
    "stderr_has": ["^usage: --sid is required \\(no session id; this command works on one session's state and never runs without its id\\)$"],
    "absent": ["$WATCH/unknown", "$WATCH/unknown.classic.jsonl", "$WATCH/anon-*"]}},
  {"name": "reconcile: no --sid is refused",
   "argv": ["reconcile", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "",
    "stderr_has": ["^usage: --sid is required \\(no session id; "]}},
  {"name": "reconcile: an unsubstituted ${CLAUDE_SESSION_ID} is refused and named",
   "argv": ["reconcile", "--sid", "${CLAUDE_SESSION_ID}", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "",
    "stderr_has": ["^usage: --sid is required \\(the session id was not substituted; this command works on one session's state and never runs without its id\\)$"],
    "absent": ["$WATCH/unknown", "$WATCH/unknown.classic.jsonl", "$WATCH/anon-*"]}},
  {"name": "checkpoint (writes per-session state): empty, missing and unsubstituted are refused",
   "argv": ["checkpoint", "--sid", "", "--nonce", "71000001", "--budget-ms", "10000"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is required \\(no session id; "]}},
  {"argv": ["checkpoint", "--nonce", "71000001", "--budget-ms", "10000"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is required \\(no session id; "]}},
  {"argv": ["checkpoint", "--sid", "${CLAUDE_SESSION_ID}", "--nonce", "71000001", "--budget-ms", "10000"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is required \\(the session id was not substituted; "],
    "absent": ["$WATCH/unknown", "$WATCH/unknown.classic.jsonl", "$WATCH/anon-*"]}},
  {"name": "pin (writes this session's pin): empty and missing are refused like the unsubstituted one (HT-PI-01)",
   "argv": ["pin", "--sid", "", "--resumed-from", "$TMP/work/none.md"],
   "expect": {"exit": 3, "stdout": "REFUSED: no-session\n"}},
  {"argv": ["pin", "--resumed-from", "$TMP/work/none.md"],
   "expect": {"exit": 3, "stdout": "REFUSED: no-session\n"}},
  {"argv": ["pin", "--sid", "${CLAUDE_SESSION_ID}", "--resumed-from", "$TMP/work/none.md"],
   "expect": {"exit": 3, "stdout": "REFUSED: no-session\n"}},
  {"name": "the pool of rows without a session id (hook.pl logs them under `unknown`)",
   "setup": [
    {"write": "$WATCH/unknown.classic.jsonl", "jsonl": [
     {"v": 1, "ts": "2026-10-26T02:11:00+02:00", "ev": "watch_error", "sid": "unknown", "actor": "main", "writer": "classic"}]}
   ]},
  {"name": "status --sid unknown (the placeholder, not a session): the no-id path, the pool is not shown, nothing written",
   "argv": ["status", "--sid", "unknown", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["^session: unknown \\(no session id\\); ", "^thresholds: settings only \\(", "^queue: off$"],
    "stdout_lacks": ["^escalations: ", "watch_error", "^last hook row: ", "reconcile --sid"],
    "absent": ["$WATCH/unknown"]}},
  {"name": "status --sid smoke and --sid anon-…: the same",
   "argv": ["status", "--sid", "smoke", "--cwd", "$TMP/work"],
   "expect": {"exit": 0, "stdout_has": ["^session: unknown \\(no session id\\); "],
    "stdout_lacks": ["^escalations: ", "reconcile --sid"], "absent": ["$WATCH/smoke"]}},
  {"argv": ["status", "--sid", "anon-1258b019e83284fa", "--cwd", "$TMP/work"],
   "expect": {"exit": 0, "stdout_has": ["^session: unknown \\(no session id\\); "],
    "stdout_lacks": ["^escalations: ", "reconcile --sid"], "absent": ["$WATCH/anon-*"]}},
  {"name": "reconcile and checkpoint refuse a placeholder id: its folder is many sessions' rows",
   "argv": ["reconcile", "--sid", "unknown", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "",
    "stderr_has": ["^usage: --sid is not a session id \\(unknown is the plugin's placeholder for rows without one\\)$"],
    "absent": ["$WATCH/unknown"]}},
  {"argv": ["reconcile", "--sid", "smoke", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is not a session id \\(smoke is the plugin's placeholder "]}},
  {"argv": ["checkpoint", "--sid", "anon-1258b019e83284fa", "--nonce", "71000001", "--budget-ms", "10000"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is not a session id \\(anon-1258b019e83284fa is the plugin's placeholder "],
    "absent": ["$WATCH/anon-*"]}},
  {"name": "CW-1 review 2: a bare CLAUDE_SESSION_ID (braces and dollar dropped) is no session id: the no-id path, nothing written",
   "argv": ["status", "--sid", "CLAUDE_SESSION_ID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["^session: unknown \\(no session id\\); ", "^thresholds: settings only \\(", "^queue: off$"],
    "stdout_lacks": ["^compactions: ", "^halt: ", "reconcile --sid", "CLAUDE_SESSION_ID"],
    "absent": ["$WATCH/CLAUDE_SESSION_ID", "$WATCH/CLAUDE_SESSION_ID.classic.jsonl", "$WATCH/CLAUDE_SESSION_ID.jsonl"]}},
  {"name": "CW-1 review 2: $CLAUDE_SESSION_ID without braces: the same, not a refusal",
   "argv": ["status", "--sid", "$CLAUDE_SESSION_ID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["^session: unknown \\(no session id\\); ", "^thresholds: settings only \\("],
    "stdout_lacks": ["^compactions: ", "^halt: ", "reconcile --sid", "CLAUDE_SESSION_ID"]}},
  {"name": "reconcile names both as not substituted",
   "argv": ["reconcile", "--sid", "CLAUDE_SESSION_ID", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "",
    "stderr_has": ["^usage: --sid is required \\(the session id was not substituted; "],
    "absent": ["$WATCH/CLAUDE_SESSION_ID", "$WATCH/CLAUDE_SESSION_ID.classic.jsonl"]}},
  {"argv": ["reconcile", "--sid", "$CLAUDE_SESSION_ID", "--orphans", "--full"],
   "expect": {"exit": 64, "stdout": "", "stderr_has": ["^usage: --sid is required \\(the session id was not substituted; "]}},
  {"name": "CW-1 review 2: queue on without a session id says this session's queue state is unknown",
   "setup": [{"write": "$TMP/bin/queue", "text": "#!/bin/sh\nexit 0\n", "mode": "0755"}],
   "options": {"queue_cmd": "$TMP/bin/queue"},
   "argv": ["status", "--sid", "", "--cwd", "$TMP/work"],
   "expect": {"exit": 0,
    "stdout_has": ["^session: unknown \\(no session id\\); ", "^queue: on \\(this session's queue state unknown: no session id\\)$"]}},
  {"name": "with the session id: plain `queue: on`",
   "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/work"],
   "expect": {"exit": 0, "stdout_has": ["^queue: on$"], "stdout_lacks": ["queue state unknown"]}}
 ]
}
