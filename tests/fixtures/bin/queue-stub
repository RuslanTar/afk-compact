#!/bin/sh
# AT-E-10, HT-LA-01, AT-Q (D-10): a queue_cmd with canned answers chosen by its first argument.
# QUEUE_STUB_DIR holds <subcommand>.out (printed), <subcommand>.err (printed to stderr),
# <subcommand>.rc (exit code, default 0) and <subcommand>.sleep (seconds to wait before
# answering, for the helper's 5 s budget). QUEUE_STUB_LOG, when set, gets one line per call
# with the arguments, so a case can assert that no adopt or add call happened.
# QUEUE_STUB_STDIN, when set, receives what `add` reads on stdin (the queue-add/v1 draft);
# without it `add` still drains stdin. A subcommand without a canned answer exits 64.
# Q-ADAPTER QA-2 (AT-QA-03, -04): queue/v1-tagged, v1-count, untagged and v2 hold strict-contract
# list replies; queue/adopt-* hold the adopt exit codes 0, 2, 3 (`REFUSED: held: holder=<sid>
# kind=<process|heartbeat> lane=<id>` on stdout), 4 and 6. Each folder's list.expect /
# adopt.expect names what the plugin must make of the reply; the stub never reads those.
[ -n "$QUEUE_STUB_LOG" ] && printf '%s\n' "$*" >> "$QUEUE_STUB_LOG"
sub=$1
dir=${QUEUE_STUB_DIR:-$(dirname "$0")/../queue/prose}
if [ "$sub" = add ] && [ ! -t 0 ]; then cat > "${QUEUE_STUB_STDIN:-/dev/null}"; fi
[ -f "$dir/$sub.out" ] || [ -f "$dir/$sub.rc" ] || exit 64
[ -f "$dir/$sub.sleep" ] && sleep "$(cat "$dir/$sub.sleep")"
[ -f "$dir/$sub.err" ] && cat "$dir/$sub.err" >&2
[ -f "$dir/$sub.out" ] && cat "$dir/$sub.out"
rc=0
[ -f "$dir/$sub.rc" ] && rc=$(cat "$dir/$sub.rc")
exit "$rc"
