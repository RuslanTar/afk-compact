#!/usr/bin/python3
"""tools/check: run one phase's exit checks (BUILD-PLAN §4) in order; stop at the first failure.

Usage: tools/check PHASE [--names FILE] [--no-drill]
  PHASE    phase0       X-validate (skeleton), X-test, X-types, X-gen, X-assemble, X-gates,
                        X-name, X-tools, BT-02 rename drill
           integration  the same with every skill required, plus X-H (every helper case:
                        tests/helper/run.* over tests/helper/cases, then the WP-watch driver)
           selftest     X-tools alone
  --names  the competitor-name list (E-7); default $GATE_NAMES_FILE. Missing = X-gates fails.
  --no-drill  skip X-tools and BT-02 (used for the drill's own run inside its renamed copy)

X-tools: plant known faults in temp copies of the work tree (tmp/selftest/) and confirm that
tools/build --check and tools/gates report every one, while the unplanted copy passes the
same command: CRLF line ends in GEN files, stray files where only GEN tools write, other
candidate names inside longer words, and npm manifests or node_modules under plugin/ (BT-06).

BT-02 (BUILD-PLAN §4.6, a real rename): copy the work tree to tmp/rename, set brand.json there
to the drill name, run the §4.6 regenerate steps (tools/build, tools/assemble --goldens,
tools/fixtures-gen) in the copy, then the copy's own `tools/check PHASE --no-drill`, so every
check of the phase (X-test and X-H included) runs under the new name. Then the old name must
be gone from the copy's plugin/, README.md and marketplace file, the old launcher removed, and
the repo's own tree unchanged.

Environment: CC_TYPES_DIR (tools/typecheck), NODE or node on PATH, `claude` on PATH.
"""
import json, os, re, shutil, subprocess, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
EVENTS = {"PreCompact": 5, "PostCompact": 15, "SessionStart": 5, "SessionEnd": 5,
          "Stop": 8, "SubagentStop": 3, "StopFailure": 2, "PermissionDenied": 2}   # MOD §1.3, D-4
SESSION_START_MATCHER = "startup|resume|clear|compact|fork"
SKILLS_ALL = ["handoff", "resume", "status"]
WATCH_DRIVERS = ["tests/helper/cases/watch/_driver/run-watch.pl"]
DRILL_NAME = "x" * 14
DRILL_DIR = os.path.join(REPO, "tmp", "rename")
SELFTEST_DIR = os.path.join(REPO, "tmp", "selftest")
RENAME_STEPS = [["tools", "build"], ["tools", "assemble", "--goldens"], ["tools", "fixtures-gen"]]   # §4.6
COPY_SKIP_TOP = {".git", "node_modules", "tmp"}
COPY_SKIP = {"__pycache__", ".DS_Store", os.path.join("plugin", ".claude-plugin", "types")}


class Fail(Exception):
    pass


def run(argv, label, cwd=REPO, capture=False):
    print("$ " + " ".join(argv), flush=True)
    r = subprocess.run(argv, cwd=cwd, capture_output=capture, text=True)
    if capture and r.stdout and not argv[-1] == "--json":
        sys.stdout.write(r.stdout[-4000:])
    if r.returncode != 0:
        if capture:
            sys.stdout.write((r.stdout or "")[-4000:] + (r.stderr or "")[-2000:])
        raise Fail("{}: exit {}".format(label, r.returncode))
    return r


def brand(root=REPO):
    with open(os.path.join(root, "brand.json"), encoding="utf-8") as f:
        return json.load(f)


def x_validate(plugin_dir, root_dir, name, skills_required):
    r = run(["claude", "plugin", "validate", plugin_dir, "--strict", "--json"], "X-validate plugin", capture=True)
    rep = json.loads(r.stdout)
    if not rep.get("success"):
        raise Fail("X-validate: success is false")
    hooks = [c for c in rep.get("contents", []) if c.get("type") == "hooks"]
    if len(hooks) != 1 or not any(n.startswith("./register.ts hooks:") for n in hooks[0].get("notes", [])):
        raise Fail("X-validate: the report does not name one hooks module (./register.ts)")
    with open(os.path.join(plugin_dir, "hooks", "hooks.json"), encoding="utf-8") as f:
        hj = json.load(f)
    if hj.get("modules") != ["./register.ts"]:
        raise Fail("X-validate: hooks.json modules is {}".format(hj.get("modules")))
    if set(hj.get("hooks", {})) != set(EVENTS):
        raise Fail("X-validate: classic events {} != MOD §1.3".format(sorted(hj.get("hooks", {}))))
    for ev, timeout in EVENTS.items():
        groups = hj["hooks"][ev]
        cmds = [h for g in groups for h in g.get("hooks", [])]
        want = '"${{CLAUDE_PLUGIN_ROOT}}/bin/{}-store" hook {}'.format(name, ev)
        if len(cmds) != 1 or cmds[0].get("type") != "command" or cmds[0].get("command") != want:
            raise Fail("X-validate: {} command is not the quoted shell form {}".format(ev, want))
        if cmds[0].get("timeout") != timeout:
            raise Fail("X-validate: {} timeout {} != {}".format(ev, cmds[0].get("timeout"), timeout))
        matcher = groups[0].get("matcher")
        if ev == "SessionStart" and matcher != SESSION_START_MATCHER:
            raise Fail("X-validate: SessionStart matcher {}".format(matcher))
        if ev != "SessionStart" and matcher not in (None, "", "*"):
            raise Fail("X-validate: {} has matcher {}".format(ev, matcher))
    sk_dir = os.path.join(plugin_dir, "skills")
    present = sorted(d for d in os.listdir(sk_dir) if os.path.isfile(os.path.join(sk_dir, d, "SKILL.md")))
    missing = [s for s in skills_required if s not in present]
    if missing:
        raise Fail("X-validate: skills missing: {}".format(missing))
    extra = [s for s in present if s not in SKILLS_ALL]
    if extra:
        raise Fail("X-validate: unexpected skills: {}".format(extra))
    pending = [s for s in SKILLS_ALL if s not in present]
    run(["claude", "plugin", "validate", root_dir, "--strict"], "X-validate marketplace", capture=True)
    print("X-validate: PASS (1 module, {} classic events, skills {}{})".format(
        len(EVENTS), ", ".join(present), "; pending: " + ", ".join(pending) if pending else ""))


def x_assemble(name_first):
    for n in (name_first, "x" * 14, "x" * 16):
        r = run([os.path.join(REPO, "tools", "assemble"), "--name", n, "--path-len", "141"],
                "X-assemble " + n, capture=True)
        if "RESULT: PASS" not in r.stdout:
            raise Fail("X-assemble {}: no RESULT: PASS".format(n))


def gates(targets, names, brand_name, only=None):
    argv = [os.path.join(REPO, "tools", "gates")] + targets + ["--names", names or "", "--brand", brand_name]
    if only:
        argv += ["--only", only]
    run(argv, "gates " + " ".join(targets) + (" --only " + only if only else ""), capture=True)


def tree_state():
    return subprocess.run(["git", "-C", REPO, "status", "--porcelain", "--untracked-files=all"],
                          capture_output=True, text=True).stdout


def copy_tree(dst):
    """Copy the work tree (tracked and untracked files; no .git, node_modules or tmp/) to dst.

    node_modules is linked, not copied, so X-types runs in the copy. Symlinks stay links.
    """
    if os.path.lexists(dst):
        shutil.rmtree(dst)
    for d, dirs, files in os.walk(REPO):
        rel = os.path.relpath(d, REPO)
        keep = []
        for x in sorted(dirs):
            xrel = os.path.normpath(os.path.join(rel, x))
            if (rel == "." and x in COPY_SKIP_TOP) or x in COPY_SKIP or xrel in COPY_SKIP:
                continue
            if os.path.islink(os.path.join(d, x)):
                os.makedirs(os.path.join(dst, rel), exist_ok=True)
                os.symlink(os.readlink(os.path.join(d, x)), os.path.join(dst, xrel))
                continue
            keep.append(x)
        dirs[:] = keep
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for f in files:
            if f not in COPY_SKIP:
                shutil.copy2(os.path.join(d, f), os.path.join(dst, rel, f), follow_symlinks=False)
    if os.path.isdir(os.path.join(REPO, "node_modules")):
        os.symlink(os.path.join(REPO, "node_modules"), os.path.join(dst, "node_modules"))


# ---------------------------------------------------------------- X-tools (self-test)

def write_text(path, text, mode="w"):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, mode, encoding="utf-8", newline="") as f:
        f.write(text)


def to_crlf(path):
    with open(path, "rb") as f:
        data = f.read()
    with open(path, "wb") as f:
        f.write(data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n"))


def probes(name):
    """(id, finding, argv relative to the copy, plant(copy), [regex every stdout must hold])."""
    gates_only = lambda g: ["tools/gates", "plugin", "--names", os.devnull, "--brand", name,
                            "--no-git-log", "--only", g]

    def crlf(d):
        to_crlf(os.path.join(d, "plugin", "bin", name + "-store"))
        to_crlf(os.path.join(d, "plugin", "hooks", "hooks.json"))

    def stray(d):
        for rel in ("plugin/assets/old-asset.txt", "plugin/hooks/lib/old.gen.ts",
                    "plugin/tests/unit/_gen/stray.gen.ts", "plugin/.claude-plugin/extra.json",
                    "plugin/notes.txt", "plugin/skills/handoff/.hidden"):
            write_text(os.path.join(d, rel), "stray\n")

    def other_names(d):
        write_text(os.path.join(d, "plugin", "README.md"),
                   "\nP5 cache at ~/.cache/compact-handoff-research and the compact-handoffs folder\n"
                   "P6 the compactseams and wheelover2 variants, and HOLD-THREADS\n", "a")

    def npm(d):
        write_text(os.path.join(d, "plugin", "package.json"), '{"dependencies":{"left-pad":"1.3.0"}}\n')
        write_text(os.path.join(d, "plugin", "node_modules", "left-pad", "index.js"), "module.exports = 1\n")
        write_text(os.path.join(d, "plugin", "helper", "package-lock.json"), "{}\n")

    readme = r"plugin/README\.md:\d+: "
    return [
        ("crlf", "RN-4", ["tools/build", "--check"], crlf,
         [r"^differs plugin/bin/" + re.escape(name) + r"-store$", r"^differs plugin/hooks/hooks\.json$"]),
        ("stray", "RN-5", ["tools/build", "--check"], stray,
         [r"^stale plugin/assets/old-asset\.txt$", r"^stale plugin/hooks/lib/old\.gen\.ts$",
          r"^stale plugin/tests/unit/_gen/stray\.gen\.ts$", r"^stale plugin/\.claude-plugin/extra\.json$",
          r"^stale plugin/notes\.txt$", r"^stale plugin/skills/handoff/\.hidden$"]),
        ("other-names", "RN-3", gates_only("stale-name"), other_names,
         ["^GATE stale-name " + readme + n + "$" for n in ("compact-handoff", "compactseam", "wheelover", "hold-thread")]),
        ("npm", "RN-6", gates_only("npm"), npm,
         [r"^GATE npm plugin/package\.json: BT-06", r"^GATE npm plugin/node_modules/: BT-06",
          r"^GATE npm plugin/helper/package-lock\.json: BT-06"]),
    ]


def x_tools():
    name = brand()["name"]
    if os.path.lexists(SELFTEST_DIR):
        shutil.rmtree(SELFTEST_DIR)
    clean = os.path.join(SELFTEST_DIR, "clean")
    copy_tree(clean)
    failures = []
    for pid, finding, argv, plant, want in probes(name):
        r = subprocess.run([os.path.join(clean, argv[0])] + argv[1:], cwd=clean, capture_output=True, text=True)
        if r.returncode != 0:
            failures.append("{} ({}): `{}` fails on the unplanted copy:\n{}".format(
                pid, finding, " ".join(argv), (r.stdout + r.stderr)[-1500:]))
            continue
        d = os.path.join(SELFTEST_DIR, pid)
        shutil.copytree(clean, d, symlinks=True)
        plant(d)
        r = subprocess.run([os.path.join(d, argv[0])] + argv[1:], cwd=d, capture_output=True, text=True)
        lines = r.stdout.splitlines()
        missing = [w for w in want if not any(re.search(w, ln) for ln in lines)]
        if r.returncode != 1 or missing:
            failures.append("{} ({}): `{}` exit {}; not reported: {}\n{}".format(
                pid, finding, " ".join(argv), r.returncode, missing, r.stdout[-1500:]))
        else:
            print("X-tools {} ({}): {} planted faults reported".format(pid, finding, len(want)))
    if failures:
        for f in failures:
            print("X-tools FAIL " + f)
        raise Fail("X-tools: {} of {} probes not caught".format(len(failures), len(probes(name))))
    shutil.rmtree(SELFTEST_DIR)
    print("X-tools: PASS ({} probes)".format(len(probes(name))))


# ---------------------------------------------------------------- BT-02 (rename drill)

def old_name_left(root, old):
    """Lines in the renamed copy's shipped files that still hold the old name (substring)."""
    targets = [os.path.join(root, "README.md"), os.path.join(root, ".claude-plugin", "marketplace.json")]
    for d, dirs, files in os.walk(os.path.join(root, "plugin")):
        dirs[:] = sorted(x for x in dirs if x not in ("node_modules", ".git") and
                         not (x == "types" and os.path.basename(d) == ".claude-plugin"))
        targets += [os.path.join(d, f) for f in sorted(files)]
    left = []
    for p in targets:
        if not os.path.isfile(p):
            continue
        with open(p, "rb") as f:
            data = f.read()
        if b"\0" in data[:8192]:
            continue
        for no, line in enumerate(data.decode("utf-8", errors="replace").splitlines(), 1):
            if old in line:
                left.append("{}:{}".format(os.path.relpath(p, root), no))
    return left


def bt02(phase, names):
    old = brand()["name"]
    if old in DRILL_NAME:
        raise Fail("BT-02: the drill name {} contains the brand {}".format(DRILL_NAME, old))
    before = tree_state()
    copy_tree(DRILL_DIR)
    b = brand(DRILL_DIR)
    if b["marketplace"] == b["name"]:
        b["marketplace"] = DRILL_NAME
    b["name"] = DRILL_NAME
    write_text(os.path.join(DRILL_DIR, "brand.json"), json.dumps(b, indent=2, ensure_ascii=False) + "\n")
    for step in RENAME_STEPS:
        run([os.path.join(DRILL_DIR, *step[:2])] + step[2:], "BT-02 " + " ".join(step), cwd=DRILL_DIR)
    inner = [os.path.join(DRILL_DIR, "tools", "check"), phase, "--no-drill"] + (["--names", names] if names else [])
    run(inner, "BT-02 tools/check {} under {}".format(phase, DRILL_NAME), cwd=DRILL_DIR)
    left = old_name_left(DRILL_DIR, old)
    if left:
        raise Fail("BT-02: the old name {} is left in {} lines of the renamed copy: {}".format(
            old, len(left), ", ".join(left[:12])))
    if os.path.exists(os.path.join(DRILL_DIR, "plugin", "bin", old + "-store")):
        raise Fail("BT-02: the old launcher survived in the renamed copy")
    run([os.path.join(REPO, "tools", "build"), "--check"], "BT-02 committed tree")
    if tree_state() != before:
        raise Fail("BT-02: the drill changed the working tree")
    shutil.rmtree(DRILL_DIR)
    print("BT-02: PASS (renamed to {} by the §4.6 steps; tools/check {} passed in the copy; "
          "no {} left; committed tree unchanged)".format(DRILL_NAME, phase, old))


def main(argv):
    if not argv or argv[0] not in ("phase0", "integration", "selftest"):
        sys.exit(__doc__)
    phase = argv[0]
    names = os.environ.get("GATE_NAMES_FILE")
    if "--names" in argv:
        names = argv[argv.index("--names") + 1]
    drill = "--no-drill" not in argv
    steps = []
    if phase == "selftest":
        try:
            steps.append("X-tools")
            x_tools()
        except Fail as e:
            print("CHECK selftest: FAIL at X-tools ({})".format(e))
            return 1
        print("CHECK selftest: PASS (X-tools)")
        return 0
    b = brand()
    name = b["name"]
    skills_required = ["handoff", "resume"] if phase == "phase0" else SKILLS_ALL
    plugin = os.path.join(REPO, "plugin")
    tools = os.path.join(REPO, "tools")
    try:
        steps.append("X-validate")
        x_validate(plugin, REPO, name, skills_required)
        steps.append("X-test")
        run(["claude", "plugin", "test", plugin], "X-test")
        steps.append("X-types")
        run([os.path.join(tools, "typecheck")], "X-types")
        steps.append("X-gen")
        run([os.path.join(tools, "build"), "--check"], "X-gen build")
        if os.path.exists(os.path.join(tools, "fixtures-gen")):
            run([os.path.join(tools, "fixtures-gen"), "--check"], "X-gen fixtures")
        elif phase == "integration":
            raise Fail("X-gen: tools/fixtures-gen missing")
        else:
            print("X-gen: tools/fixtures-gen not present yet (WP-fix); build part only")
        if os.path.exists(os.path.join(tools, "helper-replies-gen")):
            run([os.path.join(tools, "helper-replies-gen"), "--check"], "X-gen helper replies")
        steps.append("X-assemble")
        x_assemble(name)
        steps.append("X-gates")
        gates(["plugin"], names, name)
        gates(["README.md"], names, name)
        steps.append("X-name")
        gates(["plugin", "README.md"], names, name, only="stale-name")
        if phase == "integration":
            steps.append("X-H")
            runners = [f for f in os.listdir(os.path.join(REPO, "tests", "helper"))
                       if f.startswith("run.")] if os.path.isdir(os.path.join(REPO, "tests", "helper")) else []
            if not runners:
                raise Fail("X-H: no tests/helper/run.* yet")
            cases = os.path.join(REPO, "tests", "helper", "cases")
            run([os.path.join(REPO, "tests", "helper", runners[0]), cases], "X-H")
            # WP-watch's cases are case.pl files run in-process by their own driver, which
            # the case.json runner does not read (escalated); X-H runs that driver as well.
            for drv in WATCH_DRIVERS:
                p = os.path.join(REPO, drv)
                if os.path.exists(p):
                    run(["/usr/bin/perl", p], "X-H " + drv)
        if drill:
            steps.append("X-tools")
            x_tools()
            steps.append("BT-02")
            bt02(phase, names)
    except Fail as e:
        print("CHECK {}: FAIL at {} ({})".format(phase, steps[-1], e))
        return 1
    print("CHECK {}: PASS ({})".format(phase, ", ".join(steps)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
