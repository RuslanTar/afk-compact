{
 "id": "HT-RE-01",
 "tmp_base": "repo",
 "layer": "H",
 "owner": "skills",
 "note": "restore-evidence <handoff> --to DIR: copies the listed copies (not withheld, not ref-only) into DIR 0700 with files 0600, prints one line per file, never moves (the durable copies stay)",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "setup": [
  {
   "repo": {
    "branch": "feature/LAB-7-retry",
    "commits": [
     {
      "files": {
       "app/retry.rb": "x = 1\n"
      },
      "msg": "seed"
     }
    ]
   },
   "at": "$TMP/repo"
  },
  {
   "write": "$TMP/s/notes.txt",
   "content": "notes\n"
  },
  {
   "write": "$TMP/s/other.txt",
   "content": "other\n"
  },
  {
   "write": "$TMP/s/app.log",
   "content_parts": [
    "ok\npass",
    "word=hunter2",
    "xyz\n"
   ]
  },
  {
   "write": "$TMP/s/.env",
   "content": "A=1\n"
  },
  {
   "bigfile": "$TMP/s/big.bin",
   "bytes": 11534336
  }
 ],
 "cwd": "$TMP/repo",
 "argv": [
  "begin",
  "--sid",
  "$SID",
  "--topic",
  "retry"
 ],
 "capture": {
  "STAGE": "json:stage",
  "NONCE": "json:nonce",
  "STEM": "json:stem"
 },
 "expect": {
  "exit": 0
 },
 "then": [
  {
