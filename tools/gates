        out.append((launcher, None, "AT-PK-01 launcher", "AT-PK-01 launcher: no {}/{}-store".format(LAUNCHER_DIR, brand), ""))
    elif os.stat(launcher).st_mode & 0o777 != 0o755:
        out.append((launcher, None, "AT-PK-01 launcher", "AT-PK-01 launcher: mode {:o}, want 755".format(
            os.stat(launcher).st_mode & 0o777), ""))
    hj = os.path.join(target, "hooks", "hooks.json")
    if os.path.isfile(hj):   # the skills-only variant ships no hooks/
        try:
            with open(hj, encoding="utf-8") as f:
                groups = json.load(f).get("hooks") or {}
        except ValueError:
            groups = None
            out.append((hj, None, "AT-PK-01 hooks", "AT-PK-01 hooks: hooks.json is not valid JSON", ""))
        n = 0
        for ev, lst in sorted((groups or {}).items()):
            for h in (x for g in lst for x in (g.get("hooks") or [])):
                if h.get("type") != "command":
                    continue
                n += 1
                m = HOOK_CMD.match(h.get("command") or "")
                if not m or m.group(1) != LAUNCHER_DIR or m.group(2) != brand or m.group(3) != ev:
                    out.append((hj, None, "AT-PK-01 hooks", "AT-PK-01 hooks: {} command {!r}, want '\"${{CLAUDE_PLUGIN_ROOT}}/"
                                "{}/{}-store\" hook {}'".format(ev, h.get("command"), LAUNCHER_DIR, brand, ev), ""))
        if groups is not None and n != HOOK_COUNT:
            out.append((hj, None, "AT-PK-01 hooks", "AT-PK-01 hooks: {} commands, want {}".format(n, HOOK_COUNT), ""))
    other_dir = re.compile(r"/([^/\s\"'`()<>]+)/" + re.escape(brand) + r"-store" + E)
    # A bare call (`<brand>-store <subcommand>`, no folder before it) only works if the launcher
    # is on the Bash PATH, which it is not since BLD-01: shipped text calls it by its full path
