    strict validation; skills-only has no hooks/ or tests/, triggers-off pins triggers false.
    --allow-dirty: the check also runs on uncommitted trees and in the BT-02 copy (no git); the
    clean-tree refusal itself is the X-tools build-out probe (CR-F41/F45)."""
    for v in ("skills-only", "triggers-off"):
        out = os.path.join(VARIANTS_DIR, v)
        run([os.path.join(REPO, "tools", "build"), "--variant", v, "--out", out, "--allow-dirty"],
            "X-variants build " + v, capture=True)
        plugin_dir = os.path.join(out, "plugin")
        run(["claude", "plugin", "validate", plugin_dir, "--strict"], "X-variants validate " + v, capture=True)
        run(["claude", "plugin", "validate", out, "--strict"], "X-variants validate marketplace " + v, capture=True)
        with open(os.path.join(plugin_dir, ".claude-plugin", "plugin.json"), encoding="utf-8") as f:
            doc = json.load(f)
        if doc.get("name") != name:
            raise Fail("X-variants: {} manifest name {}".format(v, doc.get("name")))
        trig = doc["userConfig"]["triggers"]["default"]
        has = [x for x in ("hooks", "tests") if os.path.exists(os.path.join(plugin_dir, x))]
        if v == "skills-only" and (has or not os.path.isfile(os.path.join(plugin_dir, "bin", name + "-store"))):
            raise Fail("X-variants: skills-only has {} or no launcher".format(has))
        if v == "skills-only" and trig is not True:
            raise Fail("X-variants: skills-only changed triggers")
        if v == "triggers-off" and (trig is not False or "hooks" not in has):
            raise Fail("X-variants: triggers-off has triggers {} / hooks {}".format(trig, "hooks" in has))
    shutil.rmtree(VARIANTS_DIR)
    print("X-variants: PASS (skills-only, triggers-off)")


# ---------------------------------------------------------------- X-H

# Helper cases accepted as failing until a named later merge, each with the regex one line of
# its first failing step must match (any other case failing, or a different first failure,
# fails X-H). Remove a row when it prints KNOWN-RED-DONE.
KNOWN_RED = {}


def x_h(argv):
    """X-H: the helper runner, with the KNOWN_RED cases allowed to fail as stated."""
    print("$ " + " ".join(argv), flush=True)
    # One stream, in the order the runner writes it: a case's `#   ` lines follow its `not ok`.
    r = subprocess.run(argv, cwd=REPO, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    out = r.stdout
    sys.stdout.write(out[-4000:])
    failed, first, cur = [], {}, None
    for line in out.splitlines():
        m = re.match(r"^(not )?ok \d+ - (.*)$", line)
        if m:
            cur = m.group(2).strip() if m.group(1) else None
            if cur:
                failed.append(cur)
            continue
        m = re.match(r"^#   (step \d+):", line)
        if cur and m and first.setdefault(cur, (m.group(1), []))[0] == m.group(1):
            first[cur][1].append(line)
    # CR-F42: the runner prints its plan and summary only after the last case; a run that died
    # part-way (a die outside a case, a signal, an OOM kill) lacks them and never passes.
    finished = (re.search(r"(?m)^1\.\.\d+$", out) and re.search(r"(?m)^# passed \d+, failed \d+", out))
    if not finished or r.returncode not in (0, 1):
        raise Fail("X-H: exit {}; the runner did not finish (no `1..N` and `# passed` lines, or "
                   "an exit other than 0/1)".format(r.returncode))
    if r.returncode == 0:
        for case in sorted(KNOWN_RED):
            print("KNOWN-RED-DONE {}: passes now; remove it from KNOWN_RED".format(case))
        return
    bad = [c for c in failed if c not in KNOWN_RED
           or not any(re.search(KNOWN_RED[c], ln) for ln in first.get(c, ("", []))[1])]
    if bad or not failed:
        raise Fail("X-H: exit {}; failed beyond KNOWN_RED: {}".format(r.returncode, ", ".join(bad) or "(none parsed)"))
    for case in sorted(KNOWN_RED):
        if case in failed:
            hit = next(ln for ln in first[case][1] if re.search(KNOWN_RED[case], ln))
            print("KNOWN-RED {}: {}".format(case, hit.strip()[:160]))
        else:
            print("KNOWN-RED-DONE {}: passes now; remove it from KNOWN_RED".format(case))
    print("X-H: PASS except KNOWN_RED ({} cases)".format(len(failed)))


def main(argv):
    if not argv or argv[0] not in ("phase0", "integration", "selftest", "xgen"):
        sys.exit(__doc__)
    phase = argv[0]
    names = os.environ.get("GATE_NAMES_FILE")
    if "--names" in argv:
        names = argv[argv.index("--names") + 1]
    drill = "--no-drill" not in argv
    steps = []
    if phase == "selftest":
        try:
            steps.append("X-tools")
            x_tools()
        except Fail as e:
            print("CHECK selftest: FAIL at X-tools ({})".format(e))
            return 1
        print("CHECK selftest: PASS (X-tools)")
        return 0
    if phase == "xgen":
        try:
            steps.append("X-gen")
            x_gen("integration")
        except Fail as e:
            print("CHECK xgen: FAIL at X-gen ({})".format(e))
            return 1
        print("CHECK xgen: PASS (X-gen)")
        return 0
    b = brand()
    name = b["name"]
    skills_required = ["handoff", "resume"] if phase == "phase0" else SKILLS_ALL
    plugin = os.path.join(REPO, "plugin")
    tools = os.path.join(REPO, "tools")
    try:
        steps.append("X-validate")
        x_validate(plugin, REPO, name, skills_required)
        steps.append("X-test")
        run(["claude", "plugin", "test", plugin], "X-test")
        steps.append("X-types")
        run([os.path.join(tools, "typecheck")], "X-types")
        steps.append("X-gen")
        x_gen(phase)
        steps.append("X-assemble")
        x_assemble(name)
        steps.append("X-gates")
        gates(["plugin"], names, name)
        gates(["README.md"], names, name)
        steps.append("X-name")
        gates(["plugin", "README.md"], names, name, only="stale-name")
        if phase == "integration":
            steps.append("X-variants")
            x_variants(name)
            steps.append("X-H")
            runners = [f for f in os.listdir(os.path.join(REPO, "tests", "helper"))
                       if f.startswith("run.")] if os.path.isdir(os.path.join(REPO, "tests", "helper")) else []
            if not runners:
                raise Fail("X-H: no tests/helper/run.* yet")
            cases = os.path.join(REPO, "tests", "helper", "cases")
            x_h([os.path.join(REPO, "tests", "helper", runners[0]), cases])
            # WP-watch's cases are case.pl files run in-process by their own driver, which
            # the case.json runner does not read (escalated); X-H runs that driver as well.
            for drv in WATCH_DRIVERS:
                p = os.path.join(REPO, drv)
                if os.path.exists(p):
                    run(["/usr/bin/perl", p], "X-H " + drv)
        if drill:
            steps.append("X-tools")
            x_tools()
            steps.append("BT-02")
            bt02(phase, names)
    except Fail as e:
        print("CHECK {}: FAIL at {} ({})".format(phase, steps[-1], e))
        return 1
    print("CHECK {}: PASS ({})".format(phase, ", ".join(steps)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
