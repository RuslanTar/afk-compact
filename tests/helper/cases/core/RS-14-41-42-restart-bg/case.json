              "files": [{"path": "$WATCH/$SID/restart.json", "json": {"state": "armed"}}],
              "absent": ["$TMP/stub-bypass.out", "$WATCH/$SID/restart-respawn.pid"]}},
  {"name": "another job folder's session: job-unknown", "argv": ["restart", "respawn", "--sid", "$SID", "--short", "job1", "--nonce", "aabbccddeeff0011", "--to", "2.1.312", "--job-dir", "$TMP/jobs/none", "--mode", "default"], "path_prepend": ["$TMP/bin"], "expect": {"exit": 0, "json": {"ok": false, "why": "job-unknown"}}},
  {"setup": [{"write": "$TMP/jobs/job1/state.json", "json": {"sessionId": "$SID", "respawnFlags": ["--allow-dangerously-skip-permissions", "--permission-mode", "default", "--frobnicate"]}}]},
  {"name": "B9 at the respawn: the job's flags read again hold a restriction a restart drops: restriction-lost, nothing starts", "argv": ["restart", "respawn", "--sid", "$SID", "--short", "job1", "--nonce", "aabbccddeeff0011", "--to", "2.1.312", "--job-dir", "$TMP/jobs/job1", "--mode", "default"], "path_prepend": ["$TMP/bin"], "env": {"STUB_OUT": "$TMP/stub-b9.out"}, "expect": {"exit": 0, "json": {"ok": false, "why": "restriction-lost"}, "absent": ["$TMP/stub-b9.out", "$WATCH/$SID/restart-respawn.pid"]}},
  {"setup": [{"write": "$TMP/jobs/job1/state.json", "json": {"sessionId": "$SID", "respawnFlags": ["--settings", "/s.json", "--permission-mode", "default"]}}]},
