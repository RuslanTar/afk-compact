{
 "id": "HS-07-late-save-without-evidence",
 "note": "0.1.3 hook speed (lib/reconcile.pm SWEEP_MIN_MS), a main-proven save waits for its sweep only when there is evidence to copy. With auto_evidence off, HS-05's late Stop (1.7 s late) saves the copy late at once (copy_late), with nothing for the sweep to wait for; stop_timing names nothing as cut (or only gsd, with status no-time, when a loaded host left the catch-up no time)",
 "tz": "Etc/GMT-3",
 "options": {
  "auto_evidence": false
 },
 "steps": [
  {
   "name": "setup",
   "setup": [
    {
     "mkdir": "$TMP/work"
    },
    {
     "rows": [
      {
       "prompt": {
        "ts": "2026-10-21T14:04:40+03:00"
       }
      }
     ],
     "transcript": "$TMP/proj/$SID.jsonl"
    },
    {
     "text": "evidence line\n",
     "write": "$TMP/work/tasks/ev1.output"
    },
    {
     "paths": [
      "$TMP/work/tasks/ev1.output"
     ]
    }
   ]
  },
  {
   "name": "mod dispatch (main, mod-hook); PostCompact with an unmarked summary: deferred to the after-step",
   "now": "2026-10-21T14:05:00.813+03:00",
   "setup": [
    {
     "dispatch": {
      "actor": "main",
      "channel": "mod-hook",
      "nonce": "d1d2d3d4",
      "trigger": "auto",
      "ts": "2026-10-21T14:04:48+03:00"
     }
    }
   ],
   "argv": [
    "hook",
    "PostCompact"
   ],
   "stdin_json": {
    "compact_summary": "<summary>\n1. Primary Request: RRNOSWEEP unshaped\n</summary>",
    "cwd": "$TMP/work",
    "hook_event_name": "PostCompact",
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "trigger": "auto"
   },
   "expect": {
    "exit": 0,
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "copy_deferred",
      "count": 1,
      "fields": {
       "why": "mod"
      }
     }
    ]
   }
  },
  {
   "name": "late Stop, auto_evidence off: the save is made now (no sweep to wait for)",
   "now": "2026-10-21T14:05:40+03:00",
   "setup": [
    {
     "rows": [
      {
       "boundary": {
        "duration_ms": 12100,
        "post": 9000,
        "pre": 160000,
        "precomputed": false,
        "trigger": "auto",
        "ts": "2026-10-21T14:05:00.865+03:00"
       }
      }
     ],
     "transcript": "$TMP/proj/$SID.jsonl"
    }
   ],
   "env": {
    "STORE_TEST_HOOK_START_AGO_MS": "1700"
   },
   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "background_tasks": [],
    "cwd": "$TMP/work",
    "hook_event_name": "Stop",
    "session_crons": [],
    "session_id": "$SID",
    "stop_hook_active": false,
    "transcript_path": "$TMP/proj/$SID.jsonl"
   },
   "expect": {
    "exit": 0,
    "files": [
     {
      "count": 1,
      "path": "$ROOT/work/general/compact/*_c1-d1d2d3.md"
     }
    ],
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "copy_late",
      "count": 1
     },
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "stop_timing",
      "count": 1,
      "fields_any": [
       {
        "cut": []
       },
       {
        "cut": [
         "gsd"
        ],
        "gsd": "no-time"
       }
      ]
     }
    ]
   }
  }
 ]
}
