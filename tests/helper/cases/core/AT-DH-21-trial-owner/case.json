{
 "id": "AT-DH-21-trial-owner",
 "note": "TRIAL-DUAL-HANDOFF 4.3 (P-DH-CFG, the lab case): a valid config read from another CLAUDE_CONFIG_DIR, or with a handoff root or log folder other than the pinned ones -> skip not-owner-config with the reason; a trial folder inside the pinned handoff root -> bad dir-in-handoff_root; a skip-listed repo -> skip repo-skipped; a CLAUDE_CONFIG_DIR whose settings.json is the account's own file (a symlink to ~/.claude/settings.json: the owner's same-file rule, 2026-10-27 20:38) is the owner's config, so the next check decides",
 "now": "2026-10-27T10:00:00+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "another config dir",
   "setup": [
    {
     "mkdir": "$TMP/work"
    },
    {
     "mkdir": "$TMP/other-config"
    },
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "env": {
    "CLAUDE_CONFIG_DIR": "$TMP/other-config"
   },
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "not-owner-config",
     "why": "config-dir"
    }
   }
  },
  {
   "name": "a config dir whose settings.json is the account's own file: the same file, not config-dir",
   "setup": [
    {
     "write": "$HOME/.claude/settings.json",
     "json": {}
    },
    {
     "mkdir": "$TMP/linked-config"
    },
    {
     "symlink": "$TMP/linked-config/settings.json",
     "to": "$HOME/.claude/settings.json"
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "env": {
    "CLAUDE_CONFIG_DIR": "$TMP/linked-config",
    "CLAUDE_PLUGIN_OPTION_LOG_DIR": "$TMP/logs"
   },
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "not-owner-config",
     "why": "log-dir"
    }
   }
  },
  {
   "name": "another handoff root",
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "env": {
    "CLAUDE_PLUGIN_OPTION_HANDOFF_ROOT": "$TMP/elsewhere",
    "CLAUDE_PLUGIN_OPTION_LOG_DIR": "$WATCH"
   },
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "not-owner-config",
     "why": "handoff-root"
    }
   }
  },
  {
   "name": "another log folder",
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "env": {
    "CLAUDE_PLUGIN_OPTION_LOG_DIR": "$TMP/logs"
   },
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "not-owner-config",
     "why": "log-dir"
    }
   }
  },
  {
   "name": "trial folder inside the handoff root",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$HOME",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "bad",
     "why": "dir-in-handoff_root"
    }
   }
  },
  {
   "name": "skip-listed repo",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ],
      "skip_repos": [
       "work"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "repo-skipped"
    }
   }
  },
  {
   "name": "the owner config",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": null,
     "old.status": "no-old-skill",
     "native.status": "no-native-prompt",
     "facts.repo": "work",
     "facts.ticket": "general"
    }
   }
  }
 ]
}
