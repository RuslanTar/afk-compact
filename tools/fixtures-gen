def walk(base):
    for d, dirs, files in os.walk(base):
        dirs[:] = sorted(x for x in dirs if x not in SKIP_DIRS)
        for f in sorted(files):
            yield os.path.join(d, f)


# Sequences (README "Sequences"): ordered hook steps with the main transcript's state per step.
def transcript_counts(text):
    """(compact_boundary rows of the main thread, isCompactSummary rows) in transcript text."""
    nb = ns = 0
    for line in text.split("\n"):
        try:
            r = json.loads(line) if line.strip() else None
        except ValueError:
            continue
        if not isinstance(r, dict):
            continue
        if r.get("type") == "system" and r.get("subtype") == "compact_boundary" and not r.get("isSidechain"):
            nb += 1
        if r.get("isCompactSummary") is True:
            ns += 1
    return nb, ns


def main_boundaries(text):
    """Main-thread compact_boundary rows of transcript text: {e, off, meta, version} in file order
    (off = the byte offset of the row's line, for the 512 KB tail rule of PKG-RUNTIME E.1)."""
    out, off = [], 0
    for line in text.split("\n"):
        try:
            r = json.loads(line) if line.strip() else None
        except ValueError:
            r = None
        if (isinstance(r, dict) and r.get("type") == "system" and r.get("subtype") == "compact_boundary"
                and not r.get("isSidechain")):
            out.append({"e": parse_iso(r.get("timestamp")), "off": off, "meta": r.get("compactMetadata") or {},
                        "version": r.get("version")})
        off += len(line.encode("utf-8")) + 1
    return out


# The reconcile constants the sequence references read (reconcile.pm, MOD-SPEC §5.4; BD-3 keeps
# them as built, T-TEXT E5), the lab S-21 lag range (AT-BD-01) and the E.1 tail read.
SETTLE_S, MAIN_WINDOW_S, TOL_S, SUB_WINDOW_S = 10, 600, 2, 120
S21_LAG_MS = (12, 42)
TAIL_BYTES = 512 * 1024


def seq_compactions(inp, info):
    """One entry per PreCompact step: its capture var, the main boundary count at PreCompact,
    the PostCompact step that follows, and whether a seeded mod dispatch proves it main (P1)."""
    seeded = {}
    for s in inp.get("seed", []):
        m = re.match(r"^\$WATCH/\$SID/dispatch/([0-9a-f]{8})\.json$", s.get("to", ""))
        if m and os.path.exists(os.path.join(FIX, s.get("copy", ""))):
            seeded[m.group(1)] = json.loads(read(os.path.join(FIX, s["copy"])))
    comps = []
    for i, st in enumerate(info):
        if st["ev"] != "PreCompact":
            continue
        post = next((j for j in range(i + 1, len(info)) if info[j]["ev"] == "PostCompact"), None)
        var = next(iter(st["capture"]), None)
        comps.append({"var": var, "pre": i, "at_pre": len(st["mains"]), "post": post,
                      "post_e": info[post]["now"] if post is not None else None})
    loose = [c for c in comps if c["var"] is None]
    for n, d in seeded.items():
        if len(loose) == 1:
            loose[0].update(nonce=n, p1=d.get("agent_id") is None and d.get("channel") in ("mod-hook", "mod-self"),
                            dispatch_e=parse_iso(d.get("ts")))
    return comps


def seq_comp_for(comps, nonce):
    if isinstance(nonce, str) and nonce.startswith("$"):
        return next((c for c in comps if c["var"] == nonce[1:]), None)
    return next((c for c in comps if c.get("nonce") == nonce), None)


def seq_boundary(c, comps, st):
    """The main boundary row that reconcile matches to compaction c at step st (the first one
    after c's PreCompact count, not yet a later compaction's, at most MAIN_WINDOW_S after its
    PostCompact), or None."""
    later = [x["at_pre"] for x in comps if x["pre"] > c["pre"]]
    lim = min(later) if later else None
    for k, bd in enumerate(st["mains"]):
        if k < c["at_pre"] or (lim is not None and k >= lim) or bd["e"] is None or c["post_e"] is None:
            continue
        if c["post_e"] <= bd["e"] + 0.0005 and bd["e"] - c["post_e"] <= MAIN_WINDOW_S:
            return bd
    return None


def seq_bd3(c, comps, st):
    """BD-3 (T-TEXT E5) rollup fields of compaction c as reconcile decides them at step st."""
    bd = seq_boundary(c, comps, st)
    proof = "P1" if c.get("p1") else ("P3" if bd else "none")
    lag = int(round((bd["e"] - c["post_e"]) * 1000)) if bd and proof != "none" else None
    return {"proof": proof, "proof_lag_ms": lag, "settle_ms": int(round((st["now"] - c["post_e"]) * 1000))}


def seq_copied(c, comps, info, upto):
    """True when a Stop before step index upto has saved compaction c's copy: P1 already in
    PostCompact, else a reconcile that proves it (P3) or decides it after SETTLE_S."""
    if c.get("p1"):
        return True
    for j in range(c["post"] + 1, upto):
        if info[j]["ev"] == "Stop" and (seq_boundary(c, comps, info[j]) or info[j]["now"] - c["post_e"] >= SETTLE_S):
            return True
    return False


def seq_turn_kind(comps, info, k):
    """PKG-RUNTIME E.1 for the step index k (no rollup row, receipt or nudge in these sequences):
    a pending record qualifies when its ts is after the last Stop, it has no copy row yet, and a
    main boundary row inside the last 512 KB lies in [ts - TOL_S, ts + MAIN_WINDOW_S]."""
    stops = [info[j]["now"] for j in range(k) if info[j]["ev"] == "Stop"]
    last_stop = max(stops) if stops else None
    st = info[k]
    tail_from = st["bytes"] - TAIL_BYTES
    for c in comps:
        if c["post"] is None or c["post"] >= k or c.get("p1"):
            continue
        ts = c["post_e"]
        if last_stop is not None and ts <= last_stop:
            continue
        if seq_copied(c, comps, info, k):
            continue
        if any(bd["off"] >= tail_from and bd["e"] is not None and ts - TOL_S <= bd["e"] <= ts + MAIN_WINDOW_S
               for bd in st["mains"]):
            return "post-compaction"
    return "other"


def seq_reference(where, inp, exp, info):
    """Recompute the values step_asserts pins from the replayed transcript and hook times:
    BD-3 proof / proof_lag_ms / settle wait (AT-BD-01), E.1 turn_kind (AT-WD-10) and the E.2
    compaction_boundary sizes and the rollup join (AT-WD-11)."""
    p, comps, snaps = [], seq_compactions(inp, info), {}
    for a in exp.get("step_asserts", []):
        k = a.get("after_step", 0) - 1
        if not 0 <= k < len(info):
            continue
        st = info[k]
        for f in a.get("files", []):
            if f.get("snapshot"):
                snaps[f["snapshot"]] = (k, f["path"])
            if f.get("same_bytes_as"):
                s = snaps.get(f["same_bytes_as"])
                if s is None or s[0] >= k or s[1] != f["path"]:
                    p.append("{} after step {}: same_bytes_as {!r} needs an earlier snapshot of {}".format(
                        where, k + 1, f["same_bytes_as"], f["path"]))
        for rw in a.get("rows", []):
            f = rw.get("fields") or {}
            w = "{} after step {} {}".format(where, k + 1, rw.get("ev"))
            if rw.get("ev") == "compaction" and ({"proof", "proof_lag_ms"} & set(f)):
                c = seq_comp_for(comps, f.get("nonce"))
                if c is None or c["post"] is None or c["post"] > k:
                    p.append("{}: nonce {} names no compaction whose PostCompact ran by then".format(w, f.get("nonce")))
                    continue
                ref = seq_bd3(c, comps, st)
                for key in ("proof", "proof_lag_ms"):
                    if key in f and f[key] != ref[key]:
                        p.append("{}: {} is {!r}, the BD-3 reference gives {!r} (boundary row time minus the "
                                 "PostCompact time)".format(w, key, f[key], ref[key]))
                if ref["proof"] == "P3" and inp.get("order") == "S-21" and not S21_LAG_MS[0] <= ref["proof_lag_ms"] <= S21_LAG_MS[1]:
                    p.append("{}: proof_lag_ms {} is outside the lab S-21 range {}-{} ms".format(w, ref["proof_lag_ms"], *S21_LAG_MS))
                if ref["proof"] == "none":
                    if ref["settle_ms"] < SETTLE_S * 1000:
                        p.append("{}: unproven, but the stash is only {} ms old: reconcile waits SETTLE_S".format(w, ref["settle_ms"]))
                    ge = (a.get("fields_ge") or {}).get("settle_waited_ms")
                    if ge is None or not 0 <= ge <= ref["settle_ms"]:
                        p.append("{}: an unproven stash needs fields_ge settle_waited_ms between 0 and {}".format(w, ref["settle_ms"]))
            if rw.get("ev") == "compaction" and ({"pre_tokens", "post_tokens", "duration_ms"} & set(f)):
                c = seq_comp_for(comps, f.get("nonce"))
                if c is None or c["post"] is None or c["post"] > k:
                    p.append("{}: nonce {} names no compaction whose PostCompact ran by then".format(w, f.get("nonce")))
                    continue
                ref = seq_rollup_sizes(c, comps, info)
                for key in ("pre_tokens", "post_tokens", "duration_ms"):
                    if key in f and f[key] != ref[key]:
                        p.append("{}: rollup {} is {!r}, the writer's reading gives {!r}".format(w, key, f[key], ref[key]))
            if rw.get("ev") == "permission_denied" and "turn_kind" in f:
                if st["ev"] != "PermissionDenied":
                    p.append("{}: a turn_kind assert must follow a PermissionDenied step".format(w))
                    continue
                ref = seq_turn_kind(comps, info, k)
                if f["turn_kind"] != ref:
                    p.append("{}: turn_kind is {!r}, the E.1 reference gives {!r}".format(w, f["turn_kind"], ref))
            if rw.get("ev") == "compaction_boundary" and "nonce" in f:
                c = seq_comp_for(comps, f["nonce"])
                bd = seq_boundary(c, comps, st) if c else None
                if bd is None:
                    p.append("{}: no main boundary row is matched to nonce {} by then".format(w, f["nonce"]))
                    continue
                ref = {"pre_tokens": bd["meta"].get("preTokens"), "post_tokens": bd["meta"].get("postTokens"),
                       "duration_ms": bd["meta"].get("durationMs"), "precomputed": bool(bd["meta"].get("precomputed")),
                       "cc_version": bd["version"]}
                for key, v in sorted(ref.items()):
                    if key in f and f[key] != v:
                        p.append("{}: {} is {!r}, the matched boundary row gives {!r}".format(w, key, f[key], v))
                if rw.get("count") != 1:
                    p.append("{}: one compaction_boundary row per nonce (count 1)".format(w))
        for j in a.get("joined", []):
            p += seq_joined(where, k, j, comps, info)
    return p


SIZE_KEYS = (("pre_tokens", "preTokens"), ("post_tokens", "postTokens"), ("duration_ms", "durationMs"))


def seq_rollup_sizes(c, comps, info):
    """The rollup row's sizes as its writer fills them. P1 (mod path): PostCompact writes the row,
    with the sizes of postcompact.pm own_boundary (the newest main row already in the transcript,
    stamped no earlier than the dispatch time minus 1 s; S-21: usually none, so null). Otherwise
    reconcile writes it with the matched boundary's sizes once that row is in."""
    if c.get("p1"):
        since = c.get("dispatch_e")
        own = [x for x in info[c["post"]]["mains"] if since is not None and x["e"] is not None and x["e"] >= since - 1]
        own = own[[x["e"] for x in own].index(max(x["e"] for x in own))] if own else None   # the newest row
    else:
        own = next((seq_boundary(c, comps, st) for st in info[c["post"] + 1:] if st["ev"] == "Stop"
                    and seq_boundary(c, comps, st)), None)
    return {k2: (own["meta"].get(m) if own else None) for k2, m in SIZE_KEYS}


def seq_joined(where, k, j, comps, info):
    """E.2 join: a null rollup field takes the matched boundary's value, a non-null one is kept;
    join_conflict counts the nonces whose kept value disagrees with the boundary."""
    w = "{} after step {} joined {}".format(where, k + 1, j.get("nonce"))
    c = seq_comp_for(comps, j.get("nonce"))
    if c is None or c["post"] is None:
        return ["{}: names no compaction".format(w)]
    bd = seq_boundary(c, comps, info[k])
    keys = SIZE_KEYS
    rollup = seq_rollup_sizes(c, comps, info)
    joined, conflict = {}, 0
    for k2, m in keys:
        b = bd["meta"].get(m) if bd else None
        joined[k2] = rollup[k2] if rollup[k2] is not None else b
        conflict = 1 if rollup[k2] is not None and b is not None and rollup[k2] != b else conflict
    p = []
    for k2, v in sorted(joined.items()):
        if k2 in j and j[k2] != v:
            p.append("{}: {} is {!r}, the E.2 join gives {!r} (rollup {!r}, boundary {!r})".format(
                w, k2, j[k2], v, rollup[k2], bd["meta"] if bd else None))
    if "join_conflict" in j and j["join_conflict"] != conflict:
        p.append("{}: join_conflict is {}, the E.2 join gives {}".format(w, j["join_conflict"], conflict))
    return p


def check_sequences():
    problems, count = [], 0
    if not os.path.isdir(SEQUENCES):
        return problems, count
    for name in sorted(os.listdir(SEQUENCES)):
        d = os.path.join(SEQUENCES, name)
        if not os.path.isdir(d):
            continue
        count += 1
        where = "sequences/" + name
        try:
            inp = json.loads(read(os.path.join(d, "input.json")))
            exp = json.loads(read(os.path.join(d, "expected.json")))
        except (OSError, ValueError) as e:
            problems.append("{}: {}".format(where, e))
            continue
        if inp.get("id") != name or exp.get("id") != name:
            problems.append("{}: input.json and expected.json ids must equal the folder name".format(where))
        for s in inp.get("seed", []):
            if not os.path.exists(os.path.join(FIX, s.get("copy", ""))):
                problems.append("{}: seed file {} missing".format(where, s.get("copy")))
        steps, text, at_pre, info, broken = inp.get("steps", []), "", None, [], False
        for i, st in enumerate(steps, 1):
            argv = st.get("argv", [])
            ev = argv[1] if len(argv) > 1 and argv[0] == "hook" else None
            label = "{} step {} {}".format(where, i, ev)
            if st.get("transcript_append"):
                p = os.path.join(FIX, st["transcript_append"])
                if not os.path.exists(p):
                    problems.append("{}: transcript_append {} missing".format(label, st["transcript_append"]))
                    broken = True
                    continue
                text += read(p)
            try:
                payload = json.loads(read(os.path.join(FIX, st.get("stdin", ""))))
            except (OSError, ValueError) as e:
                problems.append("{}: stdin {}: {}".format(label, st.get("stdin"), e))
                broken = True
                continue
            if payload.get("hook_event_name") != ev or payload.get("session_id") != inp.get("sid"):
                problems.append("{}: stdin {} is a {} payload for {}".format(
                    label, st.get("stdin"), payload.get("hook_event_name"), payload.get("session_id")))
            nb, ns = transcript_counts(text)
            want = st.get("transcript_state")
            if want is not None and (want.get("boundaries"), want.get("summaries")) != (nb, ns):
                problems.append("{}: the replayed transcript holds {} boundary and {} summary rows, "
                                "transcript_state says {} and {}".format(label, nb, ns, want.get("boundaries"),
                                                                          want.get("summaries")))
            nbytes = len(text.encode("utf-8"))
            if st.get("transcript_bytes_min") is not None and nbytes < st["transcript_bytes_min"]:
                problems.append("{}: the replayed transcript is {} bytes, transcript_bytes_min says {}".format(
                    label, nbytes, st["transcript_bytes_min"]))
            if ev == "PreCompact":
                at_pre = nb
            in_hook = ev == "PostCompact" or (ev == "SessionStart" and payload.get("source") == "compact")
            if inp.get("order") == "S-21" and in_hook and at_pre is not None and nb != at_pre:
                problems.append("{}: S-21 order: the boundary row lands after PostCompact, but this step sees "
                                "{} new since PreCompact".format(label, nb - at_pre))
            info.append({"ev": ev, "now": parse_iso(st.get("now")), "capture": st.get("capture") or {},
                         "mains": main_boundaries(text), "bytes": nbytes})
        for a in exp.get("step_asserts", []):
            if not 1 <= a.get("after_step", 0) <= len(steps):
                problems.append("{}: step_asserts after_step {} is not a step".format(where, a.get("after_step")))
        if not broken and len(info) == len(steps):
            problems += seq_reference(where, inp, exp, info)
    return problems, count


# RV-24 (small-rulings §3a): a time in fixture text is a stamp, `YYYY-MM-DD HH:MM ±hhmm`, or an
# ISO timestamp with seconds. The short forms stay only in the files below, because the case
# they feed checks that the legacy reading still works (WATCHER-SPEC T-10, M-10 `time_legacy_re`).
WHOLE_TIME_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} [+-][0-9]{4}"
                           r"|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\.[0-9]+)?)?(?:Z|[+-][0-9]{2}:?[0-9]{2})?")
SHORT_TIME_RE = re.compile(r"(?<![0-9:.+\-])[0-2][0-9]:[0-5][0-9](?![0-9:.])"
                           r"|[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}")
LEGACY_TIME_OK = {
    "tests/fixtures/watcher/T-10/payloads/01-PostCompact.json",   # `checked 14:05`, summary (a)
    "tests/fixtures/transcripts/T-10/main.jsonl",                 # the same summary as a transcript row
    "tests/fixtures/watcher/T-10/expected.json",                  # quotes the legacy form
}


def check_stamps():
    problems, seen_legacy, nfiles = [], set(), 0
    for p in walk(FIX):
        rel = os.path.relpath(p, REPO)
        if rel.startswith(os.path.join("tests", "fixtures", "assembly", "expected") + os.sep):
            continue   # goldens: tools/assemble renders them from runtime.json, which is scanned
        if rel == os.path.join("tests", "fixtures", "README.md"):
            continue   # documents the rule, so it quotes the short forms
        try:
            text = read(p)
        except UnicodeDecodeError:
            continue
        nfiles += 1
        hits = [m.group(0) for m in SHORT_TIME_RE.finditer(WHOLE_TIME_RE.sub("@", text))]
        if not hits:
            continue
        if rel in LEGACY_TIME_OK:
            seen_legacy.add(rel)
        else:
            problems.append("stamps {}: short time {!r} (RV-24: write a stamp `YYYY-MM-DD HH:MM ±hhmm`)".format(rel, hits[0]))
    for rel in sorted(LEGACY_TIME_OK - seen_legacy):
        problems.append("stamps {}: listed in LEGACY_TIME_OK but holds no short time any more".format(rel))
    return problems, nfiles, len(seen_legacy)


# Setups (README "Setups"): tests/fixtures/setups/<id>.json holds `setup`, a list of the case
# runner's setup steps (tests/helper/run.pl `setup`) that builds one scenario: temp repos with
# worktrees and a submodule (D-12), process records, sidecar slots, job rows and transcript
# stubs (Dev-1). The reference interpreter below runs them in a temp dir with the runner's
# placeholders, so the recipes are proven to build, and then checks what they built.
SETUPS = os.path.join(FIX, "setups")
SETUP_ACTIONS = ("write", "repo", "git", "mkdir", "symlink", "copy", "touch")
CLOCK_NOW = "2026-10-21T14:05:12+03:00"   # ids.json now: the case clock of every scenario
GIT_DATE = "2026-10-21T09:30:00+03:00"
DEFAULT_SID = "5e55a001-0c0f-4f1e-9a00-00000000a001"
JOB_STATUSES = {"RUNNING-ELSEWHERE", "RUNNING", "ENDED-UNEXPLAINED", "LEFTOVER", "DONE-UNREPORTED", "FAILED",
                "STOPPED", "LOST", "NOT-LOST"}
RECORD_RE = re.compile(r"^(\d+)-(\d+)\.(live|ended)-([0-9a-f]{8})\.json$")
_LITERALS = {}


def literals():
    """The spec-literals block of src/assets/handoff-spec.md ({} when the file is absent)."""
    if "v" not in _LITERALS:
        spec = os.path.join(REPO, "src", "assets", "handoff-spec.md")
        lit = {}
        if os.path.exists(spec):
            m = re.search(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", read(spec), re.S | re.M)
            if m:
                try:
                    lit = json.loads(m.group(1))
                except ValueError:
                    lit = {}
        _LITERALS["v"] = lit
    return _LITERALS["v"]


def parse_iso(s):
    """ISO 8601 with an offset (or Z) -> epoch seconds (float), or None."""
    m = re.match(r"^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d)(?::(\d\d)(\.\d+)?)?(Z|[+-]\d\d:?\d\d)$", s or "")
    if not m:
        return None
    y, mo, d, h, mi, se, frac, tz = m.groups()
    t = datetime.datetime(int(y), int(mo), int(d), int(h), int(mi), int(se or 0), tzinfo=datetime.timezone.utc).timestamp()
    t += float(frac) if frac else 0
    if tz != "Z":
        sign = 1 if tz[0] == "+" else -1
        t -= sign * (int(tz[1:3]) * 3600 + int(tz[-2:]) * 60)
    return t


def process_lstart(pid):
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           universal_newlines=True, timeout=10)
        return " ".join(r.stdout.split()) or "Thu Jan  1 00:00:00 1970"
    except (OSError, subprocess.SubprocessError):
        return "Thu Jan  1 00:00:00 1970"


class Scenario:
    """A temp dir in which one setup recipe is materialised, with the runner's placeholders."""

    def __init__(self, b, sid=DEFAULT_SID):
        self.b = b
        self.tmp = os.path.realpath(tempfile.mkdtemp(prefix="fixtures-gen-setup-"))
        home = self.tmp + "/home"
        os.makedirs(home)
        root = home + "/.local/state/" + b["name"] + "/handoffs"    # the default handoff_root (STATE-ROOT), as tests/helper/run.pl
        self.v = {"TMP": self.tmp, "HOME": home, "ROOT": root, "WATCH": root + "/.watch", "SID": sid, "SID8": sid[:8],
                  "BRAND": b["name"], "FIX": FIX, "FIXTURES": FIX, "LSTART1": process_lstart(1), "HOST": os.uname().nodename}
        self.touched = {}

    def sub(self, x):
        if isinstance(x, list):
            return [self.sub(i) for i in x]
        if isinstance(x, dict):
            return {self.sub(k): self.sub(v) for k, v in x.items()}
        if not isinstance(x, str):
            return x
        x = fill(x, self.b)
        return re.sub(r"\$\{?(TMP|HOME|ROOT|WATCH|SID8|SID|BRAND|FIXTURES|FIX|LSTART1|HOST)\b\}?", lambda m: self.v[m.group(1)], x)

    def env(self):
        e = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": self.v["HOME"], "GIT_CONFIG_NOSYSTEM": "1",
             "GIT_CONFIG_GLOBAL": os.devnull, "GIT_AUTHOR_NAME": "Test", "GIT_AUTHOR_EMAIL": "test@example.invalid",
             "GIT_COMMITTER_NAME": "Test", "GIT_COMMITTER_EMAIL": "test@example.invalid",
             "GIT_AUTHOR_DATE": GIT_DATE, "GIT_COMMITTER_DATE": GIT_DATE}
        return e

    def git(self, cwd, *args):
        r = subprocess.run(["git", "-C", cwd] + list(args), env=self.env(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           universal_newlines=True, timeout=60)
        if r.returncode != 0:
            raise RuntimeError("git {} in {}: exit {}: {}".format(" ".join(args), cwd, r.returncode, r.stdout.strip()[:200]))
        return r.stdout

    def write(self, path, text, mode=None):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        if mode:
            os.chmod(path, int(mode, 8))

    def run(self, step):
        s = self.sub(step)
        if "write" in s:
            if "json" in s:
                text = json.dumps(s["json"], ensure_ascii=False) + "\n"
            elif "jsonl" in s:
                text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in s["jsonl"])
            else:
                text = s.get("content", s.get("text", ""))
            self.write(s["write"], text, s.get("mode"))
        elif isinstance(s.get("repo"), dict):
            rc, at = s["repo"], s["at"]
            base = rc.get("base", "main")
            os.makedirs(at, exist_ok=True)
            self.git(at, "init", "-q", "-b", base)
            for cm in rc.get("commits", [{"files": {"README.md": "seed\n"}, "msg": "seed"}]):
                for rel, text in sorted(cm.get("files", {}).items()):
                    self.write(os.path.join(at, rel), text)
                self.git(at, "add", "-A")
                self.git(at, "commit", "-q", "--allow-empty", "-m", cm.get("msg", "commit"))
            if rc.get("branch") and rc["branch"] != base:
                self.git(at, "checkout", "-q", "-b", rc["branch"])
            if rc.get("ignored"):
                self.write(os.path.join(at, ".gitignore"), "\n".join(rc["ignored"]) + "\n")
                self.git(at, "add", ".gitignore")
                self.git(at, "commit", "-q", "-m", "ignore")
            for key in ("dirty", "untracked"):
                for rel, text in sorted(rc.get(key, {}).items()):
                    self.write(os.path.join(at, rel), text)
        elif "git" in s:
            self.git(s.get("cwd", self.tmp), *s["git"])
        elif "mkdir" in s:
            os.makedirs(s["mkdir"], exist_ok=True)
        elif "symlink" in s:
            os.makedirs(os.path.dirname(s["symlink"]), exist_ok=True)
            os.symlink(s["to"], s["symlink"])
        elif "copy" in s:
            text = read(os.path.join(FIX, s["copy"]))
            self.write(s["to"], self.sub(text) if s.get("subst") else text, s.get("mode", "0600"))
        elif "touch" in s:
            t = parse_iso(s["at"])
            if t is None:
                raise RuntimeError("touch {}: bad time {!r}".format(s["touch"], s["at"]))
            os.utime(s["touch"], (t, t))
            self.touched[s["touch"]] = t
        else:
            raise RuntimeError("unknown setup action: " + ",".join(sorted(s)))

    def done(self):
        shutil.rmtree(self.tmp, ignore_errors=True)


def read_jsonl(path):
    return [json.loads(l) for l in read(path).split("\n") if l.strip()]


def jobs_semantics(doc, sc):
    """What a Dev-1 setup must have built (AT-J-04 and friends)."""
    p = []
    ex = doc.get("expect", {})
    sid = doc["invoke"]["argv"][doc["invoke"]["argv"].index("--origin") + 1]
    task = doc["invoke"]["argv"][doc["invoke"]["argv"].index("--item") + 1]
    watch, odir = sc.v["WATCH"], sc.v["WATCH"] + "/" + sid
    now = parse_iso(CLOCK_NOW)
    if ex.get("status") is not None and ex["status"] not in JOB_STATUSES:
        p.append("expect.status {} is not a verdict name".format(ex["status"]))
    if ex.get("result") not in ("ok", "REFUSED"):
        p.append("expect.result must be ok or REFUSED")
    if ex.get("result") == "ok" and not ex.get("relaunch"):
        p.append("expect.result ok means a relaunch; set expect.relaunch true")
    if ex.get("result") == "REFUSED" and ex.get("relaunch"):
        p.append("expect.result REFUSED cannot relaunch")
    # process records
    byp = sc.v["ROOT"] + "/.sessions/by-pid"
    live, ended = {}, {}
    if os.path.isdir(byp):
        for f in sorted(os.listdir(byp)):
            m = RECORD_RE.match(f)
            if not m:
                p.append("process record name {} does not match <pid>-<epoch>.<live|ended>-<sid8>.json".format(f))
                continue
            d = json.loads(read(os.path.join(byp, f)))
            (live if m.group(3) == "live" else ended)[(m.group(1), m.group(2), m.group(4))] = d
            if d.get("session_id", "")[:8] != m.group(4):
                p.append("process record {}: session_id does not start with {}".format(f, m.group(4)))
            if m.group(3) == "live" and not (isinstance(d.get("pid"), int) and d.get("pid_lstart")):
                p.append("process record {}: a live record needs pid and pid_lstart".format(f))
            if parse_iso(d.get("ts")) is None:
                p.append("process record {}: ts is not an ISO time with an offset".format(f))
    for k in ended:
        if k not in live:
            p.append("ended record {} has no live twin".format("-".join(k)))
    # job rows
    rows = read_jsonl(odir + "/jobs.jsonl") if os.path.exists(odir + "/jobs.jsonl") else []
    mine = [r for r in rows if r.get("task_id") == task and r.get("kind") == "job"]
    if len(mine) != 1:
        p.append("jobs.jsonl: expected one job row for {}, found {}".format(task, len(mine)))
    for r in rows:
        if r.get("kind") == "job":
            cmd = r.get("command")
            if cmd is None:
                if not r.get("command_withheld"):
                    p.append("job {}: a null command needs command_withheld rule ids".format(r.get("task_id")))
            elif hashlib.sha256(cmd.encode("utf-8")).hexdigest() != r.get("command_sha256"):
                p.append("job {}: command_sha256 is not the sha256 of the command".format(r.get("task_id")))
            la = parse_iso(r.get("launched_at"))
            if la is None or la >= now:
                p.append("job {}: launched_at must be an earlier time of the case day".format(r.get("task_id")))
        if r.get("sid") != sid:
            p.append("jobs.jsonl row for {} names another session".format(r.get("task_id")))
    # output files and the touched times
    for r in mine:
        out = r.get("output_path")
        if out and not out.startswith(sc.tmp):
            p.append("job {}: output_path is outside $TMP".format(task))
        if out and os.path.exists(out) and out not in sc.touched:
            p.append("job {}: the output file has no touch step (its mtime would be the run time)".format(task))
        if out and ex.get("signals", {}).get("V5") == "pass" and out in sc.touched and mine[0].get("launched_at"):
            if sc.touched[out] < parse_iso(mine[0]["launched_at"]):
                p.append("job {}: output mtime precedes the launch".format(task))
    # transcript stub: V1 as the helper reads it
    tpath = sc.v["HOME"] + "/.claude/projects/-tmp-example-repo/{}.jsonl".format(sid)
    matches = False
    if os.path.exists(tpath) and mine:
        use = {}
        for row in read_jsonl(tpath):
            msg = row.get("message") if isinstance(row.get("message"), dict) else {}
            for c in (msg.get("content") if isinstance(msg.get("content"), list) else []):
                if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == "Bash":
                    cmd = (c.get("input") or {}).get("command")
                    if cmd is not None and hashlib.sha256(cmd.encode("utf-8")).hexdigest() == mine[0].get("command_sha256"):
                        use[c.get("id")] = True
            tr = row.get("toolUseResult") if isinstance(row.get("toolUseResult"), dict) else {}
            if use and tr.get("backgroundTaskId") == task:
                for c in (msg.get("content") if isinstance(msg.get("content"), list) else []):
                    if isinstance(c, dict) and c.get("tool_use_id") in use:
                        matches = True
        want = ex.get("signals", {}).get("V1") != "fail"
        if matches != want:
            p.append("transcript stub: V1 would {} but the scenario expects V1 {}".format(
                "pass" if matches else "fail", "pass" if want else "fail"))
    elif mine and ex.get("signals", {}).get("V1") != "fail":
        p.append("no transcript stub at the path the helper reads")
    # sidecar slots: seq and the ring counter
    bg = odir + "/bg"
    if os.path.isdir(bg):
        slots = {}
        for f in os.listdir(bg):
            m = re.match(r"^slot-(\d+)\.json$", f)
            if m:
                d = json.loads(read(os.path.join(bg, f)))
                if int(m.group(1)) >= 20:
                    p.append("slot file {}: the ring has 20 slots (0-19)".format(f))
                if not isinstance(d.get("seq"), int):
                    p.append("slot file {}: seq must be an integer".format(f))
                slots[int(m.group(1))] = (d.get("seq", 0), os.path.getmtime(os.path.join(bg, f)))
        seqs = [s for s, _ in slots.values()]
        if len(set(seqs)) != len(seqs):
            p.append("slot seq values are not unique")
        lock = bg + "/slot.lock"
        if slots and os.path.exists(lock):
            if json.loads(read(lock)).get("n") != max(seqs):
                p.append("slot.lock n must equal the highest seq")
        if doc["id"] == "jobs-slot-ring":
            by_seq = [i for _, i in sorted((v[0], i) for i, v in slots.items())]
            by_mtime = [i for _, i in sorted((v[1], i) for i, v in slots.items())]
            if by_seq[-1] == by_mtime[-1]:
                p.append("jobs-slot-ring: the newest slot by seq must not be the newest by mtime")
    elif doc["id"] == "jobs-slot-ring":
        p.append("jobs-slot-ring has no slots")
    return p


def rm_declaration_valid(text):
    """D-12 §1.5.2 declaration validation (the reference reading)."""
    if len(text.encode("utf-8")) > 4096:
        return False
    try:
        d = json.loads(text)
    except ValueError:
        return False
    if not isinstance(d, dict) or d.get("version") != 1 or d.get("mode") != "repo":
        return False
    root = d.get("root")
    if not isinstance(root, str) or root.startswith("/"):
        return False
    parts = root.split("/")
    if not 1 <= len(parts) <= 4:
        return False
    return all(re.match(r"^[A-Za-z0-9._-]+$", c) and c not in (".", "..") and not c.startswith(".git") and c != ".planning"
               for c in parts)


def frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    return dict(l.split(": ", 1) for l in m.group(1).split("\n") if ": " in l) if m else None


def rm_semantics(doc, sc):
    p = []
    top = sc.tmp + "/example-repo"
    id_ = doc["id"]
    if id_ == "rm-bad-declarations":
        for name, want in doc["expect"]["reasons"].items():
            f = "{}/{}/.claude/handoffs.json".format(sc.tmp, name)
            if not os.path.exists(f):
                p.append("{}: no declaration file".format(name))
                continue
            valid = rm_declaration_valid(read(f))
            if valid != want.startswith("repo ("):
                p.append("{}: the reference reading of §1.5.2 says valid={}, the recipe expects {!r}".format(name, valid, want))
        return p
    decl = top + "/.claude/handoffs.json"
    if not os.path.exists(decl):
        return ["no declaration at " + decl]
    if id_ == "rm-declared" or id_ == "rm-worktrees" or id_ == "rm-exports":
        if not rm_declaration_valid(read(decl)):
            p.append("the declaration is not valid by the §1.5.2 reading")
        tracked = sc.git(top, "ls-files").split()
        for f in ("README.md", "src/a.rb", ".claude/handoffs.json"):
            if f not in tracked:
                p.append("{} is not tracked".format(f))
        if sc.git(top, "rev-parse", "--abbrev-ref", "HEAD").strip() != "feature/LAB-42-retry":
            p.append("the main checkout is not on feature/LAB-42-retry")
    if id_ == "rm-worktrees":
        listing = sc.git(top, "worktree", "list", "--porcelain")
        paths = [l[len("worktree "):] for l in listing.split("\n") if l.startswith("worktree ")]
        if sorted(os.path.realpath(x) for x in paths) != sorted(sc.tmp + "/" + n for n in ("example-repo", "example-repo-old", "example-repo-wt")):
            p.append("git worktree list names {}".format(paths))
        if not os.path.exists(sc.tmp + "/example-repo-wt/.claude/handoffs.json"):
            p.append("the declared worktree has no declaration")
        if os.path.exists(sc.tmp + "/example-repo-old/.claude/handoffs.json"):
            p.append("the old worktree must have no declaration")
        if sc.git(sc.tmp + "/example-repo-old", "rev-parse", "--abbrev-ref", "HEAD").strip() != "HEAD":
            p.append("the old worktree must be a detached checkout")
    if id_ == "rm-submodule":
        if not os.path.isfile(top + "/vendor/lib/.git"):
            p.append("vendor/lib/.git must be a file (a submodule checkout)")
        if "vendor/lib" not in sc.git(top, "submodule", "status"):
            p.append("git submodule status does not list vendor/lib")
        if not os.path.exists(top + "/.gitmodules"):
            p.append("no .gitmodules")
        if not json.loads(read(decl))["root"].startswith("vendor/lib/"):
            p.append("the declared root must lie inside the submodule")
    if id_ == "rm-symlink-root":
        link = top + "/docs"
        if not os.path.islink(link):
            p.append("docs must be a symlink")
        elif os.path.commonpath([os.path.realpath(link), os.path.realpath(top)]) == os.path.realpath(top):
            p.append("docs must point outside the repository")
        if not json.loads(read(decl))["root"].startswith("docs/"):
            p.append("the declared root must pass through docs")
    if id_ == "rm-exports":
        keys = set(literals().get("frontmatter_keys_export") or [])
        machine = {"transcript_path", "claude_pid", "worktree"}
        base = top + "/.claude/handoffs"
        for need in ("README.md", ".gitignore"):
            if not os.path.exists(base + "/" + need):
                p.append("export folder lacks the generated " + need)
        exports = {}
        for f in sorted(os.listdir(base + "/LAB-42")):
            text = read(base + "/LAB-42/" + f)
            fm = frontmatter(text)
            if fm is None:
                p.append("export {}: no frontmatter".format(f))
                continue
            exports[f] = fm
            if keys and set(fm) - keys:
                p.append("export {}: keys {} are not in frontmatter_keys_export".format(f, sorted(set(fm) - keys)))
            if machine & set(fm):
                p.append("export {}: machine-only keys {}".format(f, sorted(machine & set(fm))))
            if fm.get("export") != (literals().get("export_value") or "repo"):
                p.append("export {}: export key is {!r}".format(f, fm.get("export")))
            for private in (sc.tmp, sc.v["HOME"]):
                if private in text:
                    p.append("export {}: holds the machine path {}".format(f, private))
        own = [f for f, fm in exports.items() if fm.get("session_id") == DEFAULT_SID]
        mate = [f for f, fm in exports.items() if fm.get("session_id") != DEFAULT_SID]
        if len(own) != 1 or len(mate) != 1:
            p.append("rm-exports needs one own and one teammate export")
        else:
            twins = [f for f in os.listdir(sc.v["ROOT"] + "/example-repo/LAB-42") if f == own[0]]
            if not twins:
                p.append("the own export has no private twin with the same file name")
            else:
                twin = frontmatter(read(sc.v["ROOT"] + "/example-repo/LAB-42/" + own[0]))
                if twin.get("nonce") != exports[own[0]].get("nonce") or twin.get("session_id") != DEFAULT_SID:
                    p.append("the private twin and the own export must share nonce and session")
                if not machine <= set(twin):
                    p.append("the private twin must keep transcript_path, claude_pid and worktree")
            if exports[mate[0]].get("nonce") == exports[own[0]].get("nonce"):
                p.append("the teammate export must have its own nonce")
            if "approved: deploy" not in read(base + "/LAB-42/" + mate[0]) or "approved: deploy" in read(base + "/LAB-42/" + own[0]):
                p.append("only the teammate export holds `approved: deploy`")
    return p


def pid_state(pid, lstart):
    """live (pid alive, same start time), restarted (alive, another start time) or dead."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return "dead"
    except (PermissionError, OverflowError):
        pass
    except OSError:
        return "dead"
    return "live" if process_lstart(pid) == " ".join(str(lstart).split()) else "restarted"


def transcript_row_line(path):
    """True when the first non-empty line parses as a transcript row (BD-4 detector c)."""
    for line in read(path).split("\n"):
        if line.strip():
            try:
                r = json.loads(line)
            except ValueError:
                return False
            return isinstance(r, dict) and "type" in r and ("sessionId" in r or "parentUuid" in r)
    return False


def st_semantics(doc, sc):
    """What the C-STORE setups must have built (AT-ST-04/05 records, AT-ST-13 agent outputs)."""
    p = []
    if doc["id"] == "st-05-finish-records":
        byp = sc.v["ROOT"] + "/.sessions/by-pid"
        files = sorted(os.listdir(byp)) if os.path.isdir(byp) else []
        for sid8, want in sorted(doc["expect"]["records"].items()):
            live = [f for f in files if f.endswith(".live-{}.json".format(sid8))]
            ended = [f for f in files if f.endswith(".ended-{}.json".format(sid8))]
            if not live:
                state, host = "none", None
            else:
                d = json.loads(read(os.path.join(byp, live[0])))
                state = pid_state(d["pid"], d["pid_lstart"])
                host = d.get("host")
                if host is not None and host != sc.v["HOST"]:
                    p.append("{}: host {!r} is not this machine's node name".format(sid8, host))
            if state != want["state"]:
                p.append("{}: the record reads {}, the recipe says {}".format(sid8, state, want["state"]))
            if "host" in want and (host is not None) != want["host"]:
                p.append("{}: host {} but the recipe says {}".format(sid8, "present" if host else "absent", want["host"]))
            if "ended" in want and bool(ended) != want["ended"]:
                p.append("{}: ended- record {} but the recipe says {}".format(sid8, bool(ended), want["ended"]))
            if "eligible" in want:
                rule = bool(ended) or (state in ("dead", "restarted") and host is not None)
                if rule != want["eligible"]:
                    p.append("{}: the C-STORE §5.8 reading gives eligible={}, the recipe says {}".format(sid8, rule, want["eligible"]))
    elif doc["id"] == "st-13-agent-output":
        sid = doc["invoke"]["argv"][doc["invoke"]["argv"].index("--sid") + 1]
        slot = json.loads(read(sc.v["WATCH"] + "/" + sid + "/bg/slot-0.json"))
        types = {t["id"]: (t["type"], t["output_path"]) for t in slot["tasks"]}
        for tid, want in sorted(doc["expect"]["outputs"].items()):
            if tid not in types:
                p.append("{}: not in the sidecar slot".format(tid))
                continue
            typ, out = types[tid]
            if want.get("type") and want["type"] != typ:
                p.append("{}: slot type {} but the recipe says {}".format(tid, typ, want["type"]))
            det = want.get("detector")
            if tid == "x":
                at = json.loads(read(os.path.join(FIX, "tempfiles", "at-e-05-task-output.json")))
                if out != sc.sub(at["files"][0]["path"]):
                    p.append("x: output_path must be the AT-E-05 tempfile path")
                continue
            if not os.path.lexists(out):
                p.append("{}: {} missing".format(tid, out))
                continue
            link = os.path.islink(out)
            real = os.path.realpath(out)
            is_a = link and real.endswith(".jsonl") and "/.claude/projects/" in real
            is_c = not link and transcript_row_line(out)
            is_b = typ not in ("shell", "monitor")
            fired = sorted(k for k, v in (("a", is_a), ("b", is_b), ("c", is_c)) if v)
            if fired != ([det] if det else []):
                p.append("{}: BD-4 detectors {} fire, the recipe expects {}".format(tid, fired, [det] if det else []))
            if want.get("result") == "withheld" and not fired or want.get("result") == "copied" and fired:
                p.append("{}: result {} does not follow from the detectors {}".format(tid, want.get("result"), fired))
        if sorted(sc.sub(doc["expect"]["paths"])) != sorted(o for _, o in types.values()):
            p.append("expect.paths must list every slot output_path")
    elif doc["id"] == "st-09-fill-scope":
        p += st09_semantics(doc, sc)
    return p


def st09_semantics(doc, sc):
    """AT-ST-09 (d): every copy is fillable by nonce (its nonce is the marker nonce of a summary row
    in a planted agent file), and `filled` follows C-STORE D5 step 5: only a sub-unknown copy in
    compact/subagents/ is filled; compact/ and compact/unattributed/ are never touched."""
    p, b = [], sc.b
    subdir = sc.sub("$HOME/.claude/projects/-tmp-example-repo/$SID/subagents")
    nonces = set()
    for f in sorted(os.listdir(subdir)) if os.path.isdir(subdir) else []:
        for line in read(os.path.join(subdir, f)).split("\n"):
            r = json.loads(line) if line.strip() else {}
            if r.get("isCompactSummary") is True:
                nonces.add(detect(fill(row_text(r), b), b["name"])[3])
    slots = {"main": "/compact/", "unattributed": "/compact/unattributed/", "subagents": "/compact/subagents/"}
    want_slots = set(slots)
    for key, c in sorted(doc["expect"]["copies"].items()):
        path = sc.sub(c["path"])
        if not os.path.isfile(path):
            p.append("{}: {} missing".format(key, path))
            continue
        fm = dict(ln.split(": ", 1) for ln in read(path).split("---\n")[1].split("\n") if ": " in ln)
        if os.path.dirname(path) + "/" != sc.sub("$ROOT/example-repo/general") + slots[c["slot"]].rstrip("/") + "/":
            p.append("{}: {} is not in the {} folder".format(key, path, c["slot"]))
        if (fm.get("actor"), fm.get("nonce")) != (c["actor"], c["nonce"]) or not path.endswith("-{}.md".format(c["id6"])):
            p.append("{}: frontmatter actor/nonce or the -<id6>.md name differ from expect".format(key))
        if c["nonce"] not in nonces:
            p.append("{}: nonce {} is no agent summary row's marker nonce, so a scope bug could not fill it".format(key, c["nonce"]))
        rule = c["slot"] == "subagents" and c["actor"] == "sub-unknown"
        if c.get("filled") != rule:
            p.append("{}: filled={} but C-STORE D5 step 5 gives {} (only sub-unknown copies in compact/subagents/)".format(
                key, c.get("filled"), rule))
        if rule and not c.get("renamed_to", "").endswith("-{}.md".format(c["id6"])):
            p.append("{}: a filled copy names its -a<agent8> renamed_to path".format(key))
        if os.stat(path).st_mode & 0o777 != 0o400:
            p.append("{}: copies are mode 0400".format(key))
        want_slots.discard(c["slot"])
    if want_slots:
        p.append("st-09 needs a copy in each of compact/, compact/unattributed/ and compact/subagents/; missing {}".format(sorted(want_slots)))
    return p


def check_setups(b):
    problems, n = [], 0
    if not os.path.isdir(SETUPS):
        return problems, n
    for fname in sorted(os.listdir(SETUPS)):
        if not fname.endswith(".json"):
            problems.append("setups/{}: only .json recipes belong here".format(fname))
            continue
        n += 1
        where = "setups/" + fname
        try:
            doc = json.loads(read(os.path.join(SETUPS, fname)))
        except ValueError as e:
            problems.append("{}: {}".format(where, e))
            continue
        if doc.get("id") != fname[:-5]:
            problems.append("{}: id {!r} must equal the file name".format(where, doc.get("id")))
        for k in ("ruling", "tests", "note", "setup", "expect"):
            if k not in doc:
                problems.append("{}: missing {}".format(where, k))
        if not doc.get("setup"):
            continue
        sc = Scenario(b)
        try:
            for i, step in enumerate(doc["setup"], 1):
                try:
                    sc.run(step)
                except (RuntimeError, OSError, subprocess.SubprocessError, KeyError, ValueError) as e:
                    problems.append("{} step {}: {}".format(where, i, e))
                    break
            else:
                if doc["id"].startswith("jobs-"):
                    sem = jobs_semantics(doc, sc)
                elif doc["id"].startswith("rm-"):
                    sem = rm_semantics(doc, sc)
                elif doc["id"].startswith("st-"):
                    sem = st_semantics(doc, sc)
                elif doc["id"].startswith("wb-"):
                    sem = wb_semantics(doc, sc)
                else:
                    sem = []
                problems += ["{}: {}".format(where, x) for x in sem]
        except (RuntimeError, OSError, subprocess.SubprocessError, KeyError, ValueError, IndexError) as e:
            problems.append("{}: {}: {}".format(where, type(e).__name__, e))
        finally:
            sc.done()
    return problems, n


# PATH stubs (README "bin/"): bin/git-noexclude must defeat an exclude pathspec that the real git
# honours (C-STORE D7 BD-1: the rebuilt clone patch, AT-ST-11 fail-closed). Proven on a temp repo.
def numstat_paths(sc, cwd, env, args):
    patch = subprocess.run(["git", "-C", cwd] + args, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    if patch.returncode != 0:
        raise RuntimeError("git {}: exit {}".format(" ".join(args[:2]), patch.returncode))
    r = subprocess.run(["git", "-C", cwd, "apply", "--numstat", "-z", "-"], input=patch.stdout, env=sc.env(),
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    return sorted(x.split("\t")[-1] for x in r.stdout.decode("utf-8", "replace").split("\0") if "\t" in x)


def check_stubs(b):
    problems = []
    stub = os.path.join(FIX, "bin", "git-noexclude")
