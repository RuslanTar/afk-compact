     "write": "$DISP/2026-09-01/2026-09-01_10-00-00_11111111_old-evidence/run.log",
     "content": "old run log\n",
     "mtime_ago_s": 3456000
    },
    {
     "mkdir": "$TMP/prot/2026-09-02"
    },
    {
