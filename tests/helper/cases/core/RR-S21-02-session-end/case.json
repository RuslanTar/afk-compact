    "transcript_path": "$TMP/proj/$SID.jsonl"
   },
   "expect": {
    "exit": 0
   }
  },
  {
   "name": "PostCompact: deferred for want of proof",
   "now": "2026-10-21T14:05:00.813+03:00",
   "argv": [
    "hook",
    "PostCompact"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
