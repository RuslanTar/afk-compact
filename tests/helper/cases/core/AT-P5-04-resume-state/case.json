{
 "id": "AT-P5-04",
 "note": "P5-FOLD A2 / MOD-SPEC §2.5 resume row (CORE-05): rollup::resume_state, shared by PostCompact and reconcile. The claim file decides first, whatever the actor: a classic subagent compaction whose SessionStart(compact) claimed the block reads delivered:sessionstart with actor sub-unknown; a mod-path subagent with no claim reads none-subagent; main with no claim at PostCompact reads pending (the mod's row settles it); a classic subagent with no claim reads undelivered; a claim holding dropped:session-end (XR-26) is taken as it is",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "classic subagent, claimed",
   "setup": [{"dispatch": {"nonce": "aa000001", "actor": "unknown", "channel": "classic", "trigger": "auto", "age_s": 5, "midturn": false}},
             {"write": "$WATCH/$SID/resume-claimed/aa000001", "text": "sessionstart\n"}],
   "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto",
                  "compact_summary": "<summary>\n⟪$BRAND v1 n=aa000001 s=sub⟫\n## Task as assigned: \"count rows\"\n## Next action\nreport\n⟪/$BRAND n=aa000001⟫\n</summary>\n"},
   "expect": {"exit": 0, "rows": [{"file": "$WATCH/$SID/compactions.jsonl", "ev": "compaction", "count": 1,
                                   "fields": {"nonce": "aa000001", "actor": "sub-unknown", "resume": "delivered:sessionstart", "sentinel_place": "inside"}}]}},
  {"name": "mod-path subagent, no claim",
   "setup": [{"dispatch": {"nonce": "aa000002", "actor": "a9a00b3f363327444", "channel": "mod-hook", "trigger": "auto", "age_s": 5, "midturn": false}}],
   "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto",
                  "compact_summary": "<summary>\n⟪$BRAND v1 n=aa000002 s=sub⟫\n## Task as assigned: \"count rows\"\n## Next action\nreport\n⟪/$BRAND n=aa000002⟫\n</summary>\n"},
   "expect": {"exit": 0, "rows": [{"file": "$WATCH/$SID/compactions.jsonl", "ev": "compaction", "count": 1,
                                   "fields": {"nonce": "aa000002", "resume": "none-subagent"}}]}},
  {"name": "main, no claim at PostCompact",
   "setup": [{"dispatch": {"nonce": "aa000003", "actor": "main", "channel": "mod-hook", "trigger": "auto", "age_s": 5, "midturn": false}}],
   "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto",
                  "compact_summary": "<summary>\n⟪$BRAND v1 n=aa000003 s=main⟫\n# LAB-1 — x\n## Resume here\nStatus: active\n⟪/$BRAND n=aa000003⟫\n</summary>\n"},
   "expect": {"exit": 0, "rows": [{"file": "$WATCH/$SID/compactions.jsonl", "ev": "compaction", "count": 1,
                                   "fields": {"nonce": "aa000003", "actor": "main", "resume": "pending"}}]}},
  {"name": "classic subagent, no claim",
   "setup": [{"dispatch": {"nonce": "aa000004", "actor": "unknown", "channel": "classic", "trigger": "auto", "age_s": 5, "midturn": false}}],
   "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto",
                  "compact_summary": "<summary>\n⟪$BRAND v1 n=aa000004 s=sub⟫\n## Task as assigned: \"x\"\n## Next action\nreport\n⟪/$BRAND n=aa000004⟫\n</summary>\n"},
   "expect": {"exit": 0, "rows": [{"file": "$WATCH/$SID/compactions.jsonl", "ev": "compaction", "count": 1,
                                   "fields": {"nonce": "aa000004", "resume": "undelivered"}}]}},
  {"name": "main, claim dropped at session end",
   "setup": [{"dispatch": {"nonce": "aa000005", "actor": "main", "channel": "mod-hook", "trigger": "auto", "age_s": 5, "midturn": false}},
             {"write": "$WATCH/$SID/resume-claimed/aa000005", "text": "dropped:session-end\n"}],
   "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto",
                  "compact_summary": "<summary>\n⟪$BRAND v1 n=aa000005 s=main⟫\n# LAB-1 — x\n## Resume here\nStatus: active\n⟪/$BRAND n=aa000005⟫\n</summary>\n"},
   "expect": {"exit": 0, "rows": [{"file": "$WATCH/$SID/compactions.jsonl", "ev": "compaction", "count": 1,
                                   "fields": {"nonce": "aa000005", "resume": "dropped:session-end"}}]}}
 ]
}
