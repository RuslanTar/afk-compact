def gates(targets, names, brand_name, only=None):
    argv = [os.path.join(REPO, "tools", "gates")] + targets + ["--names", names or "", "--brand", brand_name]
    if only:
        argv += ["--only", only]
    run(argv, "gates " + " ".join(targets) + (" --only " + only if only else ""), capture=True)


def tree_state():
    return subprocess.run(["git", "-C", REPO, "status", "--porcelain", "--untracked-files=all"],
                          capture_output=True, text=True).stdout


def copy_tree(dst):
    """Copy the work tree (tracked and untracked files; no .git, node_modules or tmp/) to dst.

    node_modules is linked, not copied, so X-types runs in the copy. Symlinks stay links.
    """
    if os.path.lexists(dst):
        shutil.rmtree(dst)
    for d, dirs, files in os.walk(REPO):
        rel = os.path.relpath(d, REPO)
        keep = []
        for x in sorted(dirs):
            xrel = os.path.normpath(os.path.join(rel, x))
            if (rel == "." and x in COPY_SKIP_TOP) or x in COPY_SKIP or xrel in COPY_SKIP:
                continue
            if os.path.islink(os.path.join(d, x)):
                os.makedirs(os.path.join(dst, rel), exist_ok=True)
                os.symlink(os.readlink(os.path.join(d, x)), os.path.join(dst, xrel))
                continue
            keep.append(x)
        dirs[:] = keep
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for f in files:
            if f not in COPY_SKIP:
                shutil.copy2(os.path.join(d, f), os.path.join(dst, rel, f), follow_symlinks=False)
    if os.path.isdir(os.path.join(REPO, "node_modules")):
        os.symlink(os.path.join(REPO, "node_modules"), os.path.join(dst, "node_modules"))


# ---------------------------------------------------------------- X-tools (self-test)

def write_text(path, text, mode="w"):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, mode, encoding="utf-8", newline="") as f:
        f.write(text)


def to_crlf(path):
    with open(path, "rb") as f:
        data = f.read()
    with open(path, "wb") as f:
        f.write(data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n"))


GIT_ID = ["-c", "user.name=selftest", "-c", "user.email=selftest@example.invalid", "-c", "commit.gpgsign=false",
          "-c", "core.hooksPath=/dev/null", "-c", "init.defaultBranch=main", "-c", "core.autocrlf=false"]


def git_in(d, *args):
    r = subprocess.run(["git"] + GIT_ID + ["-C", d] + list(args), capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail("X-tools: git {} in {}: {}".format(" ".join(args), d, r.stderr.strip()[-300:]))
    return r.stdout


def same_dir(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def git_repo(d):
    """The copy as a one-commit repo on main (the probes that need git history)."""
    git_in(d, "init", "-q")
    git_in(d, "add", "-A")
    git_in(d, "commit", "-q", "-m", "selftest base")


def pinned_claude(root=REPO):
    """The Claude Code binary the canary baseline's C8 counts were taken from, if installed."""
    try:
        with open(os.path.join(root, "plugin", "assets", "canary-baseline.json"), encoding="utf-8") as f:
            v = json.load(f)["c8"]["binary_version"]
    except (OSError, ValueError, KeyError, TypeError):
        return None, None
    b = os.path.join(os.path.expanduser("~"), ".local", "share", "claude", "versions", str(v))
    return v, (b if os.path.isfile(b) else None)


