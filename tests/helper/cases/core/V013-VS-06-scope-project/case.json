{
 "id": "V013-VS-06-scope-project",
 "note": "0.1.3 version skew (lib/plugver.pm), install scope: Claude Code's installed_plugins.json pins the project $TMP/work to 0.1.2 (a project entry) while the user install is 0.1.3. A session in that project (pid 424242, started 09:00) runs 0.1.2: its load record carries the project scope tag (sha256 over `project`, the cache folder of the plugin's versions and the project path). A user-scope session started at 12:00 on 0.1.3 gives it no notice; a project session started at 13:00 on 0.1.1 does. Its status, run from another folder, still takes the scope from that record. A process with no load record takes the scope from installed_plugins.json: outside the project (its cwd, or CLAUDE_PROJECT_DIR when set) the user scope, whose newest load is the 0.1.3 one.",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "manifest": {
  "version": "0.1.2"
 },
 "plugin_at": "$HOME/.claude/plugins/cache/m/$BRAND/0.1.2",
 "env": {
  "CLAUDE_PROJECT_DIR": ""
 },
 "steps": [
  {
   "name": "the project session starts: its record has the project scope",
   "now": "2026-10-21T09:00:05+03:00",
   "setup": [
    {
     "sha_tag": "user\n$PLUGIN_PARENT",
     "var": "UTAG"
    },
    {
     "sha_tag": "project\n$PLUGIN_PARENT\n$TMP/work",
     "var": "PTAG"
    },
    {
     "mkdir": "$TMP/work"
    },
    {
     "mkdir": "$TMP/else"
    },
    {
     "touch": "$PLUGIN/.claude-plugin/plugin.json",
     "at": "2026-10-01T00:00:00+03:00"
    },
    {
     "write": "$HOME/.claude/plugins/installed_plugins.json",
     "json": {
      "version": 2,
      "plugins": {
       "$BRAND@m": [
        {
         "scope": "user",
         "installPath": "$PLUGIN_PARENT/0.1.3",
         "version": "0.1.3"
        },
        {
         "scope": "project",
         "projectPath": "$TMP/work",
         "installPath": "$PLUGIN",
         "version": "0.1.2"
        }
       ],
       "other@m": [
        {
         "scope": "project",
         "projectPath": "$TMP/else",
         "installPath": "/x/other/1.0.0",
         "version": "1.0.0"
        }
       ]
      }
     }
    }
   ],
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "source": "startup"
   },
   "expect": {
    "exit": 0,
    "files": [
     {
      "path": "$ROOT/.sessions/loads/1792562405_424242-1792562400_0.1.2_$PTAG.json",
      "json": {
       "plugin_version": "0.1.2",
       "scope": "project"
      }
     },
     {
      "path": "$ROOT/.sessions/loads/*",
      "count": 1
     }
    ]
   }
  },
  {
   "name": "a user-scope session started 0.1.3 at 12:00: no notice for the pinned project",
   "setup": [
    {
     "write": "$ROOT/.sessions/loads/1792573200_515151-1792573195_0.1.3_$UTAG.json",
     "json": {
      "v": 1,
      "plugin_version": "0.1.3",
      "plugin_root": "$PLUGIN_PARENT/0.1.3",
      "host": "$HOST",
      "session_id": "51515151-1111-4222-8333-444444444444",
      "source": "startup",
      "ts": "2026-10-21T12:00:00+03:00",
      "scope": "user"
     }
    }
   ],
   "cwd": "$TMP/else",
   "argv": [
    "status",
    "--sid",
    "$SID"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^plugin: 0\\.1\\.2 · \\S+$"
    ],
    "stdout_lacks": [
     "^plugin notice:",
     "0\\.1\\.3"
    ]
   }
  },
  {
   "name": "a project session started 0.1.1 at 13:00: the notice names it",
   "setup": [
    {
     "write": "$ROOT/.sessions/loads/1792576800_616161-1792576790_0.1.1_$PTAG.json",
     "json": {
      "v": 1,
      "plugin_version": "0.1.1",
      "plugin_root": "$PLUGIN_PARENT/0.1.1",
      "host": "$HOST",
      "session_id": "61616161-1111-4222-8333-444444444444",
      "source": "startup",
      "ts": "2026-10-21T13:00:00+03:00",
      "scope": "project"
     }
    }
   ],
   "cwd": "$TMP/else",
   "argv": [
    "status",
    "--sid",
    "$SID"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^plugin notice: this session runs 0\\.1\\.2; sessions started since 2026-10-21 13:00 \\+0300 run 0\\.1\\.1: /reload-plugins$"
    ]
   }
  },
  {
   "name": "a process with no record outside the project: the user scope",
   "env": {
    "STORE_TEST_CLAUDE_PID": "939393:Tue Oct 21 13:30:00 2026"
   },
   "cwd": "$TMP/else",
   "argv": [
    "status",
    "--sid",
    "$SID"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^plugin notice: this session runs 0\\.1\\.2; sessions started since 2026-10-21 12:00 \\+0300 run 0\\.1\\.3: /reload-plugins$"
    ]
   }
  },
  {
   "name": "the same with CLAUDE_PROJECT_DIR naming the project: the project scope",
   "env": {
    "STORE_TEST_CLAUDE_PID": "939393:Tue Oct 21 13:30:00 2026",
    "CLAUDE_PROJECT_DIR": "$TMP/work"
   },
   "cwd": "$TMP/else",
   "argv": [
    "status",
    "--sid",
    "$SID"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^plugin notice: this session runs 0\\.1\\.2; sessions started since 2026-10-21 13:00 \\+0300 run 0\\.1\\.1: /reload-plugins$"
    ]
   }
  }
 ]
}
