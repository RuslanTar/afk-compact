{
 "id": "HT-PR-04 (prune: a root that is, lies inside or holds a protected path refuses the whole run and deletes nothing; real paths by whole parts; a missing protected path still protects)",
 "needs": [
  "symlinks"
 ],
 "layer": "H",
 "owner": "skills",
