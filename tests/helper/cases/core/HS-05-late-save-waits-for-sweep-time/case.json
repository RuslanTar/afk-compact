{
 "id": "HS-05-late-save-waits-for-sweep-time",
 "note": "0.1.3 hook speed (lib/reconcile.pm SWEEP_MIN_MS): RR-S21-04's late main-proven save is swept right after it, and the sweep claims swept/<id6> once. A Stop that starts 1.7 s late (STORE_TEST_HOOK_START_AGO_MS) gives reconcile under 0.5 s (3.5 - 0.3 reserve - 1 for the watcher - 1.7): the save and its sweep both wait (no copy, no copy_late, no swept claim, no sweep_evidence; the stop_timing row says reconcile was cut). The next Stop, on time, saves the copy late and sweeps it: the planted evidence file is copied into the evidence folder (referenced_budget 0). Before, a budget above 0 but too small to copy saved the copy, then claimed the sweep with about 0 ms left: the evidence was only referenced, for good. On a loaded host the GSD catch-up (due here) may get no time as well: the row then also names gsd, with status no-time",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "setup",
   "setup": [
    {
     "mkdir": "$TMP/work"
    },
    {
     "rows": [
      {
       "prompt": {
        "ts": "2026-10-21T14:04:40+03:00"
       }
      }
     ],
     "transcript": "$TMP/proj/$SID.jsonl"
    },
    {
     "text": "evidence line\n",
     "write": "$TMP/work/tasks/ev1.output"
    },
    {
     "paths": [
      "$TMP/work/tasks/ev1.output"
     ]
    }
   ]
  },
  {
   "name": "mod dispatch (main, mod-hook); PostCompact with an unmarked summary: deferred to the after-step",
   "now": "2026-10-21T14:05:00.813+03:00",
   "setup": [
    {
     "dispatch": {
      "actor": "main",
      "channel": "mod-hook",
      "nonce": "d1d2d3d4",
      "trigger": "auto",
      "ts": "2026-10-21T14:04:48+03:00"
     }
    }
   ],
   "argv": [
    "hook",
    "PostCompact"
   ],
   "stdin_json": {
    "compact_summary": "<summary>\n1. Primary Request: RRNOSWEEP unshaped\n</summary>",
    "cwd": "$TMP/work",
    "hook_event_name": "PostCompact",
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "trigger": "auto"
   },
   "expect": {
    "exit": 0,
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "copy_deferred",
      "count": 1,
      "fields": {
       "why": "mod"
      }
     }
    ]
   }
  },
  {
   "name": "no after-step; the boundary lands; the next Stop starts 1.7 s late: the save and its sweep wait",
   "now": "2026-10-21T14:05:40+03:00",
   "setup": [
    {
     "rows": [
      {
       "boundary": {
        "duration_ms": 12100,
        "post": 9000,
        "pre": 160000,
        "precomputed": false,
        "trigger": "auto",
        "ts": "2026-10-21T14:05:00.865+03:00"
       }
      }
     ],
     "transcript": "$TMP/proj/$SID.jsonl"
    }
   ],
   "env": {
    "STORE_TEST_HOOK_START_AGO_MS": "1700"
   },
   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "background_tasks": [],
    "cwd": "$TMP/work",
    "hook_event_name": "Stop",
    "session_crons": [],
    "session_id": "$SID",
    "stop_hook_active": false,
    "transcript_path": "$TMP/proj/$SID.jsonl"
   },
   "expect": {
    "exit": 0,
    "files": [
     {
      "count": 0,
      "path": "$ROOT/work/general/compact/*_c1-d1d2d3.md"
     },
     {
      "count": 0,
      "path": "$WATCH/$SID/swept/*"
     }
    ],
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "copy_late",
      "count": 0
     },
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "sweep_evidence",
      "count": 0
     },
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "stop_timing",
      "count": 1,
      "fields_le": {
       "reconcile_budget_ms": 499
      },
      "fields_any": [
       {
        "cut": [
         "reconcile"
        ]
       },
       {
        "cut": [
         "reconcile",
         "gsd"
        ],
        "gsd": "no-time"
       }
      ]
     }
    ]
   }
  },
  {
   "name": "the Stop after it, on time: saved late and swept, the evidence copied",
   "now": "2026-10-21T14:06:10+03:00",
   "argv": [
    "hook",
    "Stop"
   ],
   "stdin_json": {
    "background_tasks": [],
    "cwd": "$TMP/work",
    "hook_event_name": "Stop",
    "session_crons": [],
    "session_id": "$SID",
    "stop_hook_active": false,
    "transcript_path": "$TMP/proj/$SID.jsonl"
   },
   "expect": {
    "exit": 0,
    "files": [
     {
      "count": 1,
      "path": "$ROOT/work/general/compact/*_c1-d1d2d3.md"
     },
     {
      "count": 1,
      "path": "$WATCH/$SID/swept/d1d2d3"
     },
