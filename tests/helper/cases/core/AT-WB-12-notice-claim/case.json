{
 "id": "AT-WB-12 (helper half: notice claim)",
 "note": "W-BETA A / WATCHER-SPEC §8 item 8 (CORE-17): `notice claim --id watcher-1` makes <watch>/notice/watcher-1.shown by exclusive create (0600 in a 0700 folder) and prints show; every later claim prints seen (also from another session: the marker is per install); a version bump (watcher-2) shows again; with watcher off it prints off and makes no marker; `notice text` prints the fixed text, {{plugin}} filled, at most 200 characters, no placeholder left; status drops its notice line once the marker exists; a bad id is a usage error",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"name": "first claim",
   "argv": ["notice", "claim", "--id", "watcher-1"],
   "expect": {"exit": 0, "stdout": "show\n", "stderr_empty": true,
    "files": [{"path": "$WATCH/notice/watcher-1.shown", "mode": "0600"}, {"path": "$WATCH/notice", "mode": "0700"}]}},
  {"name": "second claim",
   "argv": ["notice", "claim", "--id", "watcher-1"],
   "expect": {"exit": 0, "stdout": "seen\n"}},
  {"name": "another session: per install",
   "argv": ["notice", "claim", "--id", "watcher-1", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout": "seen\n"}},
  {"name": "status: no notice line once claimed",
   "argv": ["status", "--sid", "$SID"],
   "expect": {"exit": 0, "stdout_has": ["\\A(?:ok|attention): [^\\n]*\\nwatcher: shadow · "], "stdout_lacks": ["^notice: "]}},
  {"name": "version bump shows again",
   "argv": ["notice", "claim", "--id", "watcher-2"],
   "expect": {"exit": 0, "stdout": "show\n", "files": [{"path": "$WATCH/notice/watcher-2.shown", "mode": "0600"}]}},
  {"name": "the fixed text",
   "argv": ["notice", "text"],
   "expect": {"exit": 0,
    "stdout": "$BRAND: local compaction logs are on (content-free; nothing is sent). To share them: /$BRAND:report. To turn them off: set watcher to false in /config.\n",
    "stdout_has": ["\\A[^\\n]{1,200}\\n\\z"], "stdout_lacks": ["\\{\\{", "\\}\\}", "@[a-z_]+@"]}},
  {"name": "watcher off: no marker",
   "options": {"watcher": "off"},
   "argv": ["notice", "claim", "--id", "watcher-3"],
   "expect": {"exit": 0, "stdout": "off\n", "files": [{"path": "$WATCH/notice/watcher-3.shown", "count": 0}]}},
  {"name": "bad id",
   "options": {"watcher": "shadow"},
   "argv": ["notice", "claim", "--id", "../x"],
   "expect": {"exit": 64, "stdout": ""}},
  {"argv": ["notice", "claim"], "expect": {"exit": 64, "stdout": ""}},
  {"argv": ["notice", "show", "--id", "watcher-1"], "expect": {"exit": 64, "stdout": ""}}
 ]
}
