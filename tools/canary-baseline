#!/usr/bin/python3
"""tools/canary-baseline: write plugin/assets/canary-baseline.json.

Usage: tools/canary-baseline [--types FILE] [--claude BIN] [--out FILE] [--check] [--no-c8]
  --types   claude-code.d.ts to read (default: $CC_TYPES_DIR/claude-code.d.ts, else .types/)
  --claude  the Claude Code binary for the C8 string counts (default: the newest installed
            version in ~/.local/share/claude/versions/, else $CLAUDE_CODE_EXECPATH)
  --out     output file (default plugin/assets/canary-baseline.json)
  --check   compare with the existing file instead of writing (exit 1 on drift)
  --no-c8   for tools/check's fallback only (the baseline's own binary is not installed):
            render every part but c8, reading no binary, to an --out other than the
            baseline; never with --check

Contents (no timestamps, so a re-run gives the same bytes):
  keysets   C5: per classic event and for the session.compact input, the required and
            optional top-level keys from the type declarations, plus sha8 of the sorted set
            (classic events also take OBSERVED_OPTIONAL as optional: keys sent live but not typed)
  c8        binary string counts (the C8_STRINGS list) for the tested binary, plus
            idle_prefixes: the two native idle-compaction notice prefixes that
            reconcile matches after a main boundary row (both are counted in `counts` too);
            rare_max: smoke fails on a changed count of a string whose count here is rare, 1 to
            rare_max (is_rare), and prints any other change as information (see RARE_MAX); a
            binary where a string outside COMMON_WORDS is not rare is refused (exit 2). No arm list: in
            Claude Code 2.1.321 to 2.1.323 and 2.1.325 (the versions measured) the
            experiment's flag and env variable carry a whole compaction prompt, so its arm
            names (2.1.314's) are not counted
  c9        sha256/16 of the declarations C9 names; `specs` holds the start regexes so the
            helper's `smoke` extracts with the same rule (helper/cmd/smoke.pl decl_hash)
  copy_trailers  installed-message trailers the normalizer cuts (none known)
GEN file: committed by the integrator only. Owner: WP-core.
"""
import hashlib, json, os, re, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

EVENTS = ["PreCompact", "PostCompact", "SessionStart", "SessionEnd", "Stop", "SubagentStop",
          "StopFailure", "PermissionDenied"]
# The compaction-prompt experiment: its flag and env variable (in 2.1.314 they picked one of
# eight named arms; in 2.1.321 to 2.1.323 and 2.1.325, the versions measured, they carry a whole
# compaction prompt, used only when it holds "<summary>", so no arm name or arm list is left to
# count), the env variable the helper
# reads the binary path from, and the PreCompact hook's stdout notice.
C8_STRINGS = ["Exit code 0 - stdout appended as custom compact instructions", "tengu_curried_trinket",
              "CLAUDE_CODE_CURRIED_TRINKET", "CLAUDE_CODE_EXECPATH"]
# The C8 rule smoke applies: a string the recorded binary holds at most RARE_MAX times is rare
# (every C8 string: 2 to 5 in 2.1.321 to 2.1.323 and 2.1.325), and smoke fails when its count changes. A
# string above RARE_MAX would be a common word, used by unrelated code, whose count moves with
# every release: smoke prints its change as information only.
RARE_MAX = 16
# The strings meant to be common words: none. The four it held (control, lean, short, capped,
# 244 to 5,380 times in 2.1.314 and in 2.1.321 to 2.1.323 and 2.1.325) were arm names, counted on their own
# as information only, beside the arm list that 2.1.321 to 2.1.323 and 2.1.325 no longer hold; as plain
# words they say nothing about compaction. The list stays as
# the place for a string that turns common. Every other C8 string must stay rare in the
# binary recorded (count 1 to RARE_MAX), or the tool refuses to write (rare_guard): one that
# rose above RARE_MAX would silently become information only, and one missing (count 0) would
# let smoke pass on its absence.
COMMON_WORDS = []
# The native informational rows after an idle compaction (2.1.306 had only the first;
# 2.1.314 has both)
IDLE_PREFIXES = {"notice": "Compacted while idle",
                 "return": "Compacted using a summary written while you were away"}
C8_STRINGS += [IDLE_PREFIXES[k] for k in sorted(IDLE_PREFIXES)]
# Keys Claude Code sends on every classic hook event that the type declarations lack, observed
# live (`scratchpad_dir` on all 35 hook payloads of 2.1.307):
# optional in every C5 key set, so a payload carrying them is not a key-set change.
OBSERVED_OPTIONAL = ["scratchpad_dir"]
C9_SPECS = [
    {"name": "SessionCompactInput", "start_re": r"^\s*export type SessionCompactInput\b"},
    {"name": "SessionCompactResult", "start_re": r"^\s*export type SessionCompactResult\b"},
    {"name": "SessionCompactTrigger", "start_re": r"^\s*export type SessionCompactTrigger\b"},
    {"name": "SessionVersion", "start_re": r"^\s*export type SessionVersion\b"},
    {"name": "$.store", "start_re": r"^\s*store: \{\s*$"},
    {"name": "$.session.version", "start_re": r"^\s*version: \(\) => Promise<SessionVersion>;"},
]


def die(msg):
    print("canary-baseline: " + msg, file=sys.stderr)
    sys.exit(2)


def strip_comments(lines, start):
    """Yield (stripped line) from `start`, comments removed, blank lines skipped."""
    in_block = False
    for l in lines[start:]:
        if in_block:
            m = re.match(r"^.*?\*/", l)
            if not m:
                continue
            l = l[m.end():]
            in_block = False
        l = re.sub(r"/\*.*?\*/", "", l)
        m = re.search(r"/\*.*$", l)
        if m:
            l = l[:m.start()]
            in_block = True
        l = re.sub(r"//.*$", "", l).strip()
        if l:
            yield l


def decl(lines, start_re):
    """The C9 rule: from the first matching line until depth 0 on a line ending ';'."""
    rx = re.compile(start_re)
    idx = next((i for i, l in enumerate(lines) if rx.search(l)), None)
    if idx is None:
        return None
    kept, depth = [], 0
    for l in strip_comments(lines, idx):
        depth += len(re.findall(r"[{(\[]", l)) - len(re.findall(r"[})\]]", l))
        kept.append(l)
        if depth <= 0 and l.endswith(";"):
            break
    return kept


def members(kept):
    """Top-level property names of a type literal (depth 1), with optional flags."""
    out, depth = [], 0
    for l in kept:
        if depth == 1:
            m = re.match(r"^(?:readonly\s+)?(\w+)(\?)?:", l)
            if m:
                out.append((m.group(1), bool(m.group(2))))
        depth += len(re.findall(r"[{(\[]", l)) - len(re.findall(r"[})\]]", l))
    return out


def is_rare(n, rare_max):
    """The one definition of a rare count, used here, by tools/check (c8_fixed_parts) and by
    smoke (helper/cmd/smoke.pl _rare): a whole number from 1 to rare_max. A count of 0 is never
    rare."""
    return type(n) is int and 1 <= n <= rare_max


def rare_guard(counts, binary):
    """The C8 strings outside COMMON_WORDS that the binary does not hold as rare strings."""
    bad = []
    for s in C8_STRINGS:
        if s in COMMON_WORDS:
            continue
        n = counts[s]
        if not is_rare(n, RARE_MAX):
            bad.append("{} {} (want 1 to {})".format(json.dumps(s), n, RARE_MAX))
    if bad:
        die("{}: not rare as C8 needs, so no baseline is written: {}. Check the strings, or move a "
            "now-common one to COMMON_WORDS".format(binary, "; ".join(bad)))


def render(doc):
    """The baseline's text: what this tool writes and --check compares (tools/check's fallback
    compares the same text, with the baseline's own c8 part and cc_version)."""
    return json.dumps(doc, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def keyset(req, opt):
    keys = sorted(set(req) | set(opt))
    return {"required": sorted(set(req)), "optional": sorted(set(opt) - set(req)),
            "sha8": hashlib.sha256(",".join(keys).encode()).hexdigest()[:8]}


def type_members(lines, name):
    kept = decl(lines, r"^\s*(?:export\s+)?type {}\b".format(re.escape(name)))
    if kept is None:
        die("type {} not found".format(name))
    return kept


def main(argv):
    types = None
    binary = None
    out = os.path.join(REPO, "plugin", "assets", "canary-baseline.json")
    check = False
    no_c8 = False
    out_given = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--types", "--claude", "--out") and i + 1 < len(argv):
            if a == "--types":
                types = argv[i + 1]
            elif a == "--claude":
                binary = argv[i + 1]
            else:
                out = argv[i + 1]
                out_given = True
            i += 2
            continue
        if a == "--check":
            check = True
            i += 1
            continue
        if a == "--no-c8":
            no_c8 = True
            i += 1
            continue
        die("unknown argument {}\n{}".format(a, __doc__))
    baseline = os.path.realpath(os.path.join(REPO, "plugin", "assets", "canary-baseline.json"))
    if no_c8 and (check or not out_given or os.path.realpath(out) == baseline):
        die("--no-c8 renders for tools/check's fallback only: give an --out other than the "
            "baseline, and no --check")
    if not types:
        d = os.environ.get("CC_TYPES_DIR")
        types = os.path.join(d, "claude-code.d.ts") if d else os.path.join(REPO, ".types", "claude-code.d.ts")
    if not os.path.isfile(types):
        die("no type declarations at {} (set CC_TYPES_DIR or --types)".format(types))
    if not binary:
        vdir = os.path.expanduser("~/.local/share/claude/versions")
        vers = [v for v in os.listdir(vdir) if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", v)] if os.path.isdir(vdir) else []
        vers.sort(key=lambda v: [int(x) for x in v.split(".")])
        binary = os.path.join(vdir, vers[-1]) if vers else os.environ.get("CLAUDE_CODE_EXECPATH")
    if not binary or not os.path.isfile(binary):
        if not no_c8:
            die("no Claude Code binary (set CLAUDE_CODE_EXECPATH or --claude)")
        binary = None
    with open(types, encoding="utf-8") as f:
        text = f.read()
    lines = text.split("\n")
    m = re.match(r"^// Written by Claude Code (\S+?)\.?$", lines[0])
    types_version = m.group(1) if m else "unknown"
    name = os.path.basename(binary) if binary else ""
    cc_version = name if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", name) else "unknown"

    base = members(type_members(lines, "BaseHookInput"))
    keysets = {}
    for ev in EVENTS:
        kept = type_members(lines, ev + "HookInput")
        own = members(kept)
        allm = base + own
        if "BaseHookInput" not in " ".join(kept):
            allm = own
        req = [n for n, o in allm if not o]
        opt = [n for n, o in allm if o]
        # A key typed optional in one part and required in another counts as required.
        keysets[ev] = keyset(req, [n for n in opt if n not in req] + [k for k in OBSERVED_OPTIONAL if k not in req])
    sc = members(type_members(lines, "SessionCompactInput"))
    keysets["session.compact"] = keyset([n for n, o in sc if not o], [n for n, o in sc if o])

    counts = None
    if not no_c8:
        with open(binary, "rb") as f:
            data = f.read()
        counts = {s: data.count(s.encode()) for s in C8_STRINGS}
        del data
        rare_guard(counts, binary)

    hashes = {}
    for spec in C9_SPECS:
        kept = decl(lines, spec["start_re"])
        if kept is None:
            die("C9 declaration {} not found".format(spec["name"]))
        hashes[spec["name"]] = hashlib.sha256("\n".join(kept).encode()).hexdigest()[:16]

    doc = {"v": 1, "cc_version": cc_version, "types_version": types_version, "keysets": keysets,
           "c9": {"types_version": types_version, "specs": C9_SPECS, "hashes": hashes},
           "copy_trailers": []}
    if not no_c8:
        doc["c8"] = {"binary_version": cc_version, "counts": counts, "idle_prefixes": IDLE_PREFIXES,
                     "rare_max": RARE_MAX}
    text_out = render(doc)
    if check:
        # bytes as written (newline=""): CRLF drift is a difference too
        cur = open(out, encoding="utf-8", newline="").read() if os.path.isfile(out) else ""
        if cur != text_out:
            print("canary-baseline: {} differs from a fresh render".format(os.path.relpath(out, REPO)))
            return 1
        print("canary-baseline: current")
        return 0
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, "w", encoding="utf-8", newline="\n") as f:
        f.write(text_out)
    print("canary-baseline: wrote {} ({}, types {})".format(
        out, "no C8" if no_c8 else "Claude Code " + cc_version, types_version))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
