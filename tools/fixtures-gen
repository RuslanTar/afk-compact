# ---------------------------------------------------------------- reference detector (MOD §5.1)

_TRAILERS = {}


def shipped_trailers():
    """copy_trailers of the spec literals and of plugin/assets/canary-baseline.json (compiled)."""
    if "v" not in _TRAILERS:
        src = list(literals().get("copy_trailers") or [])
        base = os.path.join(REPO, "plugin", "assets", "canary-baseline.json")
        if os.path.exists(base):
            try:
                src += json.loads(read(base)).get("copy_trailers") or []
            except ValueError:
                pass
        _TRAILERS["v"] = compile_trailers(src)
    return _TRAILERS["v"]


def compile_trailers(src):
    out = []
    for t in src:
        s = t.get("re") if isinstance(t, dict) else t
        if isinstance(s, str) and s:
            try:
                out.append(re.compile(s))
            except re.error:
                pass
    return out


def table_trailers(d):
    """Shipped trailers plus the table's own copy_trailers.json (p5 only)."""
    extra = os.path.join(d, "copy_trailers.json")
    own = compile_trailers(json.loads(read(extra)).get("copy_trailers") or []) if os.path.exists(extra) else []
    return shipped_trailers() + own


def cut_trailers(body, trailers, keep):
    """Cut listed installed-message trailers from the end of body, never at or above index keep."""
    j = len(body) - 1
    while j >= keep:
        if not body[j].strip():
            j -= 1
            continue
        if not any(rx.search(body[j]) for rx in trailers):
            break
        del body[j:]
        j -= 1
    return body


def normalize(text, name=None, trailers=()):
    """Normalized body: wrapper parts stripped from the head, cut at </summary>, \\n line ends.

    Head (repeated until none applies, blank lines between parts dropped): a line starting
    `This session is being continued`; a `<tools-used-before-summary>` block through its closing
    tag; a closed `<analysis>` block (the PostCompact form keeps it, 2.1.309); a closed
    `<system-reminder>` block (the installed form wraps the tools-used block in it, 2.1.311); a
    `Summary:` line; a `<summary>` tag (text after the tag on the same line is body).
    Tail: the body ends before the first line holding `</summary>` (text before the tag on that
    line is body). Sentinel after the close tag (MOD-SPEC §5.1, P5-FOLD A1; needs `name`): when
    the first non-blank text after `</summary>` (the rest of that line, else the next non-blank
    line) matches the sentinel grammar, that line is appended as the body's last line and the
    lines after it follow it as trailers; any other first line keeps everything after the tag
    outside the body. Listed trailers (`trailers`) are then cut from the end, never the moved
    sentinel itself; with no `</summary>` the same cut applies to the end of the body (detect.pm).
    Trailing blank lines are trimmed. Result: (text, moved) with text = lines joined by \\n plus
    one final \\n or the empty string for an empty body, and moved = the sentinel line's index in
    the body when it was moved, else None.
    """
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    i = 0
    while i < len(lines):
        s = lines[i].strip()
        if s == "":
            i += 1
        elif lines[i].startswith("This session is being continued"):
            i += 1
        elif s.startswith("<tools-used-before-summary>"):
            while i < len(lines) and "</tools-used-before-summary>" not in lines[i]:
                i += 1
            i += 1
        elif s.startswith("<analysis>"):
            # the summarizer's scratch block a PostCompact compact_summary keeps (2.1.309);
            # an unclosed one is body
            j = i
            while j < len(lines) and "</analysis>" not in lines[j]:
                j += 1
            if j >= len(lines):
                break
            i = j + 1
        elif s.startswith("<system-reminder>"):
            # the reminder block the 2.1.311 installed message wraps the tools-used block in;
            # an unclosed one is body
            j = i
            while j < len(lines) and "</system-reminder>" not in lines[j]:
                j += 1
            if j >= len(lines):
                break
            i = j + 1
        elif s == "Summary:":
            i += 1
        elif lines[i].startswith("<summary>"):
            rest = lines[i][len("<summary>"):]
            if rest.strip():
                lines[i] = rest
                break
            i += 1
        else:
            break
    body, moved, closed = [], None, False
    rest = lines[i:]
    for j, line in enumerate(rest):
        if "</summary>" in line:
            closed = True
            k = line.index("</summary>")
            head, tail = line[:k], line[k + len("</summary>"):]
            if head.strip():
                body.append(head)
            after = ([tail] if tail.strip() else []) + rest[j + 1:]
            while after and not after[0].strip():
                after.pop(0)
            if name is not None and after and sentinel_grammar(name).match(after[0]):
                while body and not body[-1].strip():
                    body.pop()
                moved = len(body)
                body += after
            break
        body.append(line)
    if moved is not None:
        cut_trailers(body, trailers, moved + 1)
    elif not closed:
        cut_trailers(body, trailers, 0)
    while body and not body[-1].strip():
        body.pop()
    return ("\n".join(body) + "\n" if body else ""), moved


def sentinel_grammar(name):
    return re.compile(r"^⟪/" + re.escape(name) + r" n=([0-9a-f]{8})⟫$")


def unclosed(lines, scope, sentinel_re):
    """0.1.3 ok-unclosed: no line in the sentinel grammar (any nonce), and every section the spec's
    unclosed_required lists for the marker's scope (sub, else main) is there, in order, with
    text under the last (or after a colon on its heading line); a summary complete but for its
    closing line."""
    if any(sentinel_re.match(ln.rstrip()) for ln in lines):
        return False
    heads = (literals().get("unclosed_required") or {}).get("sub" if scope == "sub" else "main") or []
    if not heads:
        return False
    j = 0
    for h in heads:
        while j < len(lines) and not lines[j].startswith(h):
            j += 1
        if j >= len(lines):
            return False
        j += 1
    if re.search(r":\s*\S", lines[j - 1][len(heads[-1]):]):
        return True
    return any(ln.strip() for ln in lines[j:])


def detect(text, name, dispatch=None, trailers=()):
    """(verdict, marker_line, sentinel_from_end, nonce, scope, sha256, sentinel_place) per MOD §5.1.

    dispatch: None = text alone; "none" = a PostCompact with no dispatch at all; else the
    dispatch record (dict) of this compaction. sentinel_place: `inside`, `after-close` (the
    sentinel found is the line moved from after `</summary>`) or None (no sentinel found).
    """
    body, moved = normalize(text, name, trailers)
    lines = body.split("\n")[:-1] if body else []
    marker_re = re.compile(r"^⟪" + re.escape(name) + r" v1 n=([0-9a-f]{8}) s=(main|sub|manual)⟫$")
    sentinel_re = sentinel_grammar(name)
    marker_line = nonce = scope = None
    for idx, line in enumerate(lines[:5]):
        m = marker_re.match(line)
        if m:
            marker_line, nonce, scope = idx + 1, m.group(1), m.group(2)
            break
    nonblank = [(ix, ln) for ix, ln in enumerate(lines) if ln.strip()]
    sfe = s_nonce = place = None
    for k in range(1, min(3, len(nonblank)) + 1):
        m = sentinel_re.match(nonblank[-k][1])
        if m:
            sfe, s_nonce = k, m.group(1)
            place = "after-close" if nonblank[-k][0] == moved else "inside"
            break
    resume_heading = any(ln.startswith("## Resume here") for ln in lines)
    verdict = None
    if dispatch is not None:
        if dispatch == "none":
            if nonce:
                verdict = "stale"
        else:
            # P1 of MOD §2.4: sub = agent_id set; main = agent_id null and a mod channel.
            # A classic dispatch (actor unknown) proves neither scope.
            sub = dispatch.get("agent_id") is not None
            main = not sub and dispatch.get("channel") in ("mod-hook", "mod-self")
            if nonce and nonce != dispatch["nonce"]:
                verdict = "stale"
            elif sub and (scope == "main" or resume_heading):
                verdict = "scope-leak"
            elif main and scope == "sub":
                verdict = "scope-leak"
    if verdict is None:
        if not nonce:
            verdict = "unshaped"
        elif sfe is None or s_nonce != nonce:
            verdict = "ok-unclosed" if unclosed(lines, scope, sentinel_re) else "truncated"
        elif sfe > 1:
            verdict = "ok-trailer"
        else:
            verdict = "ok"
    sha = hashlib.sha256(body.encode("utf-8")).hexdigest()
    return verdict, marker_line, sfe, nonce, scope, sha, place


def tables():
    """(dir, expected.tsv) of each corpus table: the main corpus, then each SUB_TABLES folder."""
    out = [(SUMMARIES, EXPECTED)]
    for name in SUB_TABLES:
        d = os.path.join(SUMMARIES, name)
        if os.path.isdir(d):
            out.append((d, os.path.join(d, "expected.tsv")))
    return out


def summary_files(d=SUMMARIES):
    return sorted(f for f in os.listdir(d) if f.endswith(".txt"))


def load_dispatch(ref):
    if ref in ("", None):
        return None
    if ref == "none":
        return "none"
    with open(os.path.join(FIX, ref), encoding="utf-8") as f:
        return json.load(f)


def read_expected(path=EXPECTED):
    rows = []
    with open(path, encoding="utf-8") as f:
        header = f.readline().rstrip("\n").split("\t")
        if header != COLUMNS:
            die("{} header is {}, want {}".format(os.path.relpath(path, REPO), header, COLUMNS))
        for line in f:
            line = line.rstrip("\n")
            if line:
                parts = line.split("\t")
                parts += [""] * (len(COLUMNS) - len(parts))
                rows.append(dict(zip(COLUMNS, parts)))
    return rows


def dash(v):
    return "-" if v is None else str(v)


def expected_rows(b, dispatch_refs, d=SUMMARIES):
    out = []
    trailers = table_trailers(d)
    for f in summary_files(d):
        ref = dispatch_refs.get(f, "")
        v, ml, sfe, n, sc, sha, place = detect(fill(read(os.path.join(d, f)), b), b["name"],
                                               load_dispatch(ref), trailers)
        out.append({"file": f, "verdict": v, "marker_line": dash(ml), "sentinel_from_end": dash(sfe),
                    "nonce": dash(n), "scope": dash(sc), "normalized_sha256": sha, "dispatch": ref,
                    "sentinel_place": dash(place)})
    return out


def tsv(rows):
    return "\t".join(COLUMNS) + "\n" + "".join("\t".join(r[c] for c in COLUMNS) + "\n" for r in rows)


def sha_refreshed(b, d=SUMMARIES, path=EXPECTED):
    """(rows of one expected.tsv with normalized_sha256 recomputed for brand b, number changed).

    Only the sha column is touched: it is a function of the text and the brand alone, so a
    rename changes it (README "Corpus"). The other columns stay as authored for --check.
    """
    rows = read_expected(path)
    fresh = {r["file"]: r for r in expected_rows(b, {r["file"]: r["dispatch"] for r in rows}, d)}
    changed = 0
    for r in rows:
        f = fresh.get(r["file"])
        if f and f["normalized_sha256"] != r["normalized_sha256"]:
            r["normalized_sha256"] = f["normalized_sha256"]
            changed += 1
    return rows, changed


def refresh_sha(b):
    total = 0
    for d, path in tables():
        rows, changed = sha_refreshed(b, d, path)
        if changed:
            with open(path, "w", encoding="utf-8", newline="\n") as f:
                f.write(tsv(rows))
            print("fixtures-gen: refreshed normalized_sha256 for {} rows of {} (brand {})".format(
                changed, os.path.relpath(path, REPO), b["name"]))
        total += changed
    return total


