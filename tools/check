def old_name_left(root, old):
    """Lines in the renamed copy's shipped files, README.md and docs/ that still hold the old name (substring)."""
    targets = [os.path.join(root, "README.md"), os.path.join(root, ".claude-plugin", "marketplace.json")]
    for top in ("plugin", "docs"):
        for d, dirs, files in os.walk(os.path.join(root, top)):
            dirs[:] = sorted(x for x in dirs if x not in ("node_modules", ".git") and
                             not (x == "types" and os.path.basename(d) == ".claude-plugin"))
            targets += [os.path.join(d, f) for f in sorted(files)]
    left = []
    for p in targets:
        if not os.path.isfile(p):
            continue
        with open(p, "rb") as f:
            data = f.read()
        if b"\0" in data[:8192]:
            continue
        for no, line in enumerate(data.decode("utf-8", errors="replace").splitlines(), 1):
            if old in line:
                left.append("{}:{}".format(os.path.relpath(p, root), no))
    return left


def bt02(phase, names):
    old = brand()["name"]
    if old in DRILL_NAME:
        raise Fail("BT-02: the drill name {} contains the brand {}".format(DRILL_NAME, old))
    before = tree_state()
    copy_tree(DRILL_DIR)
    b = brand(DRILL_DIR)
    if b["marketplace"] == b["name"]:
        b["marketplace"] = DRILL_NAME
    b["name"] = DRILL_NAME
    # The repo slug holds the brand (badges, install lines, manifest URLs): the drill renames it.
    b["repo"] = b["repo"].split("/")[0] + "/" + DRILL_NAME
    write_text(os.path.join(DRILL_DIR, "brand.json"), json.dumps(b, indent=2, ensure_ascii=False) + "\n")
    for step in RENAME_STEPS:
        run([os.path.join(DRILL_DIR, *step[:2])] + step[2:], "BT-02 " + " ".join(step), cwd=DRILL_DIR)
    inner = [os.path.join(DRILL_DIR, "tools", "check"), phase, "--no-drill"] + (["--names", names] if names else [])
    run(inner, "BT-02 tools/check {} under {}".format(phase, DRILL_NAME), cwd=DRILL_DIR)
    left = old_name_left(DRILL_DIR, old)
    if left:
        raise Fail("BT-02: the old name {} is left in {} lines of the renamed copy: {}".format(
            old, len(left), ", ".join(left[:12])))
    # The old name's launcher must be gone from the launcher folder
    # and from the folder it used to live in; the new name's launcher is in scripts/ only.
    for folder in (LAUNCHER_DIR,) + OLD_LAUNCHER_DIRS:
        if os.path.lexists(os.path.join(DRILL_DIR, *launcher_rel(old, folder).split("/"))):
            raise Fail("BT-02: the old launcher survived in the renamed copy: " + launcher_rel(old, folder))
    if not os.path.isfile(os.path.join(DRILL_DIR, *launcher_rel(DRILL_NAME).split("/"))):
        raise Fail("BT-02: the renamed copy has no " + launcher_rel(DRILL_NAME))
    left_dirs = [d for d in OLD_LAUNCHER_DIRS if os.path.lexists(os.path.join(DRILL_DIR, "plugin", d))]
    if left_dirs:
        raise Fail("BT-02: the renamed copy still has plugin/{}/".format(left_dirs[0]))
    run([os.path.join(REPO, "tools", "build"), "--check"], "BT-02 committed tree")
    if tree_state() != before:
        raise Fail("BT-02: the drill changed the working tree")
    shutil.rmtree(DRILL_DIR)
    print("BT-02: PASS (renamed to {} by the regenerate steps; tools/check {} passed in the copy; "
          "no {} left; committed tree unchanged)".format(DRILL_NAME, phase, old))


