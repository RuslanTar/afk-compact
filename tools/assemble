#!/usr/bin/python3
"""tools/assemble: assemble every compaction asset per path and check its budget.

Port of the design-phase assembler (compaction DESIGN-NOTES §2 grammar, HK-39 / AT-P-07
budgets, SIZE-CHECK worst cases), reading src/assets/.

Usage: tools/assemble [--name NAME] [--path-len N] [--dir ASSET_DIR] [--goldens | --check]
  --name      plugin name filled into {{plugin}} (default: brand.json name)
  --path-len  length of the worst-case previous-copy path (default 141)
  --dir       asset folder (default src/assets)
  --goldens   also write tests/fixtures/assembly/expected/<asset>__<tags|base>.txt for every
              tag combination, with the runtime values of tests/fixtures/assembly/runtime.json
              when that file exists (else the worst-case values below), and the same
              texts as plugin/tests/unit/_gen/goldens.gen.ts for the U half of BT-04
  --check     compare those files with a fresh render instead of writing them, byte for byte
              (CRLF drift and stray .txt files count; BUILD-PLAN §4 X-gen, BH-5)

Build step: strip <!-- ... --> comments, fill {{plugin}}. Runtime: fill @tokens@ with
worst-case values. A line starting "[tag] " is kept (tag stripped) only when the tag is
active on the path, else dropped. [measured] lines and @remeasure@ belong to the block budget,
not the static core. Extra checks: no `<!--` survives; CDN Review item 9 (cited step numbers
exist and still name the same step; [queue]/[halt] lines reference only kept lines); a
nudge with [halt] and without [continue] never says the plugin compacts the session into a
handoff summary or copies after this turn, and the [halt] line says the plugin compacts only
if auto-continue is off or at its hourly limit (CR-F30/F35); no handoff-turn render has a
line that starts with "/" and a [submit-idle] render says "launch no agents or workflows"
(AT-LT-18, AT-IC-12); no render of any asset names the bare launcher (with or without a
subcommand), and one that writes `<store>` defines it as the @store@ word (AT-PK-03, never skipped); heading literals equal the spec-literals block of handoff-spec.md once
that file exists. Exclusive tag groups (EXCLUSIVE, XR-19) limit every walk over combinations.
Budgets: the BUDGETS table (D-17 of the 2026-10-21 rulings, compaction-rem-6 of 2026-10-22;
AT-P-07, AT-TX-10), with @store@ at a 160-character root stand-in (PKG-RUNTIME A.2). Above a soft
limit a check prints ADVISORY and still passes; above a hard limit it prints OVER and fails. The
resume protocol and the resume block total (RP-1, owner 2026-10-23) are soft targets that pass
only with a logged reason in tools/budget-reasons.json (ADVISORY <budget> <n> > soft <s>: <reason>),
and only up to the size that reason names; without one they fail. The [idle-return] line (ID-3)
is checked alone and its static part counts against the protocol. AT-QA-01: with no [queue] tag
the main text and the nudge name no queue or lane.
Exit 1 when a hard budget is exceeded or any check fails.
"""
import itertools, json, os, re, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
DIR = os.path.join(REPO, "src", "assets")
GOLDEN_DIR = os.path.join(REPO, "tests", "fixtures", "assembly", "expected")
RUNTIME_JSON = os.path.join(REPO, "tests", "fixtures", "assembly", "runtime.json")
with open(os.path.join(REPO, "brand.json"), encoding="utf-8") as f:
    NAME = json.load(f)["name"]
PATH_LEN = 141   # longest real handoff path in the corpus (~-abbreviated; median 100, p90 116)
GOLDENS = False
args = sys.argv[1:]
for flag in ("--name", "--path-len", "--dir"):
    if flag in args:
        i = args.index(flag)
        if i + 1 >= len(args):
            sys.exit("assemble: {} needs a value".format(flag))
        if flag == "--name":
            NAME = args[i + 1]
        elif flag == "--path-len":
            PATH_LEN = int(args[i + 1])
        else:
            DIR = os.path.abspath(args[i + 1])
        del args[i:i + 2]
if "--goldens" in args:
    GOLDENS = True
    args.remove("--goldens")
CHECK = False
if "--check" in args:
    CHECK = True
    args.remove("--check")
if GOLDENS and CHECK:
    sys.exit("assemble: --goldens and --check exclude each other")
if args:
    sys.exit("assemble: unknown arguments {}\n{}".format(args, __doc__))

PREV = "~/.claude/handoffs/example-repo/LAB-123/" + "p" * (PATH_LEN - len("~/.claude/handoffs/example-repo/LAB-123/"))
# PKG-RUNTIME A.2 (BLD-04): `@store@` = storeWord(<root>/scripts/<name>-store), the launcher's
# absolute path as one double-quoted shell word. Budget tests use a 160-character root stand-in.
STORE_ROOT_LEN = 160
_ROOT_BASE = "/opt/example/.claude/plugins/cache/example-marketplace/"
STORE_ROOT = _ROOT_BASE + "r" * (STORE_ROOT_LEN - len(_ROOT_BASE))
STORE = '"' + STORE_ROOT + "/scripts/" + NAME + '-store"'
RUNTIME = {"nonce": "a1b2c3d4", "previous_copy": PREV, "measured_at": "2026-10-21T04:40:00+03:00",
           "session_id": "00000000-0000-4000-8000-000000000000", "saved_copy": PREV, "tokens": "612,345",
           "store": STORE,
           # nudge.ts builds queue_add with storeWord (PKG-RUNTIME A.2).
           "queue_add": STORE + " queue-add --sid 00000000-0000-4000-8000-000000000000 --nonce a1b2c3d4", "measured_facts": "", "remeasure": "",
           # D-18 tokens (worst case; text-to-build.md §1): the longest halt reason, c = 1 + call_cap
           # + recipe_cap (DP-19), and core's handoff_turn::finish_command form. Since wp/core C-2
           # (XR-03 (1), DP-31 (1)) that command starts with the `<store>` token, which the resume
           # context defines once; it no longer carries the full launcher word (B-4).
           "halt_reason": "compactions keep repeating without progress", "max_calls": "34", "handoff_path": PREV,
           "draft_state": "present",
           "handoff_finish": "`<store> publish --stage '" + PREV + "/.staging/xxxxxxxx-a1b2c3d4' --slug example-topic-slug --status in-progress`",
           # IC-1 D5 [submit-idle]: minutes idle when the pre-idle turn fires (MOD-SPEC §9.4: 49).
           "idle_min": "49"}
# ID-3 [idle-return]: `measure --compact --brief` output at its cap (600 B). Only the check of
# the [idle-return] line fills it (that line is never part of a resume block render).
IDLE_RETURN = "i" * 600
TAG = re.compile(r"^\[([a-z-]+)\] ")
FILES = {"main": "handoff-instructions.txt", "sub": "subagent-instructions.txt",
         "res": "resume-context.txt", "nudge": "checkpoint-nudge.txt", "turn": "handoff-turn.txt"}
# Tags per asset, in the order DESIGN-NOTES §2 lists them (golden file names use this order).
# BLD-04: resume-context gains [idle] (IC-1 D3) and [prod-forbid]/[prod-allow] (S-SETTINGS B);
# handoff-turn gains [submit-pre], [submit-halt] (S-SETTINGS D) and [submit-idle] (IC-1 D5).
# Q-ADAPTER QA-3 / QA-B3 (owner xxxxxxxx-11): the main text gains [queue], kept only when
# queue_cmd is set (both paths).
TAGS = {"main": ["midturn", "auto", "chain", "measured", "handoff", "queue"], "sub": ["fallback"],
        "res": ["midturn", "nonok", "idle", "handoff", "handoff-partial", "prod-forbid", "prod-allow"],
        "nudge": ["continue", "halt", "halt-handoff", "queue"],
        "turn": ["submit", "near", "spent", "imminent", "submit-pre", "submit-halt", "submit-idle"]}
# CROSS-REVIEW XR-19: tag groups whose members exclude each other. "one" = exactly one member is
# active on every path; "most" = at most one. combos() skips every other combination, so the
# goldens, the step checks and every walk over combinations see only paths that can happen.
EXCLUSIVE = {"res": [(("prod-forbid", "prod-allow"), "one"), (("idle", "midturn"), "most")]}
# CDN Review item 9: a cited step must exist and still start with the same word.
STEP_NAMES = {("nudge", 1): "Finish", ("nudge", 2): "Save", ("nudge", 3): "List",
              ("res", 3): "Background"}
# CDN Review item 9: a kept [tag] line refers to these lines, which must be kept too.
TAG_NEEDS = {("nudge", "halt"): ["Checkpoint: "], ("nudge", "halt-handoff"): ["Checkpoint: "],
             ("nudge", "queue"): ["Questions: "]}


def load(name):
    with open(os.path.join(DIR, name), encoding="utf-8") as f:
        return re.sub(r"[ \t]*<!--.*?-->", "", f.read(), flags=re.S).replace("{{plugin}}", NAME)


def assemble(text, tags, drop=()):
    out = []
    for line in text.splitlines():
        m = TAG.match(line)
        if m:
            if m.group(1) not in tags or m.group(1) in drop:
                continue
            line = line[m.end():]
        if any(f"@{d}@" in line for d in drop):
            continue
        out.append(line)
    s = "\n".join(out).strip() + "\n"
    return re.sub(r"@([a-z_]+)@", lambda m: RUNTIME.get(m.group(1), m.group(0)), s)


# One row per budget: (unit, soft, hard); None = no limit of that kind. Soft = ADVISORY only.
# D-17 (root DP-8): the static core has a soft target and no hard cap; the mod channel total
# stays the hard guard on what reaches the summarizer. compaction-rem-6 (2026-10-22, supersedes
# DP-8): resume block total 6,500, and never over the 10,000-char SessionStart cutoff.
# Ratify xxxxxxxx#R3 overturned (owner 2026-10-23, SPEC-DELTAS RP-1): the resume protocol's
# 3,000 and the block total's 6,500 are SOFT targets that may be exceeded only with a logged
# reason (REASON_REQUIRED, tools/budget-reasons.json); the 10,000 cutoff stays hard.
BUDGETS = {
    "static core":           ("chars", 4500, None),
    "mod channel total":     ("bytes", None, 8192),
    "classic channel total": ("bytes", None, 8192),
    "measured block":        ("bytes", None, 3000),   # worst case filled into @measured_facts@ and @remeasure@
    "subagent mod":          ("chars", 900, None),
    "subagent classic":      ("chars", 1100, None),
    "resume protocol":       ("chars", 3000, None),
    "resume block total":    ("chars", 6500, None),
    "sessionstart cutoff":   ("chars", None, 10000),
    "idle-return line":      ("chars", None, 900),    # ID-3: the [idle-return] line alone, @idle_return@ at its 600 B cap
    "nudge":                 ("chars", 2200, None),
    "handoff turn submit":   ("chars", None, None),   # D-18 handoff-turn.txt: printed, no limit set
    "handoff turn note":     ("chars", None, None),
    "submit-idle lines":     ("chars", None, 600),    # IC-1 D5 / MOD-SPEC §9.4: the [submit-idle] lines alone
}


# RP-1: soft budgets that may be exceeded only with a logged reason. tools/budget-reasons.json
# maps a budget name to its reason: a string, or {"why": …, "up_to": N}, where up_to (chars or
# bytes, as the budget counts) is the size the reason was written for; above it the reason no
# longer covers the overrun and the check fails until the reason is reviewed (so a reason never
# becomes a blank cheque, and the compaction-rem-6 probe still catches a text that grows).
REASON_REQUIRED = {"resume protocol", "resume block total"}
REASONS_FILE = os.path.join(REPO, "tools", "budget-reasons.json")


def load_reasons(path=REASONS_FILE):
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
    out = {}
    for k, v in doc.items():
        if isinstance(v, str):
            out[k] = (v, None)
        elif isinstance(v, dict) and isinstance(v.get("why"), str) and v["why"].strip():
            up = v.get("up_to")
            out[k] = (v["why"], up if isinstance(up, int) and not isinstance(up, bool) else None)
    return out


REASONS = load_reasons()


def check(label, s, budget):
    unit, soft, hard = BUDGETS[budget]
    n = len(s) if unit == "chars" else len(s.encode())
    leftovers = re.findall(r"^\[[a-z-]+\] |@[a-z_]+@|\{\{[^}]*\}\}|<!--", s, flags=re.M)
    over = hard is not None and n > hard
    flag = "OVER" if over else "ADVISORY (over soft)" if soft is not None and n > soft else "ok"
    if not over and soft is not None and n > soft and budget in REASON_REQUIRED:
        why, up_to = REASONS.get(budget, (None, None))
        if why is None:
            flag, over = "OVER (soft; no reason for it in tools/budget-reasons.json)", True
        elif up_to is not None and n > up_to:
            flag, over = "OVER (soft; the logged reason covers up to {})".format(up_to), True
        else:
            flag = "ADVISORY {} {} > soft {}: {}".format(budget, n, soft, why)
    print(f"{label:44} {n:6} {unit:5} soft={soft if soft else '-':>5} hard={hard if hard else '-':>5}  {flag}"
          + (f"  LEFTOVER {leftovers}" if leftovers else ""))
    return over or bool(leftovers)


def budget_table():
    print("budget                    unit   soft   hard")
    for k, (unit, soft, hard) in BUDGETS.items():
        print(f"{k:25} {unit:5} {soft if soft else '-':>6} {hard if hard else '-':>6}")


TEXT = {k: load(v) for k, v in FILES.items()}
main, sub, res, nudge, turn = TEXT["main"], TEXT["sub"], TEXT["res"], TEXT["nudge"], TEXT["turn"]


def static(text, tags, drop=()):
    """HK-39 static core: build-time text only; runtime @tokens@ count toward the channel total, not here."""
    saved = dict(RUNTIME)
    RUNTIME.update({k: "" for k in RUNTIME})
    try:
        return assemble(text, tags, drop)
    finally:
        RUNTIME.update(saved)


def valid(asset, tags):
    """XR-19: the combination keeps every EXCLUSIVE rule of the asset."""
    for members, rule in EXCLUSIVE.get(asset, []):
        n = sum(1 for t in members if t in tags)
        if n > 1 or (rule == "one" and n != 1):
            return False
    return True


def combos(asset):
    tags = TAGS[asset]
    for r in range(len(tags) + 1):
        for c in itertools.combinations(tags, r):
            if valid(asset, c):
                yield list(c)


def longest(asset, variants, drop=()):
    """(tags, text) of the longest render among the tag lists (the worst case of a check)."""
    best = None
    for tags in variants:
        if not valid(asset, tags):
            sys.exit("assemble: invalid tag combination {} for {}".format(tags, asset))
        s = assemble(TEXT[asset], tags, drop)
        if best is None or len(s) > len(best[1]):
            best = (tags, s)
    return best


def submit_checks():
    """AT-LT-18 (DP-24 g) and AT-IC-12: no handoff-turn render, at any tag combination, starts
    with "/" or has a line that starts with "/" (the host refuses such a submit). Once the asset
    has [submit-idle] lines, every render with that tag says "launch no agents or workflows"."""
    bad = False
    has_idle = re.search(r"^\[submit-idle\] ", TEXT["turn"], flags=re.M)
    for tags in combos("turn"):
        s = assemble(TEXT["turn"], tags)
        label = "+".join(tags) or "base"
        if s.startswith("/") or any(ln.startswith("/") for ln in s.splitlines()):
            print(f"submit check turn {label:32} FAIL a line starts with '/'")
            bad = True
        if has_idle and "submit-idle" in tags and "launch no agents or workflows" not in s.lower():
            print(f"submit check turn {label:32} FAIL [submit-idle] lacks 'launch no agents or workflows'")
            bad = True
    print("AT-LT-18 / AT-IC-12 (handoff-turn submit text)  " + ("FAIL" if bad else "ok"))
    return bad


def store_checks():
    """AT-PK-03 (assembler half), never skipped: since BLD-01 the launcher is not on the Bash PATH,
    so no render of any assembled asset (FILES: handoff and subagent instructions, resume context,
    nudge, handoff turn) names the bare `<name>-store`, with or without a subcommand after it (the
    texts call it through @store@ or the `<store>` token; the filled @store@ word holds it only
    after `/scripts/`), and a render that writes `<store>` also defines it as the filled launcher
    word, `<store> = <@store@>` (TXT-06, XR-03 (1))."""
    bare = re.compile(r"(?<![/\w.-])" + re.escape(NAME) + r"-store(?![\w-])")
    define = "<store> = " + STORE
    bad = False
    for asset in FILES:
        for tags in combos(asset):
            label = "{} {}".format(asset, "+".join(tags) or "base")
            s = assemble(TEXT[asset], tags)
            for ln in s.splitlines():
                m = bare.search(ln)
                if m:
                    print(f"store check {label:32} FAIL bare launcher: "
                          f"{ln[max(0, m.start() - 30):m.end() + 20]!r}")
                    bad = True
                    break
            if "<store>" in s.replace(define, "") and define not in s:
                print(f"store check {label:32} FAIL uses <store> without the line '{define[:24]}…'")
                bad = True
    print("AT-PK-03 bare launcher name in assembled texts  " + ("FAIL" if bad else "ok"))
    return bad


def step_checks():
    """CDN Review item 9 over every tag combination of the nudge and the resume block."""
    bad = False
    for asset in ("nudge", "res"):
        for tags in combos(asset):
            s = assemble(TEXT[asset], tags)
            lines = s.splitlines()
            steps = {}
            for line in lines:
                m = re.match(r"^(\d+)\. (\S+)", line)
                if m:
                    steps[int(m.group(1))] = m.group(2).rstrip(",:")
            label = "{} {}".format(asset, "+".join(tags) or "base")
            nums = sorted(steps)
            if nums != list(range(1, len(nums) + 1)):
                print(f"step check {label:32} FAIL steps not 1..n: {nums}")
                bad = True
            for m in re.finditer(r"\bstep[ -](\d+)\b", s):
                n = int(m.group(1))
                want = STEP_NAMES.get((asset, n))
                if n not in steps:
                    print(f"step check {label:32} FAIL cites step {n}, which is not in the text")
                    bad = True
                elif want and steps[n] != want:
                    print(f"step check {label:32} FAIL cites step {n}, now '{steps[n]}', expected '{want}'")
                    bad = True
            for tag in tags:
                if not re.search(r"^\[{}\] ".format(re.escape(tag)), TEXT[asset], flags=re.M):
                    continue
                for need in TAG_NEEDS.get((asset, tag), []):
                    if not any(line.startswith(need) for line in lines):
                        print(f"step check {label:32} FAIL [{tag}] line refers to '{need.strip()}', which is dropped")
                        bad = True
    print("CDN Review item 9 (step refs, [queue]/[halt] refs)  " + ("FAIL" if bad else "ok"))
    return bad


# CR-F30/F35 (text-to-build §6): a nudge that halts (no [continue]) never promises a plugin
# compaction or an after-turn copy; the [halt] line says when the plugin still compacts (DP-4).
HALT_FORBIDDEN = ("the plugin compacts the session into a handoff summary", "after this turn the plugin copies")
HALT_LINE_NEEDS = "only if auto-continue is off or at its hourly limit"


def halt_checks():
    bad = False
    halt_lines = [ln for ln in TEXT["nudge"].splitlines() if ln.startswith("[halt] ")]
    if not halt_lines or not all(HALT_LINE_NEEDS in ln for ln in halt_lines):
        print(f"halt check nudge [halt] line                FAIL lacks '{HALT_LINE_NEEDS}'")
        bad = True
    for tags in combos("nudge"):
        if "halt" not in tags or "continue" in tags:
            continue
        s = assemble(TEXT["nudge"], tags).lower()
        for phrase in HALT_FORBIDDEN:
            if phrase in s:
                print(f"halt check nudge {'+'.join(tags):27} FAIL promises '{phrase}'")
                bad = True
    print("CR-F30/F35 (halted nudge: no compaction or copy promise)  " + ("FAIL" if bad else "ok"))
    return bad


# AT-QA-01 (Q-ADAPTER QA-3, owner xxxxxxxx-11 "setting-driven, one text"): with queue_cmd empty
# the [queue] tag is never active, and then no render of the main text (mod and classic paths)
# or the nudge names a queue, a queued question or a lane.
QUEUE_WORDS = re.compile(r"\bqueue[a-z_-]*|\bQueued\b|\blanes?\b", re.I)


def queue_checks():
    bad = False
    for asset in ("main", "nudge"):
        for tags in combos(asset):
            if "queue" in tags:
                continue
            # The work-state ladder's `queued` (spec §4) is a work state, not the question queue.
            s = assemble(TEXT[asset], tags).replace("|queued|", "|")
            m = QUEUE_WORDS.search(s)
            if m:
                print(f"queue check {asset} {'+'.join(tags) or 'base':27} FAIL off-mode text names {m.group(0)!r}")
                bad = True
    print("AT-QA-01 (queue off: no queue or lane text)  " + ("FAIL" if bad else "ok"))
    return bad


def heading_checks():
    spec_md = os.path.join(DIR, "handoff-spec.md")
    if not os.path.exists(spec_md):
        print("heading literals vs handoff-spec.md               skip (no handoff-spec.md yet)")
        return False
    text = load("handoff-spec.md")
    m = re.search(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", text, re.S | re.M)
    if not m:
        print("heading literals vs handoff-spec.md               FAIL (no ```json spec-literals block)")
        return True
    spec = json.loads(m.group(1))
    bad = False
    for key, asset, tags in (("sections_main", "main", ["chain"]), ("sections_subagent", "sub", [])):
        heads = spec.get(key)
        if not isinstance(heads, list):
            print(f"heading literals {key:32} FAIL (missing in spec)")
            bad = True
            continue
        lines = [ln for ln in assemble(TEXT[asset], tags).splitlines() if ln.startswith("#")]
        pos = []
        for h in heads:
            idx = next((i for i, ln in enumerate(lines) if ln.startswith(h)), None)
            if idx is None:
                print(f"heading literals {key:32} FAIL '{h}' not at the start of a # line")
                bad = True
            pos.append(idx)
        found = [p for p in pos if p is not None]
        if found != sorted(found):
            print(f"heading literals {key:32} FAIL order differs from the spec")
            bad = True
    print("heading literals vs handoff-spec.md               " + ("FAIL" if bad else "ok"))
    return bad


GOLDENS_MODULE = os.path.join(REPO, "plugin", "tests", "unit", "_gen", "goldens.gen.ts")


def render_goldens():
    """{absolute path: text} for every golden .txt and for goldens.gen.ts (nothing written)."""
    runtime = dict(RUNTIME)
    if os.path.exists(RUNTIME_JSON):
        with open(RUNTIME_JSON, encoding="utf-8") as f:
            # runtime.json may hold {{plugin}} (a command line the text quotes): fill it with the
            # name this render uses, so a renamed copy regenerates without the old name (BT-02).
            runtime.update({k: v.replace("{{plugin}}", NAME) for k, v in json.load(f).items()})
    saved = dict(RUNTIME)
    RUNTIME.update(runtime)
    out = {}
    rows = []
    try:
        for asset, fname in FILES.items():
            stem = fname[:-4]
            for tags in combos(asset):
                text = assemble(TEXT[asset], tags)
                out[os.path.join(GOLDEN_DIR, "{}__{}.txt".format(stem, "+".join(tags) or "base"))] = text
                rows.append({"asset": stem, "tags": tags, "parts": text.split(NAME)})
    finally:
        RUNTIME.clear()
        RUNTIME.update(saved)
    out[GOLDENS_MODULE] = goldens_module(runtime, rows)
    return out


def write_goldens():
    files = render_goldens()
    os.makedirs(GOLDEN_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(GOLDENS_MODULE), exist_ok=True)
    for path, text in files.items():
        with open(path, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
    for f in os.listdir(GOLDEN_DIR):
        if f.endswith(".txt") and os.path.join(GOLDEN_DIR, f) not in files:
            os.unlink(os.path.join(GOLDEN_DIR, f))
    print("goldens: {} files in {}".format(len(files) - 1, os.path.relpath(GOLDEN_DIR, REPO)))
    print("goldens module: {} goldens in {}".format(len(files) - 1, os.path.relpath(GOLDENS_MODULE, REPO)))


def check_goldens():
    """True when a golden or goldens.gen.ts differs from a fresh render (bytes), is missing,
    or a .txt in expected/ is no golden's."""
    files = render_goldens()
    bad = False
    for path, text in sorted(files.items()):
        rel = os.path.relpath(path, REPO)
        if not os.path.isfile(path):
            print("missing " + rel)
            bad = True
            continue
        with open(path, "rb") as f:
            if f.read() != text.encode("utf-8"):
                print("differs " + rel)
                bad = True
    if os.path.isdir(GOLDEN_DIR):
        for f in sorted(os.listdir(GOLDEN_DIR)):
            if f.endswith(".txt") and os.path.join(GOLDEN_DIR, f) not in files:
                print("stale " + os.path.relpath(os.path.join(GOLDEN_DIR, f), REPO))
                bad = True
    print("GOLDENS CHECK: " + ("FAIL (run tools/assemble --goldens)" if bad else "PASS ({} files)".format(len(files))))
    return bad


def goldens_module(runtime, rows):
    """plugin/tests/unit/_gen/goldens.gen.ts: the goldens for the TS half of BT-04 (the kit has no fs).

    Each golden is kept in parts split at the plugin name it was rendered with, so the module
    holds no name (the rename drill copies _gen unchanged) and a test joins the parts with the
    name it assembles for. ASCII escapes keep marker shapes out of the plain text of plugin/.
    """
    rt = {k: v for k, v in sorted(runtime.items())}
    return ("// GEN by tools/assemble --goldens from tests/fixtures/assembly (runtime.json, expected/).\n"
            "// Do not edit; edit the assets or runtime.json and run tools/assemble --goldens.\n"
            "// Each golden is split at the plugin name it was rendered with: join the parts with a name.\n\n"
            "export const GOLDEN_RUNTIME: Readonly<Record<string, string>> = "
            + json.dumps(rt, ensure_ascii=True, indent=1) + "\n\n"
            "export type Golden = { asset: string; tags: readonly string[]; parts: readonly string[] }\n\n"
            "export const GOLDENS: readonly Golden[] = " + json.dumps(rows, ensure_ascii=True, indent=1) + "\n")


def idle_return_line(text, fill):
    """ID-3: the [idle-return] lines alone (tag removed), as the mod delivers them on its own,
    with @idle_return@ filled; the line is never part of a resume block render (no TAGS entry)."""
    lines = [ln[len("[idle-return] "):] for ln in text.splitlines() if ln.startswith("[idle-return] ")]
    if not lines:
        return ""
    s = "\n".join(lines).strip() + "\n"
    return re.sub(r"@([a-z_]+)@", lambda m: fill if m.group(1) == "idle_return" else RUNTIME.get(m.group(1), m.group(0)), s)


