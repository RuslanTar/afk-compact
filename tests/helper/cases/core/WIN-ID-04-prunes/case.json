     {"path": "$ROOT/.sessions/loads/1791280800_33336-0_0.1.0_aaaaaaaa.json", "count": 1},
     {"path": "$ROOT/.sessions/loads/1791712800_22192-0_0.1.0_aaaaaaaa.json", "count": 1},
     {"path": "$ROOT/.sessions/loads/1791367200_22193-1792573200_0.1.0_aaaaaaaa.json", "count": 1},
