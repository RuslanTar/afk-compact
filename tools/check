    def build_out(d):
        """CR-F40/F44: every --out at, above or inside the repo (but tmp/<name>/), through a
        symlink or in other letter case, and an unmarked full folder elsewhere, is refused and
        nothing is deleted. CR-F41/F45: a variant from a tree that differs from HEAD is refused
        (exit 1 with VARIANT REFUSED); a clean one names its commit (exit 0)."""
        tool = os.path.join(d, "tools", "build")
        build = lambda *a: subprocess.run([tool] + list(a), cwd=d, capture_output=True, text=True)
        count = lambda: sum(len(f) for top in ("plugin", "src", "tools")
                            for _, _, f in os.walk(os.path.join(d, top)))
        link, other = d + "-link", d + "-other"
        for p in (link, other):
            if os.path.islink(p):
                os.unlink(p)
            elif os.path.lexists(p):
                shutil.rmtree(p)
        os.symlink(d, link)
        write_text(os.path.join(other, "keep.txt"), "user data\n")
        outs = ["plugin", "src", "plugin/helper", ".", "..", "tmp", "tmp/store-h-1-ab", os.path.join(link, "src"), link, other]
        if d.upper() != d and same_dir(d.upper(), d):
            outs += [d.upper(), os.path.join(d.upper(), "plugin")]
        before, msgs, bad = count(), [], []
        for o in outs:
            for args in (["--variant", "skills-only", "--allow-dirty"], ["--name", "zz-drill"]):
                r = build(*(args + ["--out", o]))
                if r.returncode != 2 or "build: --out" not in r.stderr:
                    bad.append("not refused: --out {} {} (exit {})".format(o, " ".join(args), r.returncode))
        if count() != before or not os.path.isfile(os.path.join(other, "keep.txt")):
            bad.append("files were deleted")
        os.unlink(link)
        shutil.rmtree(other)
        r = build("--variant", "skills-only", "--out", "tmp/variant")
        if r.returncode == 0 and re.search(r"^tree sha256 [0-9a-f]{64} skills-only commit [0-9a-f]{40}$", r.stdout, re.M):
            msgs.append("VARIANT BUILT from a commit")
            code = 0
        elif r.returncode == 2 and "differ from HEAD" in r.stderr:
            u = build("--variant", "skills-only", "--out", "tmp/variant", "--allow-dirty")
            if u.returncode != 0 or " UNVERIFIED (" not in u.stdout:
                bad.append("--allow-dirty: exit {} {}".format(u.returncode, u.stdout[-300:]))
            msgs.append("VARIANT REFUSED: " + r.stderr.strip()[-300:])
            code = 1
        else:
            bad.append("variant build: exit {} {}{}".format(r.returncode, r.stdout[-300:], r.stderr[-300:]))
        if bad:
            return 2, "\n".join(bad) + "\n"
        return code, "\n".join(msgs) + "\n"

