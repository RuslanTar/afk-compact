#!/usr/bin/python3
"""tools/fixtures-gen: tests/fixtures -> plugin/tests/unit/_gen/*.gen.ts, and the fixture checks.

Usage:
  tools/fixtures-gen                 the regenerate step (BUILD-PLAN §4.3, §4.6): refresh the
                                     brand-dependent normalized_sha256 column of
                                     summaries/expected.tsv (written only when a value changed),
                                     then write plugin/tests/unit/_gen/{corpus,payloads,brand}.gen.ts
  tools/fixtures-gen --out DIR       write the same three files under DIR/plugin/tests/unit/_gen/
                                     (sha column refreshed in memory; the repo is not written)
  tools/fixtures-gen --check         fixture checks (below) plus drift: the three files on disk
                                     must equal a fresh render; exit 1 on any problem
  tools/fixtures-gen --clean         remove the three generated files (nothing else)
  tools/fixtures-gen --print-expected
                                     print summaries/expected.tsv as the reference detector
                                     computes it (authoring aid; never writes)
  tools/fixtures-gen --refresh-sha   only the sha-column refresh of the regenerate step

Checks run by --check (BUILD-PLAN §4.2, WP-fix exit list):
  parse     every *.json under tests/fixtures parses; every *.jsonl line parses
  expected  summaries/expected.tsv equals the reference detector (MOD-SPEC §5.1) on every file
  secrets   no file under tests/fixtures, tools/fixtures-gen or the generated output holds a
            secret-shaped string; every secrets/corpus.json entry hits its declared class once
            its fragments are joined, and no single fragment hits anything
  drift     the generated files are current
  sequences every sequences/<id>/ replays: files exist, payloads match their step, the main
            transcript after each step's appends holds the declared transcript_state, and with
            "order": "S-21" SessionStart(compact) and PostCompact see no boundary row newer than
            PreCompact (lab S-21: the row lands after PostCompact)
  scope     transcripts/scope-cases.json: expect_scope (at reconcile, every proof) and
            expect_scope_postcompact (inside SessionStart(compact)/PostCompact, no P3; F2-1)
            equal the MOD-SPEC §2.4 rule computed from each row's dispatch, summary and transcripts
  queue     a JSON queue/<case>/list.out has the queue-stub/v1 shape (ROOT-RULINGS F2-8)
  stamps    RV-24: no short time (HH:MM, MM-DD HH:MM, a date and time without the offset) in any
            fixture text, except the files listed in LEGACY_TIME_OK, which test the legacy
            reading and must still hold one (a stale list entry fails too)
  rename a temp copy renamed to another brand passes --check after the plain regenerate
            step alone (BUILD-PLAN §4.6; skipped inside the drill, FIXTURES_GEN_NO_DRILL=1)

Placeholders (tests/fixtures/README.md): `{{plugin}}` and `{{marketplace}}` are filled from
brand.json; `$TMP`, `$HOME`, `$WATCH`, `$ROOT`, `$SID` stay for the case runner;
`$SECRET{<id>}` is filled from secrets/corpus.json by the case runner only. Files that hold a
`$SECRET{` token are left out of the generated modules (no secret corpus in U fixtures).

Secret rules: the `secret_rules` (id, class, re) of the spec-literals block in
src/assets/handoff-spec.md when that file exists (BUILD-PLAN §3.4), else the provisional
built-in set below, written from MOD-SPEC §10 and the handoff template §5. The file-name
deny list is always the built-in one below: the spec's `deny_names` is not read yet.
"""
import datetime, hashlib, json, math, os, re, shutil, subprocess, sys, tempfile

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
FIX = os.path.join(REPO, "tests", "fixtures")
GEN_REL = os.path.join("plugin", "tests", "unit", "_gen")
GEN_FILES = ("brand.gen.ts", "corpus.gen.ts", "payloads.gen.ts")
SUMMARIES = os.path.join(FIX, "summaries")
EXPECTED = os.path.join(SUMMARIES, "expected.tsv")
PAYLOADS = os.path.join(FIX, "payloads")
SEQUENCES = os.path.join(FIX, "sequences")
SECRET_MARK = "$SECRET{"
COLUMNS = ["file", "verdict", "marker_line", "sentinel_from_end", "nonce", "scope",
           "normalized_sha256", "dispatch"]
SKIP_DIRS = {".git", "node_modules", ".types", "__pycache__"}
# jsonl lines that are malformed on purpose (WATCH T-16: the sweeper must survive them)
INTENDED_MALFORMED = {"tests/fixtures/transcripts/T-16/main.jsonl": {5}}


def die(msg):
    print("fixtures-gen: " + msg, file=sys.stderr)
    sys.exit(2)


def brand():
    with open(os.path.join(REPO, "brand.json"), encoding="utf-8") as f:
        return json.load(f)


def fill(text, b):
    return text.replace("{{plugin}}", b["name"]).replace("{{marketplace}}", b["marketplace"])


def read(path):
    with open(path, encoding="utf-8", newline="") as f:
        return f.read()


# ---------------------------------------------------------------- reference detector (MOD §5.1)

def normalize(text):
    """Normalized body: wrapper parts stripped from the head, cut at </summary>, \\n line ends.

    Head (repeated until none applies, blank lines between parts dropped): a line starting
    `This session is being continued`; a `<tools-used-before-summary>` block through its closing
    tag; a `Summary:` line; a `<summary>` tag (text after the tag on the same line is body).
    Tail: the body ends before the first line holding `</summary>` (text before the tag on that
    line is body). Trailing blank lines are trimmed. Result: lines joined by \\n plus one final
    \\n, or the empty string for an empty body.
    """
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    i = 0
    while i < len(lines):
        s = lines[i].strip()
        if s == "":
            i += 1
        elif lines[i].startswith("This session is being continued"):
            i += 1
        elif s.startswith("<tools-used-before-summary>"):
            while i < len(lines) and "</tools-used-before-summary>" not in lines[i]:
                i += 1
            i += 1
        elif s == "Summary:":
            i += 1
        elif lines[i].startswith("<summary>"):
            rest = lines[i][len("<summary>"):]
            if rest.strip():
                lines[i] = rest
                break
            i += 1
        else:
            break
    body = []
    for line in lines[i:]:
        if "</summary>" in line:
            head = line[:line.index("</summary>")]
            if head.strip():
                body.append(head)
            break
        body.append(line)
    while body and not body[-1].strip():
        body.pop()
    return "\n".join(body) + "\n" if body else ""


def detect(text, name, dispatch=None):
    """(verdict, marker_line, sentinel_from_end, nonce, scope, sha256) per MOD §5.1.

    dispatch: None = text alone; "none" = a PostCompact with no dispatch at all; else the
    dispatch record (dict) of this compaction.
    """
    body = normalize(text)
    lines = body.split("\n")[:-1] if body else []
    marker_re = re.compile(r"^⟪" + re.escape(name) + r" v1 n=([0-9a-f]{8}) s=(main|sub|manual)⟫$")
    sentinel_re = re.compile(r"^⟪/" + re.escape(name) + r" n=([0-9a-f]{8})⟫$")
    marker_line = nonce = scope = None
    for idx, line in enumerate(lines[:5]):
        m = marker_re.match(line)
        if m:
            marker_line, nonce, scope = idx + 1, m.group(1), m.group(2)
            break
    nonblank = [ln for ln in lines if ln.strip()]
    sfe = s_nonce = None
    for k in range(1, min(3, len(nonblank)) + 1):
        m = sentinel_re.match(nonblank[-k])
        if m:
            sfe, s_nonce = k, m.group(1)
            break
    resume_heading = any(ln.startswith("## Resume here") for ln in lines)
    verdict = None
    if dispatch is not None:
        if dispatch == "none":
            if nonce:
                verdict = "stale"
        else:
            # P1 of MOD §2.4: sub = agent_id set; main = agent_id null and a mod channel.
            # A classic dispatch (actor unknown) proves neither scope.
            sub = dispatch.get("agent_id") is not None
            main = not sub and dispatch.get("channel") in ("mod-hook", "mod-self")
            if nonce and nonce != dispatch["nonce"]:
                verdict = "stale"
            elif sub and (scope == "main" or resume_heading):
                verdict = "scope-leak"
            elif main and scope == "sub":
                verdict = "scope-leak"
    if verdict is None:
        if not nonce:
            verdict = "unshaped"
        elif sfe is None or s_nonce != nonce:
            verdict = "truncated"
        elif sfe > 1:
            verdict = "ok-trailer"
        else:
            verdict = "ok"
    sha = hashlib.sha256(body.encode("utf-8")).hexdigest()
    return verdict, marker_line, sfe, nonce, scope, sha


def summary_files():
    return sorted(f for f in os.listdir(SUMMARIES) if f.endswith(".txt"))


def load_dispatch(ref):
    if ref in ("", None):
        return None
    if ref == "none":
        return "none"
    with open(os.path.join(FIX, ref), encoding="utf-8") as f:
        return json.load(f)


def read_expected(path=EXPECTED):
    rows = []
    with open(path, encoding="utf-8") as f:
        header = f.readline().rstrip("\n").split("\t")
        if header != COLUMNS:
            die("expected.tsv header is {}, want {}".format(header, COLUMNS))
        for line in f:
            line = line.rstrip("\n")
            if line:
                parts = line.split("\t")
                parts += [""] * (len(COLUMNS) - len(parts))
                rows.append(dict(zip(COLUMNS, parts)))
    return rows


def dash(v):
    return "-" if v is None else str(v)


def expected_rows(b, dispatch_refs):
    out = []
    for f in summary_files():
        ref = dispatch_refs.get(f, "")
        v, ml, sfe, n, sc, sha = detect(fill(read(os.path.join(SUMMARIES, f)), b), b["name"],
                                        load_dispatch(ref))
        out.append({"file": f, "verdict": v, "marker_line": dash(ml), "sentinel_from_end": dash(sfe),
                    "nonce": dash(n), "scope": dash(sc), "normalized_sha256": sha, "dispatch": ref})
    return out


def tsv(rows):
    return "\t".join(COLUMNS) + "\n" + "".join("\t".join(r[c] for c in COLUMNS) + "\n" for r in rows)


def sha_refreshed(b):
    """(rows of expected.tsv with normalized_sha256 recomputed for brand b, number changed).

    Only the sha column is touched: it is a function of the text and the brand alone, so a
    rename changes it (README "Corpus"). The other columns stay as authored for --check.
    """
    rows = read_expected()
    fresh = {r["file"]: r for r in expected_rows(b, {r["file"]: r["dispatch"] for r in rows})}
    changed = 0
    for r in rows:
        f = fresh.get(r["file"])
        if f and f["normalized_sha256"] != r["normalized_sha256"]:
            r["normalized_sha256"] = f["normalized_sha256"]
            changed += 1
    return rows, changed


def refresh_sha(b):
    rows, changed = sha_refreshed(b)
    if changed:
        with open(EXPECTED, "w", encoding="utf-8", newline="\n") as f:
            f.write(tsv(rows))
        print("fixtures-gen: refreshed normalized_sha256 for {} rows of {} (brand {})".format(
            changed, os.path.relpath(EXPECTED, REPO), b["name"]))
    return changed


# ---------------------------------------------------------------- secret rules

BUILTIN_RULES = [
