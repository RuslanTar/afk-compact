def pending_row(gate, rule, rel, line):
    for row in PENDING:
        g, r, p, frag = row
        if g == gate and r == rule and p == rel and (frag is None or frag in line):
            return row
    return None


def npm_paths(target):
    """BT-06: npm manifests, lock files and node_modules folders inside a folder target."""
    if not os.path.isdir(target):
        return
    for d, dirs, files in os.walk(target):
        for x in sorted(dirs):
            if x in NPM_DIRS:
                yield os.path.join(d, x)
        dirs[:] = sorted(x for x in dirs if x not in NPM_DIRS and x != ".git")
        for f in sorted(files):
            if f in NPM_FILES:
                yield os.path.join(d, f)


def die(msg):
    print("gates: " + msg, file=sys.stderr)
    sys.exit(2)


def files_of(target):
    if os.path.isfile(target):
        yield target
        return
    for d, dirs, files in os.walk(target):
        dirs[:] = sorted(x for x in dirs if x not in SKIP_DIRS and
                         not (x == "types" and os.path.basename(d) == ".claude-plugin"))
        for f in sorted(files):
            yield os.path.join(d, f)


def text_of(path):
    with open(path, "rb") as f:
        data = f.read()
    if b"\0" in data[:8192]:
        return None
    return data.decode("utf-8", errors="replace")


def load_names(path):
    names = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                names.append(line)
    return names


def main(argv):
    names_file = None
    brand = None
    git_log = True
    use_pending = True
    only = None
    targets = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--names" and i + 1 < len(argv):
            names_file = argv[i + 1]
            i += 1
        elif a == "--brand" and i + 1 < len(argv):
            brand = argv[i + 1]
            i += 1
        elif a == "--only" and i + 1 < len(argv):
            only = argv[i + 1]
            i += 1
        elif a == "--no-git-log":
            git_log = False
        elif a == "--no-pending":
            use_pending = False
        elif a.startswith("--"):
            die("unknown flag " + a + "\n" + __doc__)
        else:
            targets.append(a)
        i += 1
    if not targets:
        die("no target\n" + __doc__)
    hits = []

    def hit(gate, where, text):
        hits.append((gate, where, text))

    if not names_file or not os.path.isfile(names_file):
        hit("names", names_file or "--names", "competitor-name list missing (E-7)")
        names = []
    else:
        names = load_names(names_file)
        if not names:
            hit("names", names_file, "competitor-name list is empty")
    if brand is None:
        with open(os.path.join(REPO, "brand.json"), encoding="utf-8") as f:
            brand = json.load(f)["name"]

    name_res = [(n, re.compile(B + re.escape(n) + E, re.I)) for n in names]
    user_res = [("/Users/", re.compile(r"/Users/")), ("/home/", re.compile(r"/home/"))]
    login = getpass.getuser()
    if login:
        user_res.append(("login", re.compile(B + re.escape(login) + E)))
    email = subprocess.run(["git", "-C", REPO, "config", "user.email"], capture_output=True, text=True).stdout.strip()
    if email:
        user_res.append(("email", re.compile(re.escape(email), re.I)))
    common = subprocess.run(["git", "-C", REPO, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    main_repo = os.path.dirname(common) if common else REPO
    parent = os.path.basename(os.path.dirname(main_repo))
    if parent:
        user_res.append(("projects folder", re.compile(B + re.escape(parent) + E)))
    # Other candidate names are substrings: a trailing letter, digit or `-` must not hide them.
    other_res = [(n, re.compile(re.escape(n), re.I)) for n in OTHER_NAMES]

    count = 0
    for target in targets:
        if not os.path.exists(target):
            hit("target", target, "missing")
            continue
        for path in npm_paths(target):
            shown = os.path.relpath(path) + ("/" if os.path.isdir(path) else "")
            hit("npm", shown, "BT-06: no npm manifest or node_modules inside the plugin")
        if os.path.isdir(target):
            for where, text in skill_desc_hits(target):
                hit("skill-desc", where, text)
        for path in files_of(target):
            text = text_of(path)
            if text is None:
                continue
            count += 1
            rel = os.path.relpath(path)
            for no, line in enumerate(text.splitlines(), 1):
                where = "{}:{}".format(rel, no)
                for n, rx in name_res:
                    if rx.search(line):
                        hit("names", where, n)
                for label, rx in user_res:
                    if rx.search(line):
                        hit("user-path", where, label)
                if MARKERS.search(line):
                    hit("markers", where, MARKERS.search(line).group(0))
                m = ATTRIBUTION.search(line)
                if m:
                    hit("attribution", where, m.group(0))
                for rx in NAME_SHAPES:
                    for m in rx.finditer(line):
                        if m.group(1) != brand:
                            hit("stale-name", where, m.group(0))
                for n, rx in other_res:
                    if rx.search(line):
                        hit("stale-name", where, n)
            base = os.path.basename(path)
            if base in ("plugin.json", "marketplace.json") and os.path.basename(os.path.dirname(path)) == ".claude-plugin":
                try:
                    doc = json.loads(text)
                except ValueError:
                    hit("stale-name", rel, "not valid JSON")
                    continue
                found = [doc.get("name")] if base == "plugin.json" else [p.get("name") for p in doc.get("plugins", [])]
                for n in found:
                    if n != brand:
                        hit("stale-name", rel, '"name": {}'.format(json.dumps(n)))

    pending, used, applicable = [], set(), set()
    for target in targets:
        if not os.path.exists(target):
            continue
        base = os.path.abspath(target if os.path.isdir(target) else os.path.dirname(os.path.abspath(target)))
        for gate, fn in TEXT_GATES:
            if only and only != gate:
                continue
            if os.path.isdir(target):
                applicable |= {row for row in PENDING if row[0] == gate and os.path.exists(os.path.join(target, row[2]))}
            if gate != "wait-text" and not os.path.isdir(target):
                continue
            for path, no, rule, text, line in fn(target, brand):
                where = os.path.relpath(path) + (":{}".format(no) if no else "")
                row = pending_row(gate, rule, os.path.relpath(os.path.abspath(path), base), line) if use_pending else None
                if row:
                    used.add(row)
                    pending.append((gate, where, text))
                else:
                    hit(gate, where, text)

    if git_log:
        r = subprocess.run(["git", "-C", REPO, "log", "--format=%H%n%B"], capture_output=True, text=True)
        sha = None
        for line in r.stdout.splitlines():
            if re.fullmatch(r"[0-9a-f]{40}", line):
                sha = line[:10]
                continue
            m = ATTRIBUTION.search(line)
            if m:
                hit("attribution", "commit " + str(sha), m.group(0))

    if only:
        hits = [h for h in hits if h[0] in (only, "target")]
    for gate, where, text in hits:
        print("GATE {} {}: {}".format(gate, where, text))
    for gate, where, text in pending:
        print("PENDING {} {}: {}".format(gate, where, text))
    if use_pending:
        for row in PENDING:
            if row in applicable and row not in used:
                print("PENDING-DONE {} {} {}: no hit left; remove the row from PENDING".format(row[0], row[2], row[1]))
    print("GATES: {} ({} files, {} names, brand {}, {} hits, {} pending)".format(
        "FAIL" if hits else "PASS", count, len(names), brand, len(hits), len(pending)))
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
