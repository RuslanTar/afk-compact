    sc = Scenario(b)
    try:
        repo = sc.tmp + "/r"
        sc.run({"repo": {"commits": [{"files": {"README.md": "seed\n"}, "msg": "seed"},
                                     {"files": {"src/a.rb": "x = 1\n", ".netrc": "fixture netrc line\n"}, "msg": "both"}]},
                "at": repo})
        args = ["format-patch", "--stdout", "--no-renames", "-1", "HEAD", "--", ".", ":(top,literal,exclude).netrc"]
        real = numstat_paths(sc, repo, sc.env(), args)
        if real != ["src/a.rb"]:
            problems.append("stubs: the real git does not honour ':(top,literal,exclude)' with --no-renames here: numstat {}".format(real))
        bindir = sc.tmp + "/stubbin"
        os.makedirs(bindir)
        os.symlink(stub, bindir + "/git")
        log = sc.tmp + "/noexclude.log"
        env = dict(sc.env(), PATH=bindir + os.pathsep + sc.env()["PATH"], GIT_NOEXCLUDE_LOG=log)
        stubbed = numstat_paths(sc, repo, env, args)
