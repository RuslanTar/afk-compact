     "^withheld - - - \\S+/clone#[0-9a-f]{8}:app\\.sqlite$",
     "^withheld - - - \\S+/clone#[0-9a-f]{8}:\\.netrc$",
     "^withheld - \\d+ [0-9a-f]{8} \\S+/clone#[0-9a-f]{8}$",
     "^copied $ROOT/repo/LAB-7/evidence/$STEM/0004-[0-9a-f]{8}\\.patch \\d+ [0-9a-f]{8} \\S+/clone#[0-9a-f]{8}$",
     "^withheld - - - \\S+/clone#uncommitted:app\\.sqlite$",
     "^Volatile: \\S+/clone#[0-9a-f]{8}:app\\.sqlite — withheld by the secret gate \\(deny-name\\)$",
     "^Volatile: \\S+/clone#[0-9a-f]{8}:\\.netrc — withheld by the secret gate \\(deny-name\\)$",
     "^Volatile: \\S+/clone#[0-9a-f]{8} — withheld by the secret gate \\(github-token[^)]*\\)$",
     "^Volatile: \\S+/clone#uncommitted:app\\.sqlite — withheld by the secret gate \\(deny-name\\)$"
    ],
    "stdout_lacks": [
     "^copied \\S+/000[23]-",
     "^\\S+ \\S+/0002-",
     "^\\S+ \\S+/0001-[0-9a-f]{8}\\.patch ",
     "^\\S+ \\S+/uncommitted",
     "^redacted ",
     "^withheld - \\S+ \\S+ \\S+/clone#uncommitted$"
    ],
    "grep_absent": [
     {
      "dir": "$ROOT",
      "text": "RRP01-NETRC-CANARY"
     },
     {
      "dir": "$ROOT",
      "text": "RRP01-SQLITE-CANARY"
     },
     {
      "dir": "$ROOT",
      "text": "$SECRET{github-token}"
     },
     {
      "dir": "$DISP",
