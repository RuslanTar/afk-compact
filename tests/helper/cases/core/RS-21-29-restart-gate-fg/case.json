{
 "id": "AT-RS-21, AT-RS-23, AT-RS-27, AT-RS-28, AT-RS-29, AT-RS-19 (helper part), AT-RS-24 (SESSION-RESTART §3.4, §3.5, §4.1, §5.2)",
 "note": "The terminal route's gate, arm, state change and claim against the launcher's file contract (protocol 1). A main Stop keeps the turn's permission mode, effort and transcript; a main PostCompact the fresh mode with its time (D10). The gate: no launch folder (no-launcher); a relative, linked, wrongly named or not private folder, launcher.json missing or of another protocol or token, its pid not an ancestor of this claude (a fake process table) or another claude between them (nested), the folder bound to another session (launcher-invalid:<reason>); the fresh mode older than the compaction (mode-unknown) or not the Stop's (mode-changed); bypass the launch did not make available, a launch file gone, three relaunches in the hour (G3a); a transcript not named <sid>.jsonl; a release on hold or a hold that cannot be read (G5b); and the RS-P1 ship gate (fg-not-shipped) unless the test seam opens it. arm binds the folder (sid, O_EXCL) and writes the launch note (12 keys) and the carry note; set moves both, the launch note keeping its form; claim takes the carry note only with restart.used holding its nonce and session, once",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "options": {"restart_on_update": "on"},
 "env": {"STORE_TEST_PROC": "$TMP/proc.txt", "STORE_TEST_CLAUDE_PID": "4242:Tue Oct 21 09:00:00 2026"},
 "steps": [
  {"setup": [
    {"write": "$TMP/proc.txt", "content": "4242 1 /opt/cc/claude/versions/2.1.311\n"},
    {"mkdir": "$TMP/rt", "mode": "0700"},
    {"mkdir": "$TMP/rt/L-0123456789abcdef", "mode": "0700"},
    {"write": "$TMP/rt/L-0123456789abcdef/launcher.json", "content": "{\"proto\":1,\"launcher_version\":\"0.1.2\",\"pid\":1,\"token\":\"0123456789abcdef\",\"started\":1792580000,\"cwd\":\"/w\",\"uname\":\"Darwin\",\"relaunches\":0,\"bypass_ok\":false,\"file_flags\":[\"$TMP/s.json\"],\"stamps\":\"stamps\"}\n"},
    {"write": "$TMP/s.json", "content": "{}\n"},
    {"write": "$TMP/proj/$SID.jsonl", "content": "{\"type\":\"user\"}\n"},
    {"write": "$HOME/.claude.json", "json": {"cachedGrowthBookFeatures": {"tengu_max_version_config": {}}}}
  ]},
  {"name": "no fresh mode yet: mode-unknown", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--model", "opus", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": false, "why": "mode-unknown", "token": "0123456789abcdef"}}},
  {"name": "a main Stop", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false,
                  "permission_mode": "default", "effort": {"level": "high"}, "background_tasks": [], "session_crons": []},
   "expect": {"exit": 0, "files": [{"path": "$WATCH/$SID/restart-mode.json", "mode": "0600", "json": {"stop_mode": "default", "stop_effort": "high"}}]}},
  {"name": "a subagent's PostCompact is not the fresh mode", "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto", "agent_id": "a1", "permission_mode": "plan", "compact_summary": "x"},
   "expect": {"exit": 0, "files": [{"path": "$WATCH/$SID/restart-mode.json", "has": ["\"post_mode\":null", "\"stop_mode\":\"default\""]}]}},
  {"name": "the main PostCompact", "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto", "permission_mode": "default", "compact_summary": "x"},
   "expect": {"exit": 0, "files": [{"path": "$WATCH/$SID/restart-mode.json", "json": {"post_mode": "default", "post_at": 1792580712000}}]}},
  {"name": "every gate passes but the RS-P1 ship gate", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--model", "opus", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": false, "why": "fg-not-shipped", "mode": "default", "effort": "high"}}},
  {"name": "with the ship gate open: ok", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--model", "opus", "--since", "1792580712000"],
   "env": {"STORE_TEST_RESTART_FG": "1"},
   "expect": {"exit": 0, "json": {"ok": true, "why": {"null": true}, "route": "fg", "mode": "default", "effort": "high", "token": "0123456789abcdef"}}},
  {"name": "a compaction later than the PostCompact: mode-unknown", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580760000"],
   "expect": {"exit": 0, "json": {"why": "mode-unknown"}}},
  {"name": "no launch folder: no-launcher", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "no-launcher"}}},
  {"name": "a relative folder", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:relative"}}},
  {"setup": [
    {"symlink": "$TMP/rt/L-1111111111111111", "to": "$TMP/rt/L-0123456789abcdef"},
    {"mkdir": "$TMP/rt/L-2222222222222222", "mode": "0755"},
    {"mkdir": "$TMP/rt/L-3333333333333333", "mode": "0700"},
    {"write": "$TMP/rt/L-3333333333333333/launcher.json", "content": "{\"proto\":1,\"pid\":1,\"token\":\"0123456789abcdef\",\"bypass_ok\":false,\"file_flags\":[]}\n"},
    {"mkdir": "$TMP/rt/L-4444444444444444", "mode": "0700"},
    {"write": "$TMP/rt/L-4444444444444444/launcher.json", "content": "{\"proto\":2,\"pid\":1,\"token\":\"4444444444444444\",\"bypass_ok\":false,\"file_flags\":[]}\n"},
    {"mkdir": "$TMP/rt/L-5555555555555555", "mode": "0700"},
    {"mkdir": "$TMP/rt/x", "mode": "0700"}
  ]},
  {"name": "a symlinked folder", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-1111111111111111", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:symlink"}}},
  {"name": "a folder not 0700", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-2222222222222222", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:mode"}}},
  {"name": "a token other than the folder's name", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-3333333333333333", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:token"}}},
  {"name": "another protocol", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-4444444444444444", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:proto"}}},
  {"name": "no launcher.json", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-5555555555555555", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:no-launcher-json"}}},
  {"name": "a folder not named L-<token>", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/x", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-invalid:name"}}},
  {"setup": [{"write": "$TMP/proc2.txt", "content": "4242 300 /bin/bash\n300 200 /opt/cc/claude/versions/2.1.311\n200 1 /bin/sh\n"}]},
  {"name": "launcher, claude A, bash, claude B: nested", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "env": {"STORE_TEST_PROC": "$TMP/proc2.txt"}, "expect": {"exit": 0, "json": {"why": "launcher-invalid:nested"}}},
  {"setup": [{"write": "$TMP/proc3.txt", "content": "4242 300 node\n300 1 teamclaude\n"}]},
  {"name": "a teamclaude or node wrapper between the launcher and claude: ok", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "env": {"STORE_TEST_PROC": "$TMP/proc3.txt", "STORE_TEST_RESTART_FG": "1"}, "expect": {"exit": 0, "json": {"ok": true}}},
  {"setup": [{"write": "$TMP/proc4.txt", "content": "4242 77 /bin/zsh\n77 66 /bin/zsh\n66 0 launchd\n"}]},
  {"name": "a live launcher that is not an ancestor", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "env": {"STORE_TEST_PROC": "$TMP/proc4.txt"}, "expect": {"exit": 0, "json": {"why": "launcher-invalid:not-ancestor"}}},
  {"setup": [{"write": "$HOME/.claude.json", "json": {"cachedGrowthBookFeatures": {"tengu_max_version_config": {"external": "2.1.311"}}}}]},
  {"name": "2.1.312 above the hold 2.1.311: on-hold", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "on-hold"}}},
  {"name": "a target equal to the hold passes", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.310", "--to", "2.1.311", "--since", "1792580712000"],
   "env": {"STORE_TEST_RESTART_FG": "1"}, "expect": {"exit": 0, "json": {"ok": true}}},
  {"setup": [{"write": "$HOME/.claude.json", "content": "{not json"}]},
  {"name": "an unreadable cache: version-unknown", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "version-unknown"}}},
  {"setup": [{"write": "$HOME/.claude.json", "json": {"cachedGrowthBookFeatures": {}}}, {"write": "$TMP/rt/L-0123456789abcdef/stamps", "content": "1792580100\n1792580200\n1792580300\n"}]},
  {"name": "three relaunches in the hour: launcher-cap", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launcher-cap"}}},
  {"setup": [{"write": "$TMP/rt/L-0123456789abcdef/stamps", "content": "1792570000\n1792580300\n"}, {"write": "$TMP/rt/L-0123456789abcdef/launcher.json", "content": "{\"proto\":1,\"launcher_version\":\"0.1.2\",\"pid\":1,\"token\":\"0123456789abcdef\",\"started\":1792580000,\"cwd\":\"/w\",\"uname\":\"Darwin\",\"relaunches\":0,\"bypass_ok\":false,\"file_flags\":[\"$TMP/gone.json\"],\"stamps\":\"stamps\"}\n"}]},
  {"name": "a launch file that is gone: launch-file", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "launch-file"}}},
  {"setup": [{"write": "$TMP/rt/L-0123456789abcdef/launcher.json", "content": "{\"proto\":1,\"launcher_version\":\"0.1.2\",\"pid\":1,\"token\":\"0123456789abcdef\",\"started\":1792580000,\"cwd\":\"/w\",\"uname\":\"Darwin\",\"relaunches\":0,\"bypass_ok\":false,\"file_flags\":[\"$TMP/s.json\"],\"stamps\":\"stamps\"}\n"}]},
  {"name": "a model outside the launcher's pattern: note-pattern", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--model", "opus $(id)", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "note-pattern"}}},
  {"name": "PostCompact in bypass after a Stop in bypass", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "bypassPermissions"},
   "expect": {"exit": 0}},
  {"name": "(the PostCompact)", "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto", "permission_mode": "bypassPermissions", "compact_summary": "x"},
   "expect": {"exit": 0}},
  {"name": "bypass the launch did not make available: bypass-not-available", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "bypass-not-available", "mode": "bypassPermissions"}}},
  {"name": "Shift+Tab after the last Stop: the PostCompact says plan", "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto", "permission_mode": "plan", "compact_summary": "x"},
   "expect": {"exit": 0}},
  {"name": "mode-changed", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "mode-changed"}}},
  {"name": "(back to default: a Stop)", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/other.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "default"},
   "expect": {"exit": 0}},
  {"name": "(and a PostCompact)", "argv": ["hook", "PostCompact"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/other.jsonl", "cwd": "$TMP", "hook_event_name": "PostCompact", "trigger": "auto", "permission_mode": "default", "compact_summary": "x"},
   "expect": {"exit": 0}},
  {"name": "a transcript not named <sid>.jsonl: transcript", "argv": ["restart", "gate", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--from", "2.1.311", "--to", "2.1.312", "--since", "1792580712000"],
   "expect": {"exit": 0, "json": {"why": "transcript"}}},
  {"name": "(the transcript back)", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "default", "effort": {"level": "high"}},
   "expect": {"exit": 0}},
  {"name": "arm: binds the folder, writes the launch note (12 keys, 0600) and the carry note", "argv": ["restart", "arm", "--sid", "$SID", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--nonce", "00112233445566ff", "--from", "2.1.311", "--to", "2.1.312", "--continue", "1", "--mode", "default", "--effort", "high", "--model", "opus", "--load-id", "abcd1234", "--now-ms", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": true, "token": "0123456789abcdef"},
              "files": [{"path": "$TMP/rt/L-0123456789abcdef/sid", "mode": "0600", "has": ["^$SID$"]},
                        {"path": "$TMP/rt/L-0123456789abcdef/restart.note", "mode": "0600",
                         "has": ["\\Aproto=1\\nstate=armed\\ntoken=0123456789abcdef\\nsid=$SID\\nnonce=00112233445566ff\\nat=1792580712\\nexiting_at=\\nfrom=2\\.1\\.311\\nto=2\\.1\\.312\\nmodel=opus\\neffort=high\\nmode=default\\n\\z"]},
                        {"path": "$WATCH/$SID/restart.json", "mode": "0600", "json": {"route": "fg", "state": "armed", "nonce": "00112233445566ff", "continue": true, "launch_token": "0123456789abcdef", "at": 1792580712000}}],
              "absent": ["$TMP/rt/L-0123456789abcdef/restart.note.tmp"]}},
  {"name": "another session's arm in the same folder: other-session", "argv": ["restart", "arm", "--sid", "11111111-2222-4333-8444-000000000000", "--route", "fg", "--launch", "$TMP/rt/L-0123456789abcdef", "--nonce", "00112233445566aa", "--from", "2.1.311", "--to", "2.1.312", "--continue", "0", "--mode", "default", "--now-ms", "1792580712000"],
   "expect": {"exit": 0, "json": {"ok": false, "why": "launcher-invalid:other-session"}}},
