def skill_desc_hits(target):
    """BT-09 over <target>/skills/*/SKILL.md: (where, text) for each broken rule."""
    out = []
    sk = os.path.join(target, "skills")
    if not os.path.isdir(sk):
        return out
    for name in sorted(os.listdir(sk)):
        path = os.path.join(sk, name, "SKILL.md")
        if not os.path.isfile(path):
            continue
        rel = os.path.relpath(path)
        with open(path, "rb") as f:
            data = f.read()
        if not data.startswith(b"---\n"):
            out.append((rel + ":1", "BT-09: SKILL.md does not start with ---\\n"))
            continue
        lines = data.decode("utf-8", errors="replace").split("\n")
        end = next((i for i in range(1, len(lines)) if lines[i] == "---"), None)
        desc = None
        for i in range(1, end or len(lines)):
            m = re.match(r"description:[ \t]*(.*)$", lines[i])
            if m:
                desc, no = m.group(1).strip(), i + 1
                break
        if end is None or desc is None:
            out.append((rel + ":1", "BT-09: no frontmatter description"))
            continue
        if len(desc) >= 2 and desc[0] == desc[-1] and desc[0] in "'\"":
            q = desc[0]
            desc = desc[1:-1].replace("''", "'") if q == "'" else desc[1:-1]
        where = "{}:{}".format(rel, no)
        if len(desc) > DESC_MAX:
            out.append((where, "BT-09: description {} chars > {}".format(len(desc), DESC_MAX)))
        trig = SKILL_TRIGGERS.get(name)
        if trig is None:
            out.append((where, "BT-09: no trigger phrase known for skill {}".format(name)))
        elif trig.lower() not in desc[:TRIGGER_WITHIN].lower():
            out.append((where, "BT-09: trigger {!r} not in the first {} chars".format(trig, TRIGGER_WITHIN)))
    return out


COMMENT = re.compile(r"[ \t]*<!--.*?-->", re.S)   # tools/build strips these before shipping
BLOCKING_READ = re.compile(r"\bblocking (?:[\w-]+ )?read\b", re.I)
NOTIFICATION_WAIT = re.compile(r"\bwait(?:s|ing)? (?:for|on) (?:(?:a|an|the|its|your|their) )?(?:[\w-]+ ){0,3}"
                               r"notifications?\b", re.I)
BARE_SLEEP = re.compile(r"(?i:\bsleep)\s+(?:\d|N\b|<[a-z_-]+>)")
FOREGROUND_WAIT = re.compile(r"\b(?:wait(?:s|ing)? in the foreground|foreground wait|bounded wait|"
                             r"block on it in the foreground)\b", re.I)
NEGATION = re.compile(r"\b(?:never|not|no)\b", re.I)
# CR-F43: a negation in another clause does not negate the match. A new clause starts after
# `.`, `;`, `:`, or `then`/`but`/`otherwise`/`else`; a leading subordinate clause ("If the job
# has not finished yet,", "When no notification arrived,") is dropped up to its comma.
CLAUSE_START = re.compile(r"[.;:]|\b(?:then|but|otherwise|else)\b", re.I)
SUBCLAUSE = re.compile(r"\b(?:if|when|whenever|until|unless|once|after|before|while|because|since)\b[^,]*,", re.I)
# A comma also starts a new main clause when `so`/`and` follows it ("No output yet, so wait ..."),
# or an imperative verb follows it ("Do not stop the job, wait ...") and the negation before it is
# not left dangling ("Do not, under any circumstances, wait" stays negated). A comma before a
# noun ("No recap, ..., foreground wait") does not end the negation.
COMMA_JOINER = re.compile(r"\s*(?:so|and)\b", re.I)
VERBS = r"(?:wait|block|keep|run|use|poll|check|stop|start|let|leave|stay|watch|read|call|sleep|hold|tail|go|do)"
COMMA_IMPERATIVE = re.compile(r"\s*" + VERBS + r"\b", re.I)
DANGLING_NEGATION = re.compile(r"\b(?:never|not|no)\s*$", re.I)
# DP-30 (3): a comma inside a negated verb list does not start a clause ("Never poll, block or
# wait in the foreground", "Never poll, wait in the foreground or sleep"). A list = a negation
# and one word before the first comma, single words between the commas, and an or/nor that
# closes it: right before the match, or right after it in front of a verb. "Never poll, wait in
# the foreground until it ends" closes no list, so its comma still starts a clause.
NEG_LIST_HEAD = re.compile(r"\b(?:never|not|no)\s+[a-z-]+\s*$", re.I)
LIST_WORD = re.compile(r"^\s*[a-z-]+\s*$", re.I)
LIST_LAST = re.compile(r"\b(?:or|nor)\s*$", re.I)
LIST_NEXT = re.compile(r"^\s*,?\s*(?:or|nor)\s+" + VERBS + r"\b", re.I)
STORE_WAIT = re.compile(r"(?:[\w{}@<>-]+-store|<store>) wait\b")
