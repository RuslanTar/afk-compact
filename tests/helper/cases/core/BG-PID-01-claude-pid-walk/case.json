{
 "id": "BG-PID-01-claude-pid-walk",
 "note": "Probe 2026-10-27 (P4, P5, P12): in a background session the helper's parent is the worker, whose command hides the Claude Code binary, so the walk passed it and the pty host and took the supervisor (`claude daemon`), whose pid every background session then shared. identity::claude_pid (the public entry; a chain's start pid stands for the runner's parent) over recorded process tables: the worker is taken by its executable (one read); a foreground session, a hook under sh and a CLAUDE_PID match read no executable; a nearer non-claude hop does not win; with no claude process the walk finds nothing and reads no executable; a worker whose executable cannot be read leaves the anchor, never the pty host past it. Worker command names are stand-ins (the probe did not record them); the supervisor and pty host commands are as the probe saw them",
 "steps": [
  {
   "lib": "claude_pid_walk",
   "args": {
    "chains": [
     {
      "id": "background worker under a pty host and the supervisor",
      "start": 72446,
      "procs": {
       "72446": { "ppid": 72207, "comm": "claude-bg-worker", "exe": "/Users/u/.local/share/claude/versions/2.1.311" },
       "72207": { "ppid": 70303, "comm": "claude bg-pty-host", "exe": "/Users/u/.local/share/claude/versions/2.1.311" },
       "70303": { "ppid": 1, "comm": "/Users/u/.local/bin/claude", "exe": "/Users/u/.local/share/claude/versions/2.1.311" }
      },
      "want": 72446,
      "found": true,
      "exe_calls": 1
     },
     {
      "id": "background worker whose executable cannot be read (lsof failed): the anchor, not the pty host",
      "start": 72446,
      "procs": {
       "72446": { "ppid": 72207, "comm": "claude-bg-worker" },
       "72207": { "ppid": 70303, "comm": "claude bg-pty-host", "exe": "/Users/u/.local/share/claude/versions/2.1.311" },
       "70303": { "ppid": 1, "comm": "/Users/u/.local/bin/claude", "exe": "/Users/u/.local/share/claude/versions/2.1.311" }
      },
      "want": 70303,
      "found": true,
      "exe_calls": 1
     },
     {
      "id": "background worker, CLAUDE_PID names it",
      "start": 72446,
      "env": "72446",
      "procs": {
       "72446": { "ppid": 72207, "comm": "claude-bg-worker" },
       "72207": { "ppid": 70303, "comm": "claude bg-pty-host" },
       "70303": { "ppid": 1, "comm": "/Users/u/.local/bin/claude" }
      },
      "want": 72446,
      "found": true,
      "exe_calls": 0
     },
     {
      "id": "foreground session: the parent is claude",
      "start": 500,
      "procs": {
       "500": { "ppid": 400, "comm": "/Users/u/.local/bin/claude" },
       "400": { "ppid": 1, "comm": "-zsh" }
      },
      "want": 500,
      "found": true,
      "exe_calls": 0
     },
     {
      "id": "hook under sh -c",
      "start": 600,
      "procs": {
       "600": { "ppid": 500, "comm": "/bin/sh" },
       "500": { "ppid": 400, "comm": "claude" },
       "400": { "ppid": 1, "comm": "-zsh" }
      },
      "want": 500,
      "found": true,
      "exe_calls": 0
     },
     {
      "id": "a nearer process that is not claude",
      "start": 800,
      "procs": {
       "800": { "ppid": 500, "comm": "node", "exe": "/usr/local/bin/node" },
       "500": { "ppid": 1, "comm": "/Users/u/.local/bin/claude" }
      },
      "want": 500,
      "found": true,
      "exe_calls": 1
     },
     {
      "id": "no claude process",
      "start": 700,
      "procs": {
       "700": { "ppid": 701, "comm": "-zsh" },
       "701": { "ppid": 1, "comm": "login", "exe": "/usr/bin/login" }
      },
      "want": null,
      "found": false,
      "exe_calls": 0
     }
    ]
   }
  }
 ]
}
