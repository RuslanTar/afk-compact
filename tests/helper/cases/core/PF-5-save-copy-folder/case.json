{
 "id": "PF-5-save-copy-folder",
 "note": "PF-5: `save-copy --from <folder>` is an unreadable source: `usage: --from cannot be read` on stderr, exit 64, nothing on stdout, no copy written. Before the fix util::read_file opened the folder, read nothing and save-copy saved an empty copy (exit 0). A readable file still saves",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "a folder as --from",
   "setup": [
    {"mkdir": "$TMP/work"},
    {"mkdir": "$TMP/a-folder"}
   ],
   "argv": ["save-copy", "--sid", "$SID", "--nonce", "-", "--from", "$TMP/a-folder", "--writer", "mod", "--scope", "main", "--cwd", "$TMP/work"],
   "expect": {
    "exit": 64,
    "stdout": "",
    "stderr_has": ["\\Ausage: --from cannot be read\\n\\z"],
    "files": [
     {"path": "$ROOT/*/*/compact/*", "count": 0}
    ]
   }
  },
  {
   "name": "a file as --from still saves",
   "setup": [
    {"write": "$TMP/x.mod.md", "text": "<summary>\n# LAB-42 — retry window fix in review\n</summary>"}
   ],
   "argv": ["save-copy", "--sid", "$SID", "--nonce", "-", "--from", "$TMP/x.mod.md", "--writer", "mod", "--scope", "main", "--cwd", "$TMP/work"],
   "expect": {
    "exit": 0,
    "stdout_has": ["^Saved copy: "],
    "files": [
     {"path": "$ROOT/*/*/compact/*", "count": 1}
    ]
   }
  }
 ]
}
