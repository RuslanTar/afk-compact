def canary_tool_consts(root=REPO):
    """C8_STRINGS, COMMON_WORDS, RARE_MAX, IDLE_PREFIXES, is_rare (the one rule for a rare count)
    and render (the baseline's text) from this tree's tools/canary-baseline."""
    loader = importlib.machinery.SourceFileLoader("tools_canary_baseline",
                                                  os.path.join(root, "tools", "canary-baseline"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("tools_canary_baseline", loader))
    loader.exec_module(mod)
    return mod.C8_STRINGS, mod.COMMON_WORDS, mod.RARE_MAX, mod.IDLE_PREFIXES, mod.is_rare, mod.render


def c8_shape(cur):
    """Why the baseline's C8 part cannot be checked at all (no fallback then), or None: c8 must hold
    counts, and c8.binary_version must be a version string equal to the top-level cc_version."""
    c8 = cur.get("c8") if isinstance(cur, dict) else None
    if not isinstance(c8, dict):
        return "no c8 part"
    if not isinstance(c8.get("counts"), dict) or not c8["counts"]:
        return "no c8.counts"
    v = c8.get("binary_version")
    if not isinstance(v, str) or not VERSION_RE.fullmatch(v):
        return "c8.binary_version {} is not a version".format(json.dumps(v))
    if v != cur.get("cc_version"):
        return "c8.binary_version {} is not cc_version {}".format(json.dumps(v), json.dumps(cur.get("cc_version")))
    return None


def c8_fixed_parts(c8, root=REPO):
    """The C8 problems a render without the binary can still see: the parts that are the tool's
    constants (the count keys, the count range, rare_max, idle_prefixes, no other key)."""
    strings, common, rare_max, idle, is_rare, _ = canary_tool_consts(root)
    bad = []
    extra = sorted(set(c8) - {"binary_version", "counts", "idle_prefixes", "rare_max"})
    if extra:
        bad.append("c8 keys the tool does not write: {}".format(", ".join(extra)))
    counts = c8["counts"]
    for s in sorted(set(counts) - set(strings)):
        bad.append("c8.counts key {} is not one of the tool's strings".format(json.dumps(s)))
    for s in sorted(set(strings) - set(counts)):
        bad.append("c8.counts lacks the tool's string {}".format(json.dumps(s)))
    for s in sorted(set(counts) & set(strings)):
        n = counts[s]
        if s not in common and not is_rare(n, rare_max):
            bad.append("c8.counts {} is {} (want 1 to {})".format(json.dumps(s), json.dumps(n), rare_max))
    if not (type(c8.get("rare_max")) is int and c8["rare_max"] == rare_max):
        bad.append("c8.rare_max is {} (the tool's is {})".format(json.dumps(c8.get("rare_max")), rare_max))
    if c8.get("idle_prefixes") != idle:
        bad.append("c8.idle_prefixes differ from the tool's")
    return bad


def canary_check(root=REPO, no_c8=False):
    """canary-baseline --check pinned to the binary the file records (the strict path: every
    part, C8 counts included). Returns the version whose C8 counts were not compared, or None
    when every part was compared.

    Which path runs is never chosen by the file under check. A baseline whose C8 part names no
    such binary (no c8 or no c8.counts, a binary_version that is not a version string or not
    cc_version) fails, and so does a pinned binary that is not installed, naming its version
    and the opt-in. Only the caller's opt-in, `tools/check xgen --no-c8` (no_c8 here; the
    release path, phase0 and integration, never passes it), allows the weaker path when that
    binary is really not installed: render every part but C8 (canary-baseline --no-c8, which
    reads no binary) to a temp file, put the baseline's own c8 part and cc_version in it and
    compare its text (the tool's render) with the baseline's bytes, as the strict path does,
    then every C8 part that does not come from the binary (c8_fixed_parts). With the opt-in
    and the binary installed, the strict path runs as without it."""
    tool = os.path.join(root, "tools", "canary-baseline")
    if not os.path.exists(tool):
        return None
    path = os.path.join(root, "plugin", "assets", "canary-baseline.json")
    try:
        with open(path, encoding="utf-8") as f:
            cur = json.load(f)
    except (OSError, ValueError) as e:
        raise Fail("X-gen: canary-baseline.json cannot be read: {}".format(e))
    why = c8_shape(cur)
    if why:
        raise Fail("X-gen: canary-baseline.json: {}, so C8 cannot be checked".format(why))
    v = cur["c8"]["binary_version"]
    pinned = os.path.join(os.path.expanduser("~"), ".local", "share", "claude", "versions", v)
    if os.path.isfile(pinned):
        run([tool, "--check", "--claude", pinned], "X-gen canary-baseline", cwd=root)
        return None
    if os.path.lexists(pinned):
        raise Fail("X-gen: {} is not a file, so C8 cannot be checked".format(pinned))
    if not no_c8:
        raise Fail("X-gen: Claude Code {} (the baseline's c8.binary_version) is not installed at {}, so the C8 "
                   "counts cannot be compared; install that version, or run `tools/check xgen --no-c8` to check "
                   "every part but the C8 counts".format(v, pinned))
    tmp = os.path.join(root, "tmp", "canary-render.json")
    os.makedirs(os.path.dirname(tmp), exist_ok=True)
    run([tool, "--no-c8", "--out", tmp], "X-gen canary-baseline render", cwd=root, capture=True)
    with open(tmp, encoding="utf-8") as f:
        fresh = json.load(f)
    os.unlink(tmp)
    # The text, as the strict path compares it: the render with the baseline's own c8 part and
    # cc_version, in the tool's own format, against the baseline's bytes (CRLF, a BOM, another
    # indent or key order, a blank line: each a difference).
    fresh["c8"], fresh["cc_version"] = cur["c8"], cur["cc_version"]
    with open(path, "rb") as f:
        raw = f.read()
    if raw != canary_tool_consts(root)[5](fresh).encode("utf-8"):
        raise Fail("X-gen: canary-baseline.json differs from a fresh render (C8 counts not compared: Claude Code {} "
                   "is not installed)".format(v))
    bad = c8_fixed_parts(cur["c8"], root)
    for b in bad:
        print("canary-baseline: " + b)
    if bad:
        raise Fail("X-gen: canary-baseline.json: {} C8 {} from the tool (counts not compared: "
                   "Claude Code {} is not installed)".format(len(bad), "part differs" if len(bad) == 1 else "parts differ", v))
    print("canary-baseline: current except the C8 counts, which were not compared (--no-c8; Claude Code {} "
          "not installed)".format(v))
    return v


