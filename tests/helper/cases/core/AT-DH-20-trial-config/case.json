{
 "id": "AT-DH-20-trial-config",
 "note": "no trial.json -> absent and nothing written; an unknown key (a cap), on:false, an ended trial_until, a missing pin, an old_skill list without the template sum -> off/bad; a valid config on an unlisted or unknown Claude Code version -> skip cc-version",
 "now": "2026-10-27T10:00:00+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "name": "absent",
   "setup": [
    {
     "mkdir": "$TMP/work"
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "absent"
    },
    "files": [
     {
      "path": "$HOME/.cache",
      "exists": false
     }
    ]
   }
  },
  {
   "name": "a cap is refused",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ],
      "cap": 3
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "bad",
     "why": "unknown-key:cap"
    }
   }
  },
  {
   "name": "on false",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": false,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "off",
     "why": "off"
    }
   }
  },
  {
   "name": "ended",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-10-26",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "off",
     "why": "ended"
    }
   }
  },
  {
   "name": "no pinned log_dir",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "bad",
     "why": "log_dir"
    }
   }
  },
  {
   "name": "old_skill without the template sum",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ],
      "old_skill": {
       "dir": "$TMP/old-skills",
       "sha256": {
        "create-handoff/SKILL.md": "fc896770577a3d03fcb5f646a8342a0a2781ec9f13fe18266070077d8dbfe7ef"
       }
      }
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "bad",
     "why": "old_skill.sha256 lacks create-handoff/references/handoff-template.md"
    }
   }
  },
  {
   "name": "unlisted version",
   "setup": [
    {
     "write": "$HOME/.cache/$BRAND-trial/trial.json",
     "json": {
      "v": 1,
      "on": true,
      "trial_until": "2026-11-24",
      "handoff_root": "$ROOT",
      "log_dir": "$WATCH",
      "cc_versions": [
       "2.1.311"
      ]
     }
    }
   ],
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.312"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "cc-version",
     "why": "unlisted"
    }
   }
  },
  {
   "name": "unknown version",
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "on",
     "skip": "cc-version",
     "why": "unknown"
    }
   }
  },
  {
   "name": "nothing written by a measure",
   "argv": [
    "trial-measure",
    "--sid",
    "$SID",
    "--cwd",
    "$TMP/work",
    "--cc-version",
    "2.1.311"
   ],
   "expect": {
    "exit": 0,
    "files": [
     {
      "path": "$HOME/.cache/$BRAND-trial/*",
      "count": 1
     },
     {
      "path": "$ROOT/*",
      "count": 0
     }
    ]
   }
  }
 ]
}
