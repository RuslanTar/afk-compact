                  "background_tasks": [{"id": "b1", "type": "shell", "status": "running", "description": "x"}, {"id": "m1", "type": "monitor", "status": "running", "description": "y"}], "session_crons": []},
   "expect": {"exit": 0}},
  {"name": "background-work with the types", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312"], "expect": {"exit": 0, "json": {"why": "background-work", "types": ["monitor", "shell"]}}},
  {"name": "shadow: background work does not refuse; the reply lists it as items (what the exit dialog would count)", "argv": ["restart", "gate", "--sid", "$SID", "--route", "bg", "--job-dir", "$TMP/jobs/job1", "--from", "2.1.311", "--to", "2.1.312"], "options": {"restart_on_update": "shadow"}, "expect": {"exit": 0, "json": {"ok": true, "items": ["monitor", "shell"], "types": {"len": 0}}}},
  {"name": "(a Stop with a session cron only)", "argv": ["hook", "Stop"],
   "stdin_json": {"session_id": "$SID", "transcript_path": "$TMP/proj/$SID.jsonl", "cwd": "$TMP", "hook_event_name": "Stop", "stop_hook_active": false, "permission_mode": "default",
                  "background_tasks": [], "session_crons": [{"id": "c1"}]},
   "expect": {"exit": 0}},
