{
 "id": "AT-E-03",
 "note": "MOD-SPEC §10 AT-E-03 (S-09): the sweep writes under <disposable_root>/<today>/<stem>-evidence/ (0700 folders, 0600 files), never under <bucket>/evidence/, and the destination is not a git work tree; a disposable_root inside a git work tree or a .planning/ folder is refused and nothing is written there; a disposable_root with no absolute form in this platform (a drive path C:/x or C:\\x on macOS and Linux, a rooted \\x, a drive-relative C:x, a relative path) is refused as root-invalid before any git call and before the sweep claims the compaction (RF-2: it was joined to the cwd, found outside any work tree and swept); under MSYS or Cygwin perl a drive path is read in its /c/ form first (seams STORE_TEST_OS, STORE_TEST_CYGDRIVE). These roots are written in the settings file: the runner's home guard refuses a root env value that is not absolute, so one inside a git work tree is root-in-git and one outside is swept into",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "setup": [
    {
     "mkdir": "$TMP/example-repo"
    },
    {
     "tempfiles": "at-e-07-dup.json",
     "tmp": "$TMP/tmpdir",
     "record": true
    }
   ],
   "argv": [
    "sweep",
    "--sid",
    "$SID",
    "--nonce",
    "1a2b3c4d",
    "--cwd",
    "$TMP/example-repo"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^copied\\t\\S+/scratch/shared-result\\.txt\\t~?/\\S+/2026-10-21/2026-10-21_14-05-12_11111111-1a2b3c-evidence/shared-result\\.txt\\t2048\\t"
    ],
    "files": [
     {
      "path": "$DISP/2026-10-21",
      "mode": "0700"
     },
     {
      "path": "$DISP/2026-10-21/2026-10-21_14-05-12_$SID8-1a2b3c-evidence",
      "mode": "0700"
     },
     {
      "path": "$DISP/2026-10-21/2026-10-21_14-05-12_$SID8-1a2b3c-evidence/shared-result.txt",
      "mode": "0600"
     },
     {
      "path": "$DISP/2026-10-21/2026-10-21_14-05-12_$SID8-1a2b3c-evidence/MANIFEST.tsv",
      "mode": "0600"
     }
    ],
    "absent": [
     "$ROOT/example-repo/general/evidence",
     "$ROOT/*/*/evidence"
    ]
   }
  },
  {
   "name": "the destination is no git work tree",
   "exec": [
    "git",
    "-C",
    "$DISP/2026-10-21/2026-10-21_14-05-12_$SID8-1a2b3c-evidence",
    "rev-parse",
    "--git-dir"
   ],
   "expect": {
    "exit": 128
   }
  },
  {
   "name": "disposable_root inside a git work tree: refused",
   "setup": [
    {
     "repo_fixture": "main-branch.json",
     "at": "$TMP/tracked"
    }
   ],
   "env": {
    "CLAUDE_PLUGIN_OPTION_DISPOSABLE_ROOT": "$TMP/tracked/trash"
   },
   "argv": [
    "sweep",
    "--sid",
    "$SID",
    "--nonce",
    "2b3c4d5e",
    "--cwd",
    "$TMP/example-repo"
   ],
   "expect": {
    "exit": 3,
    "stdout": "REFUSED: root-in-git\n",
    "absent": [
     "$TMP/tracked/trash"
    ]
   }
  },
  {
   "name": "disposable_root inside .planning: refused",
   "setup": [
    {
     "mkdir": "$TMP/plan/.planning"
    }
   ],
   "env": {
    "CLAUDE_PLUGIN_OPTION_DISPOSABLE_ROOT": "$TMP/plan/.planning/trash"
   },
   "argv": [
    "sweep",
    "--sid",
    "$SID",
    "--nonce",
    "3c4d5e6f",
    "--cwd",
    "$TMP/example-repo"
   ],
   "expect": {
    "exit": 3,
    "stdout": "REFUSED: root-in-planning\n",
    "absent": [
     "$TMP/plan/.planning/trash"
    ],
    "files": [
     {
      "path": "$TMP/trace-4.log",
      "snapshot": "no-root-git"
     }
    ]
   }
  },
  {
   "name": "disposable_root as a drive path (C:/): root-invalid, no git call, no sweep",
   "options": {
    "disposable_root": "C:$TMP/tracked/trash"
   },
   "argv": [
    "sweep",
    "--sid",
    "$SID",
    "--nonce",
    "4d5e6f70",
    "--cwd",
    "$TMP/example-repo"
   ],
   "expect": {
    "exit": 3,
    "stdout": "REFUSED: root-invalid\n",
    "trace_absent": [
