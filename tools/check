    if os.path.exists(os.path.join(tools, "helper-replies-gen")):
        run([os.path.join(tools, "helper-replies-gen"), "--check"], "X-gen helper replies", cwd=root)
    canary_check(root)
    run([os.path.join(tools, "assemble"), "--check"], "X-gen goldens", cwd=root, capture=True)


