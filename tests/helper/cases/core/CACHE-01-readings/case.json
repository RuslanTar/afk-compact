{
 "id": "CACHE-01-readings",
 "note": "0.1.7 D-81: `cache [--sid] [--stdin] [--json]` reads Claude Code's status-line prompt_cache (2.1.312+) as the main source; without it the transcript's last main api-request line (its timestamp, the TTL of its last cache breakpoint; 5m when that names none), read from the end in 256 KiB, then 2 MiB. It always exits 0 and writes nothing: with no state there is no file under HOME, and a reading leaves the HOME tree as it was. Unknown prints nothing; a bad, empty or mismatched session id is unknown, bad-sid. A same-message.id assistant block after the request does not move the anchor (critique 1); an agent's api-request is not the main one; a line over 256 KiB after the request is read through the 2 MiB tail.",
 "now": "2026-11-09T12:00:00Z",
 "tz": "UTC",
 "steps": [
  {
   "name": "no state, no stdin: unknown, nothing printed, nothing written",
   "argv": [
    "cache",
    "--sid",
    "$SID"
   ],
   "expect": {
    "exit": 0,
    "stdout": "",
    "absent": [
     "$HOME/.local/state/$BRAND"
    ]
   }
  },
  {
   "name": "json: unknown, no-data",
   "argv": [
    "cache",
    "--sid",
    "$SID",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "schema": "$BRAND-cache/v1",
     "sid": "$SID",
     "state": "unknown",
     "why": "no-data",
     "now": 1794225600,
     "keep_warm": {
      "null": true
     },
     "last": {
      "null": true
     }
    },
    "absent": [
     "$HOME/.local/state/$BRAND"
    ],
    "files": [
     {
      "path": "$HOME",
      "tree_snapshot": "h0"
     }
    ]
   }
  },
  {
   "name": "prompt_cache warm, 1h: the plain line",
   "argv": [
    "cache",
    "--stdin"
   ],
   "expect": {
    "exit": 0,
    "stdout": "cache 1h warm 30m left\n",
    "files": [
     {
      "path": "$HOME",
      "same_tree_as": "h0"
     }
    ]
   },
   "stdin_json": {
    "session_id": "$SID",
    "prompt_cache": {
     "warm": true,
     "caching_observed": true,
     "ttl": "1h",
     "expires_at": 1794227400,
     "requests": 8
    }
   }
  },
  {
   "name": "prompt_cache warm: json",
   "argv": [
    "cache",
    "--stdin",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "warm",
     "why": {
      "null": true
     },
     "source": "claude-code",
     "ttl": "1h",
     "expires_at": 1794227400,
     "seconds_left": 1800
    }
   },
   "stdin_json": {
    "session_id": "$SID",
    "prompt_cache": {
     "ttl": "1h",
     "expires_at": 1794227400
    }
   }
  },
  {
   "name": "prompt_cache expired: cold, expired 12m ago",
   "argv": [
    "cache",
    "--stdin"
   ],
   "expect": {
    "exit": 0,
    "stdout": "cache 1h cold (expired 12m ago)\n"
   },
   "stdin_json": {
    "session_id": "$SID",
    "prompt_cache": {
     "warm": false,
     "ttl": "1h",
     "expires_at": 1794224880
    }
   }
  },
  {
   "name": "caching_observed false: unknown, caching-off, nothing printed",
   "argv": [
    "cache",
    "--stdin",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "unknown",
     "why": "caching-off"
    }
   },
   "stdin_json": {
    "session_id": "$SID",
    "prompt_cache": {
     "caching_observed": false,
     "warm": false
    }
   }
  },
  {
   "name": "--sid and the status line's session_id differ: bad-sid",
   "argv": [
    "cache",
    "--sid",
    "other-session",
    "--stdin",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "unknown",
     "why": "bad-sid",
     "sid": {
      "null": true
     }
    }
   },
   "stdin_json": {
    "session_id": "$SID",
    "prompt_cache": {
     "ttl": "1h",
     "expires_at": 1794227400
    }
   }
  },
  {
   "name": "a path as the session id: bad-sid",
   "argv": [
    "cache",
    "--sid",
    "../x",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "unknown",
     "why": "bad-sid"
    }
   }
  },
  {
   "name": "an empty session id: bad-sid",
   "argv": [
    "cache",
    "--sid",
    "",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "unknown",
     "why": "bad-sid"
    }
   }
  },
  {
   "name": "garbage on stdin: unknown, exit 0",
   "argv": [
    "cache",
    "--stdin",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "json": {
     "state": "unknown",
     "why": "bad-sid"
    }
   },
   "stdin_text": "{not json"
  },
  {
   "name": "an unknown flag: exit 0, the usage on stderr",
   "argv": [
    "cache",
    "--bogus"
   ],
   "expect": {
    "exit": 0,
    "stdout": "",
    "stderr_has": [
     "usage: cache"
    ]
   }
  },
