    "evidence",
    "--stage",
    "$STAGE",
    "--keep",
    "$TMP/s/notes.txt",
    "$TMP/s/other.txt",
    "$TMP/s/app.log",
    "$TMP/s/.env",
    "$TMP/s/big.bin"
   ],
   "expect": {
    "exit": 0
   }
  },
  {
   "write": "$STAGE/body.md",
   "content": "# LAB-7 — retry fix drafted, suite pending\n## Resume here\nStatus: active · State: retry window fix drafted for LAB-7 (checkpoint: clean)\nStep 1: `bin/test retry` — for \"fix the retry window\"\nGate: none · Don't: change the window size\nLive: nothing running (checked 2026-10-21 14:05 +0300)\n## User constraints\n- U-1: \"keep the 45 s window\" — scope retry window; user, 11111111\n## Decisions and do-not-re-raise\n- D-1: keep 45 s — because upstream retries at 40 s (user)\n## In flight\nNothing in flight — checked 2026-10-21 14:05 +0300 via task list\n## Live state\n| claim | as of | re-check | tag |\n|---|---|---|---|\n| HEAD on feature/LAB-7-retry, clean | 14:05 | `git -C $TMP/repo status -sb` | measured |\n## Open questions\nnone\n## Location\nrepo repo · worktree $TMP/repo · branch feature/LAB-7-retry · this handoff: @self@\n## Work done and findings\n- retry fix: implemented — `app/retry.rb#retry_window`\n## Next steps\n1. `bin/test retry` — done when the suite passes\n"
  },
  {
   "cwd": "$TMP/repo",
   "argv": [
    "publish",
    "--stage",
    "$STAGE",
    "--slug",
    "retry",
    "--status",
    "in-progress"
   ],
   "expect": {
    "exit": 0
   },
   "capture": {
    "PUB": "re:^Wrote handoff to: (.+)$"
   }
  },
  {
   "argv": [
    "restore-evidence",
    "$PUB",
    "--to",
    "$TMP/restore"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^$TMP/restore/notes.txt$",
     "^$TMP/restore/other.txt$",
     "^$TMP/restore/app.log$"
    ],
    "stdout_lacks": [
     "\\.env",
     "big.bin"
    ],
    "files": [
     {
      "path": "$TMP/restore",
      "mode": "0700"
     },
     {
      "path": "$TMP/restore/notes.txt",
      "mode": "0600",
      "has": [
       "\\Anotes\\n\\z"
      ]
     },
     {
      "path": "$TMP/restore/app.log",
      "lacks": [
       "hunter2"
      ]
     },
     {
      "path": "$ROOT/repo/LAB-7/evidence/$STEM/notes.txt"
     },
     {
      "path": "$ROOT/repo/LAB-7/evidence/$STEM/app.log"
     },
     {
      "path": "$ROOT/repo/LAB-7/evidence/$STEM/MANIFEST.tsv"
     }
    ],
    "absent": [
     "$TMP/restore/.env",
     "$TMP/restore/big.bin"
    ]
   }
  },
  {
   "argv": [
    "restore-evidence",
    "$PUB",
    "--to",
    "$TMP/restore"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^$TMP/restore/notes-2.txt$"
    ],
    "files": [
     {
      "path": "$TMP/restore/notes.txt"
     }
    ]
   }
  },
  {
   "argv": [
    "restore-evidence",
    "$PUB"
   ],
   "expect": {
    "exit": 64
   }
  }
 ]
}
