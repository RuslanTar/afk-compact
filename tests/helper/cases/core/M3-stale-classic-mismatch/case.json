{
 "id": "M3-stale-classic-mismatch",
 "note": "MOD-SPEC §5.1 stale verdict, §5.3, §5.5 (copy-mismatch is an escalation), §11: on the seated classic path a second summary that repeats the first compaction's marker (stale) meets the first copy under the same nonce name; it is not saved (EXISTS sha-differs, copy result=mismatch), and status lists it as copy_mismatch. Naming such a summary so that it is saved too is escalated (§5.3 names copies by the marker nonce and does not cover stale markers)",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {
   "setup": [
    {
     "mkdir": "$TMP/work"
    }
   ],
   "argv": [
    "hook",
    "PreCompact"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "PreCompact",
    "trigger": "auto",
    "custom_instructions": null
   },
   "capture": {
    "N1": "re:n=([0-9a-f]{8}) s=main"
   },
   "expect": {
    "exit": 0
   }
  },
  {
   "argv": [
    "hook",
    "PostCompact"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "PostCompact",
    "trigger": "auto",
    "compact_summary": "<summary>\n⟪$BRAND v1 n=$N1 s=main⟫\n# LAB-42 first\n## Resume here\nStatus: active\n⟪/$BRAND n=$N1⟫\n</summary>"
   },
   "expect": {
    "exit": 0,
    "files": [
     {
      "path": "$ROOT/work/general/compact/unattributed/*.md",
      "count": 1
     }
    ]
   }
  },
  {
   "now": "2026-10-21T14:25:12+03:00",
   "argv": [
    "hook",
    "PreCompact"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "PreCompact",
    "trigger": "auto",
    "custom_instructions": null
   },
   "expect": {
    "exit": 0
   }
  },
  {
   "now": "2026-10-21T14:25:14+03:00",
   "argv": [
    "hook",
    "PostCompact"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "PostCompact",
    "trigger": "auto",
    "compact_summary": "<summary>\n⟪$BRAND v1 n=$N1 s=main⟫\n# LAB-42 second, much later work\n## Resume here\nStatus: active, new state\n⟪/$BRAND n=$N1⟫\n</summary>"
   },
   "expect": {
    "exit": 0,
    "rows": [
     {
      "file": "$WATCH/$SID.classic.jsonl",
      "ev": "copy",
      "count": 1,
      "fields": {
       "nonce": "$N1",
       "result": "mismatch",
       "writer": "postcompact-fallback"
      }
     },
     {
      "file": "$WATCH/$SID/compactions.jsonl",
      "ev": "compaction",
      "count": 1,
      "fields": {
       "verdict": "stale"
      }
     }
    ],
    "files": [
     {
      "path": "$ROOT/work/general/compact/unattributed/*.md",
      "count": 1
     }
    ]
   }
  },
  {
   "name": "status lists the classic mismatch",
   "now": "2026-10-21T14:26:00+03:00",
   "argv": [
    "status",
    "--sid",
    "$SID"
   ],
   "expect": {
    "exit": 0,
    "stdout_has": [
     "^escalations: .*\\bcopy_mismatch 1\\b"
    ]
   }
  }
 ]
}