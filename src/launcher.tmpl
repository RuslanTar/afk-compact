#!/bin/sh
# {{plugin}}-store: launcher for the plugin helper (POSIX sh; dash, ash,
# bash 3.2 and Git Bash). It finds perl and runs helper/main.pl, with no
# version check of its own: main.pl's first lines refuse a perl older than
# 5.28, and for a hook they run this file again as `--fallback-hook hook
# <Event>`, stdin unread. Without perl or a readable main.pl, from that call,
# or for a hook whose perl cannot start or ends on a signal, it takes the
# fallback path: a hook prints nothing and exits 0 after one content-free row
# (none under a root the helper would refuse); any other command refuses.

# Keep the user's perl library paths for queue_cmd children, then clear
# every variable that can inject modules or change byte handling.
STORE_ORIG_PERL5LIB=${PERL5LIB-}
STORE_ORIG_PERLLIB=${PERLLIB-}
export STORE_ORIG_PERL5LIB STORE_ORIG_PERLLIB
unset PERL5OPT PERL5LIB PERLLIB PERL5DB PERL_UNICODE PERLIO

# Resolve this file's real path (follow symlinks); the plugin root is the
# parent of its folder, scripts/.
self=$0
while [ -h "$self" ]; do
  link=$(ls -ld "$self" | sed 's/^.* -> //')
  case $link in
    /*) self=$link ;;
    *) self=${self%/*}/$link ;;
  esac
done
case $self in
  */*) here=${self%/*} ;;
  *) here=. ;;
esac
root=$(cd "$here/.." 2>/dev/null && pwd -P) || root=$here/..

perl=$(command -v perl 2>/dev/null)
[ -n "$perl" ] || perl=/usr/bin/perl
if [ "${1-}" = --fallback-hook ]; then
  shift
elif [ -x "$perl" ] && [ -r "$root/helper/main.pl" ]; then
  # A locale the system lacks (LC_ALL, LC_*, LANG) makes perl print five warning lines on
  # stderr before main.pl runs, which a skill's Bash output would carry; 0 keeps it quiet.
  PERL_BADLANG=0
  export PERL_BADLANG
  if [ "${1-}" != hook ]; then
    exec "$perl" "$root/helper/main.pl" "$@"
  fi
  # Exit 2 from a hook blocks, vetoes or re-prompts; perl exits 2 on its own when it
  # dies with errno ENOENT. A hook always exits 0, whatever main.pl does. main.pl's guard
  # reads this file's path from $main::STORE_LAUNCHER to run its fallback on an old perl.
  # perl runs as a child, not in this shell's place: a perl found but unable to start (an
  # interpreter line that points nowhere, a version manager's shim with no perl picked) ends
  # with 1 to 128, stdin unread, and the fallback below runs. One that ends on a signal (above
  # 128: a perl that aborts on a missing library, a crash, a kill) takes the fallback too, so
  # its row is written; its sid reads unknown when perl had read stdin. Only a perl that ran
  # main.pl to its END ends 0. Its walk to Claude Code starts at this shell's parent
  # ($main::STORE_LAUNCHER_PARENT, "<this pid>:<parent>"), as when perl took this shell's place.
  "$perl" -e 'END { $? = 0 } my $main = shift @ARGV; $main::STORE_LAUNCHER = shift @ARGV; $main::STORE_LAUNCHER_PARENT = shift @ARGV; do $main;' \
    "$root/helper/main.pl" "$root/scripts/${self##*/}" "$$:${PPID-}" "$@" 2>/dev/null
  [ "$?" -eq 0 ] && exit 0
fi

# Fallback: no perl, no readable helper/main.pl, a hook's perl that could not start or ended on
# a signal, or (from main.pl) a perl older than 5.28.
if [ "${1-}" = hook ]; then
  payload=$(cat 2>/dev/null | head -c 65536 2>/dev/null)
  sid=$(printf '%s' "$payload" | sed -n 's/.*"session_id"[ ]*:[ ]*"\([0-9A-Za-z-]\{8,64\}\)".*/\1/p' | head -n 1)
  [ -n "$sid" ] || sid=unknown
  ver=$(sed -n 's/.*"version"[ ]*:[ ]*"\([0-9A-Za-z.+-]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" 2>/dev/null | head -n 1)
  watch=${CLAUDE_PLUGIN_OPTION_LOG_DIR-}
  case $watch in '${user_config.'*) watch= ;; esac
  if [ -z "$watch" ]; then
    hroot=${CLAUDE_PLUGIN_OPTION_HANDOFF_ROOT-}
    case $hroot in '${user_config.'*) hroot= ;; esac
    [ -n "$hroot" ] || hroot='~/.local/state/{{plugin}}/handoffs'
    # a handoff_root that is not an absolute path is root-invalid: as in the helper, the logs of
    # an unset log_dir then go to the default folder
    case $hroot in /*|'~'|'~/'*) ;; *) hroot='~/.local/state/{{plugin}}/handoffs' ;; esac
    # the default root reads under $XDG_STATE_HOME when that is an absolute path (as the helper)
    case $hroot in
      '~/.local/state/{{plugin}}/handoffs'|'~/.local/state/{{plugin}}/handoffs/'|"${HOME-}/.local/state/{{plugin}}/handoffs"|"${HOME-}/.local/state/{{plugin}}/handoffs/")
        case ${XDG_STATE_HOME-} in /*) hroot=${XDG_STATE_HOME%/}/{{plugin}}/handoffs ;; esac ;;
    esac
    watch=$hroot/.watch
  fi
  case $watch in '~'|'~/'*) watch=${HOME-}${watch#\~} ;; esac
  # a watch folder that is not an absolute path (a relative log_dir) is root-invalid (the helper
  # refuses it): no row, since it would land under the hook's working folder
  case $watch in /*) ;; *) exit 0 ;; esac
  # MOD-SPEC 1.2 without the helper: a row only in an absolute folder that no folder from it up to
  # / marks as a git work tree or a .planning folder (no git call, so a git-ignored root gets no
  # row either), at most 64 levels; else nothing is written and the hook still exits 0. The walk
  # runs on the path as given and again from the deepest folder that exists read through its
  # symlinks (cd -P), so a root reached through a link into a work tree is refused too.
  safe=0
  case $watch in
    /*)
      t=$watch
      while :; do case $t in */) t=${t%/} ;; *) break ;; esac; done
      e=$t n=0
      while [ -n "$e" ] && [ ! -d "$e" ] && [ "$n" -lt 64 ]; do n=$((n + 1)); e=${e%/*}; done
      r=$t
      if [ -d "${e:-/}" ] && p=$(cd -P "${e:-/}" 2>/dev/null && pwd -P); then r=${p%/}${t#"$e"}; fi
      case /$t/$r/ in
        */[.][Pp][Ll][Aa][Nn][Nn][Ii][Nn][Gg]/*) ;;
        *)
          safe=1
          for d in "$t" "$r"; do
            n=0
            while :; do
              if [ -e "$d/.git" ] || [ -e "$d/.planning" ]; then safe=0; break; fi
              [ -n "$d" ] || break
              n=$((n + 1))
              if [ "$n" -gt 64 ]; then safe=0; break; fi
              case $d in */*) d=${d%/*} ;; *) d= ;; esac
            done
          done ;;
      esac ;;
  esac
  event=$(printf '%s' "${2-}" | tr -cd 'A-Za-z')
  ts=$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null | sed 's/\([0-9][0-9]\)$/:\1/')
  umask 077
  [ "$safe" = 1 ] && mkdir -p "$watch" 2>/dev/null &&
    printf '{"v":1,"ts":"%s","ev":"helper_runtime_missing","sid":"%s","actor":"unknown","writer":"helper","pid":%s,"plugin_version":"%s","cc_version":null,"turn_seq":null,"event":"%s"}\n' \
      "$ts" "$sid" "$$" "$ver" "$event" >>"$watch/$sid.classic.jsonl" 2>/dev/null
  exit 0
fi
echo 'REFUSED: helper-runtime'
exit 3
