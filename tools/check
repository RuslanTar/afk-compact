    def release_strict(d):
        """The release path compares the C8 counts: phase0 and integration refuse --no-c8 (exit 2,
        before any check) and call the canary check strict (no_c8 false); only xgen passes the
        opt-in through. The copy's tools/check runs in process with every step stubbed out and
        the canary check replaced by a recorder that stops the run there, so nothing heavy runs
        and no Claude Code is started."""
        loader = importlib.machinery.SourceFileLoader("tools_check_release", os.path.join(d, "tools", "check"))
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("tools_check_release", loader))
        loader.exec_module(mod)
        seen = []

        def canary_stub(root=None, no_c8=False):
            seen.append(no_c8)
            raise mod.Fail("release probe: stopped at the canary check")

        def stop(step):
            def f(*a, **k):
                raise mod.Fail("release probe: {} reached before the canary check".format(step))
            return f
        mod.canary_check = canary_stub
        mod.run = lambda *a, **k: None
        mod.x_validate = lambda *a, **k: None
        for step in ("x_launcher", "x_assemble", "gates", "x_variants", "x_h", "x_tools", "bt02"):
            setattr(mod, step, stop(step))
        out, bad = [], 0
        for argv, want_code, want_calls in ((["phase0"], 1, [False]), (["integration"], 1, [False]),
                                            (["phase0", "--no-c8"], 2, []), (["integration", "--no-c8"], 2, []),
                                            (["xgen"], 1, [False]), (["xgen", "--no-c8"], 1, [True])):
            del seen[:]
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                code = mod.main(argv)
            shown = " ".join(argv)
            calls = ", ".join("canary check no_c8={}".format(x) for x in seen) or "no canary check"
            if code == want_code and seen == want_calls:
                out.append("RELEASE ok: {}: exit {}, {}".format(shown, code, calls))
                continue
            bad += 1
            out.append("RELEASE lax: {}: exit {}, {} (want exit {}, {})".format(
                shown, code, calls, want_code,
                ", ".join("canary check no_c8={}".format(x) for x in want_calls) or "refused before any check"))
        return (1 if bad else 0), "\n".join(out) + "\n"

    def release_lax(d):
        """The release path given the opt-in: the refusal off and phase0/integration's X-gen
        called with no_c8 true."""
        p = os.path.join(d, "tools", "check")
        with open(p, encoding="utf-8", newline="") as f:
