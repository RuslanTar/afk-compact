 "tz": "Etc/GMT-3",
 "path_prepend": [
  "$TMP/bin"
 ],
 "steps": [
  {
   "setup": [
    {
     "stub": "perl",
     "script": "exit 1"
    }
   ],
   "argv": [
    "hook",
    "PreCompact"
   ],
   "stdin_json": {
    "session_id": "$SID",
    "transcript_path": "$TMP/proj/$SID.jsonl",
    "cwd": "$TMP/work",
    "hook_event_name": "PreCompact",
    "trigger": "auto",
    "custom_instructions": null
   },
   "expect": {
