#!/usr/bin/python3
"""tools/build: render src/ into the installable plugin.

Usage:
  tools/build                       render into the repo (GEN files), update tools/build.state
  tools/build --check               render in memory and diff against the committed GEN files
                                    byte for byte (CRLF drift counts), and report any other
                                    file in a folder only GEN tools write as stale
  tools/build --headings            print every heading of the docs pages (page, level, text, anchor);
                                    a heading text must not repeat across the shipped pages
  tools/build --name N --out DIR    render a full copy under DIR (rename drill; repo untouched;
                                    the repo slug becomes <owner>/N)
  tools/build --variant V --out DIR render a lab variant under DIR (experiment arms; repo untouched):
                                    skills-only   same name, skills, helper and assets; no hooks/
                                                  (no hooks.json, no mod) and no plugin/tests/
                                    triggers-off  the full build with userConfig triggers
                                                  defaulting to false
                                    It prints a tree sha256 (paths, modes and bytes) to record,
                                    and refuses unless the plugin/ files it copies, src/,
                                    brand.json, LICENSE and tools/build match HEAD, untracked
                                    files included (the arms come from one commit; the line
                                    then names it). --allow-dirty builds anyway and marks
                                    the hash UNVERIFIED (not for a record).
  DIR is refused when it is the repo, one of its parents, or inside the repo other than under
  tmp/<name>/ (not tmp/store-h-*), compared after symlinks and letter case are resolved. An
  existing DIR is replaced only when it is empty or holds the .tools-build-out mark a previous
  --out run wrote; anything else is left alone.

Build-time rules: strip
`[ \\t]*<!--.*?-->` (multi-line) and fill `{{plugin}}`. The docs, the landing page and the
manifests also take `{{repo}}` (the GitHub owner/name) and `{{cc_min}}` (the oldest Claude Code
version the plugin runs on) from brand.json; manifests also take `{{marketplace}}`,
`{{version}}` and `{{description}}`. A `{{word}}` left in a rendered page fails the build.

Docs (one source per page; the rendered files are GEN, edit the sources):
  src/landing.md        -> README.md (the GitHub landing page)
  src/docs/<page>.md    -> docs/<page>.md, for every page src/docs/ORDER lists
  src/docs/_plugin-header.md + Contents + the "shipped" pages of src/docs/ORDER in that order,
  each heading one level down + src/docs/_plugin-footer.md -> plugin/README.md (the full
  reference; only plugin/ reaches a user's machine)
  Every page starts with its one H1. Links in the sources: `page.md#anchor` to another page,
  `#anchor` within a page, `../<path>` to a repo file (`../LICENSE`, `../plugin/assets/<f>`);
  the landing page writes `docs/page.md#anchor` and repo paths as they are. Anchors follow
  GitHub's heading rules (lower case, punctuation dropped, spaces to `-`). The build rewrites
  the links of plugin/README.md: `page.md#a` -> `#a`, `page.md` -> the page's H1 anchor, a
  GitHub-only page -> https://github.com/<repo>/blob/main/docs/<page>, `../plugin/<f>` -> `<f>`,
  `../LICENSE` and `../NOTICE` -> the plugin's own copies, any other `../<path>` -> its GitHub
  URL. It fails on an unresolved link or anchor, a missing linked file, a heading that repeats
  among the joined parts (GitHub would suffix it `-1`), a relative image in a shipped page,
  and a page in neither ORDER list or listed but missing.
"""
import hashlib, json, os, re, shutil, stat, subprocess, sys

sys.dont_write_bytecode = True
REPO = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
STATE = "tools/build.state"
COMMENT = re.compile(r"[ \t]*<!--.*?-->", re.S)
SPEC_BLOCK = re.compile(r"^```json spec-literals[ \t]*\n(.*?)\n```[ \t]*$", re.S | re.M)
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
EXEC = 0o755
PLAIN = 0o644
# The launcher's folder: the one spelling here, in deps.ts and in
# ctx.pm; the AT-PK-01 gate finds any other. No top-level bin/ ships (claude.ai and Cowork
# refuse a plugin with one).
LAUNCHER_DIR = "scripts"
# The launcher's old folder (before the move). It stays a GEN place for one round: a
# file left there is reported stale by --check, and tools/build removes the old launcher
# (listed in tools/build.state) and then the folder once it is empty.
OLD_LAUNCHER_DIRS = ("plugin/bin",)
# Places only GEN tools write (OWNERS.tsv). Every file found there must be a
# tools/build output or one of OTHER_GEN (a path, or a pattern in OTHER_GEN_PATTERNS), else
# --check reports it stale: it would ship. A pattern's owner reports its own stale files: since
# 0.1.2 (goldens-split) tools/assemble --check reports a _gen/goldens*.gen.ts no render writes.
GEN_TREES = ("plugin/skills", "plugin/" + LAUNCHER_DIR, "plugin/assets", "plugin/tests/unit/_gen",
             "docs") + OLD_LAUNCHER_DIRS
GEN_FLAT = (("plugin", ""), ("plugin/.claude-plugin", ""), ("plugin/hooks/lib", ".gen.ts"))
OTHER_GEN = {
    "plugin/assets/canary-baseline.json": "tools/canary-baseline",
    "plugin/tests/unit/_gen/brand.gen.ts": "tools/fixtures-gen",
    "plugin/tests/unit/_gen/corpus.gen.ts": "tools/fixtures-gen",
    "plugin/tests/unit/_gen/payloads.gen.ts": "tools/fixtures-gen",
    "plugin/tests/unit/_gen/paths.gen.ts": "tools/fixtures-gen",
    "plugin/tests/unit/_gen/helper-replies.gen.ts": "tools/helper-replies-gen",
}
# The goldens index and its data modules (goldens.<asset>[.<n>].gen.ts, tools/assemble).
OTHER_GEN_PATTERNS = {
    re.compile(r"^plugin/tests/unit/_gen/goldens(\.[a-z0-9-]+)*\.gen\.ts$"): "tools/assemble --goldens",
}
IGNORED_FILES = {".DS_Store"}
VARIANTS = ("skills-only", "triggers-off")   # E1-plan-changes finding 2 (H11 arms)
OUT_MARK = ".tools-build-out"   # written into every --out DIR
# Inputs of a variant besides the copied plugin/ files: they must match HEAD.
VARIANT_INPUTS = ("plugin", "src", "brand.json", "LICENSE", "tools/build")


def other_gen(rel):
    """The tool that writes rel, when OTHER_GEN or OTHER_GEN_PATTERNS names one; else None."""
    if rel in OTHER_GEN:
        return OTHER_GEN[rel]
    return next((tool for pat, tool in OTHER_GEN_PATTERNS.items() if pat.match(rel)), None)


def die(msg):
    print("build: " + msg, file=sys.stderr)
    sys.exit(2)


def read(rel):
    with open(os.path.join(REPO, rel), encoding="utf-8") as f:
        return f.read()


def read_bytes(path):
    with open(path, "rb") as f:
        return f.read()


def strip(text):
    return COMMENT.sub("", text)


def render(text, name, brand=None):
    """Strip review comments and fill {{plugin}}; with brand also {{repo}} and {{cc_min}}."""
    out = strip(text).replace("{{plugin}}", name)
    if brand is not None:
        out = out.replace("{{repo}}", brand["repo"]).replace("{{cc_min}}", brand["cc_min"])
    return out


def render_manifest(text, brand):
    out = text.replace("{{plugin}}", brand["name"]).replace("{{marketplace}}", brand["marketplace"])
    out = out.replace("{{repo}}", json.dumps(brand["repo"])[1:-1]).replace("{{cc_min}}", json.dumps(brand["cc_min"])[1:-1])
    out = out.replace("{{version}}", json.dumps(brand["version"])[1:-1])
    out = out.replace("{{description}}", json.dumps(brand["description"], ensure_ascii=False)[1:-1])
    json.loads(out)  # must stay valid JSON
    left = PLACEHOLDER.search(out)
    if left:
        die("a manifest has a placeholder tools/build does not fill: " + left.group(0))
    return out


VERSION_RE = re.compile(r"^[0-9A-Za-z.+-]{1,32}$")
# brand.json repo (GitHub owner/name) and cc_min (digits and dots: it also goes into a badge URL).
REPO_RE = re.compile(r"^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$")
CC_MIN_RE = re.compile(r"^[0-9]+(?:\.[0-9]+){0,3}$")
PLACEHOLDER = re.compile(r"\{\{[A-Za-z_]+\}\}")

# ---------------------------------------------------------------- docs

LANDING = "src/landing.md"
DOCS_SRC = "src/docs"
DOCS_ORDER = DOCS_SRC + "/ORDER"
PLUGIN_HEADER = DOCS_SRC + "/_plugin-header.md"
PLUGIN_FOOTER = DOCS_SRC + "/_plugin-footer.md"
CONTENTS = "Contents"
FENCE = re.compile(r"^[ \t]*(```|~~~)")
HEADING = re.compile(r"^(#{1,6})[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$")
# An inline link or image; the target has no spaces or parentheses.
MD_LINK = re.compile(r"(!?)\[([^\]\n]*)\]\(([^()\s]+)\)")
CODE_SPAN = re.compile(r"(`+)(?:(?!\1).)+?\1")
URL_RE = re.compile(r"^(?:https?://|mailto:)")
PAGE_LINK = re.compile(r"^([A-Za-z0-9_.-]+\.md)(?:#(.*))?$")


class Docs:
    """Problems found while rendering the docs; reported together."""
    def __init__(self):
        self.problems = []

    def bad(self, msg):
        self.problems.append(msg)


def gh_slug(text):
    """GitHub's heading anchor: link text kept, tags dropped, lower case, every character but
    letters, digits, `_`, `-` and spaces dropped, spaces to `-`."""
    t = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)
    t = re.sub(r"<[^>]+>", "", t).strip().lower()
    t = re.sub(r"[^\w\- ]", "", t)
    return t.replace(" ", "-")


def md_lines(text):
    """(index, line, in_fence) for every line; fence lines themselves count as in a fence."""
    fence = None
    for i, line in enumerate(text.split("\n")):
        m = FENCE.match(line)
        if m and fence is None:
            fence = m.group(1)
            yield i, line, True
        elif m and line.strip().startswith(fence):
            fence = None
            yield i, line, True
        else:
            yield i, line, fence is not None


def md_headings(text):
    """[(level, text)] outside code fences."""
    out = []
    for _i, line, in_fence in md_lines(text):
        m = None if in_fence else HEADING.match(line)
        if m:
            out.append((len(m.group(1)), m.group(2)))
    return out


def anchors_of(text):
    """The anchors GitHub gives the headings of one file, a repeat suffixed -1, -2, ..."""
    seen, out = {}, []
    for _lv, h in md_headings(text):
        s = gh_slug(h)
        n = seen.get(s, 0)
        seen[s] = n + 1
        out.append(s if n == 0 else "{}-{}".format(s, n))
    return out


def docs_order(dx):
    """(shipped pages, GitHub-only pages) from src/docs/ORDER; every src/docs/*.md but _*.md in one."""
    shipped, github, cur = [], [], None
    for no, line in enumerate(read(DOCS_ORDER).split("\n"), 1):
        s = line.strip()
        if not s:
            continue
        if s.startswith("#"):
            word = s.lstrip("#").strip().lower()
            if word == "shipped":
                cur = shipped
            elif word == "github":
                cur = github
            continue
        if cur is None:
            dx.bad("{}:{}: {} comes before a `# shipped` or `# github` line".format(DOCS_ORDER, no, s))
        elif s in shipped or s in github:
            dx.bad("{}:{}: {} is listed twice".format(DOCS_ORDER, no, s))
        elif not os.path.isfile(os.path.join(REPO, DOCS_SRC, s)):
            dx.bad("{}:{}: {} is listed but src/docs/{} is missing".format(DOCS_ORDER, no, s, s))
        else:
            cur.append(s)
    listed = set(shipped) | set(github)
    for f in sorted(os.listdir(os.path.join(REPO, DOCS_SRC))):
        if f.startswith(".") or f == "ORDER" or (f.startswith("_") and f.endswith(".md")):
            continue
        if not f.endswith(".md") or not os.path.isfile(os.path.join(REPO, DOCS_SRC, f)):
            dx.bad("src/docs/{}: only .md pages, ORDER and _*.md parts belong in src/docs".format(f))
        elif f not in listed:
            dx.bad("src/docs/{} is in neither list of {}".format(f, DOCS_ORDER))
    return shipped, github


def map_links(text, fn):
    """text with every inline link outside code fences and code spans replaced by fn(bang, label, target, line no)."""
    out = text.split("\n")
    for i, line, in_fence in md_lines(text):
        if in_fence or "](" not in line:
            continue
        code = [m.span() for m in CODE_SPAN.finditer(line)]

        def sub(m, i=i, code=code):
            if any(a <= m.start() < b for a, b in code):
                return m.group(0)
            return "{}[{}]({})".format(m.group(1), m.group(2), fn(m.group(1), m.group(2), m.group(3), i + 1))
        out[i] = MD_LINK.sub(sub, line)
    return "\n".join(out)


def shift_headings(text, dx, where):
    out = text.split("\n")
    for i, line, in_fence in md_lines(text):
        if not in_fence and HEADING.match(line):
            if line.startswith("######"):
                dx.bad("{}:{}: an H6 cannot move one level down into plugin/README.md".format(where, i + 1))
            else:
                out[i] = "#" + line
    return "\n".join(out)


def repo_path_exists(rel, gen):
    rel = rel.split("#", 1)[0]
    p = os.path.normpath(rel)
    return not p.startswith("..") and (p in gen or os.path.exists(os.path.join(REPO, p)) or
                                       any(g.startswith(p + "/") for g in gen))


def docs_plan(brand, gen):
    """{path: text} for README.md, docs/<page> and plugin/README.md, and the problems found."""
    dx = Docs()
    name, repo = brand["name"], brand["repo"]
    out = {}
    if not os.path.isfile(os.path.join(REPO, LANDING)):
        dx.bad(LANDING + " is missing (the source of README.md)")
        return out, dx
    if not os.path.isdir(os.path.join(REPO, DOCS_SRC)) or not os.path.isfile(os.path.join(REPO, DOCS_ORDER)):
        dx.bad(DOCS_ORDER + " is missing")
        return out, dx
    shipped, github = docs_order(dx)
    pages = {p: render(read(DOCS_SRC + "/" + p), name, brand) for p in shipped + github}
    anchors = {p: anchors_of(t) for p, t in pages.items()}
    h1 = {}
    for p, t in pages.items():
        hs = md_headings(t)
        first = next((ln for ln in t.split("\n") if ln.strip()), "")
        if not hs or hs[0][0] != 1 or not HEADING.match(first) or sum(1 for lv, _h in hs if lv == 1) != 1:
            dx.bad("src/docs/{}: a page starts with its one H1 and has no other".format(p))
        h1[p] = anchors[p][0] if anchors[p] else ""
    gh_base = "https://github.com/{}/blob/main/".format(repo)

    def page_target(target, where, line):
        """(page, anchor or None) for `page.md[#a]` with the anchor checked, else None."""
        m = PAGE_LINK.match(target)
        if not m or m.group(1) not in pages:
            return None
        page, a = m.group(1), m.group(2)
        if a is not None and a not in anchors[page]:
            dx.bad("{}:{}: unresolved link {}: {} has no heading with the anchor #{}".format(where, line, target, page, a))
        return page, a

    def doc_link(page, mode):
        where = "src/docs/" + page if page else PLUGIN_HEADER

        def fn(bang, label, target, line):
            if URL_RE.match(target):
                return target
            if bang and page in github and mode == "docs" and target.startswith("../"):
                if not repo_path_exists(target[3:], gen):
                    dx.bad("{}:{}: image {} not found".format(where, line, target))
                return target
            if bang:
                dx.bad("{}:{}: relative image {} in a shipped page (images belong in GitHub-only pages)".format(where, line, target))
                return target
            if target.startswith("#"):
                own = anchors.get(page) if page else [a for p in shipped for a in anchors[p]]
                if target[1:] not in own:
                    dx.bad("{}:{}: unresolved link {}: no heading here has that anchor".format(where, line, target))
                return target
            pt = page_target(target, where, line)
            if pt is not None:
                tp, a = pt
                if mode == "docs":
                    return target
                if tp in github:
                    return gh_base + "docs/" + tp + ("#" + a if a else "")
                return "#" + (a if a else h1[tp])
            if target.startswith("../"):
                rel = target[3:]
                if not repo_path_exists(rel, gen):
                    dx.bad("{}:{}: link {}: no file {} in the repository".format(where, line, target, rel.split("#")[0]))
                if mode == "docs":
                    return target
                if rel.startswith("plugin/"):
                    return rel[len("plugin/"):]
                if rel.split("#")[0] in ("LICENSE", "NOTICE"):
                    return rel
                return gh_base + rel
            dx.bad("{}:{}: link {}: write page.md#anchor, #anchor, ../<repo path> or a URL".format(where, line, target))
            return target
        return fn

    for p, t in pages.items():
        out["docs/" + p] = map_links(t, doc_link(p, "docs"))

    # The landing page: docs/page.md#a, #a, repo paths as written.
    land = render(read(LANDING), name, brand)
    land_anchors = anchors_of(land)

    def land_fn(bang, label, target, line):
        where = LANDING
        if URL_RE.match(target):
            return target
        if target.startswith("#"):
            if target[1:] not in land_anchors:
                dx.bad("{}:{}: unresolved link {}: no heading here has that anchor".format(where, line, target))
            return target
        if target.startswith("docs/"):
            if page_target(target[5:], where, line) is None:
                dx.bad("{}:{}: link {}: no such page in {}".format(where, line, target, DOCS_ORDER))
            return target
        if target.startswith("../") or not repo_path_exists(target, gen):
            dx.bad("{}:{}: link {}: no file {} in the repository".format(where, line, target, target.split("#")[0]))
        return target
    out["README.md"] = map_links(land, land_fn)

    # plugin/README.md: header, Contents, the shipped pages one level down, footer.
    header = render(read(PLUGIN_HEADER), name, brand)
    footer = render(read(PLUGIN_FOOTER), name, brand)
    contents = "## {}\n\n".format(CONTENTS) + "".join(
        "- [{}](#{})\n".format(next((h for lv, h in md_headings(pages[p]) if lv == 1), p), h1[p]) for p in shipped)
    parts = [("_plugin-header.md", map_links(header, doc_link(None, "plugin"))), ("Contents", contents)]
    parts += [(p, shift_headings(map_links(pages[p], doc_link(p, "plugin")), dx, "src/docs/" + p)) for p in shipped]
    parts.append(("_plugin-footer.md", map_links(footer, doc_link(None, "plugin"))))
    owner = {}
    for part, text in parts:
        for _lv, h in md_headings(text):
            s = gh_slug(h)
            if s in owner:
                dx.bad("heading {!r} ({}) is also in {} (anchor #{}): plugin/README.md joins both, so GitHub would "
                       "give the second #{}-1; give one a page-specific heading".format(h, part, owner[s], s, s))
            else:
                owner[s] = part
    out["plugin/README.md"] = "\n\n".join(t.strip("\n") for _p, t in parts) + "\n"

    for rel, text in out.items():
        for no, line in enumerate(text.split("\n"), 1):
            for m in PLACEHOLDER.finditer(line):
                dx.bad("{}:{}: placeholder {} is not filled by tools/build ({{{{plugin}}}}, {{{{repo}}}} and "
                       "{{{{cc_min}}}} are)".format(rel, no, m.group(0)))
    return out, dx


def print_headings(brand):
    dx = Docs()
    shipped, github = docs_order(dx)
    for p in shipped + github:
        t = render(read(DOCS_SRC + "/" + p), brand["name"], brand)
        for (lv, h), a in zip(md_headings(t), anchors_of(t)):
            print("{}\t{}{}\t{}\t#{}".format(p, "H", lv, h, a))
    for msg in dx.problems:
        print("docs: " + msg, file=sys.stderr)
    return 1 if dx.problems else 0


def launch_env(name):
    """The env name the restart launcher exports its launch folder in (AFK_COMPACT_LAUNCH for
    afk-compact): the plugin name in upper case, `-` as `_`, then `_LAUNCH`. The plugin side
    reads the same name, so both come from here."""
    return name.upper().replace("-", "_") + "_LAUNCH"


def render_claude_launcher(text, brand):
    """src/claude-launcher.tmpl: the plugin name, its launch env name and the version."""
    if not VERSION_RE.match(brand["version"]):
        die("brand.json version {!r} cannot go into the launcher".format(brand["version"]))
    out = render(text, brand["name"]).replace("{{launch_env}}", launch_env(brand["name"]))
    out = out.replace("{{version}}", brand["version"])
    if "{{" in out:
        die("src/claude-launcher.tmpl has a placeholder tools/build does not fill: " +
            out[out.index("{{"):out.index("{{") + 40].split("\n")[0])
    return out


def ts_header(src):
    return "// GEN by tools/build from {}. Do not edit; edit the source and run tools/build.\n".format(src)


def files_under(rel):
    base = os.path.join(REPO, rel)
    out = []
    for d, dirs, files in os.walk(base):
        dirs.sort()
        for f in sorted(files):
            if f.startswith(".") and f != ".gitkeep":
                continue
            out.append(os.path.relpath(os.path.join(d, f), REPO))
    return out


def gen_place_files():
    """Every file (dotfiles too) under GEN_TREES and directly in the GEN_FLAT folders."""
    out = set()
    for rel in GEN_TREES:
        for d, dirs, files in os.walk(os.path.join(REPO, rel)):
            dirs.sort()
            out.update(os.path.relpath(os.path.join(d, f), REPO) for f in files if f not in IGNORED_FILES)
    for rel, suffix in GEN_FLAT:
        base = os.path.join(REPO, rel)
        for f in sorted(os.listdir(base)) if os.path.isdir(base) else []:
            if f not in IGNORED_FILES and f.endswith(suffix) and os.path.isfile(os.path.join(base, f)):
                out.add(os.path.join(rel, f))
    return sorted(out)


def check_context_note(spec):
    """approval_context_re spells carry.foreign_approval_note
    literally, so a changed note must change the regex too (the context-only own line reuses the
    foreign form). Dies when the regex lacks the note, escaped as a regex literal."""
    rx = spec.get("approval_context_re")
    if rx is None:
        return
    note = (spec.get("carry") or {}).get("foreign_approval_note")
    lit = re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", note) if isinstance(note, str) else None
    if not isinstance(rx, str) or lit is None or lit not in rx:
        die("spec-literals: approval_context_re does not hold carry.foreign_approval_note ({!r})".format(note))


def plan(brand):
    """Return ({repo-relative path: (text, mode)} for every GEN file of tools/build, [docs problems])."""
    name = brand["name"]
    out = {}
    out["plugin/.claude-plugin/plugin.json"] = (render_manifest(read("src/plugin.json"), brand), PLAIN)
    out[".claude-plugin/marketplace.json"] = (render_manifest(read("src/marketplace.json"), brand), PLAIN)
    out["plugin/hooks/hooks.json"] = (render_manifest(render(read("src/hooks.json"), name), brand), PLAIN)

    # Assets: rendered files for the helper, and the same text for the mod.
    asset_parts = {}
    spec = None
    # A file in a subfolder keeps its path (src/assets/examples/x -> plugin/assets/examples/x);
    # what is under examples/ ships executable: a program a user copies and runs as it is
    # (the queue_cmd example). The mod's texts are the top-level .txt files only.
    for rel in files_under("src/assets"):
        sub = os.path.relpath(rel, "src/assets")
        base = os.path.basename(rel)
        text = read(rel)
        out["plugin/assets/" + sub] = (render(text, name), EXEC if sub.startswith("examples/") else PLAIN)
        if sub != base:
            continue
        if base.endswith(".txt"):
            asset_parts[base[:-4]] = strip(text).split("{{plugin}}")
        if base == "handoff-spec.md":
            m = SPEC_BLOCK.search(render(text, name))
            if not m:
                die("src/assets/handoff-spec.md has no ```json spec-literals block")
            try:
                spec = json.loads(m.group(1))
            except ValueError as e:
                die("spec-literals block is not valid JSON: {}".format(e))
            check_context_note(spec)
    if spec is not None:
        out["plugin/assets/handoff-spec.json"] = (json.dumps(spec, indent=2, ensure_ascii=False) + "\n", PLAIN)

    lines = [ts_header("src/assets/*.txt (review markers stripped)"),
             "// Each asset is kept in parts split at the plugin name; assetText joins them\n",
             "// with the name the mod reads at run time ($.plugin.name).\n",
             "const parts = {\n"]
    for key in sorted(asset_parts):
        lines.append("  {}: {},\n".format(json.dumps(key), json.dumps(asset_parts[key], ensure_ascii=False)))
    lines.append("} as const\n\n")
    lines.append("export type AssetName = keyof typeof parts\n\n")
    lines.append("export const ASSET_NAMES = Object.keys(parts) as AssetName[]\n\n")
    lines.append("export function assetText(name: AssetName, plugin: string): string {\n")
    lines.append("  return parts[name].join(plugin)\n}\n")
    out["plugin/hooks/lib/assets.gen.ts"] = ("".join(lines), PLAIN)

    if spec is None:
        spec_ts = (ts_header("src/assets/handoff-spec.md (not present yet)") +
                   "export const SPEC_PRESENT = false as const\n\nexport const SPEC = {} as const\n")
    else:
        spec_ts = (ts_header("the ```json spec-literals block of src/assets/handoff-spec.md") +
                   "export const SPEC_PRESENT = true as const\n\nexport const SPEC = " +
                   json.dumps(spec, indent=2, ensure_ascii=False) + " as const\n")
    out["plugin/hooks/lib/spec.gen.ts"] = (spec_ts, PLAIN)
    out["plugin/hooks/lib/meta.gen.ts"] = (ts_header("brand.json") + "export const PLUGIN_VERSION = " +
                                           json.dumps(brand["version"]) + "\n", PLAIN)
    # The restart launcher's launch folder env, read by its literal name
    # (the engine takes literal $.env.get names only); the launcher exports the same name.
    env = launch_env(name)
    out["plugin/hooks/lib/launch.gen.ts"] = (
        ts_header("brand.json") +
        "import type { EngineInterface } from 'claude-code'\n\n"
        "/** The env the restart launcher exports its launch folder in (tools/build launch_env). */\n"
        "export const LAUNCH_ENV = " + json.dumps(env) + "\n\n"
        "/** The launch folder of the restart launcher this session runs under, or undefined. */\n"
        "export async function launchDir($: EngineInterface): Promise<string | undefined> {\n"
        "  const v = await $.env.get(" + json.dumps(env).replace('"', "'") + ")\n"
        "  return typeof v === 'string' && v !== '' ? v : undefined\n}\n", PLAIN)

    for rel in files_under("src/skills"):
        out["plugin/skills/" + os.path.relpath(rel, "src/skills")] = (render(read(rel), name), PLAIN)

    out["plugin/{}/{}-store".format(LAUNCHER_DIR, name)] = (render(read("src/launcher.tmpl"), name), EXEC)
    # The opt-in restart launcher: beside the helper launcher, never in a
    # bin/ folder (a plugin's bin/ joins the Bash tool's PATH; the model must not start sessions).
    out["plugin/{}/{}-claude".format(LAUNCHER_DIR, name)] = (
        render_claude_launcher(read("src/claude-launcher.tmpl"), brand), EXEC)

    if os.path.exists(os.path.join(REPO, "LICENSE")):
        out["plugin/LICENSE"] = (read("LICENSE"), PLAIN)
    notice = render(read("src/NOTICE"), name)
    out["NOTICE"] = (notice, PLAIN)
    out["plugin/NOTICE"] = (notice, PLAIN)
    # README.md, docs/ and plugin/README.md from src/landing.md and src/docs/ (module docstring).
    docs, dx = docs_plan(brand, out)
    for rel, text in docs.items():
        out[rel] = (text, PLAIN)
    return out, dx.problems


def state_text(brand, gen):
    return json.dumps({"name": brand["name"], "files": sorted(gen)}, indent=2) + "\n"


def load_state():
    p = os.path.join(REPO, STATE)
    if not os.path.exists(p):
        return {"name": None, "files": []}
    with open(p, encoding="utf-8") as f:
        return json.load(f)


def write_file(root, rel, text, mode):
    p = os.path.join(root, rel)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    os.chmod(p, mode)


def apply_variant(gen, variant):
    """The experiment arms. skills-only: drop the hooks (classic hooks.json and the mod) so nothing
    runs at compaction; the skills and their helper stay. triggers-off: pin triggers to false."""
    if variant == "skills-only":
        return {rel: v for rel, v in gen.items() if not rel.startswith(("plugin/hooks/", "plugin/tests/"))}
    if variant == "triggers-off":
        rel = "plugin/.claude-plugin/plugin.json"
        doc = json.loads(gen[rel][0])
        doc["userConfig"]["triggers"]["default"] = False
        return dict(gen, **{rel: (json.dumps(doc, indent=2, ensure_ascii=False) + "\n", gen[rel][1])})
    die("unknown variant " + variant)


def tree_sha(root):
    """sha256 over every file under root: relative path, exec bit and bytes, in sorted order."""
    h = hashlib.sha256()
    for d, dirs, files in os.walk(root):
        dirs.sort()
        for f in sorted(files):
            p = os.path.join(d, f)
            h.update(os.path.relpath(p, root).encode("utf-8") + b"\0")
            h.update(b"x" if os.stat(p).st_mode & stat.S_IXUSR else b"-")
            h.update(read_bytes(p) + b"\0")
    return h.hexdigest()


def same_file(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def out_root(out_dir):
    """The real path of --out, or die. samefile (device and inode) sees through
    symlinks and letter case, which a string compare does not (case-insensitive APFS)."""
    root = os.path.realpath(os.path.abspath(out_dir))
    repo = os.path.realpath(REPO)
    p = repo
    while True:
        if same_file(p, root):
            die("--out must not be the repo or one of its parents: " + out_dir)
        up = os.path.dirname(p)
        if up == p:
            break
        p = up
    parts, p = [], root
    while True:
        if same_file(p, repo):
            rel = parts[::-1]
            in_tmp = bool(rel) and (rel[0] == "tmp" or same_file(os.path.join(p, rel[0]), os.path.join(repo, "tmp")))
            if len(rel) < 2 or not in_tmp or rel[1].lower().startswith("store-h-"):
                die("--out inside the repo must be under tmp/<name>/ (gitignored scratch, not "
                    "tmp/store-h-*): " + out_dir)
            break
        up = os.path.dirname(p)
        if up == p:
            break
        parts.append(os.path.basename(p))
        p = up
    if os.path.lexists(root):
        if not os.path.isdir(root):
            die("--out exists and is not a folder: " + out_dir)
        if os.listdir(root) and not os.path.isfile(os.path.join(root, OUT_MARK)):
            die("--out {} exists, is not empty and has no {} mark from an earlier --out run; "
                "it is left alone: pick a new folder or empty it yourself".format(out_dir, OUT_MARK))
    return root


def ships(rel, old_gen, variant):
    """A plugin/ file the --out copy takes from the work tree (GEN files are rendered instead)."""
    if rel in old_gen or rel.startswith(("plugin/.claude-plugin/types/", "plugin/{}/".format(LAUNCHER_DIR),
                                         "plugin/skills/") + tuple(d + "/" for d in OLD_LAUNCHER_DIRS)):
        return False
    if os.path.basename(rel).startswith(".") and os.path.basename(rel) != ".gitkeep":
        return False
    return not (variant == "skills-only" and rel.startswith(("plugin/hooks/", "plugin/tests/")))


def git(args):
    try:
        r = subprocess.run(["git", "-C", REPO] + args, capture_output=True, text=True)
    except OSError:
        return None
    return r.stdout if r.returncode == 0 else None


def variant_source(old_gen, variant):
    """(HEAD sha, tracked plugin/ files to copy) when every variant input matches
    HEAD, else (None, reason). Untracked files count; uncommitted GEN files under plugin/ do
    not (the variant renders those from src/)."""
    top = git(["rev-parse", "--show-toplevel"])
    if top is None or not same_file(top.strip(), REPO):
        return None, "not a git checkout of its own"
    head = (git(["rev-parse", "--verify", "HEAD"]) or "").strip()
    st = git(["status", "--porcelain", "-z", "--untracked-files=all", "--no-renames", "--"] + list(VARIANT_INPUTS))
    if not head or st is None:
        return None, "git status failed"
    dirty = []
    for entry in st.split("\0"):
        rel = entry[3:]
        if rel and (not rel.startswith("plugin/") or ships(rel, old_gen, variant)):
            dirty.append(rel)
    if dirty:
        return None, "{} paths differ from HEAD: {}".format(len(dirty), ", ".join(sorted(dirty)[:8]))
    tracked = git(["ls-files", "-z", "--", "plugin"])
    if tracked is None:
        return None, "git ls-files failed"
    return head, sorted(rel for rel in tracked.split("\0") if rel and ships(rel, old_gen, variant))


def main(argv):
    check = False
    allow_dirty = False
    headings = False
    name = None
    out_dir = None
    variant = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--check":
            check = True
        elif a == "--allow-dirty":
            allow_dirty = True
        elif a == "--headings":
            headings = True
        elif a == "--name" and i + 1 < len(argv):
            name = argv[i + 1]
            i += 1
        elif a == "--out" and i + 1 < len(argv):
            out_dir = argv[i + 1]
            i += 1
        elif a == "--variant" and i + 1 < len(argv) and argv[i + 1] in VARIANTS:
            variant = argv[i + 1]
            i += 1
        else:
            die("unknown argument " + a + "\n" + __doc__)
        i += 1
    brand = json.loads(read("brand.json"))
    for k in ("name", "marketplace", "version", "description", "repo", "cc_min"):
        if not isinstance(brand.get(k), str) or not brand[k]:
            die("brand.json lacks " + k)
    if name is not None:
        if brand["marketplace"] == brand["name"]:
            brand["marketplace"] = name
        brand["name"] = name
        # The repo slug holds the brand: the rename drill renames it too (owner kept).
        brand["repo"] = brand["repo"].split("/")[0] + "/" + name
    if not NAME_RE.match(brand["name"]):
        die("plugin name must be kebab-case: " + brand["name"])
    if not REPO_RE.match(brand["repo"]):
        die("brand.json repo must be <owner>/<name> as on GitHub: " + brand["repo"])
    if not CC_MIN_RE.match(brand["cc_min"]):
        die("brand.json cc_min must be digits and dots (it goes into a badge URL): " + brand["cc_min"])
    if name is not None and out_dir is None and not check:
        die("--name needs --out (rename the repo by editing brand.json)")
    if variant is not None and (out_dir is None or check):
        die("--variant needs --out (a variant never replaces the repo's build)")
    if headings:
        return print_headings(brand)

    gen, doc_problems = plan(brand)
    old = load_state()

    if doc_problems and not check:
        die("the docs do not render ({} problems):\n  ".format(len(doc_problems)) + "\n  ".join(doc_problems))

    if check:
        problems = ["docs: " + p for p in doc_problems]
        for rel, (text, mode) in sorted(gen.items()):
            p = os.path.join(REPO, rel)
            if not os.path.exists(p):
                problems.append("missing " + rel)
                continue
            # Bytes, not universal-newline text: a CRLF launcher passes a text compare but
            # cannot run (`#!/bin/sh\r`).
            if read_bytes(p) != text.encode("utf-8"):
                problems.append("differs " + rel)
            if bool(os.stat(p).st_mode & stat.S_IXUSR) != bool(mode & stat.S_IXUSR):
                problems.append("mode " + rel)
        stale = set()
        for rel in old["files"]:
            if rel not in gen and os.path.exists(os.path.join(REPO, rel)):
                stale.add(rel)
        for rel in gen_place_files():
            if rel not in gen and not other_gen(rel):
                stale.add(rel)
        problems += ["stale " + rel for rel in sorted(stale)]
        st = os.path.join(REPO, STATE)
        if not os.path.exists(st) or read_bytes(st) != state_text(brand, gen).encode("utf-8"):
            problems.append("differs " + STATE)
        for p in problems:
            print(p)
        if any(re.match(r"^(?:differs|stale|missing) (?:docs/|README\.md$|plugin/README\.md$)", p) for p in problems):
            print("hint: README.md, docs/ and plugin/README.md are generated: edit src/landing.md or "
                  "src/docs/<page>.md, then run tools/build")
        print("BUILD CHECK: " + ("FAIL ({} problems)".format(len(problems)) if problems else "PASS"))
        return 1 if problems else 0

    if out_dir is not None:
        root = out_root(out_dir)
        old_gen = set(old["files"])
        commit, unverified, copy = None, None, None
        if variant is not None:
            commit, copy = variant_source(old_gen, variant)
            if commit is None:
                if not allow_dirty:
                    die("--variant: {}; a frozen arm must come from one commit (commit or remove "
                        "them, or pass --allow-dirty for a hash marked UNVERIFIED)".format(copy))
                unverified, copy = copy, None
        if copy is None:
            copy = [rel for rel in files_under("plugin") if ships(rel, old_gen, variant)]
        if os.path.lexists(root):
            shutil.rmtree(root)
        os.makedirs(root)
        write_file(root, OUT_MARK, "written by tools/build --out; a later --out run may replace this folder\n", PLAIN)
        for rel in copy:
            src = os.path.join(REPO, rel)
            dst = os.path.join(root, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)
        if variant is not None:
            gen = apply_variant(gen, variant)
        for rel, (text, mode) in gen.items():
            write_file(root, rel, text, mode)
        print("built {} files for {} into {}{}".format(len(gen), brand["name"], root,
                                                       " (variant {})".format(variant) if variant else ""))
        if variant is not None:
            sha = tree_sha(os.path.join(root, "plugin"))
            if commit:
                print("tree sha256 {} {} commit {}".format(sha, variant, commit))
            else:
                print("tree sha256 {} {} UNVERIFIED ({}): not for a record".format(sha, variant, unverified))
        return 0

    for rel in old["files"]:
        if rel not in gen:
            p = os.path.join(REPO, rel)
            if os.path.exists(p):
                os.unlink(p)
                print("removed stale " + rel)
    for rel in OLD_LAUNCHER_DIRS:
        # Only an empty folder goes (rmdir); a file someone left there stays, and --check
        # reports it stale (tools/build deletes only what an earlier build wrote).
        p = os.path.join(REPO, rel)
        if os.path.isdir(p) and not os.path.islink(p) and not os.listdir(p):
            os.rmdir(p)
            print("removed empty " + rel + "/")
    for rel, (text, mode) in gen.items():
        write_file(REPO, rel, text, mode)
    write_file(REPO, STATE, state_text(brand, gen), PLAIN)
    print("built {} files for {}".format(len(gen), brand["name"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
