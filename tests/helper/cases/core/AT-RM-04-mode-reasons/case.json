{
 "id": "AT-RM-01, AT-RM-04, AT-RM-06 (mode part)",
 "note": "Repo mode (lib/repomode.pm, roots::repo_check, rc::mode, status Block C). Every repository below is listed in repo_roots in the user's settings file. A bad declaration (root ../x, /abs, a/../../x, .git/x, .planning/x, invalid JSON, version 2) gives private (repo-decl-invalid); a symlinked root component gives repo-root-symlink; a folder holding a nested .git gives repo-root-nested; nothing is written under any of these repositories. A valid declaration that is not accepted gives private (not-accepted) with the /config accept route and one handoff_mode {private, not-accepted, declared:true} row (AT-RM-01). Accepted: repo (accepted), the export count; an ignored root and a .gitignore without the generated lines are reported, each with one row. A worktree of an accepted main checkout is accepted through main_checkout (AT-RM-06)",
 "now": "2026-10-21T14:05:12+03:00",
 "tz": "Etc/GMT-3",
 "steps": [
  {"setup": [
    {"repo": "$TMP/r1", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \"../x\"}\n"}},
    {"repo": "$TMP/r2", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \"/abs\"}\n"}},
    {"repo": "$TMP/r3", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \"a/../../x\"}\n"}},
    {"repo": "$TMP/r4", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \"docs/handoffs\"}\n"}},
    {"mkdir": "$TMP/outside"},
    {"symlink": "$TMP/r4/docs", "to": "$TMP/outside"},
    {"repo": "$TMP/r5", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \".git/x\"}\n"}},
    {"repo": "$TMP/r6", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \".planning/x\"}\n"}},
    {"repo": "$TMP/r7", "files": {"README.md": "r\n", "sub/.git": "gitdir: ../.git/modules/sub\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \"sub/handoffs\"}\n"}},
    {"repo": "$TMP/r8", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\",\n"}},
    {"repo": "$TMP/r9", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 2, \"mode\": \"repo\", \"root\": \".claude/handoffs\"}\n"}},
    {"repo": "$TMP/r10", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \".claude/handoffs\", \"later\": true}\n"}},
    {"repo": "$TMP/r11", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\"}\n"}, "ignore": [".claude/handoffs/"]},
    {"repo": "$TMP/r12", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \"docs/handoffs\"}\n", "docs/handoffs/.gitignore": "compact/\n"}},
    {"repo": "$TMP/r13", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\"}\n"}},
    {"repo": "$TMP/r14", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \".GIT/handoffs\"}\n"}},
    {"repo": "$TMP/r15", "files": {"README.md": "r\n", ".claude/handoffs.json": "{\"version\": 1, \"mode\": \"repo\", \"root\": \".Planning/x\"}\n"}},
    {"git": ["worktree", "add", "-q", "-b", "wt", "$TMP/w10"], "cwd": "$TMP/r10"},
    {"write": "$TMP/planted/.git", "text": "gitdir: $TMP/r10/.git\n"},
    {"write": "$TMP/planted/.claude/handoffs.json", "text": "{\"version\": 1, \"mode\": \"repo\"}\n"},
    {"write": "$TMP/planted2/.git", "text": "gitdir: $TMP/r10/.git/worktrees/w10\n"},
    {"write": "$TMP/planted2/.claude/handoffs.json", "text": "{\"version\": 1, \"mode\": \"repo\"}\n"},
    {"write": "$HOME/.claude/settings.json", "json": {"pluginConfigs": {"$BRAND@m": {"options": {"repo_roots": "$TMP/r1;$TMP/r2;$TMP/r3; $TMP/r4 ;$TMP/r5;$TMP/r6;$TMP/r7;$TMP/r8;$TMP/r9;$TMP/r10;$TMP/r11;$TMP/r12;$TMP/r14;$TMP/r15;$TMP/gone"}}}}}
  ]},
  {"name": "../x", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r1"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$", "^  repo_roots: stale entry \\S+/gone \\(not a folder\\)$"], "absent": ["$TMP/x"]}},
  {"name": "/abs", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r2"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"]}},
  {"name": "a/../../x", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r3/"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"]}},
  {"name": "symlink", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r4"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-root-symlink\\)$"], "absent": ["$TMP/outside/handoffs"]}},
  {"name": ".git/x", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r5"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"], "absent": ["$TMP/r5/.git/x"]}},
  {"name": ".planning/x", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r6"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"], "absent": ["$TMP/r6/.planning"]}},
  {"name": "nested .git", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r7"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-root-nested\\)$"], "absent": ["$TMP/r7/sub/handoffs"]}},
  {"name": "invalid JSON", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r8"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"]}},
  {"name": "version 2", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r9"], "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"], "absent": ["$TMP/r9/.claude/handoffs"]}},
  {"name": "accepted, unknown key, no export yet", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r10"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: repo \\(accepted\\)$", "^  exports in this worktree: 0 under \\.claude/handoffs$"],
              "stdout_lacks": ["git-ignored", "lacks the generated lines", "asks for repo mode"], "absent": ["$TMP/r10/.claude/handoffs"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "handoff_mode", "count": 1, "fields": {"mode": "repo", "reason": "accepted", "declared": true, "accepted": true}},
                       {"file": "$WATCH/$SID.classic.jsonl", "ev": "decl_unknown_keys", "count": 1, "fields": {"keys": ["later"]}}]}},
  {"setup": [{"write": "$TMP/r10/.claude/handoffs/LAB-1/2026-10-21_14-00_11111111-1a2b3c.md", "text": "x\n"},
             {"write": "$TMP/r10/.claude/handoffs/README.md", "text": "x\n"}]},
  {"name": "one export; worktree accepted through the main checkout", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r10"],
   "expect": {"exit": 0, "stdout_has": ["^  exports in this worktree: 1 under \\.claude/handoffs$"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "handoff_mode", "count": 1, "fields": {"mode": "repo", "reason": "accepted"}}, {"file": "$WATCH/$SID.classic.jsonl", "ev": "decl_unknown_keys", "count": 1}]}},
  {"name": "worktree", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/w10"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: repo \\(accepted\\)$", "^  exports in this worktree: 0 under \\.claude/handoffs$"]}},
  {"name": "ignored root", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r11"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: repo \\(accepted\\)$", "^  exports in \\.claude/handoffs are git-ignored; they will not be committed$"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "repo_root_ignored", "count": 1}]}},
  {"name": ".gitignore drift", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r12"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: repo \\(accepted\\)$", "^  docs/handoffs/\\.gitignore lacks the generated lines; the plugin never edits it$"],
              "files": [{"path": "$TMP/r12/docs/handoffs/.gitignore", "contains": ["compact/\n"], "lines": 1}],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "repo_gitignore_drift", "count": 1}]}},
  {"name": "declared, not accepted (AT-RM-01)", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r13"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(not-accepted\\)$", "^  this repository asks for repo mode; to accept it, add \\S+/r13 to repo_roots in /config \\(or in your settings file by hand\\)$"],
              "absent": ["$TMP/r13/.claude/handoffs"],
              "rows": [{"file": "$WATCH/$SID.classic.jsonl", "ev": "handoff_mode", "count": 1, "fields": {"mode": "private", "reason": "not-accepted", "declared": true, "accepted": false}}]}},
  {"name": ".GIT/handoffs is the git dir on a case-insensitive file system", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r14"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"], "absent": ["$TMP/r14/.git/handoffs", "$TMP/r14/.GIT/handoffs"]}},
  {"name": ".Planning/x", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/r15"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(repo-decl-invalid\\)$"], "absent": ["$TMP/r15/.planning", "$TMP/r15/.Planning"]}},
  {"name": "repo_check refuses .GIT and .Planning components in any case", "lib": "repo_check",
   "args": {"top": "$TMP/r14", "cases": {".GIT/handoffs": "repo-root-in-git-dir", ".Git": "repo-root-in-git-dir", "docs/.gitX/h": "repo-root-in-git-dir",
                                          ".PLANNING/x": "repo-root-in-planning", "a/.Planning": "repo-root-in-planning", ".claude/handoffs": "ok"}}},
  {"name": "a folder whose .git file points at an accepted clone's git dir is not accepted", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/planted"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(not-accepted\\)$", "^  this repository asks for repo mode; to accept it, add \\S+/planted to repo_roots"],
              "stdout_lacks": ["add \\S+/r10 to repo_roots"], "absent": ["$TMP/planted/.claude/handoffs"]}},
  {"name": "nor one that points at a real worktree's admin folder", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/planted2"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(not-accepted\\)$"], "absent": ["$TMP/planted2/.claude/handoffs"]}},
  {"name": "the worktree git made is still accepted through its main checkout", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/w10"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: repo \\(accepted\\)$"]}},
  {"name": "not a repository", "argv": ["status", "--sid", "$SID", "--cwd", "$TMP/outside"],
   "expect": {"exit": 0, "stdout_has": ["^handoff mode: private \\(not-declared\\)$"], "stdout_lacks": ["exports in this worktree"]}}
 ]
}
