      "ev": "helper_runtime_missing",
      "count": 1,
      "fields": {
       "event": "PreCompact",
       "writer": "helper"
      }
     }
    ]
   }
  },
  {
   "name": "begin",
   "argv": [
    "begin",
    "--sid",
    "$SID",
    "--topic",
    "x"
   ],
   "expect": {
