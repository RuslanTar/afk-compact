   "now": "2026-10-21T14:05:00.724+03:00",
   "argv": [
    "hook",
    "SessionStart"
   ],
   "stdin_json": {
    "cwd": "$TMP/work",
    "hook_event_name": "SessionStart",
    "session_id": "$SID",
