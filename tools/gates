def _call_args(src, start):
    """The text between the `(` that ends at `start` and its matching `)`, or None."""
    depth, i = 1, start
    while i < len(src) and depth:
        ch = src[i]
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch in "'\"`":
            j = src.find(ch, i + 1)
            while j > 0 and src[j - 1] == "\\":
                j = src.find(ch, j + 1)
            if j < 0:
                return None
            i = j
        i += 1
    return src[start:i - 1] if depth == 0 else None


def model_pin_hits(target, brand):
    """MG-1 / AT-MG-01 over a built plugin folder: every `$.session.compact(…)`,
    `$.prompt.submit(…)` and `$.command.run(…)` under hooks/ (not *.gen.ts) passes one object
    literal (REVIEW-NIGHT NR-22) with no `model`, `effort`, `fallbackModel` or `agent` key and no
    spread; no userConfig key contains `model`."""
    if not _is_plugin(target):
        return []
    out = []
    n = 0
    for d, dirs, files in os.walk(os.path.join(target, "hooks")):
        dirs[:] = sorted(x for x in dirs if x not in ("node_modules", "tests"))
        for f in sorted(files):
            if not f.endswith(".ts") or f.endswith(".gen.ts"):
                continue
            p = os.path.join(d, f)
            src = _read(p)
            for m in MODEL_PIN_CALL.finditer(src):
                n += 1
                args = _call_args(src, m.end())
                no = src.count("\n", 0, m.start()) + 1
                if args is None:
                    out.append((p, no, "AT-MG-01 parse", "AT-MG-01 parse: cannot read the arguments of ${}".format(m.group(1)), ""))
                    continue
                # REVIEW-NIGHT NR-22: only an object literal can be read for its keys; a variable or
                # a call result (`$.session.compact(opts)`) could carry a model the gate never sees.
                if not OBJECT_LITERAL_ARG.match(args):
                    out.append((p, no, "AT-MG-01 literal", "AT-MG-01 literal: ${}(…) argument is not an object literal".format(m.group(1)), ""))
                    continue
                k = MODEL_PIN_KEY.search(args)
                if k:
                    out.append((p, no, "AT-MG-01 key", "AT-MG-01 key: ${}(…) passes {!r}".format(m.group(1), k.group(0).rstrip(": ")), ""))
    if n == 0:
        out.append((os.path.join(target, "hooks"), None, "AT-MG-01 scan", "AT-MG-01 scan: no compact or submit call found", ""))
    mpath, defaults = _manifest_defaults(target)
    for key in sorted(defaults):
        if "model" in key.lower():
            out.append((mpath, None, "AT-MG-01 config", "AT-MG-01 config: userConfig key {} names a model".format(key), ""))
    return out


# AT-QA-06 (Q-ADAPTER QA-4, owner xxxxxxxx-11): the queue rules live in assets/queue.md, which
# the skills read only when the queue is on; the skills keep only the pointer lines.
QUEUE_MD_REL = "assets/queue.md"
QUEUE_MD_MAX = 1600
QUEUE_WORDS = re.compile(r"(?i)queue|lane adopt|--lane\b|the lane is held|lane is held elsewhere")


def queue_text_hits(target, brand):
    """AT-QA-06: assets/queue.md exists with `## Handoff` and `## Resume` and at most
    QUEUE_MD_MAX bytes shipped; the resume SKILL points to it (Resume) and names no queue or lane
    duty outside that pointer line (QUEUE_WORDS; REVIEW-NIGHT NR-18), and queue.md holds the R8
    `Queue:` line; the handoff SKILL Step 2 points to it (Handoff); the template holds no
    `queued_line`."""
    out = []
    qpath, qlines = _shipped(target, QUEUE_MD_REL, brand)
    if qlines is None:
        return [_missing(qpath, "AT-QA-06 queue.md")]
    n = len("\n".join(qlines).encode("utf-8"))
    if n > QUEUE_MD_MAX:
        out.append((qpath, None, "AT-QA-06 size", "AT-QA-06 size: {} B > {}".format(n, QUEUE_MD_MAX), ""))
    for h in ("## Handoff", "## Resume"):
        if h not in qlines:
            out.append((qpath, None, "AT-QA-06 section", "AT-QA-06 section: no {!r}".format(h), ""))
    rpath, rlines = _shipped(target, RESUME_REL, brand)
    hpath, hlines = _shipped(target, HANDOFF_REL, brand)
    tpath, tlines = _shipped(target, TEMPLATE_REL, brand)
    if rlines is not None:
        if not any("assets/queue.md` (Resume)" in ln for ln in rlines):
            out.append((rpath, None, "AT-QA-06 pointer", "AT-QA-06 pointer: no `assets/queue.md` (Resume) line", ""))
        for no, ln in enumerate(rlines, 1):
            if "<store> lane adopt" in ln:
                out.append((rpath, no, "AT-QA-06 moved", "AT-QA-06 moved: '<store> lane adopt' belongs in assets/queue.md", ln))
        # REVIEW-NIGHT NR-18 (the -11 card: with the queue off nothing about queues or lanes reaches
        # the model): the R8 Queue line and every queue or lane line live in queue.md, so the
        # resume SKILL names the queue only on its pointer line.
        for no, ln in enumerate(rlines, 1):
            if "assets/queue.md` (Resume)" in ln:
                continue
            m = QUEUE_WORDS.search(ln)
            if m:
                out.append((rpath, no, "AT-QA-06 moved", "AT-QA-06 moved: {!r} belongs in assets/queue.md".format(m.group(0)), ln))
        if not any("`Queue: " in ln for ln in qlines):
            out.append((qpath, None, "AT-QA-06 report", "AT-QA-06 report: queue.md lacks the R8 `Queue:` line", ""))
    if hlines is not None:
        s2 = _section(hlines, r"^## Step 2 ", r"^## ") or []
        if not any("assets/queue.md` (Handoff)" in ln for ln in s2):
            out.append((hpath, None, "AT-QA-06 pointer", "AT-QA-06 pointer: Step 2 has no `assets/queue.md` (Handoff) line", ""))
    if tlines is not None:
        for no, ln in enumerate(tlines, 1):
            if "queued_line" in ln:
                out.append((tpath, no, "AT-QA-06 moved", "AT-QA-06 moved: 'queued_line' belongs in assets/queue.md", ln))
    return out


# AT-SR-09, F half (SPEC-DELTAS §5; REVIEW-NIGHT NR-03/NR-04/NR-05, TG-06): the spec's risk
# literals classify every row of tests/fixtures/risk/corpus.tsv as it says. The reference reading
# of the literals (what SR-7's `risk` must do too): a command carries no real risk only when every
# pipeline segment (split on |, ||, &&, ;, & and newlines) matches readonly_cmd_re or
# test_build_re, and no risk_classes, outward_classes, prod_classes or HARD secret_rules pattern
# matches the whole command. The recorded-command and work-tree path checks are code-only.
RISK_CORPUS = os.path.join(REPO, "tests", "fixtures", "risk", "corpus.tsv")
SEGMENT_SPLIT = re.compile(r"\|\||&&|[|;&\n]")


def risk_reference(spec, cmd):
    """The set of risk class ids the spec literals give `cmd` (empty = no real risk)."""
    hits = set()
    gates = set(spec.get("explicit_gate_classes") or [])
    for c in spec.get("outward_classes") or []:
        if re.search(c["re"], cmd):
            hits.add("gate" if c["id"] in gates else "outward")
    for c in spec.get("prod_classes") or []:
        if re.search(c["re"], cmd):
            hits.add("production")
    for c in spec.get("secret_rules") or []:
        if c.get("class") == "HARD" and re.search(c["re"], cmd):
            hits.add("credential-value")
    for c in spec.get("risk_classes") or []:
        if "re" in c and re.search(c["re"], cmd):
            hits.add(c["id"])
    ro = re.compile(spec["readonly_cmd_re"])
    tb = re.compile(spec["test_build_re"])
    for seg in SEGMENT_SPLIT.split(cmd):
        seg = seg.strip()
        if seg and not (ro.search(seg) or tb.search(seg)):
            hits.add("not-read-only")
    return hits


def risk_corpus_hits(target, brand):
    """AT-SR-09 (F half) over a built plugin folder: every corpus row gets its expected answer
    (none = no class; ask = some class, the named ones among them)."""
    spath, spec = spec_literals(target)
    if not _is_plugin(target):
        return []
    if not isinstance(spec, dict):
        return [(spath, None, "AT-SR-09 spec", "AT-SR-09 spec: no spec-literals block", "")]
    missing = [k for k in ("readonly_cmd_re", "test_build_re", "risk_classes", "outward_classes", "prod_classes")
               if k not in spec]
    if missing:
        return [(spath, None, "AT-SR-09 spec", "AT-SR-09 spec: no {}".format(", ".join(missing)), "")]
    if not os.path.isfile(RISK_CORPUS):
        return [(RISK_CORPUS, None, "AT-SR-09 corpus", "AT-SR-09 corpus: missing", "")]
    out = []
    rows = 0
    with open(RISK_CORPUS, encoding="utf-8") as f:
        for no, ln in enumerate(f, 1):
            ln = ln.rstrip("\n")
            if not ln or ln.startswith("#"):
                continue
            cols = ln.split("\t")
            if len(cols) < 3 or cols[0] not in ("none", "ask"):
                out.append((RISK_CORPUS, no, "AT-SR-09 row", "AT-SR-09 row: not `none|ask<TAB>command<TAB>classes`", ln))
                continue
            rows += 1
            want, cmd, need = cols[0], cols[1], [c for c in cols[2].split(",") if c not in ("", "-")]
            try:
                got = risk_reference(spec, cmd)
            except re.error as e:
                return [(spath, None, "AT-SR-09 spec", "AT-SR-09 spec: a pattern does not compile ({})".format(e), "")]
            if want == "none" and got:
                out.append((RISK_CORPUS, no, "AT-SR-09 none", "AT-SR-09 none: {!r} gets {}".format(cmd, ",".join(sorted(got))), ln))
            elif want == "ask" and not got:
                out.append((RISK_CORPUS, no, "AT-SR-09 ask", "AT-SR-09 ask: {!r} carries no risk class".format(cmd), ln))
            elif want == "ask" and not set(need) <= got:
                out.append((RISK_CORPUS, no, "AT-SR-09 class", "AT-SR-09 class: {!r} gets {}, want {}".format(
                    cmd, ",".join(sorted(got)), ",".join(need)), ln))
    if rows == 0:
        out.append((RISK_CORPUS, None, "AT-SR-09 corpus", "AT-SR-09 corpus: no rows", ""))
    # REVIEW-NIGHT NR-20 / AT-AP-07: protected_branch_re, matched against the lower-cased name.
    pbr = spec.get("protected_branch_re")
    try:
        prx = re.compile(pbr) if isinstance(pbr, str) else None
    except re.error:
        prx = None
    if prx is None:
        out.append((spath, None, "AT-AP-07 branch", "AT-AP-07 branch: no protected_branch_re that compiles", ""))
    else:
        for branch, want in PROTECTED_CASES:
            if bool(prx.search(branch.lower())) != want:
                out.append((spath, None, "AT-AP-07 branch", "AT-AP-07 branch: {} is {}protected, want {}".format(
                    branch, "" if not want else "not ", "protected" if want else "not protected"), ""))
    return out


